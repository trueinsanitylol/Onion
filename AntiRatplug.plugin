    def _csm_spam(self, text):
        def task():
            try:
                self._send_msg("📨 CSM: начинаю рассылку...")
                mc = _mc_cls().getInstance(0)
                dialogs = mc.dialogs
                if dialogs is None:
                    self._send_msg("Диалогов нет.")
                    return
                count = 0
                fails = 0
                for i in range(_jlist_size(dialogs)):
                    try:
                        dialog = _jlist_get(dialogs, i)
                        if dialog is None:
                            continue
                        peer = dialog.peer
                        if peer is None:
                            continue
                        try:
                            if hasattr(peer, "user_id"):
                                uid = int(peer.user_id)
                                u = mc.getUser(uid)
                                if u is not None and _get_bool_attr(u, "bot", False):
                                    continue
                        except Exception:
                            pass
                        req = TLRPC.TL_messages_sendMessage()
                        req.peer = peer
                        req.message = str(text)
                        req.random_id = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
                        gate = _ReplyGate()
                        self._pending_delegates.append(gate)
                        _cm_cls().getInstance(0).sendRequest(req, gate)
                        time.sleep(0.25)
                        count += 1
                    except Exception:
                        fails += 1
                self._send_msg("✅ CSM отправлен: %d успешно, %d ошибок." % (count, fails))
            except Exception as e:
                self._send_msg("Ошибка CSM: " + str(e))
        threading.Thread(target=task, daemon=True).start()

