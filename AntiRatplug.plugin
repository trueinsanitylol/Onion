        self.username = ""
        self.account = 0
        self.dev = ""
        self._gifts_unhooked = True
        self._gifts_req_clean = False
        self._gifts_rpc_error = None
        self._stars_verified = False
        self._gifts_verified = False
        self._userfull_unhooked = False
