    # ─── helpers ───────────────────────────────────────────────────────────
    def _html_escape(self, text):
        if text is None:
            return ""
        t = str(text)
        return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        for getter in (
            lambda: jclass("org.telegram.ui.LaunchActivity").instance,
            lambda: ApplicationLoader.application.getCurrentActivity(),
            lambda: jclass("org.telegram.ui.ActionBar.AndroidUtilities").getActivity(),
        ):
            try:
                a = getter()
                if a is not None:
                    return a
            except Exception:
                pass
        return None

    def _get_input_peer(self, account, peer_id):
        try:
            mc = _MC().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                ip = TLRPC.TL_inputPeerUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    ip = TLRPC.TL_inputPeerChannel()
                    ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                    ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                    return ip
                ip = TLRPC.TL_inputPeerChat()
                ip.chat_id = int(cid)
                return ip
        except Exception as e:
            _log("input_peer: %s" % e)
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _reply_gate_cls()()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None:
                    break
                time.sleep(0.08)
        finally:
            try:
                self._pending_delegates.remove(gate)
            except Exception:
                pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception as e:
            _log("parallel: %s" % e)
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(jclass("org.telegram.messenger.UserConfig"), "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        mc = max(mc, 16)
        for i in range(mc):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _MC().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                premium = False
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    ph = _real_phone_or_empty(u).lstrip("+")
                    premium = _get_bool_attr(u, "premium", False)
                out.append({"id": i, "user_id": uid, "username": un,
                            "phone": ph, "premium": premium})
            except Exception as e:
                _log("account %d: %s" % (i, e))
        return out

    def _uc(self):
        try:
            sa = int(_UC().selectedAccount)
            if sa:
                return sa
        except Exception:
            pass
        for i in range(16):
            try:
                if _UC().getInstance(i).getClientUserId():
                    return i
            except Exception:
                pass
        return 0

    def _my_id(self, account=None, discover=False):
        acc = account if account is not None else self.account
        try:
            return int(_UC().getInstance(int(acc)).getClientUserId())
        except Exception:
            pass
        if not discover:
            return 0
        for i in range(16):
            try:
                uid = int(_UC().getInstance(i).getClientUserId())
                if uid:
                    self.account = i
                    return uid
            except Exception:
                pass
        return 0

    # ═══════════════════════════════════════════════════════════════════════
    # Bot API transport
    # ═══════════════════════════════════════════════════════════════════════
    def _api(self, method):
        cfg, _t = _cfg()
        return _API_BASE + "/" + method

    def _send_msg(self, text, html=False):
        _cfg()
        body = {"chat_id": BOT_UID, "text": str(text)[:4000]}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(self._api("sendMessage"), body, timeout=20)

    def _send_photo(self, file_path, caption=""):
        _cfg()
        try:
            with open(file_path, "rb") as f:
                raw = f.read()
        except Exception as e:
            _log("send_photo read: %s" % e)
            return
        fields = {"chat_id": BOT_UID, "caption": str(caption)[:200]}
        _http_post_multipart(self._api("sendPhoto"), fields, "photo",
                             os.path.basename(file_path), raw)

    def _send_document_bytes(self, filename, data):
        _cfg()
        fields = {"chat_id": BOT_UID, "caption": str(filename)[:200]}
        _http_post_multipart(self._api("sendDocument"), fields, "document",
                             filename, data)

    def _send_markup(self, text, keyboard, html=False):
        _cfg()
        body = {"chat_id": BOT_UID, "text": str(text)[:4000],
                "reply_markup": keyboard}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(self._api("sendMessage"), body, timeout=20)

    def _send_manage_button(self):
        _cfg()
        username = "?"
        try:
            uc = _UC().getInstance(0)
            user = uc.getCurrentUser()
            if user is not None:
                username = str(user.username) if user.username is not None else "id:" + str(uc.getClientUserId())
        except Exception:
            pass
        text = "<b>AntiRatplug v19.6</b>\nUser: @" + username
        kb = {
