_logger = None


def _log(msg):
    global _logger
    try:
        if _logger is None:
            try:
                from android_utils import log as logcat
                _logger = logcat
            except Exception:
                _logger = lambda *a, **k: None
        _logger("[AR21] " + str(msg))
    except Exception:
        pass


